  "dependencies": {
    "node": ">=20",
    "python": ">=3.10（按实际产物类型需要）",
    "packages": [
      "python-docx（DOCX）",
      "python-pptx（PPTX）",
      "openpyxl（XLSX）"
    ],
    "optional_packages": [
      "playwright（交互验收）",
      "Pillow（图像）",
      "pypdf（PDF）",
      "ffprobe（媒体）"
    ],
    "mcp": "DSH版不注册额外MCP；Codex/ZCode适配包自带项目作用域受限的ARES工具服务，模型与原生工具由当前宿主提供。"
  },
  "runtime": {
    "cli": "scripts/ares.mjs",
    "workflows": "data/workflows.json",
    "project_state": ".ares/project.json",
    "configuration": "<DSH_HOME>/ares-workflows.json",
    "versions": "<DSH_HOME>/ares-versions/",
    "default_agent_execution": "single-agent",
    "configuration_assistant": "DSH原生专用编辑会话，无工作区选择，无自写模型请求循环"
  }
