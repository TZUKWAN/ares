{
  "competition_id": 75,
  "competition_name": "数字媒体科技作品竞赛",
  "judging_dimensions": [
    {
      "dimension": "创意性（选题立意与创意构思）",
      "weight": "约50%（推断：据校内选拔赛引用的百分制评分口径，创意性约50分）",
      "official_wording": "竞赛官网（cmit.cn）随2025年（第十三届）通知发布官方附件《2025年全国大学生数字媒体科技作品及创意竞赛评分标准及奖项设置（设定）》，为百分制评分；PDF分值未公开可检索，权重【推断】自作为其校内选拔赛的南京审计大学\"文心杯\"微电影微视频大赛评分表（总分100分：选题创意性约50分、艺术性约25分、技术性约20分、规范性约5分）。",
      "scoring_points": [
        "主题立意新颖，创意概念独特，契合\"科技创领\"竞赛理念",
        "原创性：核心创意与内容自主创作，非模板化拼凑",
        "切合赛道特征（VR与游戏/移动应用/影视与动漫/数据可视化等）的表达创意",
        "主题表达完整，叙事与交互设计有感染力"
      ],
      "common_deductions": [
        "作品同质化、套路化，创意点牵强",
        "明显模仿或搬运现有作品",
        "主题表达不完整、概念与成品脱节"
      ]
    },
    {
      "dimension": "艺术性（视觉与表现力）",
      "weight": "约25%（推断，同上口径）",
      "official_wording": "同上：官方百分制评分标准附件存在但分值未公开，维度权重【推断】自校内选拔赛评分表（艺术性约25分）。",
      "scoring_points": [
        "画面构图、色彩、动效的专业美感",
        "UI/交互视觉风格统一",
        "视听语言（剪辑、音效、节奏）表现力",
        "整体完成度带来的艺术感染力"
      ],
      "common_deductions": [
        "风格混乱、素材拼贴痕迹重",
        "使用低质或无关素材填充"
      ]
    },
    {
      "dimension": "技术性（制作与实现水平）",
      "weight": "约20%（推断，同上口径）",
      "official_wording": "同上：官方百分制评分标准附件存在但分值未公开，维度权重【推断】自校内选拔赛评分表（技术性约20分）；竞赛定位强调\"智能科技与数字创意交融\"（官网通知）。",
      "scoring_points": [
        "技术实现难度与稳定性（引擎、AR/VR、实时渲染、程序开发）",
        "AI等新技术的合理运用与集成",
        "作品可运行、可交互，技术细节经得起追问",
        "制作工艺（建模精度、代码质量、渲染效果）"
      ],
      "common_deductions": [
        "演示环境崩溃且无备份方案",
        "技术实现为开源模板直接套用未说明",
        "作品与提交说明的功能描述不符"
      ]
    },
    {
      "dimension": "规范性（格式与版权合规）",
      "weight": "约5%（推断，同上口径）",
      "official_wording": "同上：官方百分制评分标准附件存在但分值未公开，维度权重【推断】自校内选拔赛评分表（规范性约5分）；参赛指南（官网附件1）对作品格式与版权有明确要求。",
      "scoring_points": [
        "作品格式、时长、分辨率符合参赛指南要求",
        "素材版权合规（影视/音乐/图片素材有合法授权）",
        "报名信息真实完整，按时提交"
      ],
      "common_deductions": [
        "侵权素材（音乐、字体、影视片段）未获授权",
        "格式不符或材料缺失",
        "逾期提交"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "参赛作品文件（按赛道）",
      "format": "按参赛指南：影视动漫类交视频文件；VR/游戏与移动应用类交可执行程序/安装包+操作说明；数据可视化类交作品包",
      "page_limit": "未明确（以当届参赛指南为准）",
      "deadline_note": "报名截止约9月底（2025年为9月30日前），作品随报名在官方系统提交"
    },
    {
      "item": "作品说明/创意阐述材料",
      "format": "作品说明文档（创意构思、技术方案、团队分工）",
      "page_limit": "未明确",
      "deadline_note": "与作品同步提交"
    },
    {
      "item": "演示视频/路演材料（决赛）",
      "format": "演示视频或现场演示PPT",
      "page_limit": "未明确",
      "deadline_note": "晋级全国总决赛后按要求提交"
    }
  ],
  "process_stages": [
    {
      "stage": "校赛（校内初评）",
      "format": "学校组织初评，按名额推荐（多校规定推荐不超过参赛团队的40%）",
      "notes": "约9月完成校内选拔与推荐报名"
    },
    {
      "stage": "赛区赛（省赛区评审）",
      "format": "分赛区专家网评/会评，设赛区一、二、三等奖",
      "notes": "2025年赛区赛评审及公示为9月27日-10月10日；省赛获奖数量原则上不超过参评作品数量的40%，择优晋级全国总决赛"
    },
    {
      "stage": "全国总决赛",
      "format": "专家评审（作品评审+现场/线上答辩演示，按当届安排）",
      "notes": "评出全国一、二、三等奖；竞赛由行业协会与高校专家组成评审委员会，评分采用官方《评分标准及奖项设定》百分制"
    }
  ],
  "review_format": "专家按官方百分制《评分标准及奖项设定》评审：校赛初评推荐、赛区赛网评设奖、全国总决赛终评。",
  "judge_preferences": [
    "创意与立意优先，\"科技+文化\"融合题材受青睐",
    "重视新技术的真实运用（VR/AR、AI、实时交互），反对纯概念片",
    "作品完成度与演示稳定性，评委常现场运行体验",
    "版权与原创性审查严格，侵权一票否决"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "作品素材（音乐、影视、图片、字体）必须版权合规，侵权取消资格",
    "抄袭、搬运他人作品取消成绩",
    "每队人数与指导教师数须符合参赛指南（学生队规模与教师数按当届指南执行），多人挂名或跨队重复投稿违规",
    "作品须为当届新创作，往届已获奖作品重复参赛不予受理",
    "逾期或格式不符的作品不予评审"
  ],
