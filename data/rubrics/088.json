{
  "competition_id": 88,
  "competition_name": "天梯赛个人赛",
  "judging_dimensions": [
    {
      "dimension": "解题得分（测试点计分）",
      "weight": "计分主体100%（客观题：个人满分290分=基础级100+进阶级100+登顶级90，个人总分为各题通过测试点得分之和）",
      "official_wording": "团体程序设计天梯赛竞赛规程（华南师大转发官方规程原文）：'竞赛题目分3个梯级：基础级8道题，其中5分、10分、15分、20分的题各2道，满分为100分；进阶级4道题，每道题25分，满分为100分；登顶级3道题，每道题30分，满分为90分''每个测试用例分配一定分数。每题的得分为通过的测试用例得分之和；整场比赛得分为各题得分之和。可以反复提交，取最高分，提交错误不扣分''参赛队员的个人排名由其个人获得的总分决定'。",
      "scoring_points": [
        "基础级（L1）8题共100分：送分级题目必须全对，是个人与团队得分的底盘",
        "进阶级（L2）4题共100分：数据结构与基础算法（25分/题），区分中坚选手",
        "登顶级（L3）3题共90分：复杂算法（30分/题），决定个人特等奖争夺",
        "可反复提交取最高分、错误提交不扣分，应充分利用部分正确反馈逼近满分",
        "个人特等奖并列时依次按最高级别得分→最高级别完整解题数→最后一次提交时间（快者胜）"
      ],
      "common_deductions": [
        "格式错误（空格/换行不符合要求）导致测试点判错",
        "运行超时（题面时限普遍很紧，登顶级常要求150ms级）",
        "段错误/数组越界/未return 0等工程细节丢分"
      ]
    },
    {
      "dimension": "梯级策略与先锋奖励",
      "weight": "附加分数：先锋奖励50/40/30/20/10分（额外计入个人总分；团队解锁规则决定高级别得分是否有效）",
      "official_wording": "官方规程原文：'只有当一支队伍的基础题总分超过800分时，该队进阶部分的题目分数才被判为有效；只有当其进阶题总分超过400分时，该队登顶部分的题目分数才被判为有效''在进阶和登顶阶段最先完整获得其中任一题分数的前5位队员，分别依次获得50、40、30、20、10分先锋奖励。该奖励分数计入个人总分'。",
      "scoring_points": [
        "个人高分前提是团队基础级先冲过800分解锁线，快攻L1是全队策略",
        "抢先锋奖励：进阶/登顶最先完整解出任意一题的前5人获50-10分加成",
        "个人满分290分+先锋奖励，冲击个人特等奖需L2/L3接近全对",
        "团队计分：高校最多3支队伍计分评奖，个人得分汇总决定团队与高校排名"
      ],
      "common_deductions": [
        "团队基础级未达800分，个人L2/L3解题得分被判无效",
        "团队进阶级未达400分，L3得分无效",
        "只顾攻难题忽视L1基础分，个人与团队双输"
      ]
    },
    {
      "dimension": "参赛合规与独立完成",
      "weight": "一票否决：违纪剥夺参赛资格；赛后代码查重不合格取消成绩",
      "official_wording": "官方规程原文：'参赛队员仅可以携带无计算功能的铅笔或水笔入场''不能携带任何可用计算机处理的软件或数据（不允许任何私人携带的存储设备或计算器）''不能携带包括无线电接收器、移动电话等在内的任何类型的通讯工具''擅自移动赛场中的设备，未经授权修改比赛软硬件，干扰他人比赛等妨碍比赛正常进行的行为……都将被竞赛专家委员会剥夺参赛资格''命题组……在比赛结束后对所有提交的代码进行查重检验''已经获得过2届全国个人特等奖的队员将被谢绝参赛'。",
      "scoring_points": [
        "独立解题，赛前签署/提交教务部门盖章的队员身份证明",
        "3小时机考只允许纸笔，遵守纯离线规则",
        "接受赛后代码查重（24小时内提交检验合格报告）",
        "C/C++/Java任一语言在指定环境独立完成"
      ],
      "common_deductions": [
        "携带手机/存储设备入场或比赛中通讯",
        "与他人代码雷同，查重不合格取消成绩",
        "干扰他人比赛或擅自改动赛场软硬件被剥夺资格"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "赛题解题程序",
      "format": "C/C++/Java源代码，PTA（拼题A/patest）在线判题系统现场提交",
      "page_limit": "未明确（以题面输入输出要求与时空限制为准）",
      "deadline_note": "比赛日当天3小时内提交（惯例3月下旬周六13:00-16:00）"
    },
    {
      "item": "报名表与队员身份证明",
      "format": "官网报名表+学校/学院教务部门盖章的队员、教练名单",
      "page_limit": "未明确",
      "deadline_note": "报名截止约3月20日；上场队员调整须赛前1天书面报批；报到当日凭材料获得参赛资格"
    },
    {
      "item": "考场随身物品",
      "format": "仅限无计算功能的铅笔或水笔",
      "page_limit": "未明确",
      "deadline_note": "比赛日入场检查"
    }
  ],
  "process_stages": [
    {
      "stage": "校内选拔（校内赛）",
      "format": "各校用拼题A（pintia.cn）平台自行组织选拔，按成绩组队（每队最多10人+1-2名教练）",
      "notes": "2-3月进行；个人独立竞技、团队计分模式在选拔即确立"
    },
    {
      "stage": "全国分赛场现场赛",
      "format": "全国统一时间（3月下旬）在各区分赛场现场机考3小时，三个组别（珠峰争鼎/华山论剑本科组、沧海竞舟专科组）同一套题目、统一评分",
      "notes": "个人独立解题；团队总分=队员个人有效得分之和；基础>800解锁进阶有效性、进阶>400解锁登顶有效性"
    },
    {
      "stage": "赛后查重与评奖",
      "format": "命题组对全部提交代码查重检验，专家委员会确定获奖名单",
      "notes": "评出全国/省两级高校奖、团队奖（全国团队一二三等奖按5%/10%/15%比例）、个人特等奖1人（满分290+先锋奖励）及先锋奖、最佳女队等特别奖；个人成绩同时发送PAT联盟企业供招聘参考"
    }
  ],
  "review_format": "OJ机器自动评测（测试点部分给分、反复提交取最高）+赛后全量代码查重，个人排名按个人总分、团队排名按队员总有效分",
  "judge_preferences": [
    "基础级全对是底线：L1拿满既是个人分又是团队800分解锁前提",
    "L2/L3算法硬实力与极限速度：登顶级时限极紧，卡常数能力受看重",
    "抢开赛先锋奖励的果断策略（前5名完整解出加50-10分）",
    "代码独立性与风格自然：查重高压下模板痕迹过重易被关注"
  ],
