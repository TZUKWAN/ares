{
  "competition_id": 70,
  "competition_name": "信息安全与对抗技术竞赛",
  "judging_dimensions": [
    {
      "dimension": "破阵夺旗赛（CTF解题，客观积分制）",
      "weight": "客观积分制：通过flag的正解性及提交时间等因素综合评定分数（官方明文，无主观权重）",
      "official_wording": "通过flag的正解性及提交时间等因素综合评定分数（ISCC2026通知）；破阵夺旗赛关卡分为BASIC、WEB、REVERSE、PWN、MISC、MOBILE六个关卡（ISCC竞赛简况，北理工信息系统及安全对抗实验中心官网）",
      "scoring_points": [
        "解题数量：每解出一关获得对应分值的flag",
        "提交时间：用时短者排名靠前（积分与过关时间综合排序）",
        "关卡覆盖：BASIC基础、WEB渗透、逆向、二进制漏洞利用（PWN）、MISC、移动安全",
        "关卡难度与分值对等：经组委会内测定级，分值反映真实技术水平"
      ],
      "common_deductions": [
        "flag重复提交无效提交浪费排名时间",
        "使用扫描器爆破等干扰平台行为被判违规",
        "多账号、共享flag等作弊取消成绩"
      ]
    },
    {
      "dimension": "无限擂台赛与数据安全赛（客观赛项）",
      "weight": "客观题式机评：按题目未被解出持续时间/预测准确性评定分数（官方明文）",
      "official_wording": "无限擂台赛：根据擂台题目在擂台上未被解出的持续时间评定分数；数据安全赛：综合考虑选手提交预测结果的准确性和提交时间的先后顺序评定分数（ISCC2026通知）",
      "scoring_points": [
        "无限擂台赛：攻防对抗中维持己方题目不被解出的时长即得分依据",
        "数据安全赛：预测模型准确性优先，同分按提交时间排序",
        "智能安全赛：赛道评分以客观项为主（AI安全任务自动化评测）",
        "线上挑战赛（破阵夺旗+无限擂台+数据安全）统一在18天窗口内进行"
      ],
      "common_deductions": [
        "擂台题目被解出即失分，防御薄弱直接掉排名",
        "数据预测提交过晚同分落败",
        "模型复现他人方案无自主改进"
      ]
    },
    {
      "dimension": "创新作品赛（开放式自主命题）",
      "weight": "专家综合评分、以客观项为主（官方明文）；无公开分值表，属定性评审",
      "official_wording": "创新作品赛主要采用开放式自主命题方式……参赛作品必须为原创作品，未参加其他任何形式的竞赛或评奖活动，由组委会组织专家综合评分（ISCC2026通知）；创新作品赛评分以客观项为主（ISCC竞赛简况）",
      "scoring_points": [
        "选题面向信息安全真实问题（漏洞检测、数据安全、AI安全、物联安全等）",
        "技术实现完整：可运行系统/工具+测试验证数据",
        "自主知识产权与创新点（算法、机制、工具链）",
        "作品文档规范：设计说明、演示材料、原创性声明"
      ],
      "common_deductions": [
        "已用于其他竞赛评奖的作品参赛（明文禁止）",
        "开源项目直接打包冒充原创",
        "只有论文/概念无可运行验证"
      ]
    },
    {
      "dimension": "博弈对抗赛（封闭环境攻防对抗）",
      "weight": "客观题式对抗积分：按夺旗得分与防御成效排名（官方明文表述为攻防比拼得分）",
      "official_wording": "从破阵夺旗赛中选择并邀请全国各地优秀学生及个人到北京理工大学参加……在DMZ区、数据区、开发测试区、内网服务区、终端区的封闭环境中，主要采取阵地夺旗、占领高地等模式进行攻防比拼，通过入侵指定服务器获取旗子的目标而得分，并在攻上高地后防御其他队伍的攻击（ISCC竞赛简况）",
      "scoring_points": [
        "攻击能力：入侵指定服务器夺取flag得分",
        "防御能力：攻占高地后守住阵地、抵御其他队伍攻击",
        "实战中的快速情报研判与团队协作",
        "对抗全程遵守环境边界规则，不得出网攻击"
      ],
      "common_deductions": [
        "攻击超出封闭环境边界或破坏平台",
        "防御姿态粗放（直接拔网线类违规操作）",
        "队伍内单人包办无协作"
      ]
    }
  ],
