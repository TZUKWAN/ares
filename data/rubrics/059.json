{
  "competition_id": 59,
  "competition_name": "“工行杯”金融科技创新大赛",
  "judging_dimensions": [
    {
      "dimension": "创意新颖性（创新维度）",
      "weight": "约30%（官方未公布权重表；官方表述'创意新颖、可行性强的多元创想'，按金融方案类竞赛通行框架推断）",
      "official_wording": "大赛官方通知原文（多校转发一致）：'鼓励青年学子结合金融产品与服务场景挖掘真实需求，为新技术应用、银行业务模式创新提出内容充实、创意新颖、可行性强的多元创想'。【推断：权重为同类产品创新赛通行区间】",
      "scoring_points": [
        "针对十大参赛方向的金融产品/服务/场景提出新颖构想",
        "银行业务模式创新或新技术应用（AI、大模型、数字人民币等）有想象力",
        "切口独特：洞察未被满足的真实需求（如夜市经济、银发群体、Z世代消费）",
        "创意与工行真实业务场景结合度高"
      ],
      "common_deductions": [
        "创意与市面已有银行产品雷同",
        "纯技术堆砌而无金融场景内涵",
        "方案空泛、脱离银行实际业务"
      ]
    },
    {
      "dimension": "需求洞察与内容充实度",
      "weight": "约30%（推断：官方将'挖掘真实需求''内容充实'与创意并列表述，为方案主体评分载体）",
      "official_wording": "官方表述原文：'结合金融产品与服务场景挖掘真实需求……提出内容充实、创意新颖、可行性强的多元创想'（云南大学/哈工大/安徽工业大学转发通知一致）。十大方向的官方导语均以真实需求洞察开篇（如科技金融'当科技企业埋头研发时，谁来帮他们解决钱的烦恼'）。【推断：权重按通行区间】",
      "scoring_points": [
        "用户画像与痛点分析扎实（目标客群需求真实可感）",
        "商业计划书结构完整：背景—需求—方案—价值论证",
        "对金融工具（股权、债权、保险、理财、支付等）理解准确",
        "体现社会意义（普惠、绿色、养老、特色服务等政策导向领域）"
      ],
      "common_deductions": [
        "需求臆造、无调研支撑",
        "内容单薄、方案只有概念无展开",
        "金融专业知识错误（合规、风控硬伤）"
      ]
    },
    {
      "dimension": "方案可行性与商业价值",
      "weight": "约25%（推断：官方'可行性强'为三大标准之一，半决赛/总决赛由工行与行业评委考量落地价值）",
      "official_wording": "官方表述原文：'为新技术应用、银行业务模式创新提出……可行性强的多元创想'；大赛定位为'深化产教融合与新技术应用，助推数字经济与现代金融高质量协同发展'，并'为大学生搭建兼具社会意义与实践价值的金融科技创新平台'（云南大学通知原文）。【推断：权重按通行区间】",
      "scoring_points": [
        "技术实现路径可行（数据、系统、合规约束下可落地）",
        "商业模式/业务价值清晰（成本、收益、规模化的银行视角测算）",
        "风险与合规考量（金融安全、消保、监管适配）",
        "对工行业务的实际导入潜力"
      ],
      "common_deductions": [
        "方案违背金融监管或合规常识",
        "技术路线不可实现、无原型/原型无法支撑方案",
        "商业测算严重失真"
      ]
    },
    {
      "dimension": "舞台展示与答辩表现",
      "weight": "约15%（推断：全国半决赛与总决赛均为'现场舞台展示+评委提问打分'，展示为定级环节）",
      "official_wording": "安徽工业大学校赛通知原文：'全国半决赛（预计2026年11月）晋级选手进行现场舞台展示，由评委进行提问打分环节；全国总决赛（预计2026年12月）晋级队伍进行现场舞台展示，评委现场提问评审'。【推断：权重按通行区间】",
      "scoring_points": [
        "汇报PPT逻辑清晰、舞台表达有感染力",
        "在规定时间内完成展示",
        "评委提问应答专业、数据口径一致",
        "团队协作与临场应变"
      ],
      "common_deductions": [
        "超时、念稿、展示平淡",
        "答辩对方案细节与数据来源含糊",
        "材料与陈述内容矛盾"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "参赛报名",
      "format": "大赛官网 www.gonghangbei.com 及微信公众号'工行杯大学生金融科技创新大赛'线上报名；境内外高校本硕博专业不限，个人或团队（团队人数不超过3人）均可",
      "page_limit": "团队≤3人，指定1名队长，不可跨队",
      "deadline_note": "第十七届（2026）：6-9月宣讲、报名及作品提交；9月截止线上报名"
    },
    {
      "item": "参赛作品（金融科技创新方案）",
      "format": "报名表+商业计划书+项目汇报PPT等材料（围绕当届十大参赛方向之一：科技金融、绿色金融、普惠金融、养老金融、数字金融、金融安全服务、特色金融服务、财富管理服务、青年群体服务、开放创新服务）",
      "page_limit": "未明确统一页数",
      "deadline_note": "校级选拔赛多在9月中下旬；作品随校赛打包提交并同时完成线上报名"
    },
    {
      "item": "全国阶段现场展示材料",
      "format": "全国半决赛/总决赛均为现场舞台展示+评委提问；展示PPT按组委会后续要求提交",
      "page_limit": "同上",
      "deadline_note": "省赛2026年10月（工行各省分行组织）；全国半决赛11月；全国总决赛12月"
    }
  ],
  "process_stages": [
    {
      "stage": "宣讲与报名",
      "format": "工行各省分行与高校联合宣讲；官网/公众号线上报名",
      "notes": "第十七届以'数智银行、创见未来'为主题；2026年6-9月"
    },
    {
      "stage": "校级选拔赛",
      "format": "各高校组织校赛（材料评审或现场路演），评一二三等奖并推荐省赛",
      "notes": "2026年9月10日左右截止（云南大学）；作品打包发送校赛邮箱并同时线上报名"
    },
    {
      "stage": "省赛",
      "format": "由工商银行各省分行组织省级比赛（材料评审与现场展示结合）",
      "notes": "2026年10月；优胜作品晋级全国半决赛"
    },
    {
      "stage": "全国半决赛",
      "format": "现场舞台展示+评委提问打分",
      "notes": "2026年11月；设二等奖、三等奖（及优秀奖、入围奖）；优秀主创获工行行内实习机会"
    },
    {
      "stage": "全国总决赛",
      "format": "现场舞台展示+评委现场提问评审，决出特等奖、一等奖",
      "notes": "2026年12月；特等奖2万元/组、一等奖1万元/组、二等奖5千元/组、三等奖3千元/组；设总决赛优秀指导教师奖"
    }
  ],
  "review_format": "校赛材料评审/路演+省赛（工行省分行组织）+全国半决赛与总决赛'现场舞台展示、评委提问打分'的逐级评审制",
  "judge_preferences": [
    "偏好从真实金融场景切入、需求洞察鲜活的方案（各方向官方导语均以生活化需求开篇）",
    "看重与工行业务的结合度与落地导入潜力（产教融合导向、实习与招聘转化）",
    "鼓励新技术应用（AI安全智能体、多模态模型、数字金融体验重构等）",
    "强调'内容充实、创意新颖、可行性强'三位一体，纯概念或纯技术方案吃亏",
    "展示环节看重舞台表现力与答辩专业性"
  ],
