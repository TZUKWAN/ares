{
  "competition_id": 61,
  "competition_name": "跨文化能力大赛",
  "judging_dimensions": [
    {
      "dimension": "案例开发",
      "weight": "分数构成：案例开发20分（案例开发与展示分析环节满分100分）",
      "official_wording": "电子科技大学第九届选拔赛通知：'A.案例开发与展示分析（满分100分）案例开发：20分 1 案例…围绕多元文化生活、公共外交、商务沟通三大主题开发原创跨文化案例'；第五届大赛章程要求案例'根据团队成员自身经历原创'。",
      "scoring_points": [
        "案例原创性与真实性：源于团队成员亲身经历，禁止虚构/AI生成/剪辑",
        "主题契合度：紧扣多元文化生活、公共外交、商务沟通三大主题之一",
        "典型性：案例能集中体现跨文化冲突/误解/适应等典型情境",
        "文化内涵：涉及至少两种文化的碰撞与理解，素材具体可信"
      ],
      "common_deductions": [
        "案例抄袭、改编网络素材或使用AI生成内容被认定",
        "主题偏离三大主题范围",
        "案例泛泛而谈、缺乏真实细节与文化冲突点"
      ]
    },
    {
      "dimension": "案例展示（现场表演）",
      "weight": "分数构成：案例展示30分（案例开发与展示分析环节满分100分）",
      "official_wording": "电子科技大学选拔赛通知：'案例展示：30分'；章程：'团队现场表演展示案例，形式不限，须自然、合理、生动清晰'。",
      "scoring_points": [
        "表演自然合理，情境还原生动清晰",
        "英语表达准确流利，语音语调得体（中文占比不超过5%）",
        "团队成员分工均衡、角色塑造到位、配合默契",
        "舞台呈现：道具/服装/PPT等辅助恰当，控制在规定时长内"
      ],
      "common_deductions": [
        "超时或严重不足规定时长",
        "表演生硬背稿、语言错误密集",
        "个别成员游离于展示之外、参与度失衡",
        "PPT/道具喧宾夺主或出现校名等违规信息"
      ]
    },
    {
      "dimension": "案例分析（跨文化理论运用）",
      "weight": "分数构成：案例分析30分（案例开发与展示分析环节满分100分）",
      "official_wording": "电子科技大学选拔赛通知：'案例分析：30分'；四川省第二届高校跨文化能力大赛评分要点：'能恰当运用跨文化交际概念和理论知识，对案例中展现的跨文化现象进行分析'。",
      "scoring_points": [
        "理论工具恰当：正确运用Hofstede文化维度、高/低语境、文化定型、跨文化适应等概念理论",
        "分析深度：剖析冲突成因、揭示深层文化价值差异而非表面描述",
        "逻辑自洽：从现象到理论到对策层层推进",
        "提出有针对性的跨文化沟通建议或解决策略"
      ],
      "common_deductions": [
        "理论堆砌与案例两张皮、贴标签式分析",
        "只有故事复述没有理论透视",
        "分析框架错误或概念使用不当"
      ]
    },
    {
      "dimension": "创新意识",
      "weight": "分数构成：创新意识20分（案例开发与展示分析环节满分100分）",
      "official_wording": "电子科技大学选拔赛通知：'C.创新意识：20分 1 案例本身体现创新意识，能以创新方式展现案例内容 2 …'。",
      "scoring_points": [
        "案例视角新颖，选取少见的跨文化场景或文化组合",
        "展现形式有创意（叙事结构、多媒体运用等）",
        "分析视角独特，能提出新见解",
        "整体呈现给评委留下记忆点"
      ],
      "common_deductions": [
        "选题陈旧（如千篇一律的餐桌礼仪/送礼物误会）",
        "形式套路化、缺乏记忆点"
      ]
    },
    {
      "dimension": "知识问答（中国文化/世界文化/跨文化交际知识）",
      "weight": "10分（省赛环节，客观题计分）",
      "official_wording": "电子科技大学选拔赛通知：'B.知识问答（10分）5道题（选择题），涉及中国文化知识、世界文化知识和跨文化交际相关知识；10分全对得10分，答错不扣分'。",
      "scoring_points": [
        "中国文化知识准确（历史、哲学、民俗、当代国情）",
        "世界文化知识准确",
        "跨文化交际学基础知识（概念、学者、理论）",
        "5题全对方得满分，答错不扣分"
      ],
      "common_deductions": [
        "常识性错误暴露知识面短板",
        "备赛只练案例不备知识问答，丢分集中在客观题"
      ]
    },
    {
      "dimension": "评委问答与决赛综合（情境评述/讲述中国故事）",
      "weight": "省赛评委问答30分；全国决赛满分100分=初赛成绩10%+情境评述50%+问答应对10%+讲述中国故事30%",
      "official_wording": "电子科技大学选拔赛通知：'评委问答（30分）评委针对案例内容用中文或英文进行提问，团队所有成员均可回答'；'决赛评分标准（满分100分）：初赛成绩10%，情境评述50%，问答应对10%，讲述中国故事30%'。",
      "scoring_points": [
        "回答切题、观点清晰，中英双语应答能力",
        "临场应变与抗压：面对追问不慌乱、逻辑不崩",
        "情境评述：对新情境快速组织理论化分析",
        "讲述中国故事：用跨文化视角阐释中国国情与文化，叙事真诚有说服力",
        "全体成员均可回答，团队参与度"
      ],
      "common_deductions": [
        "答非所问、依赖单一名成员应答",
        "情境评述脱离理论框架",
        "讲述中国故事空洞说教、缺乏个人真实体验"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "原创跨文化案例及案例文本",
      "format": "围绕多元文化生活、公共外交、商务沟通三大主题的原创案例（团队亲身经历），配展示文稿/PPT",
      "page_limit": "未明确",
      "deadline_note": "校内选拔赛（视频评审）通常在上半年，省赛与全国决赛在下半年"
    },
    {
      "item": "案例展示视频（校赛/初赛）",
      "format": "视频评审：录制案例展示视频，全程英语，中文不超过5%，不得剪辑、不得出现学校名称等信息",
      "page_limit": "未明确（常见6-10分钟）",
      "deadline_note": "按校内选拔通知时间提交"
    },
    {
      "item": "报名表（3人团队）",
      "format": "以学校为单位组队报名，每队3名学生+指导教师",
      "page_limit": "未明确",
      "deadline_note": "省赛报名一般于比赛前1-2个月截止"
    }
  ],
  "process_stages": [
    {
      "stage": "校内选拔赛",
      "format": "视频评审为主：提交案例展示视频，按案例开发与展示分析（满分100）+知识问答等评分",
      "notes": "各校自行组织，参照大赛官方章程；胜出队伍代表学校参加省赛区赛"
    },
    {
      "stage": "省赛（分赛区）",
      "format": "现场赛：案例展示+案例评析+知识问答（10分）+评委问答（30分）",
      "notes": "案例开发与展示分析满分100分（开发20/展示30/分析30/创新20）；各省赛区（如江苏、四川、辽宁等）单独设奖并选拔晋级全国决赛名额"
    },
    {
      "stage": "全国总决赛",
      "format": "现场赛：情境评述（50%）+问答应对（10%）+讲述中国故事（30%）+初赛成绩（10%），满分100分",
      "notes": "全国决赛由上海外国语大学/组委会组织；以'外教社杯'全国高校学生跨文化能力大赛（SNICC）名义颁奖"
    }
  ],
  "review_format": "评委现场打分：案例展示与分析为观察式评分（满分100），辅以知识问答客观题与评委即席提问（30分），决赛按情境评述/问答/中国故事加权；全程英语。",
  "judge_preferences": [
    "案例必须原创且来自亲身经历，忌网络改编与AI生成",
    "理论运用要'化在分析里'，反对贴标签式套用理论",
    "团队全员参与、英语地道自然，中文比例不超过5%",
    "重视真实跨文化敏感性：对文化差异的尊重、共情与反思",
    "讲述中国故事环节偏好具体个人叙事而非宏大空话"
  ],
