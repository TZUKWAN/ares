{
  "competition_id": 116,
  "competition_name": "“茅以升公益桥”创新设计大赛",
  "judging_dimensions": [
    {
      "dimension": "公益性（实地调研与社会实践）",
      "weight": "约20%（推断：公益属性为本赛立赛之本且列为大赛理念第一条，社会实践材料为必交物）",
      "official_wording": "第八届大赛通知（基金会官网）：大赛理念'公益性：加强专业实践教育，了解国情民情，助力乡村振兴，培养家国情怀'；提交材料必含'社会实践材料'；赛项一（自选桥址）需团队'自行调查填写'《桥址信息调查表》。【推断】权重约20%。",
      "scoring_points": [
        "实地踏查桥址：地形、水文、交通量等一手调研数据",
        "《桥址信息调查表》填写完整、信息真实",
        "设计回应乡村儿童/居民安全出行真实需求（'为少年儿童架设安全求学之桥'）",
        "社会实践材料完整（照片、调研记录）"
      ],
      "common_deductions": [
        "未实地调研、桥址信息拍脑袋编造",
        "设计与当地需求脱节",
        "社会实践材料缺失或造假"
      ]
    },
    {
      "dimension": "科学性（结构安全与技术规范）",
      "weight": "约25%（推断：桥梁工程设计以安全为底线，计算书为必交物）",
      "official_wording": "第八届通知：大赛理念'科学性：在遵循安全、耐久等要求下，体现专业水准，鼓励新结构、新材料、新工艺、新技术的应用'；提交材料含'桥梁设计图和计算书'。【推断】权重约25%。",
      "scoring_points": [
        "结构计算书完整规范（承载力、稳定性验算）",
        "满足安全、耐久等基本要求，符合桥梁设计规范",
        "结构方案受力合理、构造可行",
        "图纸表达规范、深度达标"
      ],
      "common_deductions": [
        "计算书缺失或计算错误",
        "结构方案存在安全隐患（安全为一票否决性质）",
        "图纸与计算书不一致"
      ]
    },
    {
      "dimension": "先进性（新技术与双碳导向）",
      "weight": "约15%（推断：理念第三条，体现创新导向）",
      "official_wording": "第八届通知：大赛理念'先进性：鼓励通过专业设计助力国家双碳战略，鼓励智能建造、绿色建造等技术应用'。【推断】权重约15%。",
      "scoring_points": [
        "新结构、新材料、新工艺、新技术的应用",
        "绿色低碳设计（材料碳足迹、装配化建造）",
        "智能建造/BIM等技术手段运用"
      ],
      "common_deductions": [
        "技术堆砌而无实际效益论证",
        "所谓新技术与公益桥尺度不匹配（大炮打蚊子）",
        "陈旧方案无任何先进性"
      ]
    },
    {
      "dimension": "实用性与景观协调",
      "weight": "约20%（推断：理念第四条强调可实施性与人文适应）",
      "official_wording": "第八届通知：大赛理念'实用性：重视设计方案的可实施性和实用价值，兼顾景观美学价值，与当地人文风貌、民风民俗相适应'。【推断】权重约20%。",
      "scoring_points": [
        "方案可实施：施工条件、材料运输可行性论证",
        "使用功能满足行人/通行需求（净空、坡度、无障碍）",
        "造型与当地人文风貌、民风民俗协调，景观美学价值",
        "运营维护便利"
      ],
      "common_deductions": [
        "造型华而不实、施工不可行",
        "忽视当地材料与施工能力",
        "桥型与环境严重违和"
      ]
    },
    {
      "dimension": "经济性",
      "weight": "约10%（推断：理念第五条，公益桥强调低造价）",
      "official_wording": "第八届通知：大赛理念'经济性：提倡低造价、高效益，与当地经济发展水平相适应'。【推断】权重约10%。",
      "scoring_points": [
        "造价估算合理、有工程量清单支撑",
        "低造价、高效益的方案比选",
        "造价与当地经济发展水平匹配"
      ],
      "common_deductions": [
        "造价明显超出公益桥预算水平",
        "无造价测算",
        "为压低造价牺牲安全功能"
      ]
    },
    {
      "dimension": "现场决赛答辩",
      "weight": "定性（决赛环节）：入围队伍赴承办高校现场答辩，院士及行业专家评审",
      "official_wording": "第六届大赛报道（长安大学/福州大学）：决赛在福州大学举行，高宗余院士参与评审；第八届（特别赛）报道：刘加平院士等评审并公布结果。【推断】决赛答辩在总分中占一定比重，比例以当届实施方案为准。",
      "scoring_points": [
        "汇报清晰：设计逻辑、调研—方案—计算—落地主线完整",
        "答辩经得起院士级专家对结构细节的追问",
        "团队协作与应答分工"
      ],
