{
  "competition_id": 104,
  "competition_name": "安全科学与工程实践与创新作品大赛",
  "judging_dimensions": [
    {
      "dimension": "科学性（选题相关性）",
      "weight": "10%（第三届初赛评分标准：满分10分）",
      "official_wording": "第三届评分标准（官方PDF影印件）原文：'一、科学性（10%，分值10分）：选题与安全学科紧密相关——5分；选题新颖，突出实践性——5分'。",
      "scoring_points": [
        "选题与安全科学及工程学科直接相关（事故预防、灾害控制、安全管理、应急技术与管理等主题）",
        "选题新颖、突出实践性",
        "面向矿山、化工、建筑、交通、工业企业、公共场所等真实行业安全场景"
      ],
      "common_deductions": [
        "选题与安全学科关联牵强",
        "主题陈旧、纯理论堆砌缺乏实践指向",
        "作品曾获全国或全省科技创新竞赛奖励（不在申报范围）"
      ]
    },
    {
      "dimension": "创新性",
      "weight": "30%（第三届初赛评分标准：满分30分）",
      "official_wording": "第三届评分标准原文：'二、创新性（30%，分值30分）：设计思路、研究方法有新意——10分；作品功能、材料装置有创新——20分'。",
      "scoring_points": [
        "设计思路与研究方法有新意（10分档）",
        "作品功能有创新（10-20分档）",
        "材料、装置层面的原始创新或集成创新",
        "与现有同类安全产品/方法相比有明确改进点"
      ],
      "common_deductions": [
        "仅为主流技术简单拼装、无自主设计成分",
        "创新点描述空泛、无法在作品中验证",
        "与已发表/已获奖作品雷同，存在知识产权争议"
      ]
    },
    {
      "dimension": "可行性（方案与功能实现）",
      "weight": "30%（第三届初赛评分标准：满分30分）",
      "official_wording": "第三届评分标准原文：'三、可行性（30%，分值30分）：工作思路清晰，研究方案可行——15分；作品功能与预期目标相吻合——15分'。",
      "scoring_points": [
        "工作思路清晰、研究方案技术路线可行（15分档）",
        "作品实际功能与预期目标吻合（15分档）",
        "说明书载明功能、基本参数、运行条件，参数合理自洽",
        "软件/仿真类作品可运行、截图与视频证据完整"
      ],
      "common_deductions": [
        "方案存在明显技术缺陷或原理错误",
        "演示功能与声称功能不符、关键环节无法复现",
        "缺少说明书、运行视频/截图等佐证材料"
      ]
    },
    {
      "dimension": "作品完成质量与决赛展示答辩",
      "weight": "合计约30%【推断：官方PDF预览仅显示科学性10分+创新性30分+可行性30分共70分，剩余约30分按赛事惯例分配于作品完成度/应用价值与决赛现场展示、汇报答辩表现；未能取得原文】",
      "official_wording": "推断依据：中国科大新闻网对第四届决赛的报道：'决赛分为现场展示和汇报答辩两个环节，最后经评审委员会专家分组评审和集中综合会评'；河北工程大学选拔赛通知：'初赛：邀请校内外行业专家进行网络评审……决赛：入围决赛作品现场实物展示和答辩'。剩余30分的具体分项名目与分值未公开，【推断】为完成度/应用价值与展示答辩。",
      "scoring_points": [
        "实体作品制作工艺与完成度（实体/模型说明书、照片、运行视频质量）",
        "现场展示效果：实物演示流畅、可视化呈现",
        "汇报答辩：逻辑清晰、回答准确、团队协作",
        "作品的应用价值与推广前景"
      ],
      "common_deductions": [
        "实物无法现场演示或演示失败且无法解释",
        "答辩与材料陈述矛盾、关键问题无人能答",
        "第一完成人非学生或团队超员（每队不超过5人、指导教师1名）"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "安全实体作品与模型",
      "format": "面向各行业事故预防与应急救援的装置或模型；提交说明书（功能、基本参数、运行条件等）、作品照片或运行视频；实体不退还（校级惯例）",
      "page_limit": "未明确",
      "deadline_note": "校级节点示例（第10届河北工程大学选拔赛）：报名截止2024-03-31，作品提交截止2024-05-12，5月下旬校级决赛；全国决赛2024-08-17/18在大连理工大学"
    },
    {
      "item": "安全软件与仿真模拟作品",
      "format": "自主开发或基于软件平台开发的软件、仿真模拟、安全动画、DV作品、教学课件；提交说明书、软件（光盘/安装包）、运行截图",
      "page_limit": "未明确",
      "deadline_note": "与实体作品同步提交；全国赛经高校初赛筛选后推送"
    },
    {
      "item": "报名表与作品简介",
      "format": "团体参赛：每队学生不超过5人、指导教师1名，作品第一完成人必须为学生；电子材料按'作品名称+作品类别+队长姓名'打包",
      "page_limit": "未明确",
      "deadline_note": "各高校初赛筛选后按组委会通知报送全国复赛"
    }
  ],
  "process_stages": [
    {
      "stage": "高校初赛（校内选拔）",
      "format": "各高校自行征集作品、组织专家网络评审，评选优秀作品推送",
      "notes": "河北工程大学：'初赛：邀请校内外行业专家进行网络评审，评选出若干优秀作品入围决赛'"
    },
    {
      "stage": "全国复赛（函评）",
      "format": "进入复赛的作品（第四届为316件）由安全科学与工程领域专家函评（通信评审）",
      "notes": "函评依据初赛评分标准对材料匿名打分，按得分排序确定入围决赛名单（第四届54件入围）"
    },
    {
      "stage": "全国决赛（现场展示+答辩）",
      "format": "现场展示和汇报答辩两个环节，评审委员会专家分组评审后集中综合会评",
      "notes": "第四届（合肥）：38所高校150余名师生；决赛作品分安全实体模型类与安全软件与仿真模拟类分别评审"
    },
    {
      "stage": "颁奖",
      "format": "评出一、二、三等奖（第四届评出一等奖20件、二等奖34件），颁奖典礼多在全国安全年会期间举行",
      "notes": "大赛由教育部安全科学与工程类专业教学指导委员会、全国高校安全科学与工程学术年会委员会、公共安全科学技术学会、中国职业安全健康协会等共同主办"
    }
  ],
  "review_format": "初赛/复赛采用专家网络评审或函评材料打分，决赛采用现场展示+汇报答辩，经评审委员会分组评审与集中综合会评确定奖项。",
  "judge_preferences": [
    "创新性是最大权重项：装置、功能、材料层面的真创新远胜成熟技术复现",
    "选题必须紧扣安全学科与真实行业场景，突出实践性",
    "方案可行、功能可演示，说明书参数完整可核查",
    "答辩表现与作品完成度同样是决赛区分度来源",
    "注重团队协作与工程实践能力的真实体现"
  ],
  "past_winning_patterns": [],
