{
  "competition_id": 106,
  "competition_name": "高分子材料实验实践大赛",
  "judging_dimensions": [
    {
      "dimension": "产物质量评分",
      "weight": "60%（第二届竞赛规则总体评分标准原文：产物质量 60%）",
      "official_wording": "第二届全国高分子材料实验实践大赛竞赛规则（天津大学材料科学与工程国家级实验教学示范中心托管）原文：'总体评分标准：1 产物质量 60%；2 操作规范 40%（含实验报告10分）；3 其他规定 0～-∞%（总分扣除项）'。产物质量60分细则：'产率10（产率百分比×满分）、外观10、合格产率30（合格产率百分比×满分）、平均粒径5、粒径分布5'。",
      "scoring_points": [
        "产率（10分）：产率百分比=产品质量/单体质量×100%×10分",
        "合格产率（30分）：合格产物直径范围1mm≤X<3.2mm，权重最高的单项",
        "产物外观（10分）：≥80%球形颗粒且均匀得7-10分（C档），50%以上球形为4-6分（B档），50%以下仅1-3分（A档）；至少十位裁判共同打分取平均",
        "平均粒径（5分）：重量平均粒径公式计分，最低0分",
        "粒径分布（5分）：按标准偏差计分，标准偏差大于1得零分"
      ],
      "common_deductions": [
        "产物未按规程清洗烘干（真空干燥80℃、不少于1小时）即送评",
        "抽滤结束后在提交产物中故意添加水分——取消产物评分",
        "聚合失败未做后续处理（抽滤部分分数扣除）",
        "比赛结束未停止操作或未按时上交样品——产物质量成绩记零分"
      ]
    },
    {
      "dimension": "操作规范评分",
      "weight": "40%（第二届竞赛规则原文：操作规范 40%，含实验报告10分）",
      "official_wording": "竞赛规则原文：'操作规范评分采用错误打分法，即现场发现即扣除，只打\"×\"'；'参赛选手操作规范评分将参考多位裁判共同打分，只要有一位裁判认为该选手操作错误，即该操作不得分'。细则按准备（扣分上限2分）、称量（2分）、加料（3分）、聚合过程（5分）、聚合终止（2分）、抽滤（4分）、清理（4分）等阶段分项扣分。",
      "scoring_points": [
        "安全着装与防护：实验服（无明显Logo）、防护眼镜、口罩、一次性手套全程佩戴",
        "装置搭建：冷凝管先通冷却水后固定、温度计在液面以下且远离搅拌桨、装置稳固",
        "称量与加料：天平规范使用（关舱门读数稳定）、试剂标签朝掌心、玻璃棒引流加料、严禁边搅拌边加试剂",
        "聚合过程安全：取样观察严禁对准瓶口、危险带电操作零容忍、废液入桶不入下水道",
        "收尾规范：先降温后关电源、抽滤前润湿滤纸、真空泵正确启闭、器皿清洗归位、台面清洁"
      ],
      "common_deductions": [
        "防护着装不符（穿拖鞋背心短裙、不戴护目镜）或携带手机等违禁物品入场",
        "错误打分法下任一裁判认定操作错误即该项不得分（标准最严的一档）",
        "玻璃器皿破损、样品丢失（在其他规定项扣分且不补时）",
        "擅自篡改实验数据（选手与裁判同时记录称量数据）——立即取消比赛成绩"
      ]
    },
    {
      "dimension": "实验报告评分",
      "weight": "占操作规范总分的25%（=10分/40分，实验报告评分细则共10分、包含在操作规范40分内；第二届竞赛规则原文）",
      "official_wording": "竞赛规则原文：实验报告评分细则共10分——'实验报告基础分（2分）：内容全部填写且版面整洁；试剂及实验设备部分（2分）：正确完整填写；实验步骤记录情况（3分）：完整记录所有实验操作、时间以及实验现象；实验结果与分析情况（3分）：详细记录实验结果，合理恰当分析现象与结果原因，提出合理化改进方案'。裁判依据'完整性、条理性、分析合理性'打分。",
      "scoring_points": [
        "报告填写完整、版面整洁（基础分2分，一项空白扣0.5分）",
        "试剂用量与主要设备记录正确完整（2分，少填一项扣0.5分）",
        "按操作顺序记录装置搭建、称量、升温、调速、抽滤、清洗等步骤并含时间与现象（3分）",
        "结果记录详实、现象与结果分析合理、提出合理化改进建议（3分）"
      ],
      "common_deductions": [
        "步骤记录缺时间、操作、现象描述任何一项扣1分",
        "报告破损、模糊、污渍不得整洁分",
        "只记结果无分析，或分析不合理"
      ]
    },
    {
      "dimension": "其他规定（纪律与安全合规）",
      "weight": "0%起从总分累计扣除、上不封顶（总分扣除项，不设单独分数；第二届竞赛规则原文'0～-∞%'）",
      "official_wording": "竞赛规则原文：'其他规定评分项从总分中累计扣除，不设单独分数'；细则含'所加物质的总体积超过反应容器的2/3时，总分扣除5分'、'称量时间超过15分钟，每超过一分钟总分扣除1分（累计）'、'全部称量完后再回工位记录数据，总分扣除0.5分'等。",
      "scoring_points": [
        "按时到场：开赛15分钟内未到视为弃权",
        "使用组委会统一型号耗材，不带自备辅助工具（器皿、纸张等）",
        "原料总量不超过三口烧瓶体积的2/3",
        "服从抽签与场地管理，比赛结束后不将比赛用品带出场外",
        "等候称量期间停止一切操作（排队时间予以补足延时）"
      ],
      "common_deductions": [
        "超体积投料扣5分；称量超时每分钟扣1分、累计多次扣除",
        "擅自留下前次产物充当下次产物——取消比赛成绩",
        "未获竞赛委员会允许擅自进入比赛区域——选手取消获奖资格、教师取消团队奖资格",
        "比赛结束后带走实验报告、器皿、试剂——取消比赛成绩"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "现场聚合实验成果（聚合物产物）",
      "format": "以苯乙烯和甲基丙烯酸甲酯（1:1）为单体的悬浮聚合产物；统一耗材与试剂（含层析柱提纯单体、BPO提纯）；产物经水洗、抽滤、真空干燥（80℃、≥1小时）后送评，工作人员统一称重并振动筛分粒径",
      "page_limit": "未明确",
      "deadline_note": "4小时内完成装置搭建、聚合、产物处理及仪器清理归位（不含原料称量等待与烘干筛分时间）"
    },
    {
      "item": "实验报告",
      "format": "组委会统一报告纸（附表1），记录操作、时间、现象与结果分析；弄湿弄脏可申请更换，每人最多两次，提交时须标明最终报告",
      "page_limit": "统一模板",
      "deadline_note": "比赛结束由裁判填写实验结束时间并签名，随样品一并上交"
    },
    {
      "item": "参赛信息表与抽签",
      "format": "参赛高校按时提交《参赛信息表》；报到当天在监督委员会监督下抽签确定参赛号码、比赛场地及比赛内容（单体种类）",
      "page_limit": "未明确",
      "deadline_note": "开赛前一天熟悉场地并抽取参赛号码；未参加抽签视为弃权"
    }
  ],
  "process_stages": [
    {
      "stage": "校级选拔（校赛/复赛）",
      "format": "各参赛高校自行举办高分子材料实验实践技能大赛（初赛+复赛），选拔选手组队",
      "notes": "兰州理工大学等高校设校级初赛、复赛（含理论环节与现场实验）选拔国赛选手"
    },
    {
      "stage": "全国赛报名与抽签",
      "format": "高校提交《参赛信息表》确认参赛；报到当天监督委员会监督下抽签定号码、场地、单体",
      "notes": "首届（2019，东华大学）34所高校200多名师生参赛；大赛由东华大学发起、获教育部高等学校材料类教学指导委员会授权主办"
    },
    {
      "stage": "现场实验竞赛",
      "format": "个人独立操作限时4小时完成悬浮聚合全流程；分上、下半赛区等批次进行（首届每场48人、共96人）",
      "notes": "裁判流动打分+特定裁判专责称量、抽滤步骤；竞赛委员会、评审委员会、监督委员会三委员会保障"
    },
    {
      "stage": "产物评定与颁奖",
      "format": "产物烘干筛分后多裁判独立评分取平均，不合格产物剔除；按总分评个人一、二、三等奖与团体奖",
      "notes": "首届评出一等奖20名、二等奖24名、三等奖33名，另设团体一、二、三等奖；同期举办全国高分子材料实验实践教学研讨会"
    }
  ],
  "review_format": "现场实操竞赛：多位裁判按'错误打分法'现场扣分记录操作规范，产物经统一烘干筛分后由十位以上裁判独立评分取平均，实验报告另按细则评分，总分制排名（产物质量60%+操作规范40%-累计扣分）。",
  "judge_preferences": [
    "合格产率是产物质量中权重最高的硬指标（30/60分），球形颗粒率与粒径均匀度直接决定外观档位",
    "操作规范以安全红线为先：危险带电操作、废液直排等违规行为发现即扣",
    "实验原始数据真实性零容忍：选手与裁判双记录，篡改数据立即取消成绩",
    "重视实验记录的过程性与规范性（时间、现象、分析缺一不可）",
    "器皿清理归位与台面整洁计入评分，体现完整实验素养"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "擅自篡改实验数据立即取消比赛成绩（官方明文）",
    "抽滤后在产物中故意添加水分取消产物评分；留前次产物充当下次产物取消比赛成绩",
    "携带手机、智能手表等智能设备及实验讲义、食物入场（休息区除外）",
    "着装不符实验室安全要求（拖鞋、背心、短裙）禁止入场",
