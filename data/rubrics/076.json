{
  "competition_id": 76,
  "competition_name": "税收风险管控案例大赛",
  "judging_dimensions": [
    {
      "dimension": "案例原创性与一手资料价值",
      "weight": "约25%（推断：官方要求每队提交一个原创案例并须一手资料；分值表未公开，权重据赛制要求与同类案例大赛惯例推断）",
      "official_wording": "2026年大赛通知（云南大学经济学院转发）：\"每支参赛队提交一个原创案例。参赛队应通过调研、参与具体项目等方式收集第一手案例资料，并进行案例撰写和分析\"。官方分值表未公开，权重【推断】。",
      "scoring_points": [
        "案例源自真实涉税业务场景（企业税务管理、税务稽查、纳税评估等），非虚构拼凑",
        "通过实地调研、实习项目等获得一手数据与访谈材料",
        "案例典型性强，风险情景有代表性与教学价值",
        "企业与涉税信息已充分脱敏，合规使用"
      ],
      "common_deductions": [
        "案例虚构或由公开新闻、教材案例改写，无一手材料",
        "抄袭往届案例或网络模板",
        "泄露企业真实商业秘密与纳税人信息"
      ]
    },
    {
      "dimension": "税收风险识别与政策理论运用",
      "weight": "约30%（推断：案例内容核心环节，含案例背景、财税政策、税收理论阐述）",
      "official_wording": "2026年大赛通知（云南大学）：案例分析须\"就案例背景、相关财税政策、税收理论\"展开；安徽工业大学预通知要求提交原创税收风险管控案例分析报告。分值表未公开，权重【推断】。",
      "scoring_points": [
        "风险点识别全面准确（发票、申报、跨境、关联交易、优惠适用等）",
        "引用税收政策法规准确、现行有效，法条援引规范",
        "理论分析扎实（税收征管、风险管理框架）",
        "能结合金税征管实践与最新监管趋势（如数电票、以数治税）"
      ],
      "common_deductions": [
        "政策引用过时或错误",
        "风险识别停留在表面，缺定性与定量结合",
        "把合法筹划写成偷逃税方案（价值导向错误）"
      ]
    },
    {
      "dimension": "风险管控方案设计与可行性",
      "weight": "约25%（推断：大赛主题为\"风险管控\"，方案落地性为评审重心）",
      "official_wording": "大赛名称与通知要求围绕\"税收风险管控\"撰写案例分析报告（黄山学院、长江师范学院2026年通知校赛内容：\"自创税收风险管控案例分析\"）。分值表未公开，权重【推断】。",
      "scoring_points": [
        "管控方案针对识别出的风险点逐一给出措施",
        "方案可落地（内控制度、流程再造、指标监控、争议应对）",
        "成本效益与合规性权衡合理",
        "有对方案效果的前瞻评估"
      ],
      "common_deductions": [
        "方案泛泛而谈、与风险点不对应",
        "方案超出企业实际执行能力",
        "建议与现行政策冲突"
      ]
    },
    {
      "dimension": "报告写作规范",
      "weight": "约10%（推断）",
      "official_wording": "校赛通知（黄山学院）要求\"在规定时间内上传规定资料\"并附案例分析编写要求（编写体例见大赛通知）。分值表未公开，权重【推断】。",
      "scoring_points": [
        "结构完整（案例背景、政策依据、风险识别、管控方案、启示）",
        "语言专业规范、图表清晰",
        "引用与数据来源标注完整",
        "按通知规定格式与体例撰写"
      ],
      "common_deductions": [
        "体例不符通知要求",
        "篇幅失控、重点不清",
        "引用来源缺失"
      ]
    },
    {
      "dimension": "现场汇报与答辩（总决赛）",
      "weight": "约10%（推断：总决赛以汇报答辩综合评分，占比按同类案例赛事惯例推断）",
      "official_wording": "安徽工业大学预通知：\"总决赛：晋级队伍对原创案例进行分析、汇报与答辩\"；校内选拔（上海商学院）同样以\"提交案例+答辩\"方式评分。分值构成官方未公开，权重【推断】。",
      "scoring_points": [
        "汇报逻辑清晰，突出案例亮点与方案价值",
        "PPT专业，关键信息可视化",
        "答辩准确回应评委对政策与方案的追问",
        "团队协作与时间控制"
      ],
      "common_deductions": [
        "汇报口径与报告内容不符",
        "答不上政策依据细节",
        "超时、念稿"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "原创税收风险管控案例分析报告",
      "format": "按大赛通知编写体例（案例背景、相关财税政策、税收理论、风险识别与管控方案），PDF/Word按规定上传",
      "page_limit": "未明确（以当届通知附件要求为准）",
      "deadline_note": "分区赛在规定截止时间前经校内选拔后统一上传（报名约至9月，作品提交约10-11月）"
    },
    {
      "item": "原创承诺与作品材料包",
      "format": "按通知要求提交原创性承诺及相关支撑材料",
      "page_limit": "未明确",
      "deadline_note": "与案例报告同步提交"
    },
    {
      "item": "总决赛汇报PPT",
      "format": "PPT现场汇报",
      "page_limit": "未明确",
      "deadline_note": "晋级全国总决赛后提交，总决赛约11-12月（2025年总决赛为12月6日，杭州）"
    }
  ],
  "process_stages": [
    {
      "stage": "校赛（校内选拔）",
      "format": "自创税收风险管控案例分析，在规定时间内上传规定资料，按校内成绩择优选派",
      "notes": "每队固定3名参赛学生（不可跨校组队，可校内跨学院），每人仅能加入一支队伍，一队仅提交一份原创案例；每队可配1-3名指导教师（其中1名领队）"
    },
    {
      "stage": "分区赛（省级赛区）",
      "format": "全国按省（自治区、直辖市）设31个分赛区，以提交的案例分析报告为主要评审对象，专家评审",
      "notes": "约10-11月评审；按赛区择优晋级总决赛"
    },
    {
      "stage": "全国总决赛",
      "format": "晋级队伍对原创案例现场分析、汇报与答辩，综合评分",
      "notes": "约11-12月（2025年总决赛12月6日在杭州举行，注册税务师行业协会深度参与）；2025年报名队伍4340支、参赛选手13020名"
    }
  ],
  "review_format": "分区赛以原创案例分析报告的专家书面评审为主，全国总决赛为现场汇报答辩综合评分。",
  "judge_preferences": [
    "真实一手案例优先，反对书本案例改编",
    "政策引用必须现行准确，紧跟以数治税、数电票等征管改革趋势",
    "管控方案重实操与合规价值导向，绝不接受逃税型\"筹划\"",
    "关注案例的教学与推广价值（优秀案例可能被行业交流采用）",
    "企业信息脱敏与纳税遵从伦理是红线"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "案例必须原创，抄袭、改编往届获奖案例或虚构无调研支撑的案例将被取消资格",
    "不得泄露企业商业秘密与纳税人隐私信息，案例须充分脱敏",
    "不得跨校组队；每名学生限加一队、每队限报一个案例",
    "不得将偷逃税手法包装为\"筹划方案\"，价值导向错误直接淘汰",
    "逾期上传或材料不全按弃权处理"
  ],
