{
  "competition_id": 67,
  "competition_name": "计算机系统能力大赛",
  "judging_dimensions": [
    {
      "dimension": "功能正确性（测试用例通过率，客观机评）",
      "weight": "客观题式机评：按功能得分计分（官方评测项）；权重因赛道/年度而异，通常为最大分项【推断】",
      "official_wording": "评测方式分为功能测试和性能测试两部分，按功能得分、性能得分及性能测试总运行时间综合排名（编译系统设计赛技术方案）；初赛阶段实现能通过测试用例的操作系统内核（操作系统设计赛规程）",
      "scoring_points": [
        "编译赛道：编译器对规定语言特性的正确编译，功能测试用例全部通过",
        "OS赛道：内核通过初赛+决赛测试侧例（系统调用、并发、文件系统、虚存管理等）",
        "CPU赛道：设计正确运行规定测试集，能正常启动Linux系统为进入决赛门槛",
        "提交作品可在官方指定平台自动评测复现（GitLab源码管理）"
      ],
      "common_deductions": [
        "功能测试崩溃/死循环导致部分用例不得分",
        "提交不可复现：评测环境跑不过或依赖非规定环境",
        "使用禁用的第三方代码或直接封装现成实现"
      ]
    },
    {
      "dimension": "系统性能（性能测试得分与运行时间）",
      "weight": "客观题式机评：按性能得分及总运行时间计分（官方评测项）；与功能分加权后决定排名【推断权重】",
      "official_wording": "按功能得分、性能得分及性能测试总运行时间综合排名（编译系统设计赛技术方案）；决赛根据CPU运行Linux上的性能评分（华东师大龙芯杯报道）；决赛阶段改进内核使其在RISC-V 64/LoongArch 64上运行（OS赛道规程）",
      "scoring_points": [
        "编译赛道：生成代码在目标平台（如树莓派4B/ARM、RISC-V）上的运行性能与编译耗时",
        "OS赛道：内核性能测试（如UnixBench/lmbench类基准）",
        "CPU赛道：FPGA实现主频、IPC、单位功耗性能等硬件性能指标",
        "性能优化策略的原创性（指令调度、缓存优化、流水线/微架构改进）"
      ],
      "common_deductions": [
        "为刷性能指标牺牲功能稳定性，决赛现场复测翻车",
        "性能基准作弊（针对测试用例特殊化处理）被认定违规",
        "未利用目标架构特性（如RISC-V扩展指令集）导致性能平庸"
      ]
    },
    {
      "dimension": "工程规范与设计文档",
      "weight": "定性评审：文档评审综合排名的组成部分（约10-20%【推断】）",
      "official_wording": "晋级主要依据初赛功能测试成绩、系统性能及文档评审综合排名（大赛平台/院校通知归纳）",
      "scoring_points": [
        "源码工程化：模块划分、版本管理（GitLab提交记录）、构建脚本",
        "设计文档完整：架构设计、关键算法、测试方案",
        "编译/O S/CPU各赛道按要求提交作品包与说明",
        "代码原创性说明与第三方依赖声明"
      ],
      "common_deductions": [
        "文档缺失或与代码实现明显不符",
        "提交记录造假（一次性补提交伪装开发过程）",
        "第三方代码未声明构成学术不端"
      ]
    },
    {
      "dimension": "决赛现场赛与答辩",
      "weight": "决赛环节独立计分（现场测试分数+答辩定性评审）【推断：决赛任务基于初赛作品扩展并现场答辩】",
      "official_wording": "经过激烈的初赛和决赛现场赛、答辩（西北工业大学2024年OS设计赛报道：589队报名、209支入围全国总决赛）；决赛任务基于初赛作品进一步扩展（编译赛道技术方案）",
      "scoring_points": [
        "现场赛限定时间内在指定环境下完成扩展任务",
        "答辩讲清系统架构与核心设计决策",
        "对评委技术追问（为何选该方案、性能瓶颈定位）的应对",
        "团队分工与每位成员对系统的真实掌握程度"
      ],
      "common_deductions": [
        "现场赛环境适配失败（作品只能在自家机器跑）",
        "答辩暴露非本人完成（成员答不出自己模块）",
        "夸大宣传但演示与陈述不符"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "系统作品源码（编译器/OS内核/CPU硬件设计）",
      "format": "经大赛GitLab平台提交，支持官方平台自动评测；CPU赛道为FPGA可综合设计",
      "page_limit": "未明确",
      "deadline_note": "初赛提交有截止时间（如2026编译赛初赛05/19-08/02，申诉08/11）"
    },
    {
      "item": "设计文档与测试报告",
      "format": "PDF/Word按各赛道技术方案要求",
      "page_limit": "未明确",
      "deadline_note": "随源码同批提交，用于文档评审"
    },
    {
      "item": "报名（每队1-3人）",
      "format": "OS赛道每队1-3人、最多2名指导教师（初赛可无、决赛须至少1名）；同一单位报名队数不限，但通常仅该校最好成绩的2支队伍进入全国总决赛",
      "page_limit": "未明确",
      "deadline_note": "OS赛道每年3月启动报名，赛程3月至8月"
    }
  ],
  "process_stages": [
    {
      "stage": "初赛（线上自动评测）",
      "format": "在官方平台开发并通过功能测试用例，按功能+性能机评",
      "notes": "编译赛道分ARM/RISC-V等赛道；OS赛道实现能通过测试用例的内核；按比例或分数线入围区域赛/决赛"
    },
    {
      "stage": "区域赛/省赛（部分赛道）",
      "format": "编译赛道设华东等区域赛；作品继续按功能/性能评测",
      "notes": "区域赛优秀作品晋级全国总决赛"
    },
    {
      "stage": "全国总决赛（现场赛+答辩）",
      "format": "决赛任务基于初赛作品扩展，现场评测+答辩",
      "notes": "2024 OS赛道589队报名、209队入围总决赛；2026 OS总决赛8月21日南开大学；CPU赛道需能启动Linux才能进决赛，按Linux运行性能评分"
    },
    {
      "stage": "等级认定与评奖",
      "format": "按初赛和决赛最后提交的有效作品认定等级（编译赛分一级/二级/三级/入门级四级）",
      "notes": "并设一、二、等奖项；获等级认定证书"
    }
  ],
  "review_format": "客观机评为主（功能测试+性能测试自动评测）+文档评审+决赛现场赛与专家答辩的综合评审，各赛道规程独立",
  "judge_preferences": [
    "功能正确是底线：先全对再谈性能，功能不全的作品性能分无意义",
    "欣赏真正的底层优化（微架构、编译优化pass、内核调度）而非套模板",
    "Git提交记录与开发过程真实可见，反感突击造假",
    "答辩看重对系统每一层的真实理解，警惕\"队长全能、队友打酱油\"的队伍",
    "在指定架构（RISC-V/LoongArch/ARM国产平台）上的适配质量受特别关注"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "禁止使用他人成品内核/编译器/开源CPU核心冒充原创（第三方开源须按规程声明）",
    "禁止针对测试用例做特殊化作弊（识别用例编号直接输出答案等）",
    "决赛阶段队员须与初赛一致，指导教师变更须审批",
    "每校进入全国总决赛的名额受限（通常2支），超额队伍只能以交流身份参赛",
    "测评环境与提交环境不一致、作品无法复现将被判无效提交"
  ],
