{
  "competition_id": 118,
  "competition_name": "全国大学生数学竞赛",
  "judging_dimensions": [
    {
      "dimension": "核心课程知识掌握（按试卷科目构成计分）",
      "weight": "分数构成（官方考纲比例）：数学类初赛=数学分析50%+高等代数35%+解析几何15%；非数学类初赛=高等数学，决赛=高等数学约80%+线性代数约20%",
      "official_wording": "官网历届通知（PDF扫描件）附考试大纲；多个独立来源交叉印证：数学类'数学分析占50%，高等代数占35%，解析几何占15%'（CSDN竞赛综述）；非数学类'决赛考试内容：高等数学、线性代数（所占总分的比例分别为80%、20%左右）'（网易教育），'初赛只考察高等数学，决赛加入20%的线性代数'（知乎讨论）。官网通知原文：'为了激励大学生学习数学的兴趣，培养他们分析问题、解决问题的能力……中国数学会决定举办第十六届全国大学生数学竞赛'。",
      "scoring_points": [
        "数学类：数学分析（极限、级数、微分中值、积分学等）为最大分值板块",
        "非数学类：高等数学主体内容（一元/多元微积分、级数、微分方程）",
        "考纲内的定义、定理掌握准确，能迁移到非常规问题",
        "考纲参考书：佘志坤主编《全国大学生数学竞赛辅导教程》（科学出版社，通知指定）"
      ],
      "common_deductions": [
        "超出考纲的偏难怪题方法堆砌不得分",
        "概念性错误（定理条件缺失、反例混淆）",
        "关键步骤跳步导致思路链断裂"
      ]
    },
    {
      "dimension": "解题能力与数学思维",
      "weight": "定性：试卷按基础题—中档题—难题梯度设置，难题（压轴题）得分区分获奖档次",
      "official_wording": "官网通知宗旨：'培养他们分析问题、解决问题的能力'；竞赛定位为'展示数学思维能力和学习成果的平台'。【推断】难度梯度与区分度设计依据历届公开真题结构。",
      "scoring_points": [
        "基础题正确率（决定能否入围赛区奖）",
        "难题突破：构造、反证、放缩、对称性等竞赛技巧",
        "一题多解与迁移能力",
        "赛场时间分配：先易后难、保证会做的题不失分"
      ],
      "common_deductions": [
        "在难题上耗时过多导致基础题失分",
        "只会套题型、题目稍加变化即无从下手",
        "计算失误（求导/积分运算错误）"
      ]
    },
    {
      "dimension": "证明过程与表述规范",
      "weight": "客观题：每题按步骤给分（评分细则分步赋分），过程分占比高",
      "official_wording": "官网'竞赛试题'栏目公开历届决赛试题标准答案与评分细则（如第四届决赛试题评分细则：'一、(本题5分)……'分步赋分）；各赛区按统一答案与细则阅卷。【推断】细则表述依据官网公开的历届评分细则文档。",
      "scoring_points": [
        "证明逻辑链完整：条件—推理—结论闭环",
        "关键步骤书写清晰（阅卷可识别得分点）",
        "符号使用规范、卷面整洁",
        "计算题保留必要中间过程"
      ],
      "common_deductions": [
        "只写答案无过程（过程分全失）",
        "跳步严重、得分点无法辨认",
        "涂改混乱导致误读"
      ]
    },
    {
      "dimension": "考试资格与诚信规范",
      "weight": "通过制：不符合资格或违纪者成绩作废",
      "official_wording": "高校通知：'初赛由全国大学生数学竞赛陕西赛区组委会负责组织，使用全国统一试题，在同一时间内进行考试'、'不接受学生个人报名'（西安交通大学城市学院、江苏师范大学科文学院通知）；决赛要求'所有参赛学生需携带身份证、学生证与准考证参加考试'（官网第十四届决赛通知）。",
      "scoring_points": [
        "以学校/赛区为单位统一报名参赛",
        "持身份证、学生证、准考证入场",
        "遵守考场纪律、独立作答"
      ],
      "common_deductions": [
        "携带通讯工具或资料入场违纪",
        "替考、抄袭取消成绩并通报",
        "非全日制在校生参赛资格无效"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "初赛（分区赛）答卷",
      "format": "全国统一试题、闭卷笔试；第十六届初赛于2024年11月9日（周六）上午9:00-11:30各考点同时进行",
      "page_limit": "未明确（试卷由全国组委会统一命制）",
      "deadline_note": "每年10-11月（报名为当年6-9月，各赛区截止时间不同）"
    },
    {
      "item": "决赛答卷",
      "format": "闭卷笔试，次年3-5月在承办高校举行（第十四届2023年5月26-28日在广东工业大学）",
      "page_limit": "未明确",
      "deadline_note": "决赛及颁奖大会同期举行"
    },
    {
      "item": "报名信息（以高校为单位）",
      "format": "经所在学校统一组织报名，不接受学生个人报名",
      "page_limit": "未明确",
      "deadline_note": "各赛区于初赛前2-3个月截止（如第十六届多赛区7-9月截止）"
    }
  ],
  "process_stages": [
    {
      "stage": "报名",
      "format": "各高校/赛区组委会统一组织，学生经学校报名",
      "notes": "参赛对象为全日制在校大学生；分省（市、自治区）赛区（历届32个赛区左右）与军队院校赛区"
    },
    {
      "stage": "初赛（分区赛）",
      "format": "全国统一命题、各赛区同一时间闭卷考试（约2.5小时）",
      "notes": "数学类考数学分析+高等代数+解析几何；非数学类考高等数学；由各赛区组委会组织阅卷"
    },
    {
      "stage": "赛区评奖与决赛名额分配",
      "format": "按初赛成绩排序评出赛区（省级）一、二、三等奖",
      "notes": "获奖总数约为参赛人数的35%以内，一、二、三等约按2:3:5分布（第十二届获奖数据推算）；决赛名额按官网分配办法：每赛区保底6人（数学类、非数学类各3人，在预赛一等奖中产生），双一流高校、参赛规模、上年度团体前5赛区有追加名额，承办校增派5人；第十七届（2025）全国共1229人入围决赛"
    },
    {
      "stage": "全国决赛及颁奖大会",
      "format": "承办高校现场闭卷考试+颁奖典礼（次年3-5月）",
      "notes": "历届承办：第十三届华东师范大学、第十四届广东工业大学、第十五届山东大学、第十六届浙江师范大学；决赛设全国一、二、三等奖（获奖率约为决赛人数的95%以内，某届非数学类一/二/三等奖126/186/236人，占比约23%/34%/43%【推断】）"
    }
  ],
  "review_format": "全国统一命题、各赛区统一时间闭卷考试；按全国组委会下发的标准答案与分步评分细则集中阅卷，以卷面分数排序评定赛区奖与全国奖，无答辩与材料评审环节。",
  "judge_preferences": [
    "步骤分制下过程完整、得分点清晰的答卷占优（评分细则分步赋分）",
    "基础题零失误是获奖底线，难题决定一等奖归属",
    "解法规范优先于技巧堆砌：能被阅卷人快速识别的严谨证明最划算",
    "非数学类重高等数学基本功（决赛含线性代数约20%）",
    "数学类重分析功底：数学分析占50%为最大板块"
  ],
