{
  "competition_id": 2,
  "competition_name": "“挑战杯”课外学术科技作品竞赛",
  "judging_dimensions": [
    {
      "dimension": "科学性",
      "weight": "自然科学类学术论文50%（科学意义15%+研究方法合理性15%+结论重要性20%）；哲学社会科学类30%（理论基础和研究方法10%+论证严密性与论据可靠性10%+论据的正确性10%）；科技发明制作25%（技术意义10%+可行性15%）",
      "official_wording": "竞赛章程第二十二条评审'综合考虑作品的科学性、先进性、现实意义等方面因素'；各校转发全国评审规则（西安交大腾飞杯镜像国赛细则）：A类自然科技类学术论文科学性占50%，B类社会科学类占30%，C类科技发明制作占25%。",
      "scoring_points": [
        "自然科学类：选题的科学意义、研究方法规范性与结论可靠性",
        "哲社类：理论基础扎实、论证严密、数据/论据真实可靠",
        "发明制作：技术方案可行、原理正确"
      ],
      "common_deductions": [
        "研究设计有明显缺陷、样本/数据不可靠",
        "调查问卷设计粗糙、数据来源交代不清",
        "作品原理性错误"
      ]
    },
    {
      "dimension": "先进性",
      "weight": "自然科学类学术论文30%（先进程度10%+创新程度10%+难度10%）；哲学社会科学类35%（创新程度15%+难易程度10%+学术水平10%）；科技发明制作30%（先进程度10%+创新程度10%+复杂程度10%）",
      "official_wording": "官方通知评审要点：'自然科学类学术论文侧重考核基础学科学术探索的前沿性和学术性；哲学社会科学类社会调查报告侧重考核与经济社会发展热点难点问题的结合程度和前瞻意义'（中国地质大学（北京）第十八届通知等转发）；占比数字来自西安交大镜像国赛细则。",
      "scoring_points": [
        "选题处于学科前沿、瞄准热点难点问题",
        "创新点明确（新方法/新发现/新应用）",
        "研究/制作难度与工作量充分",
        "哲社类对热点问题的前瞻性判断"
      ],
      "common_deductions": [
        "选题陈旧、重复已有研究",
        "创新点表述含糊、与已有成果区分度低",
        "工作量明显不足"
      ]
    },
    {
      "dimension": "现实意义（应用价值/转化前景）",
      "weight": "自然科学类学术论文20%（应用价值10%+影响范围10%）；哲学社会科学类35%（经济效益与社会效益20%+影响范围15%）；科技发明制作45%（经济效益20%+推广价值15%+成熟程度10%）",
      "official_wording": "官方通知评审要点：'科技发明制作侧重考核作品的应用价值和转化前景'（中国地质大学（北京）转发）；占比数字来自西安交大镜像国赛细则；章程将科技发明制作分为'A类科技含量较高、制作投入较大'与'B类投入较少的小发明小制作'。",
      "scoring_points": [
        "应用场景明确、能落地转化",
        "经济效益/社会效益可量化",
        "有专利、检测报告、应用单位证明等转化佐证",
        "发明制作类作品成熟度高、演示稳定"
      ],
      "common_deductions": [
        "应用价值空泛、无落地路径",
        "实物演示不稳定或仅停留在原理样机",
        "缺乏第三方检测/用户试用证据"
      ]
    },
    {
      "dimension": "终审决赛答辩与展示",
      "weight": "定性：终审决赛环节实行公开答辩制，答辩前评委可到展示区审看作品及演示，综合申报材料与现场表现定奖",
      "official_wording": "竞赛章程第十条：'终审决赛环节实行公开答辩制，答辩前评审委员可以到参赛作品集中展示区审看参赛作品及其演示'；第二十四条：'科技发明制作类作品必须有实物或者模型参展'。",
      "scoring_points": [
        "答辩陈述逻辑清晰、时间控制好",
        "实物/模型现场演示流畅",
        "评委问辩回答专业、如实",
        "展板/展示区呈现规范"
      ],
      "common_deductions": [
        "答辩回答与申报材料矛盾",
        "实物无法演示或演示失败",
        "主要作者不熟悉作品细节（疑似代做）"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "作品申报书",
      "format": "当届组委会规定格式（含作品简介、作者信息、资格审查意见）",
      "page_limit": "未明确（以当届申报通知为准）",
      "deadline_note": "省级审查后按名额上报全国组委会办公室"
    },
    {
      "item": "自然科学类学术论文全文",
      "format": "学术论文（作者限本专科生）",
      "page_limit": "未明确",
      "deadline_note": "随申报书同步报送，侧重基础学科前沿探索"
    },
    {
      "item": "哲学社会科学类社会调查报告",
      "format": "调查报告（章程限定：仅限社会调查报告，可围绕经济、政治、文化、社会、生态文明建设5个组别）",
      "page_limit": "未明确（第十九届校赛通知多要求正文1.5万字以内，以当届作品要求文件为准）",
      "deadline_note": "同上"
    },
    {
      "item": "科技发明制作：研究报告+实物或模型",
      "format": "研究报告+实物/模型（章程第二十四条：必须有实物或者模型参展）",
      "page_limit": "未明确",
      "deadline_note": "终审决赛需现场展示演示"
    }
  ],
  "process_stages": [
    {
      "stage": "校赛",
      "format": "校内评审选拔，按省赛限额推荐",
      "notes": "两年一届，与创业计划大赛交替举办；单数年举办（第十九届为2025年）"
    },
    {
      "stage": "省级初评",
      "format": "省级组织协调委员会资格及形式审查+省级评审委员会初步评定（章程第二十三条）",
      "notes": "通过审查方可上报全国组委会"
    },
    {
      "stage": "全国初审",
      "format": "全国评审委员会初审（章程第二十九条）",
      "notes": "评出报送作品中的约35%进入终审决赛，约55%获三等奖；评审委员由非高校高级职称专家/企业技术骨干组成并签订《评审纪律承诺书》"
    },
    {
      "stage": "全国终审决赛",
      "format": "公开答辩+展示区审看（章程第十条）",
      "notes": "第十九届于2025年10月31日-11月3日在南京大学举行；决赛评出特等奖、一等奖、二等奖"
    },
    {
      "stage": "奖项评定",
      "format": "各等次奖约占各类报送作品总数：特等奖5%、一等奖10%、二等奖20%、三等奖55%（章程第二十九条）",
      "notes": "第十八届（2023）评出特等奖115件、一等奖201件等"
    }
  ],
  "review_format": "省级资格形式审查与初评+全国评审委员会初审（约35%进决赛）+终审决赛公开答辩（评委先到展示区审看作品演示，分类小组评审定奖）",
  "judge_preferences": [
    "三类作品分别按类别评审，天然分赛道竞争，评委回归本类标准",
    "自然科学类看学科前沿性与学术规范（发表、导师评价）",
    "哲社类看与经济社会发展热点难点的结合深度与一手调研扎实度",
    "发明制作看应用价值、转化前景与实物演示成熟度（专利、检测报告）",
    "终审决赛重视答辩真实性与实物演示，警惕过度包装"
  ],
  "past_winning_patterns": [
    "第十九届（2025）首设'人工智能+'专项赛，AI与各学科交叉作品集中获奖（如青岛农业大学获专项赛特等奖）",
    "'揭榜挂帅'专项赛设8个主擂台、130余项榜题，聚焦新一代信息技术、AI、新能源、新材料、高端装备、机器人、生物医药、种业，企业真实需求导向",
    "哲社类特等奖多围绕乡村振兴、共同富裕、基层治理、数字经济等热点做深度一手调查",
    "自然科学类特等奖普遍有高水平论文/前沿课题支撑，且为本专科生完成的学科前沿探索",
    "科技发明制作特等奖均有稳定实物演示+专利/检测报告+应用单位证明的完整证据链",
    "奖量结构：特等奖约占5%、一等奖约10%（第十八届特等奖115件、一等奖201件、二等奖数量更多，呈金字塔）"
  ],
  "forbidden_or_risky": [
    "学术不端与代做：评审委员为校外专家，问辩会核查学生对作品的真实掌握",
    "自然科学类学术论文作者限本专科生，研究生挂名即违规",
    "哲社类只能报社会调查报告（不能报纯学术论文为'调查报告'），且需符合5个组别方向",
    "科技发明制作类无实物或模型参展将无法参加终审决赛",
    "申报作品须为申报日前规定年限内完成的学生成果，已获往届奖励作品不得重复申报"
  ],
