{
  "competition_id": 107,
  "competition_name": "无机非金属材料基础知识大赛",
  "judging_dimensions": [
    {
      "dimension": "专业基础知识掌握（理论笔试/预赛）",
      "weight": "预赛（笔试）成绩为晋级依据；校赛阶段理论考试满分100%计分【推断：校赛以理论考试形式进行、按卷面成绩评奖；全国赛预赛阶段笔试排名决定晋级决赛名额，具体权重未公开】",
      "official_wording": "安徽理工大学校赛通知原文（对接全国赛内容）：'本次大赛以理论考试的形式进行，考试内容以无机非金属材料专业基础知识为主，主要涵盖材料科学基础、材料工程基础、无机材料物理性能、材料测试与研究方法等。大赛着重考查学生对无机非金属材料专业基础知识的掌握程度及其综合运用基础知识解决复杂问题的能力，创新精神和独立工作能力'。全国赛预赛细则未公开，按笔试选拔推断。",
      "scoring_points": [
        "材料科学基础：晶体结构、相图、扩散与固相反应、烧结理论等核心概念准确",
        "材料工程基础：热工过程、粉体工程与工艺原理",
        "无机材料物理性能：力学、热学、光学、电学性能及其机理",
        "材料测试与研究方法：XRD、SEM/TEM、热分析等表征手段的原理与判读",
        "综合运用基础知识分析解决复杂问题的能力"
      ],
      "common_deductions": [
        "概念混淆、机理表述错误",
        "表征谱图判读错误",
        "计算题公式套用错误、单位换算失误"
      ]
    },
    {
      "dimension": "决赛现场答题（必答与抢答环节）",
      "weight": "约占50%【推断：决赛环节计分定名次，预赛8支代表队晋级决赛后按现场答题总分评定特等奖/一等奖/二等奖/三等奖；全国赛决赛分值设置未公开，校级选拔赛同构环节为'必答题和抢答题两个环节'】",
      "official_wording": "全国赛决赛形式未公开细则。推断依据：洛阳理工学院（第四届承办方）新闻原文：'经过预赛阶段激烈角逐，共有8支代表队凭借优异表现进入本届大赛决赛'，评审专家组宣读比赛结果；兰州理工大学校内选拔赛新闻原文：'决赛：现场答题，设必答题和抢答题两个环节'，与全国赛团队现场对抗形式同构，【推断】全国决赛采用团队必答+抢答的现场竞赛。",
      "scoring_points": [
        "必答题环节：本队答题准确率与稳定性",
        "抢答题环节：反应速度与准确率，抢答违规按规则扣分（同类赛通例）",
        "团队协作与分工：队内答题策略与互补",
        "临场心理素质与时间控制"
      ],
      "common_deductions": [
        "答错必答题按规则扣分或不得分",
        "抢答犯规（未等题面读完、超时）",
        "队伍分工失衡、关键题无人应答"
      ]
    },
    {
      "dimension": "团队综合表现与竞赛素养",
      "weight": "定性综合排序定奖级【推断：全国赛按代表队评特等奖、一等奖、二等奖、三等奖，预赛成绩+决赛现场成绩综合排序，综合权重未公开】",
      "official_wording": "洛阳理工学院新闻原文：第四届大赛'来自全国47所院校无机非金属材料专业80支代表队'参赛，'8支代表队进入本届大赛决赛'；获奖为团队（如'河南科技大学（从容应对队）、郑州航空工业管理学院（大吉大利队）荣获特等奖'，另有6支队伍获一等奖、若干三等奖）。安徽理工大学新闻：大赛'面向全国高校材料类相关专业本科生的一项科技竞赛活动'。",
      "scoring_points": [
        "以代表队为单位的整体成绩（每队统一队名参赛）",
        "知识面对本专业内涵的完整理解（'让学生充分理解材料学科的丰富内涵'）",
        "代表学校出赛的风貌与纪律",
        "对无机非金属材料行业（水泥、玻璃、陶瓷、耐火材料、新型低碳建材等）的认知广度"
      ],
      "common_deductions": [
        "队员非相关专业或资格不符",
        "现场违纪（作弊、使用通讯工具）",
        "答题超时、不服从赛会安排"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "预赛答卷（笔试）",
      "format": "闭卷理论考试，涵盖材料科学基础、材料工程基础、无机材料物理性能、材料测试与研究方法等",
      "page_limit": "未明确",
      "deadline_note": "全国赛预赛阶段于决赛前举行（第四届决赛2023年8月17日在洛阳理工学院开幕）"
    },
    {
      "item": "决赛现场答题",
      "format": "以院校代表队为单位（统一队名）现场必答+抢答（同类赛同构形式）",
      "page_limit": "未明确",
      "deadline_note": "第四届（2023年8月，洛阳理工学院）：47所院校80支代表队参加，8支晋级决赛；决赛当天评审专家组宣读结果并颁奖"
    },
    {
      "item": "报名表（以校为单位组队）",
      "format": "高校统一组队报名（校赛选拔产生代表队）",
      "page_limit": "未明确",
      "deadline_note": "各届由承办高校发布第一轮通知确定报名与预赛时间（如第三届全国大赛第一轮通知）"
    }
  ],
  "process_stages": [
    {
      "stage": "校级选拔（校赛）",
      "format": "理论考试（笔试）选拔个人/组队，部分高校校赛决赛设必答、抢答环节",
      "notes": "安徽理工大学'联通杯'校赛：5个学院14个专业140余名学生参赛，按卷面评一、二、三等奖（14/22/32名）；兰州理工大学校赛：笔试选12人晋级，4组现场答题"
    },
    {
      "stage": "全国预赛",
      "format": "各校代表队参加预赛（笔试选拔），按成绩排名确定晋级决赛名单",
      "notes": "第四届：80支代表队经预赛角逐，8支晋级决赛"
    },
    {
      "stage": "全国决赛与颁奖",
      "format": "现场团队竞赛，评审专家组现场评审并宣读结果，当场颁奖",
      "notes": "第四届由中国建筑材料联合会专家委员会主办、其教育与人力资源学部和洛阳理工学院共同承办，郑州大学等协办；闭幕式由教育部高等学校材料类专业教学指导委员会副秘书长主持"
    }
  ],
  "review_format": "笔试预赛选拔+决赛现场团队答题（必答/抢答）计分排名，评审专家组现场评定并宣读获奖结果。",
  "judge_preferences": [
    "基础知识准确性与覆盖面优先：四门核心课程（材料科学基础、材料工程基础、无机材料物理性能、材料测试与研究方法）为命题主干",
    "强调综合运用基础知识解决复杂问题的能力，而非死记硬背",
    "决赛重视抢答反应速度与团队配合",
    "重视对无机非金属行业（建材、水泥、陶瓷、低碳新材料）的理解与专业认同"
  ],
