{
  "competition_id": 12,
  "competition_name": "电子商务三创赛",
  "judging_dimensions": [
    {
      "dimension": "创新（明确的创新点）",
      "weight": "25%（常规赛0-25分；实战赛0-15分，百分制）",
      "official_wording": "创新：项目具备明确创新点——新产品、新技术、新模式、新服务等方面至少有一个明确创新点（三创赛竞赛规则评分表，成都信息工程大学第十五届校赛通知转录）",
      "scoring_points": [
        "至少一个明确的创新点（产品/技术/模式/服务任一维度）",
        "创新点与电商行业痛点的对应关系",
        "相对现有方案的差异化与壁垒",
        "创新的技术或模式可实现性"
      ],
      "common_deductions": [
        "创新点模糊、属常见功能的重新包装",
        "与已有电商产品同质化",
        "新旧作品差异说明中创新递进不明显（多次参赛项目）"
      ]
    },
    {
      "dimension": "创意（策划设计与可行性分析）",
      "weight": "25%（常规赛0-25分；实战赛0-15分，百分制）",
      "official_wording": "创意：进行了较好的、创新性的策划与设计（含商务策划与可行性分析）（三创赛竞赛规则评分表，校赛通知转录）",
      "scoring_points": [
        "商业模式设计的完整闭环（用户、场景、盈利逻辑）",
        "市场分析与竞争策略的说服力",
        "运营/营销方案的落地路径",
        "财务与可行性分析的合理性"
      ],
      "common_deductions": [
        "只有概念没有商业模式闭环",
        "市场数据来源缺失或过时",
        "策划与电商主题赛道脱节"
      ]
    },
    {
      "dimension": "创业（实践活动与运营佐证）",
      "weight": "25%（常规赛0-25分；实战赛0-45分，百分制）",
      "official_wording": "创业：可行性、商业模式、团队与运营能力；实战赛的'创业'分值提高到45分，在三级赛现场由合作企业统一打分（第十三届、第十五届三创赛规则，多校通知转录）",
      "scoring_points": [
        "项目实际运营证据（店铺、GMV、用户量、直播场次等真实数据）",
        "团队组建与分工的合理性",
        "不强制成立公司，但需体现可持续的经营逻辑",
        "实战赛由合作企业按运营实操结果打分（跨境直播、大数据分析、BUC产学用等）"
      ],
      "common_deductions": [
        "纯纸上方案、无任何实践佐证材料",
        "运营数据造假或无法核验",
        "团队分工与项目需求错配"
      ]
    },
    {
      "dimension": "演讲（现场表达与团队配合）",
      "weight": "15%（常规赛与实战赛均为0-15分，百分制）",
      "official_wording": "演讲：团队配合、表达等（三创赛竞赛规则评分表，校赛通知转录；现场答辩每队共15分钟：演讲8分钟+评委问答7分钟）",
      "scoring_points": [
        "8分钟路演的结构、重点与时间控制",
        "答辩手对评委提问的准确理解与应变",
        "团队成员配合与角色衔接",
        "非团队成员不得代替答辩"
      ],
      "common_deductions": [
        "演讲超时被扣分或打断",
        "答辩由指导老师/非团队成员代答",
        "PPT念稿、重点不清"
      ]
    },
    {
      "dimension": "文案（项目策划书与PPT质量）",
      "weight": "10%（常规赛与实战赛均为0-10分，百分制）",
      "official_wording": "文案：PPT与文案质量（三创赛竞赛规则评分表，校赛通知转录；初级赛采取书面评审，评委依照官方评分标准对参赛项目评分，按总分高低排序晋级）",
      "scoring_points": [
        "项目策划书的逻辑与完整性",
        "答辩PPT的信息设计与视觉规范",
        "团队名≤16字符、作品名≤30字符等命名规范执行",
        "内容正能量、合法合规"
      ],
      "common_deductions": [
        "策划书结构混乱、数据图表缺失",
        "命名不符合字符数规范",
        "书面评审材料不完整影响初级赛排名"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "项目策划书（项目报告书）",
      "format": "纸质版+电子版（校级赛通常要求纸质评审），按官方模板",
      "page_limit": "未明确（按当届指南模板）",
      "deadline_note": "报名至校赛截止（如第十五届校赛报名至2024-12-31），官网www.3chuang.net注册"
    },
    {
      "item": "答辩PPT",
      "format": "路演用演示文稿，配合15分钟现场答辩（8分钟演讲+7分钟问答）",
      "page_limit": "未明确",
      "deadline_note": "现场答辩前提交，分组顺序提前公布"
    },
    {
      "item": "非首次参赛差异材料（3个文档）",
      "format": "再创新后的新作品、原参赛作品、新旧作品差异比较说明",
      "page_limit": "未明确",
      "deadline_note": "与报名材料同时提交，未申报差异属违规"
    },
    {
      "item": "实战赛运营佐证材料",
      "format": "直播带货数据、跨境店铺经营数据、数据分析报告等实操结果文件",
      "page_limit": "未明确",
      "deadline_note": "按各实战赛指南规定节点提交，合作企业据此打分"
    }
  ],
  "process_stages": [
    {
      "stage": "校级赛（初级赛）",
      "format": "书面评审（依官方评分表打分排序）+现场答辩；每队3-5人（含队长），0-2名高校导师+0-2名企业导师",
      "notes": "一人可同期参加一个常规赛和一个实战赛（须为不同项目，注册两个团队ID）；奖项比例通常一/二/三等奖≤10%/20%/30%"
    },
    {
      "stage": "省级选拔赛（中级赛）",
      "format": "按省赛区组织，书面评审与现场答辩结合，排名推荐晋级全国总决赛",
      "notes": "常规赛设三农电商、工业电商、跨境电商、电商物流、互联网金融、移动电商等9大主题；实战赛设跨境电商、乡村振兴、产学用BUC、商务大数据分析、直播电商等5类"
    },
    {
      "stage": "全国总决赛",
      "format": "现场路演答辩；实战赛创业项由合作企业统一评分（不以校内评委打分）",
      "notes": "由教育部委托教育部高校电子商务类专业教学指导委员会主办，2009年创办，校-省-国三级赛制"
    }
  ],
  "review_format": "百分制5项积分制（创新/创意/创业/演讲/文案），初级赛书面评审排序晋级，后续阶段书面评审+现场路演答辩；实战赛创业分由合作企业按真实运营实操评定。",
  "judge_preferences": [
    "至少一个看得见摸得着的明确创新点，忌概念堆砌",
    "创业维度看真实运营证据：实战化、有数据、可验证",
    "选题紧扣当届主题赛道（三农、跨境、直播电商、AI+电商等）",
    "答辩默契、8分钟讲清商业模式闭环",
    "策划书与PPT的规范度和视觉质量是基础分保障"
  ],
  "past_winning_patterns": [
    "国奖项目选题紧扣主题赛道并下沉真实场景：三农电商（县域农产品上行）、跨境电商（独立站/海外直播）、直播电商与AI+电商近年获奖密度最高",
    "常规赛获奖项目普遍为'创意+可行性验证'组合：不强制成立公司，但一等奖项目多有试点运营数据或企业合作背书",
    "实战赛获奖依赖真实操盘硬指标：直播GMV、店铺销量、大数据分析报告等，产学用（BUC）实战赛国一项目均由企业出题、企业评分",
    "团队呈现规范化：队长+答辩手+美工（PPT与计划书排版）分工明确，15分钟路演节奏紧凑（备赛复盘帖共性）",
    "多年迭代项目须提交新旧作品差异说明，持续获奖团队的创新点呈清晰递进（第十六届多校从省赛6000+队伍突围获国一的项目均为三年打磨）",
    "项目书实名规范、数据图表完整，含用户画像、财务测算与风险分析的标准结构"
  ],
  "forbidden_or_risky": [
    "作品须原创且首次参赛；非首次参赛未提交新旧作品差异比较说明（3个文档）属违规",
    "所有团队和作品须经合规检查，内容不合法合规或非正能量者不得参赛",
    "答辩不得由非本团队成员代替（含指导教师代答）",
    "同一项目不得同时报常规赛与实战赛；同期报两个赛须为不同项目并注册两个团队ID",
    "团队名≤16字符、作品名称≤30字符，超限或含违规词汇的命名不予受理"
  ],
