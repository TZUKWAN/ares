{
  "competition_id": 128,
  "competition_name": "菲尼克斯智能技术创新与应用大赛",
  "judging_dimensions": [
    {
      "dimension": "创新性与主题契合（智能创新·启迪未来）",
      "weight": "30%【推断权重，官方未公布评分细则】",
      "official_wording": "【推断】官方公布当届主题（第五届为“共创可持续发展的世界”）与指导思想“智能创新，启迪未来”，并要求参赛项目立足创新和应用（山东女子学院等对第四届的转述）；未公布分值权重。推断依据：大赛定位为“智能技术创新与应用”竞赛，主题契合与创新性是创意初评环节的核心筛选标准",
      "scoring_points": [
        "选题呼应当届主题（如可持续发展和智能工厂/智能生活/智能设施赛道定位）",
        "方案在自动化、数字化应用上有新意，非简单复刻成熟案例",
        "面向真实产业场景的应用价值"
      ],
      "common_deductions": [
        "选题与赛道定位脱节",
        "创新点表述空泛、与已有商用方案雷同"
      ]
    },
    {
      "dimension": "方案设计质量（创意初评·项目方案书）",
      "weight": "20%【推断权重】",
      "official_wording": "【推断】官方赛程为“报名→创意初评→技术探讨→项目搭建→全国总决赛”（中国工控网对往届流程的总结），创意初评以书面方案为评审对象",
      "scoring_points": [
        "系统方案完整性：控制对象、控制策略、软硬件架构清晰",
        "技术路线可行性与菲尼克斯电气产品（PLC、控制与I/O、连接技术等）的合理选型",
        "进度安排与团队分工合理"
      ],
      "common_deductions": [
        "方案书缺少系统架构或选型依据",
        "技术路线明显不可行"
      ]
    },
    {
      "dimension": "作品实现与功能完成度（项目搭建成果）",
      "weight": "30%【推断权重】",
      "official_wording": "【推断】官方流程含“技术探讨”“项目搭建”阶段，全国总决赛要求携带作品进行展示与答辩；推断依据：自动化应用类赛事通行做法及决赛获奖报道中均涉及实物/系统作品",
      "scoring_points": [
        "作品功能实现程度与运行稳定性",
        "基于菲尼克斯电气自动化产品的系统集成深度",
        "工程规范（接线、程序、人机界面等）"
      ],
      "common_deductions": [
        "作品不能现场运行、仅有效果图或视频",
        "未实际使用承办企业产品或使用极浅"
      ]
    },
    {
      "dimension": "现场展示与答辩表现（全国总决赛）",
      "weight": "20%【推断权重】",
      "official_wording": "【推断】第五届全国总决赛于2023年9月16-18日在南京菲尼克斯电气中国总部现场举行，35支晋级队伍现场比拼（南京晓庄学院、搜狐等报道），现场环节含作品展示与评委答辩；官方未公布答辩评分权重",
      "scoring_points": [
        "作品演示的流畅度与效果呈现",
        "答辩中对技术原理、实现细节的应答能力",
        "团队协作与表达专业度"
      ],
      "common_deductions": [
        "答辩答非所问、核心工作由指导教师代答",
        "演示超时或设备故障无备份方案"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "参赛报名信息",
      "format": "以院校为单位组队报名（高校师生团队）",
      "page_limit": "未明确",
      "deadline_note": "第五届于2022年9月底启动报名，总决赛2023年9月举行，赛程约一年"
    },
    {
      "item": "创意初评方案（参赛项目方案）",
      "format": "书面项目方案/创意方案（含选题背景、系统方案、技术路线）",
      "page_limit": "未明确",
      "deadline_note": "创意初评阶段（报名后、项目搭建前）"
    },
    {
      "item": "作品与技术材料（总决赛）",
      "format": "基于菲尼克斯电气自动化产品的作品（实物/系统）+ 演示材料（PPT/视频）",
      "page_limit": "未明确",
      "deadline_note": "全国总决赛现场（第五届为2023年9月16-18日，南京菲尼克斯电气中国总部）"
    }
  ],
  "process_stages": [
    {
      "stage": "报名与创意初评",
      "format": "院校组织师生团队报名，提交创意/项目方案，组委会组织初评",
      "notes": "第五届吸引40余所院校近600名师生、150余个项目团队报名"
    },
    {
      "stage": "技术探讨与项目搭建",
      "format": "入围队伍在承办方技术支持下开展方案深化与作品制作",
      "notes": "官方赛程表述为“技术探讨”“项目搭建”阶段，期间有企业技术资源对接"
    },
    {
      "stage": "全国总决赛",
      "format": "晋级队伍（第五届为20所院校35支队伍）赴南京菲尼克斯电气中国总部现场进行作品展示与答辩",
      "notes": "第五届总决赛2023年9月16-18日举行；按赛道（智能工厂/智能生活/智能设施）评出一、二、三等奖"
    }
  ],
  "review_format": "创意初评（书面方案评审）与全国总决赛（现场作品展示+答辩）两级评审，决赛按智能工厂、智能生活、智能设施三赛道分组评定奖项。",
  "judge_preferences": [
    "深度应用菲尼克斯电气自动化产品（控制、I/O、连接与接口技术）的系统级方案更受认可",
    "呼应可持续发展与智能制造主题、面向真实工业/生活场景的应用型创新",
    "作品必须能现场运行演示，工程完成度优先于概念数量",
    "师生联合、跨专业协作的团队与规范的开发过程",
    "答辩能讲清控制原理与工程实现细节"
  ],
