{
  "competition_id": 79,
  "competition_name": "数字建筑创新应用大赛",
  "judging_dimensions": [
    {
      "dimension": "技能操作成果（建模/算量计价正确性）",
      "weight": "约60%-70%（机考赛项100分制，自动评分软件）【推断：由占总成绩主体地位推定】",
      "official_wording": "校内选拔赛通知（常州大学怀德学院）原文：'比赛评分：通过自动评分软件完成评分，具体评分规则…比赛评分：总分100分，通过自动评分软件完成评分及排名'。全国选拔赛同机考形式。量化权重为官方口径（100分制）。",
      "scoring_points": [
        "BIM公建/住宅建模：构件完整性与几何精度，按自动评分软件逐项比对",
        "工程量清单编制：清单项齐全、算量结果与标准答案偏差小",
        "招标控制价编制：组价正确、取费与计价程序无误",
        "工程进度计划管理/BIM施工管理：逻辑关系、参数设置符合题面要求"
      ],
      "common_deductions": [
        "模型缺项漏项、命名与轴网不规范导致软件识别失败",
        "算量结果超偏差、清单漏项",
        "未按要求保存/提交结果文件导致无法评分"
      ]
    },
    {
      "dimension": "作品质量（创新性、实用性、技术先进性）",
      "weight": "综合应用/作品类赛项核心维度，约60%-70%【推断】",
      "official_wording": "西安培华学院赛事报道转述总决赛作品标准围绕'创新性、实用性、技术先进性'等维度展开；官方《赛项规程》未公开分值表，权重为【推断：参照BIM类作品评审惯例（中国建设教育协会系列赛）三分维结构推定】。",
      "scoring_points": [
        "创新性：方案在数字技术应用、流程或管理方法上的新意",
        "实用性：与真实工程场景结合度、可落地性",
        "技术先进性：BIM/数字施工/智能建造工具与方法的运用深度",
        "成果完整性：模型、报告、图纸、视频等成果体系齐备"
      ],
      "common_deductions": [
        "作品为软件教程式套用、无自主创新点",
        "模型与报告数据矛盾、成果拼凑",
        "脱离工程实际、炫技但不实用"
      ]
    },
    {
      "dimension": "现场展示与答辩",
      "weight": "总决赛环节约20%-30%【推断】",
      "official_wording": "团体实践赛采用'报告评审+现场展示答辩'的评审方式（高校赛事目录与历届总决赛安排转述）；具体分值为【推断：参照同类建设类赛事决赛答辩占比推定】。",
      "scoring_points": [
        "陈述逻辑清晰、突出数字技术解决工程痛点的路径",
        "答辩答问准确、团队成员分工明确",
        "展示材料（PPT/视频）制作专业"
      ],
      "common_deductions": [
        "答辩与提交报告口径不一致",
        "陈述超时、答非所问",
        "仅个别成员能答、暴露'挂名'问题"
      ]
    },
    {
      "dimension": "团队协作与规范性",
      "weight": "定性贯穿维度（入围门槛+酌情加减分）",
      "official_wording": "通知要求'每队3名成员，可配1~2名指导教师'，各赛项按本科组/高职组分组评审（南通大学转发2026年通知）；规范性为组合维度【推断】。",
      "scoring_points": [
        "报名信息与作品署名一致、符合分组要求",
        "按指定软件版本与文件格式提交",
        "三人分工在成果中可辨识"
      ],
      "common_deductions": [
        "成员人数或组别不符规定",
        "使用非指定软件版本导致文件不兼容",
        "逾期提交"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "机考成果文件",
      "format": "指定软件（广联达BIM/计价/Revit等）生成的工程文件与结果文件",
      "page_limit": "未明确",
      "deadline_note": "校赛约6月，全国选拔赛约9月，总决赛10-11月（2024届获奖名单10月29日公布）"
    },
    {
      "item": "综合应用作品（模型+报告）",
      "format": "BIM模型文件+Word/PDF报告+展示PPT/视频（按当届赛项规程）",
      "page_limit": "未明确（以官方《赛项规程》为准）",
      "deadline_note": "总决赛前按通知提交"
    },
    {
      "item": "报名表",
      "format": "纸质表（学院盖章）+电子档，3人/队+1~2名指导教师",
      "page_limit": "未明确",
      "deadline_note": "校级报名约5-6月，全国报名8-10月26日"
    }
  ],
  "process_stages": [
    {
      "stage": "校级选拔赛",
      "format": "校内机考（自动评分软件）或作品评审",
      "notes": "约6月完成；每赛项推荐不超过3个团队晋级国赛"
    },
    {
      "stage": "全国选拔赛",
      "format": "统一线上机考（自动评分）",
      "notes": "约9月举行，按成绩排序晋级总决赛"
    },
    {
      "stage": "全国总决赛",
      "format": "机考+作品评审+现场展示答辩（按赛项而定）",
      "notes": "10-11月举行，中国建设教育协会公布获奖名单"
    }
  ],
  "review_format": "技能赛项由自动评分软件按标准答案机评排名，综合/作品类赛项由专家评委按创新性、实用性、技术先进性评审并辅以现场答辩。",
  "judge_preferences": [
    "数字技术在真实工程场景中的深度应用而非软件操作演示",
    "成果体系完整：模型、报告、展示相互印证",
    "答辩陈述紧扣工程痛点与解决方案",
    "按本科组/高职组分组评审，强调公平与规范化"
  ],
