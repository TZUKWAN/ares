{
  "competition_id": 36,
  "competition_name": "“大唐杯”信息通信技术大赛",
  "judging_dimensions": [
    {
      "dimension": "通信理论基础（理论赛客观题）",
      "weight": "50%（省赛理论赛300分，省赛总分600分）",
      "official_wording": "第十二届省赛通知（常州工学院转发组委会通知）：\"理论赛答题时长75分钟，总分300分，基于'学唐OnLine'平台答题；单选题共40题3分/题（120分），多选题共30题4分/题（120分），判断题60分\"；第十一届备战分析（知乎）：\"第十一届理论题分值增加100分、仿真分值降低100分\"（理论300分+仿真300分）",
      "scoring_points": [
        "移动通信基础（无线原理、网络架构、协议流程）",
        "5G-A/6G前沿技术知识点",
        "无线通信+AI、物联网等新一代信息技术",
        "单选/多选/判断客观题作答准确率（75分钟内完成）"
      ],
      "common_deductions": [
        "多选题漏选/错选不得分（客观题无部分给分则整题失分）",
        "超时未提交系统自动收卷",
        "考场违纪取消该科成绩"
      ]
    },
    {
      "dimension": "工程实践与仿真能力（仿真实践赛）",
      "weight": "50%（省赛仿真实践赛300分，60分钟，虚拟仿真平台）",
      "official_wording": "第十一届省赛规则（知乎备战帖引用官方赛制）：\"仿真实践赛答题时长60分钟，共300分，基于虚拟仿真平台答题\"；省赛考核范围：\"移动通信基础、5G-A/6G技术、无线通信+AI、物联网等\"（河南科技学院赛事报道）",
      "scoring_points": [
        "5G全网建设与设备配置操作（基站开站、参数配置）",
        "网络规划与优化任务（覆盖、容量、故障定位与优化）",
        "车联网/网联智能车场景实现",
        "虚拟仿真平台操作熟练度与任务完成质量（60分钟）"
      ],
      "common_deductions": [
        "配置步骤遗漏导致后续任务连锁失分",
        "故障定位错误、优化方案无效不得分",
        "平台操作超时未保存结果"
      ]
    },
    {
      "dimension": "国赛阶段综合实践能力",
      "weight": "国赛按决赛成绩从高到低排名评奖，一、二、三等奖比例为实际参赛竞赛小组数量的5%、10%、20%",
      "official_wording": "第十届大赛章程（赛氪转载）：\"全国总决赛设置一、二、三等奖，获奖比例为实际竞赛小组数量的5%、10%、20%\"；第八届章程（上海海事大学教务处转发PDF）：\"大赛省赛采用统一命题、分赛区比赛的组织方式，选手在指定赛点参加省赛；省赛公示所有晋级名单\"；\"总决赛按赛道划分、按项目里程碑要求组织\"",
      "scoring_points": [
        "省赛一等奖（或各组别最高奖项）晋级全国总决赛",
        "国赛按赛道单元组织实践任务/项目里程碑考核",
        "决赛实操任务完成质量与速度",
        "同分时按完成用时等细则排序"
      ],
      "common_deductions": [
        "国赛报名缴费逾期视为弃权",
        "决赛环境不熟悉导致任务未完成",
        "团队分工配合失当拖累整体进度"
      ]
    },
    {
      "dimension": "考纪与合规",
      "weight": "违规者取消成绩（0分处理），不设固定权重，相关分数从总分中扣除",
      "official_wording": "第八届章程：\"省赛公示所有晋级名单并启动监督反馈制度\"（设监督机制约束考纪）",
      "scoring_points": [
        "独立完成理论赛答题，无作弊行为",
        "仿真赛不使用外挂、远程协助等违规手段",
        "遵守指定赛点考场纪律"
      ],
      "common_deductions": [
        "作弊一经查实取消参赛与获奖资格",
        "替考/代做取消成绩并通报学校",
        "扰乱考场秩序被终止考试"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "理论赛答卷",
      "format": "线上平台（学唐OnLine）机考客观题，75分钟，满分300分",
      "page_limit": "单选40题+多选30题+判断题（共300分）",
      "deadline_note": "省赛阶段（第十二届为2025年4-5月）指定时间统一开考"
    },
    {
      "item": "仿真实践赛答卷",
      "format": "虚拟仿真平台实操任务，60分钟，满分300分",
      "page_limit": "未明确",
      "deadline_note": "省赛阶段与理论赛同期/相邻进行"
    },
    {
      "item": "国赛实践任务/项目里程碑成果",
      "format": "按赛道组织的现场实践任务或项目里程碑交付（章程条款）",
      "page_limit": "未明确",
      "deadline_note": "国赛阶段（第十二届为2025年6-7月）"
    }
  ],
  "process_stages": [
    {
      "stage": "校赛/报名（约12月-次年3月）",
      "format": "高校统一组织报名，报名一般于每年12月15日左右启动",
      "notes": "组别：中职组、高职组、本科A组、本科B组、研究生组，以省为单位组成赛区"
    },
    {
      "stage": "省赛（约4-5月）",
      "format": "统一命题、分赛区指定赛点机考：理论赛（75分钟300分）+仿真实践赛（60分钟300分）",
      "notes": "省赛按组别设一、二、三等奖，比例原则上不低于各组别实际参赛组数的7%、15%、25%；省赛一等奖晋级全国总决赛；晋级名单公示并设监督反馈机制"
    },
    {
      "stage": "全国总决赛（约6-7月）",
      "format": "按赛道划分组织决赛实践任务/项目里程碑考核，现场或指定环境完成",
      "notes": "国赛一、二、三等奖比例为实际参赛竞赛小组的5%、10%、20%；另设优秀指导教师奖"
    }
  ],
  "review_format": "客观题机考+虚拟仿真实操双环节机评（省赛理论300分+仿真300分合计600分）按总分排名，一等奖晋级国赛后以决赛实践任务成绩排名评奖。",
  "judge_preferences": [
    "理论题覆盖面广且逐年微调（第十一届起理论增为300分），重基础概念与新一代技术动态",
    "仿真赛重操作熟练度与任务链完整性，步骤分环环相扣",
    "故障定位与优化类任务重排查思路，答案路径不唯一但结果须正确",
    "严格机考纪律，过程留痕可追溯"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "省赛为统一命题统一时长的封闭机考，任何作弊、代考行为取消资格并通报",
    "国赛资格须按通知确认并缴费，逾期视为放弃",
    "不同组别（本科A/B组等）题目与难度不同，跨组报名属违规",
    "仿真平台版本/环境以官方发布为准，私用破解环境复题不属违规但成绩不受影响，切勿在考场外传播赛题",
    "各届分值结构存在调整（如第十一届理论300/仿真300），备考须以当届章程为准"
  ],
