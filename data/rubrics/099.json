{
  "competition_id": 99,
  "competition_name": "中国汽车工程学会巴哈大赛（含电动）",
  "judging_dimensions": [
    {
      "dimension": "赛车设计（设计报告+设计答辩，静态赛）",
      "weight": "15%（150分/总分1000分，官方规则项目分值）",
      "official_wording": "2024-2026版规则参赛队（深圳技术大学赛车工作室、深技大赛车工作室公众号）公布：静态赛事含设计报告答辩150分、商业营销答辩150分；官方规则历版设『C3 赛车设计项目』章节，赛前提交设计报告、赛时进行设计答辩",
      "scoring_points": [
        "设计报告完整性：总体布置、车架、悬架转向、传动、电气系统论证",
        "创新点与工程分析深度（仿真/实测数据支撑）",
        "设计答辩：向评委讲解并回答技术追问（全体队员参与）",
        "与规则符合性：安全结构（防滚架、约束系统）、尺寸/动力限值合规"
      ],
      "common_deductions": [
        "报告数据造假或与实车不符",
        "答辩答不出基本设计依据",
        "技术检查(Scrutineering)不过关影响后续动态赛",
        "关键安全项不合规被要求整改"
      ]
    },
    {
      "dimension": "商业营销答辩（静态赛）",
      "weight": "15%（150分/总分1000分，官方规则项目分值）",
      "official_wording": "深技大赛车工作室公众号公布2024版分值：商业营销答辩150分；2016版规则设『成本与制造』与『商业营销』静态项目章节（2020 BSC规则通知亦列技术检查、赛车设计、成本与制造以及商业营销）",
      "scoring_points": [
        "商业计划书/营销方案：目标市场定位、量产可行性、成本控制",
        "路演表达与团队协作（模拟向『投资人/客户』推销）",
        "成本分析与制造方案的合理性",
        "对评委商业质询的应答"
      ],
      "common_deductions": [
        "营销方案与工程实际脱节",
        "答辩超时、PPT平庸无亮点",
        "成本清单漏项或明显失真"
      ]
    },
    {
      "dimension": "动态赛性能（牵引、操控、单圈计时、专项）",
      "weight": "单项7.5%（75分）、合计30%（300分）/总分1000分（官方规则项目分值）",
      "official_wording": "深技大赛车工作室公众号公布2024版分值：牵引赛75分、操控赛75分、单圈计时赛75分、专项赛75分；西华大学2024年通稿：动态赛含操控性、单圈计时、耐久性、牵引和专项",
      "scoring_points": [
        "牵引赛（爬坡/牵引）：低速大扭矩输出与轮胎抓地能力",
        "操控赛（绕桩/技巧道）：灵活性、驾驶员熟练度与完赛时间",
        "单圈计时：场地最快圈速（体现动力匹配与调校水平）",
        "专项赛（如加速/直线等当年设置项目）：按计时排名折算分值",
        "各项目均须先通过技术检查并完成练习轮次"
      ],
      "common_deductions": [
        "动态赛DNF（未完赛/弃权）该项记最低档分值",
        "碰撞、抢跑、漏标桩被加时或判罚",
        "驾驶员超重/护具不合规禁止上场",
        "车检不合格被取消该站动态赛资格"
      ]
    },
    {
      "dimension": "耐久赛（4小时耐久）",
      "weight": "40%（400分/总分1000分，官方规则项目分值，单项权重最高）",
      "official_wording": "豆丁网赛事报道：中国巴哈大赛分两个静态和三个动态比赛，外加一个4小时的耐久赛；深技大公众号公布耐久赛400分；2021赛制公告：本科组和职校组各前20名参加第二站，两站成绩叠加产生年度总排名",
      "scoring_points": [
        "4小时耐久的可靠性：无重大机械故障、换人换胎效率",
        "多车同场竞技下的超车与防守策略",
        "维修区组织与车手轮换计划",
        "全队工程保障体系（快速诊断与抢修能力）"
      ],
      "common_deductions": [
        "耐久中途退赛（DNF）大幅失分",
        "违规维修（场外维修、非指定区域）被罚时",
        "危险驾驶、碰撞他车被黑旗处罚",
        "燃油/电能补给违规"
      ]
    },
    {
      "dimension": "电动组专项要求（电动巴哈）",
      "weight": "独立组别评审：与油动本科组/职校组并行设电动组奖项（如襄阳站设本科组、职校组、电动组奖项），评分框架与油动组同类（静态定性打分+动态客观计时），动力系统规则单列",
      "official_wording": "官网公告：电动巴哈大赛规则委员会结合开赛五年来出现的问题及近两年电动巴哈实验赛问题修订规程并正式发布；2021年报道：9支电动巴哈车队首次加入襄阳站，『四轮驱动在比赛中是可选的』；第七届BSC奖项公告：81支车队中电车13支，襄阳站设本科组、职校组、电动组奖项【推断依据：官方公告与赛事通稿，电动组采用独立规则与总成绩排名】",
      "scoring_points": [
        "三电系统（电池、电机、电控）设计的安全性与可靠性：BMS、绝缘监测、过流保护",
        "高压安全：电池箱防护、紧急断电开关、人防触电措施（技术检查重点）",
        "四轮驱动等构型选择的合理性（规则允许四驱可选）",
        "能源管理策略对动态赛成绩的支撑"
      ],
      "common_deductions": [
        "高压系统检查不通过禁止动态赛",
        "电池规格超规、无绝缘防护",
        "雨淋/涉水环节电池防护失效",
        "充电区域违规操作"
      ]
    }
  ],
