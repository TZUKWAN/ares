{
  "competition_id": 18,
  "competition_name": "大创年会展示",
  "judging_dimensions": [
    {
      "dimension": "学术论文——学术价值与创新性",
      "weight": "约30%（年会按《作品评审标准》分三类遴选，各维度权重未公开，此为推断）",
      "official_wording": "年会遴选\"国创计划\"中创新训练项目，以学术论文形式进行学术交流；论文须出自国家级大学生创新训练计划项目，优先推荐已公开发表的论文（须标明刊物名称等信息）（第十八届各校通知）。分维度权重【推断】。",
      "scoring_points": [
        "研究问题明确，源于大创项目真实研究内容",
        "方法科学、数据可靠，结论有学术贡献或应用价值",
        "已正式发表或获录用者优先",
        "写作规范，署名与项目成员对应，作者文责自负"
      ],
      "common_deductions": [
        "与项目立项内容无关或拼凑成文",
        "查重不达标、涉嫌抄袭",
        "署名与项目组不符、指导教师未审核把关"
      ]
    },
    {
      "dimension": "改革成果项目——创新性与展示效果",
      "weight": "约25%（推断）",
      "official_wording": "改革成果展示从创新训练、创业训练/实践项目中择优遴选，\"以展板和实物作品演示的形式进行项目交流\"，入选项目由学生代表投票选出\"我最喜爱的项目\"等（第十八届通知，第十八届共遴选改革成果250项）。权重【推断】。",
      "scoring_points": [
        "项目成果有实质创新点（技术、方法、模式）",
        "展板信息设计清晰，实物/演示可现场操作",
        "完成度与实际成效（论文、专利、软著、应用证明等）",
        "学生讲解表达力与现场互动表现"
      ],
      "common_deductions": [
        "展板内容堆砌、成果与展示脱节",
        "实物无法演示或与申报材料不符",
        "成果标注夸大、佐证材料缺失"
      ]
    },
    {
      "dimension": "创业推介项目——商业性与成长性",
      "weight": "约20%（推断）",
      "official_wording": "创业推介从创业训练项目和创业实践项目中遴选，进行项目推介、宣传和交流；年会遴选约12项优秀创业推介项目，直接晋级下一年度中国国际大学生创新大赛（东南大学第十八届选拔通知）。权重【推断】。",
      "scoring_points": [
        "商业模式成立，有真实运营数据或订单佐证",
        "团队执行力与股权、合规状况清晰",
        "推介陈述（路演）逻辑完整、市场分析扎实",
        "与“国创计划”创业训练/实践项目的过程对应真实"
      ],
      "common_deductions": [
        "项目数据造假、包装过度",
        "存在知识产权和投资股权纠纷",
        "推介与项目实际进展严重不符"
      ]
    },
    {
      "dimension": "学术规范与真实性（一票否决类）",
      "weight": "定性（校方须严格把关，弄虚作假实行一票否决）",
      "official_wording": "各校通知要求：\"学校需对申报论文严格把关，做好查重查新工作，确保无抄袭\"；\"指导教师需严格审核，避免学术不端、弄虚作假、知识产权和投资股权纠纷等问题\"。",
      "scoring_points": [
        "查重查新合格",
        "成果归属清晰、无纠纷",
        "指导教师与学校两级审核签字齐全"
      ],
      "common_deductions": [
        "学术不端、代写代做",
        "重复使用已参加过其他年会/赛事的成果未作说明"
      ]
    },
    {
      "dimension": "现场交流表现（报告与答辩）",
      "weight": "约25%（推断）",
      "official_wording": "第十八届学术年会分会场由学生主持，每个报告15分钟：论文作者报告10分钟、参会代表讨论3分钟、专家点评2分钟（第十八届年会安排）。权重【推断】。",
      "scoring_points": [
        "10分钟报告重点突出、时间控制精准",
        "回答参会代表与专家提问有理有据",
        "展示材料（PPT/展板）制作专业"
      ],
      "common_deductions": [
        "严重超时被打断",
        "答辩回避问题、临场混乱"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "学术论文",
      "format": "学术论文全文（须出自国家级创新训练项目，优先推荐已公开发表并标明刊物信息）",
      "page_limit": "未明确（按当年通知附件格式）",
      "deadline_note": "每年年中由各校遴选推荐（第十八届：2025年7月校内遴选，11月在南京大学举办年会）"
    },
    {
      "item": "改革成果展示材料",
      "format": "展板（按统一规格）+实物作品现场演示",
      "page_limit": "未明确",
      "deadline_note": "年会现场展示交流，同期接受学生代表投票"
    },
    {
      "item": "创业推介材料",
      "format": "项目推介PPT/路演材料",
      "page_limit": "未明确",
      "deadline_note": "年会现场推介；优秀者（约12项）直接晋级下一年度中国国际大学生创新大赛"
    },
    {
      "item": "校级推荐名额材料",
      "format": "一般每校推荐优秀学术论文1—2篇、改革成果及创业推介项目1—3项，学术论文须来源于不同项目组",
      "page_limit": "未明确",
      "deadline_note": "按教育部高教司/国创计划秘书处当年通知"
    }
  ],
  "process_stages": [
    {
      "stage": "校级遴选",
      "format": "各高校按《全国大学生创新年会作品评审标准》组织校内评选并限额推荐",
      "notes": "需完成查重查新与指导教师、学校两级审核；第十八届共收到推荐项目1030项"
    },
    {
      "stage": "全国遴选（通讯评审）",
      "format": "国创计划秘书处组织专家评审，分别遴选学术论文约200篇、改革成果约250项、创业推介项目约60项",
      "notes": "第十八届（南京大学，2025年11月）遴选比例约为推荐数的1/3—1/5"
    },
    {
      "stage": "年会现场（展示交流）",
      "format": "创新论文交流（分会场报告15分钟：报告10+讨论3+专家点评2）、改革成果展示（展板+实物）、创业推介（路演）；学生代表投票选出\"我最喜爱的项目\"等",
      "notes": "由教育部高等教育司指导、\"国创计划\"秘书处与承办校联合主办；第十八届首次增设大学生创新主题圆桌对话"
    }
  ],
  "review_format": "校级按官方《作品评审标准》遴选+全国专家通讯评审遴选+年会现场报告/展示/路演交流，辅以学生代表投票。",
  "judge_preferences": [
    "成果必须真实源于国创计划项目过程，过程材料与结题成果对应完整",
    "优先已发表、有专利/软著/应用佐证的硬成果",
    "展示要\"看得懂、演示得了\"，反感PPT空谈",
    "创业项目重真实运营数据，晋级中国国际大学生创新大赛的项目需具备继续成长的潜力"
  ],
