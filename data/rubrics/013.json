      "deadline_note": "进入决赛（第十九届320支队伍，2026年8月在大连理工大学）后按要求提交"
    }
  ],
  "process_stages": [
    {
      "stage": "校内预赛（校赛）",
      "format": "各高校组织申报与评审，按名额择优推荐（湖南大学第十九届：申报截止2026-05-05，评审05-06至05-08）",
      "notes": "由教育部高等学校能源动力类专业教学指导委员会指导、竞赛委员会主办；主题'节能减排、绿色能源'"
    },
    {
      "stage": "全国初审（网评）",
      "format": "专家评审委员会按科学性、创新性、可行性、经济性指标网络初评",
      "notes": "第十九届共收到707所高校7773支队伍作品"
    },
    {
      "stage": "全国会评与决赛",
      "format": "会评择优进入决赛，决赛现场答辩（第十九届133所高校320支队伍进入决赛，2026年8月初于大连理工大学；设产业赛道与港澳台及'一带一路'国际赛道）",
      "notes": "历届奖励规模：特等奖10项、一等奖40项、二等奖99项（百度百科载某届数据，各届略有调整）"
    }
  ],
  "review_format": "专家评审委员会'初审+终审（会评）+决赛答辩'三级评审，按科学性、创新性、可行性、经济性四指标对科技类与社会实践类作品分别评价、择优授奖；官方未公布指标权重，为定性综合评价。",
  "judge_preferences": [
    "紧扣'节能减排、绿色能源'主题且效益可量化（折标煤/减碳数据）",
