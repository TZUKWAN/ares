{
  "competition_id": 13,
  "competition_name": "节能减排社会实践与科技竞赛",
  "judging_dimensions": [
    {
      "dimension": "创新性（新思想、新原理、新方法、新技术）",
      "weight": "定性评审（官方未公布权重；科技类作品通常此维度权重最高）",
      "official_wording": "作品形式包括实物制作（含模型）、软件、设计和社会实践调研报告等，要求体现新思想、新原理、新方法以及新技术（第十九届竞赛通知）；专家评审委员会根据作品的科学性、创新性、可行性和经济性等指标进行初审和终审（第十九届竞赛通知）",
      "scoring_points": [
        "节能减排核心原理或技术路线的原创性",
        "与现有产品/方案的差异化程度",
        "科技类：新原理、新装置、新工艺、新软件；社会实践类：调研视角与对策建议的新颖性",
        "知识产权布局（专利、软著等加分佐证）"
      ],
      "common_deductions": [
        "作品为已有技术的简单拼接",
        "创新点表述空泛、无法验证",
        "与'节能减排、绿色能源'主题关联牵强"
      ]
    },
    {
      "dimension": "科学性（技术原理与论证严谨性）",
      "weight": "定性评审（官方未公布权重）",
      "official_wording": "专家评审委员会根据作品的科学性、创新性、可行性和经济性等指标进行初审和终审，择优推荐获奖作品（第十九届竞赛通知）",
      "scoring_points": [
        "技术原理阐述正确、数据测算方法可信",
        "实验/仿真数据支撑充分（科技类）",
        "调研方法与样本的科学性（社会实践类：问卷设计、抽样、统计）",
        "引用文献与标准的规范性"
      ],
      "common_deductions": [
        "关键数据无来源或前后矛盾",
        "能效测算方法错误、单位不统一",
        "调研报告以主观描述代替数据论证"
      ]
    },
    {
      "dimension": "可行性（工程可实现性与应用推广）",
      "weight": "定性评审（官方未公布权重）",
      "official_wording": "根据作品的科学性、创新性、可行性和经济性等指标进行初审和终审（第十九届竞赛通知）",
      "scoring_points": [
        "技术方案在现有工程条件下的可实现程度",
        "实物制作（含模型）/软件/设计的完成度与演示效果",
        "推广应用的场景与路径清晰度",
        "社会实践类对策建议的可操作性"
      ],
      "common_deductions": [
        "方案停留在概念、无样机或演示支撑（科技类）",
        "成本与工艺可行性论证缺失",
        "调研结论与建议脱节"
      ]
    },
    {
      "dimension": "经济性（节能减排效益）",
      "weight": "定性评审（官方未公布权重）",
      "official_wording": "根据作品的科学性、创新性、可行性和经济性等指标进行初审和终审（第十九届竞赛通知）",
      "scoring_points": [
        "节能量/减排量的量化测算（折标准煤、碳减排当量等）",
        "投入产出与回收期分析",
        "规模化应用后的经济社会效益估算",
        "与国家双碳目标的呼应程度"
      ],
      "common_deductions": [
        "节能减排效益无量化数据、只有定性宣传",
        "测算口径夸大、经不起追问",
        "经济性分析缺失成本项"
      ]
    },
    {
      "dimension": "申报规范与完成度",
      "weight": "资格审查项（通过制+定性评价）",
      "official_wording": "作品必须是比赛当年完成的作品，须在规定时间内提交，逾期视为自动放弃；申报书文件命名格式：科技类申报书（社会实践类申报书）-作品名称-队长姓名（第十九届竞赛通知及各校校赛通知）",
      "scoring_points": [
        "申报书按科技类/社会实践类官方模板填写完整",
        "文件命名、汇总表符合规定格式",
        "作品为比赛当年完成",
        "决赛阶段答辩PPT准备充分"
      ],
      "common_deductions": [
        "命名不规范、材料缺项被形式审查剔除",
        "非当年完成的作品被取消资格",
        "逾期提交视为自动放弃"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "作品申报书（科技类/社会实践类）",
      "format": "官方模板Word/PDF电子版，压缩包以参赛作品名称命名",
      "page_limit": "按模板（未统一公开页数）",
      "deadline_note": "第十九届（2026）校内预赛申报普遍在4-5月截止（湖南大学截止2026-05-05）；全国初审前按组委会节点提交"
    },
    {
      "item": "作品本体",
      "format": "科技类：实物制作（含模型）、软件、设计；社会实践类：社会实践调研报告",
      "page_limit": "未明确",
      "deadline_note": "作品须为比赛当年完成"
    },
    {
      "item": "决赛答辩PPT",
