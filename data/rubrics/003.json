{
  "competition_id": 3,
  "competition_name": "“挑战杯”创业计划大赛",
  "judging_dimensions": [
    {
      "dimension": "实践过程",
      "weight": "推断：约20%",
      "official_wording": "全国评审要点（经吉林工商学院、中国社科大等校赛通知转述）：竞赛'在考察项目商业价值的基础上，重点考察项目的实践过程、创新性与时代意义、团队情况、社会价值等方面'。官方未公开量化权重，本维度权重为【推断：依据'重点考察'措辞及同类创业赛事（互联网+/创青春）权重模型推定】。",
      "scoring_points": [
        "项目有真实实践基础：已开展调研、试运营或注册运营",
        "实践痕迹可查（订单、运营记录、落地场景照片/视频）",
        "计划书中的设想与已完成的实践进度对应",
        "答辩时能出示实践证据"
      ],
      "common_deductions": [
        "纯纸面BP、无任何实践痕迹",
        "实践数据与计划书数字矛盾",
        "实践主体不是参赛学生"
      ]
    },
    {
      "dimension": "创新性与时代意义",
      "weight": "推断：约20%",
      "official_wording": "同上官方评审要点转述（'创新性与时代意义'并列表述）；量化权重为【推断：参照中国国际大学生创新大赛创意组创新性30%口径下调，因本赛事更重实践与商业】。",
      "scoring_points": [
        "产品/服务/技术/模式有明确创新点",
        "选题契合国家战略与时代命题（乡村振兴、双碳、数字经济、社会治理）",
        "创新性有专利/软著/查新等佐证"
      ],
      "common_deductions": [
        "创新点同质化、竞品对比缺失",
        "选题过时或与时代主题脱节",
        "创新描述与实际产品不符"
      ]
    },
    {
      "dimension": "商业价值（商业性/可行性）",
      "weight": "推断：约25%（'在考察商业价值的基础上'表明其为基座维度，权重应不低于其他维度）",
      "official_wording": "同上官方评审要点转述；参考章程性质条款：竞赛考察'基于广泛市场调研和企业分析完成完整商业计划'（西安交大等公布的评审参考稿：'项目立意需积极践行社会主义核心价值观，基于广泛市场调研和企业分析，完成完整商业计划'）。量化权重为【推断】。",
      "scoring_points": [
        "市场分析有一手调研与可信测算",
        "商业模式闭环、盈利路径清晰",
        "财务规划与融资方案合理",
        "已有营收/合同/用户数据者优先"
      ],
      "common_deductions": [
        "市场测算无依据、财务模型硬伤",
        "盈利模式讲不通",
        "BP模板化、数据陈旧"
      ]
    },
    {
      "dimension": "团队情况",
      "weight": "推断：约15%",
      "official_wording": "评审参考稿（西安交大公布）：'团队成员专业背景、创业意识、创业素质、价值观念须与项目需求相匹配；考察团队组织架构合理性'。量化权重为【推断：参照互联网+团队维度口径（20%-25%）按本赛事五维结构折减】。",
      "scoring_points": [
        "专业结构与项目需求匹配（技术+运营+市场互补）",
        "分工明确、指导教师支持得当",
        "团队稳定性与持续投入"
      ],
      "common_deductions": [
        "成员挂名、答辩答不上分工",
        "团队结构与项目领域无关",
        "核心成员临赛更换"
      ]
    },
    {
      "dimension": "社会价值",
      "weight": "推断：约20%",
      "official_wording": "同上官方评审要点转述；公益类项目条款（章程/通知）：'在公益服务领域具有较好的创意、产品或服务模式的创业计划和实践，追求社会效益的最大化'。量化权重为【推断】。",
      "scoring_points": [
        "就业带动、社会效益有量化数据",
        "服务乡村振兴/社区治理/生态文明等国家战略",
        "公益类项目社会效益最大化论证充分"
      ],
      "common_deductions": [
        "社会价值口号化、无量化和案例",
        "公益性与商业性自相矛盾"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "创业计划书",
      "format": "Word/PDF，按校赛/省赛系统提交",
      "page_limit": "未明确（通行做法3-5万字、含财务附表，以当届通知为准）",
      "deadline_note": "校赛报名约7-9月，省赛复赛8月底前后完成作品提交"
    },
    {
      "item": "项目展示PPT",
      "format": "PPT（网评版+决赛路演版）",
      "page_limit": "未明确（路演版常控制在15-25页对应10分钟陈述）",
      "deadline_note": "晋级全国终审决赛前完成报备"
    },
    {
      "item": "佐证材料",
      "format": "营业执照、专利证书、订单合同、运营数据等扫描件",
      "page_limit": "未明确",
      "deadline_note": "随计划书提交，决赛答辩备查"
    },
    {
      "item": "决赛路演",
      "format": "现场路演答辩：全国决赛常见10分钟=5分钟项目汇报+5分钟评委提问（校/省赛常见5+3）",
      "page_limit": "未明确",
      "deadline_note": "全国终审决赛阶段（第十四届：2024年10月底-11月初）"
    }
  ],
  "process_stages": [
    {
      "stage": "校赛",
      "format": "校内评审（网评+路演），按限额推荐省赛",
      "notes": "两年一届，与'大挑'交替举办（第十四届为2024年，第十五届2026年启动）"
    },
    {
      "stage": "省级复赛",
      "format": "省级网评+复赛评审，评出报送全国项目",
      "notes": "主体赛按主题分组（科技创新、乡村振兴、数字经济、文化创意、社会治理和公共服务、生态文明等）+专项赛（如秦创原专项赛）"
    },
    {
      "stage": "全国终审决赛",
      "format": "现场路演答辩终评",
      "notes": "第十四届2024年10月29日-11月2日在西安交通大学（兴庆校区）举行；412所国内高校+14所国际高校的839个项目进入全国决赛终评"
    },
    {
      "stage": "奖项评定与团体奖",
      "format": "决赛设金、银、铜奖，各约占进入决赛作品总数的10%、20%、70%（第八届章程）；金奖每件计100分、银奖70分、铜奖30分计入团体总分",
      "notes": "团体总分最高校获'挑战杯'，其后本科/高职前列获'优胜杯'"
    }
  ],
  "review_format": "校赛-省赛-全国终审决赛三级评审；全国决赛为现场路演答辩（约10分钟：5分钟展示+5分钟问辩），评审委员会按实践过程、创新性、商业价值、团队、社会价值综合打分",
  "judge_preferences": [
    "重实践真实性：有注册公司、真实订单营收的项目在决赛占优",
    "选题紧扣国家战略主题分组（乡村振兴、数字经济、生态文明等）",
    "知识产权与技术壁垒是硬科技组别加分项",
    "团队与项目匹配度、学生真实主导（评委常交叉追问成员分工细节）",
    "商业计划完整闭环：市场-产品-财务-风险一条线讲得通"
  ],
  "past_winning_patterns": [
    "硬科技金奖集中：如第十三届金奖'创智检强国芯'尖端光学智能检测系统、国赛金奖路演'昆虫雷达'迁飞虫害信息化监测（智慧农业方向）",
    "乡村振兴'科技+助农'类项目稳定产出金奖（省赛到国赛均有案例，如信息科技助力乡村改造项目获省级金奖）",
    "金奖项目普遍有真实运营数据支撑（营收、合同、用户量），呈现'实践过程完整'的证据链",
    "备赛模式规律化：校内外创新创业专家+一线创业者多轮辅导、多次模拟答辩、项目打磨会（清华、深大等获奖校通行做法）",
    "呈现形式：10分钟内完成'痛点-方案-实践进展-商业模型-社会价值'叙事，数据图表优先于文字",
    "获奖格局：强校（清华、华中科大、中科大等）金奖数量领先，第十四届839个决赛项目角逐金银铜"
  ],
  "forbidden_or_risky": [
    "项目非学生真实创业实践、过度包装代写",
    "组别资格问题：已注册公司需按章程规定计入相应组别/年限，虚报组别将被核查",
    "每名学生在同一届竞赛中原则上限报1个项目，多报将被取消资格",
    "抄袭他人商业计划或数据造假，评审问辩与材料核查中发现即取消评奖",
    "与互联网+/创青春等其他赛事交叉参赛时，作品需按本赛事评审规则重新修改完善，直接套用材料易因维度错位失分"
  ],
