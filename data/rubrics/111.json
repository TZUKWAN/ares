      "notes": "2024年起初赛为线上个人赛，参赛者需在约1小时内独立完成"
    },
    {
      "stage": "复赛",
      "format": "商业案例分析+小组展示",
      "notes": "分赛区组织，含案例写作、小组案例分析、现场演讲陈述；设赛区复赛专场（如北京赛区X致同专场）"
    },
    {
      "stage": "赛区决赛",
      "format": "团队案例分析+PPT制作+英文Presentation+雇主评委面试",
      "notes": "设北京、上海、广州、成都、沈阳、长沙等赛区；企业雇主担任评委"
    },
    {
      "stage": "全国总决赛",
      "format": "现场团队展示+评委问答",
      "notes": "历届于8月前后收官（第21届JHC全国总决赛2024年在广州收官）；决出团队冠亚季军与最佳个人表现奖"
    }
  ],
  "review_format": "线上测评客观评分与雇主评委现场打分相结合，决赛由企业雇主与ACCA代表组成评委团现场评审团队展示并提问。",
  "judge_preferences": [
    "商业英语表达流利、陈述有感染力（英文Presentation为官方固定形式）",
    "案例分析框架化并有一手/外部数据支撑，忌空谈理论",
    "职业化气质突出：简历、着装、礼仪、面试应答均按真实招聘标准衡量",
    "无领导小组讨论中展现领导力与协作力而非抢话",
    "方案贴合赞助企业真实业务情境，能赢得雇主评委认同"
  ],
  "past_winning_patterns": [
    "往届获奖队伍案例分析普遍运用SBL（战略商业领袖）等ACCA课程模型组织框架，并以外部行业数据支撑观点",
    "冠军团队英文展示流畅、分工均衡，PPT高度图表化",
    "获奖个人多在最佳个人表现奖评选中展现真实求职能力，赛后常获合作企业实习录用"
  ],
