{
  "competition_id": 111,
  "competition_name": "全国就业力大比拼",
  "judging_dimensions": [
    {
      "dimension": "商业案例分析维度",
      "weight": "约35%（推断：决赛核心环节为'团队案例分析+PPT制作+英文Presentation'，案例分析为评分主体）",
      "official_wording": "ACCA中文官网JHC2023：'JHC以团队案例分析+PPT制作+英文Presentation的形式进行比拼'；选手感想佐证案例分析需'运用SBL等模型、外部数据支撑观点'。官方未公开量化权重。【推断】按决赛环节构成估计案例分析占35%左右。",
      "scoring_points": [
        "对商业案例问题的诊断准确、抓住核心矛盾",
        "分析框架化：运用SBL等战略商业模型组织论证",
        "引用外部数据/行业资料支撑观点，结论可落地",
        "方案具有商业可行性与创新性"
      ],
      "common_deductions": [
        "案例分析停留在描述、无框架无数据",
        "方案与案例给定情境脱节、空谈理论",
        "直接套用往届案例答案或抄袭他人成果"
      ]
    },
    {
      "dimension": "展示陈述维度（英文Presentation与PPT）",
      "weight": "约25%（推断：英文Presentation为官方明示的比拼形式之一）",
      "official_wording": "ACCA官网明示形式含'PPT制作+英文Presentation'；湖北经济学院通知：'通过在线测评、小组案例分析、现场演讲陈述等多元化形式营造真实商业挑战氛围'。权重为【推断】。",
      "scoring_points": [
        "英文表达流利准确、商务语体得当",
        "陈述逻辑清晰：问题—分析—方案—结论闭环",
        "PPT专业美观、图表化表达、信息密度得当",
        "现场答问反应敏捷、经得起雇主评委追问"
      ],
      "common_deductions": [
        "照读稿件、与评委无眼神互动",
        "PPT堆砌文字、排版混乱",
        "英文表达不流畅导致超时或表意不清"
      ]
    },
    {
      "dimension": "职业素养与面试表现维度",
      "weight": "约25%（推断：赛制模拟企业标准招聘流程，含网申、在线测评、面试环节）",
      "official_wording": "湛江科技学院赛前培训：'赛制通过模拟企业标准招聘流程，从网申、笔试、商业案例分析、小组展示及雇主评委面试等多个环节锻炼和培养'。测评环节由北森提供。权重为【推断】。",
      "scoring_points": [
        "网申材料（简历/申请表）规范、职业化",
        "在线测评（北森）认知与职业性格通过度",
        "雇主评委面试中展现求职竞争力与职业潜质",
        "商务礼仪、职业着装与临场素质"
      ],
      "common_deductions": [
        "网申材料敷衍、简历硬伤多",
        "面试中答非所问、职业规划模糊",
        "测评或笔试环节未达到晋级线"
      ]
    },
    {
      "dimension": "团队协作维度",
      "weight": "约15%（推断：区域赛与总决赛均为团队赛，含无领导小组面试形式）",
      "official_wording": "广州南方学院会计学院校内赛报道提及'无领导小组面试'环节；区域赛/全国总决赛以团队为单位进行案例分析。权重为【推断】。",
      "scoring_points": [
        "无领导小组讨论中角色定位清晰、贡献均衡",
        "团队分工与展示衔接顺畅",
        "成员间观点互补、冲突处理成熟"
      ],
      "common_deductions": [
        "个别成员全程零贡献（搭车痕迹明显）",
        "讨论中互相争执、无共识产出",
        "展示环节分工失衡、水平差距过大"
      ]
    }
  ],
