{
  "competition_id": 109,
  "competition_name": "湖北省青年志愿服务项目大赛",
  "judging_dimensions": [
    {
      "dimension": "项目社会价值",
      "weight": "决赛展示与答辩五维度之一（定性综合评议，权重未公开）【推断：五维并列综合评议】",
      "official_wording": "团省委官方公众号'青春湖北'报道（第七届，2024）原文：'决赛中，各团队围绕项目社会价值、运营保障、组织治理、公益创业模式、社会影响等方面进行项目展示与答辩'。",
      "scoring_points": [
        "项目回应的社会需求真实、迫切（如基层纠纷调解、关爱孤独症儿童、留守儿童美育等）",
        "受益对象明确、受益面与受益程度可量化",
        "与国家战略和地方中心工作契合（湖北'共同缔造'、基层治理、乡村振兴）",
        "志愿育人价值与青年成长贡献"
      ],
      "common_deductions": [
        "需求论证空泛、受益对象模糊",
        "社会价值表述与实际服务内容脱节",
        "数据缺失或夸大（服务人次、时长无佐证）"
      ]
    },
    {
      "dimension": "运营保障与组织治理",
      "weight": "决赛展示与答辩五维度之一（定性综合评议，权重未公开）【推断：与上并列】",
      "official_wording": "团省委官方报道原文同上（'运营保障、组织治理'列为评审方面）；湖北大学获奖项目介绍中对应要素：'专业志愿队伍'（以法学院硕士研究生为主）、'四方联动机制'（派出所、志愿者、社区、司法所同址办公）、'1+3'工作机制。",
      "scoring_points": [
        "团队构成：核心成员稳定、专业结构合理（依托学科专业优势的队伍更具说服力）",
        "管理制度：志愿者招募培训、激励保障、安全管理规范",
        "资源保障：经费、阵地、合作单位支持可持续",
        "组织架构与多方联动机制清晰（校地、校企、警校等共建模式）",
        "项目运行时间长、常态化开展（非一次性活动）"
      ],
      "common_deductions": [
        "团队临时拼凑、无稳定志愿者队伍",
        "经费与保障来源不明",
        "项目运行时间短、材料难以证明常态化",
        "治理结构混乱、汇报与制度文件矛盾"
      ]
    },
    {
      "dimension": "公益创业模式（公益创业赛方向核心维度）",
      "weight": "决赛展示与答辩五维度之一（定性综合评议，权重未公开）【推断：公益创业方向项目须重点陈述可持续模式，与上并列】",
      "official_wording": "团省委官方报道原文将'公益创业模式'列为决赛评审答辩的五个方面之一；大赛体系对应中国青年志愿服务公益创业赛（省赛获奖项目'全力备战第七届中国青年志愿服务项目大赛'，长江大学新闻）。",
      "scoring_points": [
        "模式创新：工作机制/服务方法有原创性（如'三步解纷法'、'订单式'微宣讲）",
        "可持续性：资源自我造血、政校企协同、可复制推广（湖北大学项目经验被12所高校借鉴）",
        "成果转化：调研报告、论文、专著、课程化产品（红色书信主题思政课）",
        "成本效益：单位投入产出的服务效能"
      ],
      "common_deductions": [
        "模式表述为常规活动堆砌、无机制创新",
        "可持续性论证薄弱、依赖单一资助",
        "成果仅有活动清单、无制度性/知识性产出"
      ]
    },
    {
      "dimension": "社会影响与服务成效",
      "weight": "决赛展示与答辩五维度之一（'社会影响'，定性综合评议，权重未公开），书面评审侧重服务成效【推断：金银铜奖综合书面评审与决赛答辩评定】",
      "official_wording": "团省委官方报道原文：'经过激烈角逐……35个项目获得金奖……58个项目获得银奖……92个项目获得铜奖'且铜奖'通过前期书面评审'产生；获奖项目材料展示成效表述（湖北大学法学院新闻）：'共受理495起案件，成功化解424起''调解成功率超85%''志愿服务时长8932小时''获人民日报、中国青年网、法治网等媒体报道60余次'。",
      "scoring_points": [
        "服务量化成效：案件数、化解率、受益人数、志愿时长等硬数据",
        "第三方认可：服务对象与政府部门评价、批示、奖项",
        "媒体传播：中央/省市媒体报道、社会关注度",
        "品牌影响力：经验推广范围、入选案例库/项目库"
      ],
      "common_deductions": [
        "成效数据无出处、逻辑不自洽",
        "仅罗列活动照片无量化成效",
        "媒体报道为自媒体报道、权威性不足"
      ]
    }
  ],
