{
  "competition_id": 6,
  "competition_name": "全国大学生电子设计竞赛",
  "judging_dimensions": [
    {
      "dimension": "设计总结报告",
      "weight": "分数构成：设计报告20分/题（单题满分120分中，历届试题评分标准表官方口径）",
      "official_wording": "历届试题'评分标准'表：'设计报告'20分，内容含系统方案比较与论证、理论分析与计算、电路图及有关设计文件、测试方案与测试仪器、测试数据及结果分析、报告结构及规范性（本科组与高职高专组均为20分，2011年官方分析材料及2015/2021年试题评分表一致）。",
      "scoring_points": [
        "系统方案论证：多种方案对比并有选型理由",
        "理论分析与计算完整（关键参数推导、器件选型计算）",
        "电路图、程序流程图规范齐全",
        "测试方案、仪器型号、原始数据完整",
        "测试结果分析与误差讨论"
      ],
      "common_deductions": [
        "测试数据缺失或与实测不符",
        "方案无对比论证、直接给结论",
        "报告结构混乱、电路图不完整",
        "数据处理造假痕迹（数据过于理想）"
      ]
    },
    {
      "dimension": "基本要求完成情况",
      "weight": "分数构成：基本要求50分/题（单题满分120分中；按题目列出的各项基本要求逐项实测计分）",
      "official_wording": "历届试题评分标准表：'基本要求'合计50分，逐项对应实测功能与指标（如2021年F题智能送药小车、2015年多旋翼自主飞行器等各题均按此结构）。",
      "scoring_points": [
        "每项基本功能均能现场实测演示",
        "指标实测达到题目规定精度/范围",
        "系统运行稳定、可重复测试",
        "基础功能优先级最高：先保基本再冲发挥"
      ],
      "common_deductions": [
        "某项基本要求无法演示，该项计零分",
        "指标实测不达标按比例扣分",
        "现场运行不稳定/复测失败"
      ]
    },
    {
      "dimension": "发挥部分完成情况",
      "weight": "分数构成：发挥部分50分/题（单题满分120分中；逐项实测计分，通常在基本要求全部完成基础上计分）",
      "official_wording": "历届试题评分标准表：'发挥部分'合计50分，逐项标明分值（如完成第(1)项15分、第(2)项25分等）；试题通常注明发挥部分计分条件（须先完成基本要求）。",
      "scoring_points": [
        "高价值发挥项优先实现（分值权重不同的项先做大分项）",
        "扩展功能的精度与稳定性",
        "发挥项与基本项联动的系统鲁棒性",
        "发挥部分是拉开档次、冲击全国奖的关键区分度"
      ],
      "common_deductions": [
        "贪多求全导致基本项不稳，反而失分",
        "发挥项演示不稳定无法复测",
        "未完成基本要求时发挥部分不予计分"
      ]
    },
    {
      "dimension": "现场实测与综合测评",
      "weight": "通过制+实测打分：赛区测评与全国综合测评均以现场实测为准，测试题目与评分标准由全国专家组统一制定；部分赛题允许测试两次、取综合成绩高的一次",
      "official_wording": "竞赛组织文件：'综合测评是竞赛评审工作的重要组成部分，旨在检验参赛队的综合能力和创新水平，是对竞赛作品的指标和功能进行测评，测试题目与评分标准由全国专家组统一制定'（浙江万里学院等转发全国组委会文件）；'可以测试两次，取综合成绩高的一次'（2025年试题及测评规则）。",
      "scoring_points": [
        "作品封存完好、测评现场可立即运行",
        "按要求完成指定测试项目，实测数据当场记录",
        "两次测试机会下的策略选择",
        "队员现场答辩与操作配合"
      ],
      "common_deductions": [
        "封存期间拆改作品、失去测评资格",
        "现场无法上电/复现赛前成绩",
        "超时未到测评、弃测"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "设计总结报告",
      "format": "纸质+电子版，按全国组委会统一模板（方案论证、理论分析、电路图、测试数据、结果分析）",
      "page_limit": "未明确（历届通行做法为20页以内，以当届通知为准）",
      "deadline_note": "4天3夜赛期内完成，竞赛结束时随作品一并提交/封存"
    },
    {
      "item": "实物作品",
      "format": "现场制作的电子系统实物，竞赛结束封存，测评时运行演示",
      "page_limit": "未明确",
      "deadline_note": "全国竞赛逢单数年8月举行，赛期四天三夜；赛区测评与全国综合测评在赛后数周内进行"
    },
    {
      "item": "测试记录与佐证",
      "format": "测试现场记录表、仪器读数照片等",
      "page_limit": "未明确",
      "deadline_note": "测评环节由评测专家现场填写"
    }
  ],
  "process_stages": [
    {
      "stage": "校内培训与选拔",
      "format": "校级集训、模拟赛，按赛区名额组队报名",
      "notes": "每队3名全日制在校生，须统一时间全程参赛；含本科生即只能选本科组题目"
    },
    {
      "stage": "省级竞赛（TI杯，双数年）",
      "format": "与全国赛交替：双数年为省级大学生电子设计竞赛（TI杯），单数年为全国竞赛",
      "notes": "省赛成绩作为国赛练兵与部分赛区推荐依据"
    },
    {
      "stage": "全国竞赛（单数年8月）",
      "format": "四天三夜半开放现场制作：从全国专家组统一命题（电源类、信号源类、放大器类、仪器仪表类、数据采集与处理类、控制类等）中选一题",
      "notes": "分本科组/高职高专组两套题目；2025年H题'野生动物巡查系统'等体现控制+AI感知趋势"
    },
    {
      "stage": "赛区测评",
      "format": "各赛区组织专家按试题评分标准（报告20+基本50+发挥50，满分120分）实测评分",
      "notes": "评出赛区各等奖并按名额推荐全国评审"
    },
    {
      "stage": "全国综合测评与评奖",
      "format": "全国专家组对推荐作品统一综合测评（部分赛题测两次取高），评出全国一、二等奖",
      "notes": "全国奖比例由全国组委会按当年参赛规模确定，一等奖比例低（强校竞争激烈）"
    }
  ],
  "review_format": "实物现场实测+设计报告评分（每题报告20分+基本要求50分+发挥部分50分，满分120分）；综合测评由全国专家组统一制定测试题目与评分标准，以实测数据定奖",
  "judge_preferences": [
    "指标实测说话：精度、稳定性、响应时间等硬指标逐项对照题目评分表",
    "先保基本要求全完成，再冲发挥部分——基本不稳的高分方案反而吃亏",
    "报告与实测一致：测试数据必须可复现，宁可靠略低但真实",
    "方案论证与理论计算体现设计功力，是报告20分的关键得分点",
    "现场演示稳定性和队员操作熟练度直接影响测评印象"
  ],
  "past_winning_patterns": [
    "全国一等奖长期被传统强校垄断：电子科技大学、西安电子科技大学、哈工大、北理工、武大、桂电等",
    "题类轮换规律：电源/信号源/放大器/仪器仪表/数据采集/控制类（小车、飞行器、无人机）交替出现，控制类近年融入视觉与AI感知（2025 H题野生动物巡查系统：禁飞区、航线规划、动物识别）",
    "高分作品共性：基本要求全完成+发挥部分完成大部分+报告测试数据完整规范，即'120分制下110分区间'的完整性策略",
    "备赛体系化：获奖强校均有常年集训队、模块化硬件库（电机驱动、传感、电源模块）与历年真题复现训练",
    "呈现形式：四天三夜交付即实物+报告，无路演环节，全国综合测评现场实测定奖",
    "队伍分工规律：硬件、软件（嵌入式）、机械/结构+报告三位一体，跨界协作能力强的队伍更稳"
  ],
  "forbidden_or_risky": [
    "竞赛期间使用他人代制成果、校外人员协助属违纪；作品须学生现场制作",
    "封存后擅自拆改作品将取消测评资格",
    "部分题目对成品模块/成品小车等外购件使用有限制，违者扣分或无效",
    "报告数据与实测不符（编造测试数据）一经发现取消成绩",
    "题目组别选错（队内有本科生却选高职高专组）成绩无效；开赛后不得更改选题"
  ],
