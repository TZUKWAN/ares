      "format": "现场限时制作；材料由主办方统一提供并限定（第五届：纸、砂子、模型箱；第六届：橡胶颗粒（模拟软土）、细砂、A3纸、胶带、模型箱）",
      "page_limit": "不限（须满足题目规定尺寸与构造）",
      "deadline_note": "决赛当场比赛限时内（第五届120分钟含填埋；第六届制作限时90分钟）"
    },
    {
      "item": "决赛设计报告/方案讲解材料",
      "format": "按当届手册要求提交，供评审组综合打分",
      "page_limit": "未明确",
      "deadline_note": "决赛现场测试前"
    }
  ],
  "process_stages": [
    {
      "stage": "发布通知与报名",
      "format": "当届承办高校发布题目和规则，高校组织校内选拔",
      "notes": "每届一个工程主题：第二届（2017，河海大学）桩基础模型；第四届（2021）\"支撑条件下的基坑开挖\"；第五届（2023，\"中铁一局杯\"）抗拔桩制作；第六届（2025，\"兆弟杯\"，浙江大学承办、兆弟控股集团冠名）复合地基设计建造"
    },
    {
      "stage": "初赛（设计报告评审/校内选拔）",
      "format": "提交设计计算报告，组织方评审遴选决赛队伍",
      "notes": "第五届邀请通过土木工程学科专业认证的高校，初赛选拔出40支队伍进决赛；第六届42所高校参赛"
    },
    {
      "stage": "决赛：模型设计＋限时制作＋验收",
      "format": "现场实操，主办方提供统一材料",
      "notes": "决赛为期约3天（2025年7月3-5日浙大紫金港；第五届2023年10月29日武汉光谷科技会展中心）；制作完成后申请完工验收，不合格须整改后重新申请"
    },
    {
      "stage": "决赛：加载测试",
      "format": "评审小组监督下由参赛者自行加载",
      "notes": "第五届：逐级加砝码（每级0.1kg、级间静置30s）至破坏（加载端位移超3mm认定破坏），记录砝码数量；第六届：复合地基多级加载测沉降"
    },
    {
      "stage": "评奖",
      "format": "综合设计报告、测试性能、材料用量、制作时长等要素评定等级奖与专项奖",
      "notes": "第五届评出一等奖2、二等奖5、三等奖10；第六届评出一等奖3（上交、华南理工、浙大）、二等奖5、三等奖11，另设最佳创意奖、最佳组织奖"
    }
  ],
  "review_format": "中国土木工程学会土力学及岩土工程分会主办的单赛题实践竞赛：初赛设计报告评审遴选队伍，决赛现场限时制作实体模型并在评审组监督下加载测试，按设计报告、实测性能（承载力/沉降）、材料用量与制作时长综合计分评奖",
  "judge_preferences": [
    "力学机理正确、用最少材料实现最优承载性能（材料效率是核心得分逻辑）",
    "设计报告须能解释模型实测表现，理论与动手相互印证",
    "重视赛前试验迭代（获奖队伍普遍经多次模型制作与加载练习、辅以数值模拟比较方案）",
    "违规与工艺缺陷零容忍：超限材料、超时、验收不合格直接损失得分",
    "专业认证高校受邀参赛的邀请制传统（第五、六届规模约40-42支队伍）"
  ],
  "past_winning_patterns": [
    "一等奖队伍（如第六届上交、华南理工、浙大）在承载力/沉降实测与材料效率两项硬指标上同时领先，且报告论证完整（据官方成绩与计分规则推断）",
    "赛前系统性试错：对多种构造方案进行加载试验与有限元比较后择优（浙大第五届备战报道明确记载该路径）"
  ],
