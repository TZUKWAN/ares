{
  "competition_id": 121,
  "competition_name": "全国大学生岩土工程竞赛",
  "judging_dimensions": [
    {
      "dimension": "设计报告（岩土机理分析与方案设计）",
      "weight": "定性评分要素之一（第六届官方报道明确\"综合设计报告、地基沉降、材料用量与制作时长等要素打分\"；分值比例未公开）",
      "official_wording": "浙江大学滨海和城市岩土工程研究中心官网（承办方，2025-07-14）：\"综合设计报告、地基沉降、材料用量与制作时长等要素打分\"；河海大学2017年第二届官方报道（检索快照摘要）：\"评委会根据模型设计报告评分\"。",
      "scoring_points": [
        "对赛题岩土工程问题（复合地基、抗拔桩、基坑支护等）的机理分析正确",
        "方案设计有计算依据（如初赛阶段使用有限元软件比较多种方案）",
        "设计报告与实体模型一致、能解释加载测试结果",
        "符合工程基本概念与创新性统一"
      ],
      "common_deductions": [
        "报告与模型实测性能脱节、事后包装",
        "机理概念性错误",
        "缺少计算依据与方案比较"
      ]
    },
    {
      "dimension": "模型制作（限时实操）",
      "weight": "以现场限时完成情况计分（第五届120分钟含填埋、超时将被扣分；第六届模型制作限时90分钟；分数构成未公开）",
      "official_wording": "浙江大学建工学院官网（2023-11-06）：\"自开赛指令下达开始计时，参赛者须在120分钟时间内完成结构模型制作和填埋工作，超过120分钟将被扣分\"；第六届报道：\"模型制作限时90分钟\"。",
      "scoring_points": [
        "在限时内完成模型制作（及填埋）工序",
        "满足题目规定尺寸与构造要求",
        "工序组织与团队协作效率",
        "通过评审小组完工验收（不合格须改正后重新申请验收）"
      ],
      "common_deductions": [
        "超时扣分",
        "尺寸或构造不满足题目要求",
        "完工验收不合格反复整改耗时"
      ]
    },
    {
      "dimension": "加载测试性能（承载能力/沉降控制）",
      "weight": "以现场实测结果客观计分（第五届记录极限抗拔荷载，加载端位移超过3mm即认定破坏；第六届进行多级加载沉降测试；为决定性计分项）",
      "official_wording": "浙江大学建工学院官网（2023-11-06）：\"比赛的正式加载采用加砝码的方式逐级进行，每级增量0.1kg，两级之间静置时间间隔为30s。直至抗拔桩拔出破坏（如果在加载过程中的任何时刻，加载端位移超过3mm时，即认定为桩体破坏），记录加载的砝码数量\"；\"以22g的桩身总重，取得了6.2kg的抗拔承载力\"。",
      "scoring_points": [
        "极限承载力/抗拔能力（第五届：破坏前累计砝码重量）",
        "沉降控制水平（第六届复合地基：多级加载下的沉降量）",
        "材料效率（用更少材料实现更高承载，如桩身自重与承载力之比）",
        "破坏模式的合理性（非脆性突发破坏）"
      ],
      "common_deductions": [
        "加载中提前破坏（位移超限/拔出）",
        "施工缺陷导致承载力远低于设计预期",
        "未按规程加载或干扰测试"
      ]
    },
    {
      "dimension": "材料用量（经济性指标）",
      "weight": "定性评分要素之一（第五届官方表述\"综合材料用量与抗拔能力计分，以得分高者获胜\"；分值比例未公开）",
      "official_wording": "浙江大学建工学院官网（2023-11-06）：\"要求参赛学生用主办方提供的纸、砂子和模型箱等建造满足所要求尺寸大小的抗拔桩，综合材料用量与抗拔能力计分，以得分高者获胜\"。",
      "scoring_points": [
        "在满足承载要求下最少化材料用量",
        "材料（纸、砂、橡胶颗粒、A3纸、胶带等主办方限定材料）的创造性与合理利用",
        "不使用限定清单外的材料"
      ],
      "common_deductions": [
        "使用非限定材料",
        "材料浪费、以堆料换承载力"
      ]
    },
    {
      "dimension": "专项奖维度（创意与组织）",
      "weight": "定性（在等级奖之外设最佳创意奖、最佳组织奖等专项奖，独立评定）",
      "official_wording": "第六届获奖名单（浙江大学滨海和城市岩土工程研究中心官网）：一等奖3队（上海交通大学、华南理工大学、浙江大学）、二等奖5队、三等奖11队，\"最佳创意奖：郑州大学；最佳组织奖：北京科技大学\"。",
      "scoring_points": [
        "方案或构造的独特创意（最佳创意奖）",
        "赛前组织、训练与参赛纪律（最佳组织奖，通常面向学校）"
      ],
      "common_deductions": [
        "创意脱离力学原理、为博眼球而设计",
        "组织涣散、违反赛场纪律"
      ]
    },
    {
      "dimension": "参赛资格与初赛选拔合规",
      "weight": "定性（通过制：经初赛选拔方可进入决赛；第五届仅邀请通过土木工程学科专业认证的高校参赛）",
      "official_wording": "浙江大学建工学院官网（2023-11-06）：\"本次大赛共邀请浙江大学、上海交通大学、武汉大学等经过土木工程学科专业认证的高校参赛，经过初赛选拔，共有40支队伍进行决赛\"；第六届共42所高校队伍参赛。",
      "scoring_points": [
        "所在高校获邀请/通过专业认证（或按当年通知的开放范围报名）",
        "初赛（校内选拔+设计报告评审）排名进入决赛名额",
        "按期通过email返回报名表（第六届要求2025年4月15日前）"
      ],
      "common_deductions": [
        "初赛设计报告未按时提交",
        "报名信息不实",
        "决赛队伍成员与报名不符"
      ]
    }
  ],
