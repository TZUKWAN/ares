{
  "competition_id": 47,
  "competition_name": "先进成图技术与产品信息建模大赛",
  "judging_dimensions": [
    {
      "dimension": "先进成图技术赛道个人成绩（尺规绘图＋产品信息建模及工程图绘制）",
      "weight": "团体分的主体：机械类67%、建筑类65%、道桥类75%、水利/环艺类90%、电子类95%（取队内个人成绩前5名选手总分按比例计入团体分，官方原文）",
      "official_wording": "第十九届第一轮通知：“团体总分计算办法：1.机械类：团体分=(先进成图技术赛道个人成绩前5名选手总分)×67%+……2.建筑类：……×65%……4.水利类：……×90%……5.电子类：……×95%”；第十三届决赛通知：“机械类、建筑类团体总分=5人尺规绘图总分+5人产品信息建模及工程图绘制总分+3D打印或建筑图纸输出比赛得分（注：尺规绘图和产品信息建模及工程图绘制占比为90%，3D打印或建筑图纸输出占比为10%）”",
      "scoring_points": [
        "尺规绘图：投影正确、视图表达方案合理、尺寸标注规范、图面质量与图线粗细层次",
        "产品信息建模：三维模型几何准确性、特征与结构完整性、装配关系正确",
        "工程图绘制（由模型自动生成）：工程图规范、表达方法、明细栏与技术要求",
        "成图速度与限时完成度（现场集中、封闭式竞赛）",
        "使用大赛指定平台（第十九届各专业成图赛道采用卡伦特平台，官网发布操作手册）"
      ],
      "common_deductions": [
        "投影错误、漏标错标尺寸、线型不规范逐处扣分",
        "建模尺寸偏差、特征缺失、模型不完整",
        "超时未交卷或文件命名/提交格式错误",
        "使用非指定软件或违规插件"
      ]
    },
    {
      "dimension": "增材制造/BIM/轻量化与AI/数字化创新设计等开放赛道作品成绩",
      "weight": "团体分次要部分：机械类增材制造10%＋轻量化13%＋数字化创新10%；建筑类BIM15%＋智能结构15%＋全过程咨询5%；道桥类两赛道15%/10%；水利/电子/环艺类10%或5%（官方原文）",
      "official_wording": "第十九届第一轮通知：“其他各赛道为开放式竞赛。参赛队伍按规定提交作品后，经初评入围（入围比例另行通知）的队伍需参加线上答辩终评”；团体分公式中各赛道“本队最佳成绩”按上述百分比计入",
      "scoring_points": [
        "作品设计质量与创新性（轻量化率、结构优化效果、BIM应用深度等赛项指标）",
        "工艺可行性：3D打印件打印质量与后处理、桥梁/BIM模型工程合理性",
        "作品文档与成果完整性",
        "线上答辩终评表现（入围后）"
      ],
      "common_deductions": [
        "作品与赛题任务书要求不符",
        "初评未入围直接失去终评资格",
        "模型/打印件存在明显工艺缺陷",
        "答辩缺席或作品抄袭"
      ]
    },
    {
      "dimension": "团体组织完整性与合规",
      "weight": "资格性要求，不计分数（不满足不计团体成绩）",
      "official_wording": "第十九届第一轮通知：“机械类：至少5人参加‘先进成图技术’赛道；同时，须在‘增材制造’、‘轻量化设计与AI应用’、‘数字化创新设计’三个赛道各派出至少1组（每组2人）参赛”；“每所高校在同一专业类别限报1支队伍，每队限报选手20人、领队1人、指导教师1-8人”；“校赛参赛学生总人数，应不低于其该类别省赛报名人数的10倍”",
      "scoring_points": [
        "满足团体赛最低参赛要求（各赛道组数）",
        "校赛备案材料齐全并经教务部门盖章",
        "经省赛获得晋级资格后方可参加国赛",
        "团体奖证书署名规则（指导教师≤5人，选手机械/建筑≤11人、道桥≤9人、水利/电子/环艺≤7人）"
      ],
      "common_deductions": [
        "缺赛道组队，团体成绩无效",
        "校赛信息未备案核查",
        "跨校组队、选手资格不符"
      ]
    },
    {
      "dimension": "赛场纪律与诚信",
      "weight": "否决性条件，不计分数（作弊取消成绩并通报）",
      "official_wording": "大赛官网设“学术纠察/仲裁委”栏目，曾发布《仲裁委关于对作弊选手的处理决定》；竞赛为“现场集中、封闭式竞赛”",
      "scoring_points": [
        "封闭竞赛独立完成、不交流不传递资料",
        "遵守设备与软件使用规定",
        "服从阅卷与仲裁流程"
      ],
      "common_deductions": [
        "作弊被仲裁委处理并公开通报",
        "替考、跨校代赛",
        "干扰他队或赛场秩序"
      ]
    }
  ],
