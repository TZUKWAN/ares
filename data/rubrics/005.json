{
  "competition_id": 5,
  "competition_name": "全国大学生数学建模竞赛",
  "judging_dimensions": [
    {
      "dimension": "假设的合理性",
      "weight": "定性（官方评阅四原则之一，未量化分值）",
      "official_wording": "全国组委会及评阅专家解读：竞赛评阅依据四条原则——'假设的合理性、建模的创造性、结果的正确性、表述的清晰程度'（官方评阅要点口径，经2023年高教社杯国赛评阅解读与多所赛区文件交叉验证）。",
      "scoring_points": [
        "建模前提假设明确列出且与题设条件自洽",
        "每条假设有理由、能追溯到对问题的影响",
        "假设强弱与模型精度权衡得当",
        "敏感性讨论覆盖关键假设"
      ],
      "common_deductions": [
        "假设缺失或与题目条件矛盾",
        "关键假设无任何论证直接套用",
        "为凑出好结果而'偷'假设"
      ]
    },
    {
      "dimension": "建模的创造性",
      "weight": "定性（官方强调'从问题出发，拒绝套路化'，未量化）",
      "official_wording": "官方评阅精神：评阅强调'从问题出发，拒绝套路化'；创造性体现在针对具体问题的建模创新而非模板套用（评阅要点解读，163.com等权威转载）。",
      "scoring_points": [
        "模型针对题意量身构建，而非套模板",
        "对经典方法有改进/融合/适配论证",
        "算法求解思路清晰（含自编算法或合理调用工具）",
        "模型有推广价值与延展讨论"
      ],
      "common_deductions": [
        "千篇一律的'启发式算法+机器学习'堆砌",
        "模型与问题脱节、为炫技而建模",
        "直接照搬往年优秀论文框架"
      ]
    },
    {
      "dimension": "结果的正确性（合理性）",
      "weight": "定性（官方评阅四原则之一，未量化）",
      "official_wording": "官方评阅四原则之三：'结果的正确性'（部分赛区表述为'结果的合理性'，因开放题无唯一标准答案，重视结果的可信度与检验）。",
      "scoring_points": [
        "数值结果可信、量纲与常识一致",
        "有模型检验（误差分析、灵敏度分析、稳定性讨论）",
        "多方法交叉验证结果",
        "回答了题目要求的全部子问题"
      ],
      "common_deductions": [
        "结果明显违背常识却不加讨论",
        "只报数字无检验过程",
        "遗漏子问题或结果前后矛盾"
      ]
    },
    {
      "dimension": "表述的清晰程度",
      "weight": "定性（官方评阅四原则之一，未量化）",
      "official_wording": "官方评阅四原则之四：'表述的清晰程度'；论文结构规范（摘要、问题重述与分析、模型假设、模型建立与求解、结果分析与检验、模型评价、参考文献、附录）。",
      "scoring_points": [
        "图表规范、有编号与自明性标题",
        "公式与符号定义清楚、推导可跟随",
        "逻辑主线连贯：问题→假设→模型→求解→检验→结论",
        "行文精炼、无大段无关材料"
      ],
      "common_deductions": [
        "图表粗糙、无坐标轴单位或直接贴代码截图",
        "符号混乱、附录塞满无效代码",
        "正文冗长掩盖核心思路"
      ]
    },
    {
      "dimension": "摘要质量",
      "weight": "定性：评阅专家先读摘要，摘要在很大程度上决定论文能否进入详细评阅环节（官方要求摘要不超过1页）",
      "official_wording": "官方论文格式规范：'摘要和关键词写在正文首页，摘要不能超过一页，应包含问题、方法、数值结果、结论等关键内容'；评阅解读：摘要基本决定第一轮筛选命运。",
      "scoring_points": [
        "一页内完整覆盖：问题-方法-主要数值结果-结论",
        "给出关键量化结果（非空泛描述）",
        "突出建模创新点",
        "关键词准确"
      ],
      "common_deductions": [
        "摘要写成目录/流水账、无量化结果",
        "超一页",
        "创新点与正文不符"
      ]
    },
    {
      "dimension": "规范与诚信（格式/AI声明/查重）",
      "weight": "通过制：违反格式规范或相似度过高/AI使用违规将影响评阅直至取消成绩",
      "official_wording": "官方《赛区评阅工作规范（2019年修订稿）》与《报名和参赛须知》：论文第一页为承诺书、第二页为编号专用页、纸质版左侧装订且不得出现身份信息；2024年起要求在论文中如实说明AI工具使用情况（组委会发布《人工智能工具使用规定（2025年试行）》）；官网设有《关于参赛论文相似度查证的原则》（知网查重+自建库）。",
      "scoring_points": [
        "承诺书、编号页、摘要页顺序与格式符合规范",
        "正文无姓名、学校等身份信息",
        "AI工具使用情况如实声明且使用符合规定",
        "提交PDF/Word电子版并按时提交支撑材料"
      ],
      "common_deductions": [
        "论文相似度高被通报（官网2025年即发布部分论文相似度较高通报，情节严重取消评奖资格）",
        "AI使用不声明或违规使用，可能被取消评奖资格",
        "正文中暴露身份信息、页眉违规",
        "逾期提交或缺少支撑材料"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "参赛论文",
      "format": "PDF或Word电子版（建议非图片PDF，不压缩）；纸质版从左侧装订",
      "page_limit": "摘要不超过1页；正文页数未明确（无官方正文页数上限，但规范要求精炼）",
      "deadline_note": "每年9月中旬竞赛（连续3天约72小时）结束后按赛区规定时限提交"
    },
    {
      "item": "支撑材料（源代码/数据）",
      "format": "代码、数据文件打包提交",
      "page_limit": "未明确",
      "deadline_note": "与论文同期提交，供评阅复核"
    },
    {
      "item": "AI工具使用情况说明",
      "format": "论文内如实说明（2024年起新增，2025年试行规定细化）",
      "page_limit": "未明确",
      "deadline_note": "随论文提交"
    }
  ],
  "process_stages": [
    {
      "stage": "报名与组队",
      "format": "以高校为单位统一报名，每队3名在校生（分本科组/专科组）",
      "notes": "每年8月截止报名；竞赛于9月第二个周末前后举行，连续3天（约72小时）"
    },
    {
      "stage": "竞赛（72小时）",
      "format": "开卷、可查阅资料，从A/B/C/D/E题（本科组A/B/C，专科组D/E）中选一题完成",
      "notes": "2024年起题目增加AI工具使用规范要求"
    },
    {
      "stage": "赛区评阅",
      "format": "各赛区按《赛区评阅工作规范》组织评阅，评出送全国评阅论文（每赛区申报一等奖数量不超过送评总数的40%）",
      "notes": "每篇送全国评阅论文须明确申报一等奖或二等奖"
    },
    {
      "stage": "全国评阅",
      "format": "全国专家组分组匿名评阅、多轮评审（含一等奖复审），无答辩",
      "notes": "凭论文定奖；全国一等奖约占参赛队0.6%-1%，全国二等奖约3%-5%"
    },
    {
      "stage": "获奖公示",
      "format": "全国组委会公示并处理异议",
      "notes": "相似度查证贯穿全程，违者通报/取消成绩"
    }
  ],
  "review_format": "赛区初评+全国专家组分组匿名评阅与多轮复审，全程无答辩，凭论文（摘要+正文+支撑材料）评奖",
  "judge_preferences": [
    "摘要决定第一印象：一轮评阅基本只看摘要+图表，量化结果必须写进摘要",
    "模型贴合题意、假设合理，拒绝万能模板套路",
    "结果可信：检验、灵敏度与误差分析完备的论文更易上奖",
    "表述清晰规范：图表质量与逻辑主线是稳定加分项",
    "诚信底线：查重与AI使用合规成为近年硬门槛"
  ],
  "past_winning_patterns": [
    "获奖率呈金字塔：全国一等奖约0.6%-1%、二等奖约3%-5%（2021年国一比例0.648%），省级奖比例由各赛区设定",
    "国奖论文共性：'问题分析→模型假设→建立求解→检验→评价推广'完整闭环，方法与题目强耦合",
    "热门方法集中在优化模型、微分方程、统计回归与机器学习融合，但获奖论文均有针对性改进而非直接套用",
    "图表规范、摘要含具体数值结果的高分特征稳定（评委一轮筛主要看摘要与图表）",
    "强校梯队稳定：国一名额多被传统数学建模强校（西交、国防科大、山大、浙大等及赛区名额前列高校）获得",
    "2024-2025年AI工具规范使用成为新变量：合规声明+人机分工清晰是获奖论文新共性，违规使用则被通报"
  ],
  "forbidden_or_risky": [
    "与队外人员讨论、请人代做、赛场外协助均属违纪",
    "论文相似度高将被官网通报，情节严重取消评奖资格/成绩（官网2025年11月即有相似度通报案例）",
    "使用AI工具未如实声明或超出规定范围，可能被取消评奖资格（2025年试行规定）",
    "论文正文出现学校/姓名等身份信息、页眉违规属格式违纪",
    "逾期提交论文或支撑材料缺失按未完成处理"
  ],
