{
  "competition_id": 21,
  "competition_name": "市场调查与分析大赛",
  "judging_dimensions": [
    {
      "dimension": "研究选题（选题价值与现实意义）",
      "weight": "约15%（决赛官方口径为报告50%+展示答辩50%；六维度内部权重为评分表惯例推断）",
      "official_wording": "大赛组委会第十六届通知：\"决赛采取'报告+现场展示答辩'方式，决赛成绩=50%报告分+50%展示答辩分\"（china-cssc.org）；报告评审标准六个方面含\"研究选题\"（知乎第十五届评分表整理及多校评分细则）。内部权重【推断】。",
      "scoring_points": [
        "选题贴近国家战略与社会热点（如低空经济、乡村振兴、文化遗产保护、银发经济）",
        "问题界定清晰，有真实决策或政策含义",
        "切口具体可调查，避免大而空",
        "选题与正大集团企业命题（如有）结合度"
      ],
      "common_deductions": [
        "选题陈旧、同质化严重（外卖、网红打卡类泛滥）",
        "研究问题含糊，调查目的不清",
        "选题范围超出团队能力导致数据粗糙"
      ]
    },
    {
      "dimension": "方案设计与调查方法（抽样、问卷、实施）",
      "weight": "约25%（推断，含文案研究/方案设计/调查实施三环节）",
      "official_wording": "报告评审标准含\"文案研究、方案设计（调查方法/抽样设计）、调查实施\"（同上）；多校通知要求调查程序科学规范，问卷设计合理、有效样本量一般不低于200份。",
      "scoring_points": [
        "抽样框明确，抽样方法与样本结构能支撑推断",
        "问卷信度效度检验（预调研、Cronbach's α、KMO等）",
        "有效样本量充足（一般≥200份）与回收质量控制",
        "文献与二手数据研究充分，调查工具设计有依据"
      ],
      "common_deductions": [
        "方便样本占绝对主体却声称代表总体",
        "问卷题项与研究假设脱节",
        "样本量不足或无效问卷比例过高",
        "调查实施过程记录缺失"
      ]
    },
    {
      "dimension": "数据分析与结论（方法运用与洞见）",
      "weight": "约25%（推断）",
      "official_wording": "报告评审标准含\"分析与结论\"维度（同上）；组委会推荐使用SPSS等统计软件进行数据分析；大赛统计学专业属性由主办方中国商业统计学会定位支撑。",
      "scoring_points": [
        "方法与研究问题匹配（描述统计、假设检验、回归、聚类、结构方程等）",
        "多方法交叉验证而非堆砌模型",
        "结论由数据严格支撑，有管理或政策建议",
        "图表规范、可视化清晰，能讲出数据背后的故事"
      ],
      "common_deductions": [
        "高级模型与结论两张皮，为建模而建模",
        "显著性误读、因果乱用",
        "结论超出数据支持范围"
      ]
    },
    {
      "dimension": "报告文本规范（结构、写作、查重）",
      "weight": "约15%（推断；查重上限为官方硬性规定）",
      "official_wording": "官方查重规则：参赛报告查重率超过20%取消成绩和资格，超过40%视为学术不端并在官网通报（组委会通知及各校转发）。",
      "scoring_points": [
        "结构完整：摘要、研究背景、方案、分析、结论建议",
        "语言规范、图表编号引用规范",
        "提交格式符合当届要求（Word/PDF及附件）",
        "参考文献与数据来源标注完整"
      ],
      "common_deductions": [
        "查重率超20%直接取消成绩与资格",
        "格式不符、附件缺失",
        "数据来源与附录不一致"
      ]
    },
    {
      "dimension": "现场展示答辩（决赛占50%）",
      "weight": "约20%（对应官方\"决赛成绩=50%报告分+50%展示答辩分\"中的答辩部分，占本档案合成权重20%）",
      "official_wording": "大赛组委会：\"决赛采取'报告+现场展示答辩'方式，决赛成绩=50%报告分+50%展示答辩分\"；省赛阶段广东赛区第一轮为通讯盲评（报告70%+PPT展示30%），第二轮\"报告+现场展示答辩\"（暨南大学教务处通知）；总决赛按小组开展现场答辩，评委综合评审评出奖项。",
      "scoring_points": [
        "陈述逻辑：从选题动机到结论建议完整闭环",
        "PPT与可视化质量，重点结论一目了然",
        "回答评委追问（抽样、方法、数据真实性）准确沉稳",
        "团队分工与时间控制（超时扣分）"
      ],
      "common_deductions": [
        "答辩口径与报告数据不符",
        "核心成员答不上方法细节",
        "超时、念稿"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "调查报告（含完整附件）",
      "format": "Word/PDF，按组委会统一格式规范（含问卷、数据说明附录）",
      "page_limit": "未明确（以当届通知为准）",
      "deadline_note": "校赛/省赛/国赛各阶段按规定节点提交，国赛前须通过知识赛网考"
    },
    {
      "item": "知识赛网考",
      "format": "线上客观题考试（单选70分+多选30分，满分100分）",
      "page_limit": "满分100分",
      "deadline_note": "全国总决赛报名前置条件，统一时段开考"
    },
    {
      "item": "展示PPT与答辩材料",
      "format": "PPT（现场展示答辩用）",
      "page_limit": "未明确",
      "deadline_note": "晋级省赛第二轮/全国总决赛后提交"
    },
    {
      "item": "原创承诺与查重报告",
      "format": "按组委会要求提交",
      "page_limit": "查重率须≤20%",
      "deadline_note": "与报告同步，超20%取消成绩资格、超40%按学术不端官网通报"
    }
  ],
  "process_stages": [
    {
      "stage": "知识赛（网考）+校赛",
      "format": "个人网考合格后组队参加校级选拔，选拔晋级省赛",
      "notes": "第十六届于2025年9月启动，全国1200多所学校超36万人报名；校赛多设文本评审+展示答辩两环节（如中南财经政法大学校赛50%+50%）"
    },
    {
      "stage": "省赛/分区赛",
      "format": "第一轮通讯盲评（报告评审为主，如广东报告70%+PPT30%）选出约40余支队伍进入第二轮现场赛",
      "notes": "省赛优胜队伍按名额晋级全国总决赛"
    },
    {
      "stage": "全国总决赛",
      "format": "报告评审（50%）+现场展示答辩（50%），本科组分约15个小组开展现场答辩，评委综合评审评出奖项",
      "notes": "第十六届总决赛：专科组2026年5月武汉工商学院、研究生及在华留学生组5月郑州大学；总决赛设一等奖、二等奖及正大选题奖项（奖金总额8万元）"
    }
  ],
  "review_format": "知识赛网考客观题+报告通讯盲评（评分表六维度）+总决赛现场展示答辩，决赛成绩为报告分与展示答辩分各占50%。",
  "judge_preferences": [
    "偏好国家战略/社会热点选题且有扎实一手数据的作品（低空物流、文化遗产保护、乡村振兴等近年一等奖方向）",
    "方法服务问题：统计方法正确、解读克制比模型炫技更受认可",
    "重调研真实性：原始数据、访谈记录、实施照片等过程证据充分",
    "答辩表达与可视化：能讲述完整\"数据故事\"并稳住评委追问",
    "结论落地产出可操作的管理/政策建议"
  ],
  "past_winning_patterns": [
    "选题紧扣当年度国家战略关键词：第十三届一等奖《鼓浪涛声，古建新生——世界文化遗产鼓浪屿古建筑的保护与传承调查研究》（厦门大学嘉庚学院）、第十六届电子科大一等奖《问君何畏蜀道险，云轨无声度千山——乡村振兴下四川山区低空物流调研》（低空经济+乡村振兴双热点）",
    "一等奖多为\"热点概念+具体地域/群体+统计建模\"三要素齐备，标题普遍采用主副题式（文艺化主标题+研究型副标题）",
    "数据分析呈现上以规范图表与多方法组合为标配（信效度检验→描述→推断→模型），可视化水平显著高于普通作品",
    "强统计背景院校（北师大统计学院2023年2项一等奖、3项二等奖等）常年入围总决赛，报告方法论完整度极高",
    "获奖团队答辩普遍采用\"故事线+数据看板\"式陈述，聚焦少数核心发现而非罗列全部模型",
    "多数获奖作品附政策建议章节并与地方政府/企业场景挂钩，凸显调研的应用价值"
  ],
  "forbidden_or_risky": [
    "查重率超过20%取消成绩和资格，超过40%认定为学术不端并在大赛官网通报",
    "数据造假、编造问卷回收记录属一票否决",
    "知识赛网考替考或作弊取消该队全部参赛资格",
    "同一报告重复投稿其他赛事或往届参赛作品二次使用被取消资格",
    "答辩超时、临时更换未报名成员等违反赛场纪律将被扣分或取消评奖资格"
  ],
