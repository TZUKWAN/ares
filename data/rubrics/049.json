{
  "competition_id": 49,
  "competition_name": "中国大学生计算机设计大赛",
  "judging_dimensions": [
    {
      "dimension": "选题与主题契合（内容合规）",
      "weight": "资格性前提+评分基础维度（官方未公布分值表）【推断：约占10-15%】",
      "official_wording": "第18届竞赛规程（组委会原文）：“数媒类与计算机音乐创作类作品的主题：中国古代物理——中华优秀传统文化系列之五，内容仅限于我国历史上（1911年以前）物理相关成就”；“信息可视化设计类作品的主题：中华自然科学及其它优秀文化瑰宝”；国际生作品主题为汉学",
      "scoring_points": [
        "作品内容严格限定在当届主题范围内（数媒/音乐/信息可视化类为中华优秀传统文化系列）",
        "选题价值：解决真实需求或文化传播价值",
        "小类归属正确（如软件类分Web应用与管理信息系统、移动应用开发、算法设计与应用等）",
        "政治性、思想性与内容健康度审核"
      ],
      "common_deductions": [
        "内容偏离主题或超出限定年代范围（数媒类1911年以前）",
        "小类报错、组别（普通组/专业组）报错",
        "内容审核不通过直接取消资格"
      ]
    },
    {
      "dimension": "创新性与创意设计",
      "weight": "核心评分维度，官方未公布分值，按类别约20-30%【推断】",
      "official_wording": "大赛宗旨（规程原文）：“以赛促学、以赛促教、以赛促创……提高学生运用信息技术解决实际问题的综合能力”。官方评审未公开统一分值表，创新性为各省赛区与国赛评审共识性首要维度【推断】",
      "scoring_points": [
        "创意新颖性与原创性（相对同类作品）",
        "技术方案或艺术表达的创新点",
        "跨学科融合与问题求解思路",
        "文化类作品的文化内涵挖掘与创意转译"
      ],
      "common_deductions": [
        "题材撞车、模板化设计",
        "伪创新：换皮作品",
        "引用素材超量或无授权"
      ]
    },
    {
      "dimension": "技术实现与作品完成度",
      "weight": "核心评分维度，官方未公布分值，约30-40%（软件/大数据/AI/物联网类侧重技术，数媒类侧重制作完成度）【推断】",
      "official_wording": "规程对各类别均有功能与内容要求，如软件应用与开发类“作品是指运行在计算机……的应用软件”（分Web应用与开发、管理信息系统、移动应用开发（非游戏类）、算法设计与应用等小类）；提交要求“微课视频、动画或演示视频不超过10分钟”",
      "scoring_points": [
        "功能完整性、系统稳定性与实际运行效果（软件/物联网/大数据/AI类现场演示）",
        "技术难度：算法、架构、数据处理、AI模型的合理运用与自研占比",
        "数媒类：画面质量、动画/交互流畅度、音效与整体制作水准",
        "文档与素材规范（作品说明、源码/工程文件可核查）"
      ],
      "common_deductions": [
        "现场演示失败或功能与申报不符",
        "技术含量低、拼凑开源项目",
        "视频超10分钟、文件格式不符"
      ]
    },
    {
      "dimension": "现场答辩表现",
      "weight": "决赛定性评分环节（作者陈述含演示不超过10分钟）",
      "official_wording": "第19届竞赛规程（郑州师范学院教务处转发原文）：“每队到国赛决赛现场参与答辩的作者不少于（含）2人”“每件作品答辩时，作者陈述（含作品演示）不超过10分钟”；一等奖团队经验：国赛每件作品约20分钟=10分钟展示（陈述+演示）+10分钟问答",
      "scoring_points": [
        "陈述逻辑：需求-方案-创新点-演示-总结，10分钟内完成",
        "现场演示稳定性（本地部署备份、网络预案）",
        "回答评委提问的准确性与技术深度",
        "团队协作与答辩礼仪"
      ],
      "common_deductions": [
        "陈述超时被叫停、演示故障无预案",
        "答辩人数不足2人或非作者答辩",
        "回答与作品实际不符、数据造假被追问"
      ]
    },
    {
      "dimension": "规范与诚信（原创承诺）",
      "weight": "否决性条件，不计分数（违规取消参赛资格）",
      "official_wording": "第18届规程：“参赛院校应安排有关职能部门负责参赛作品的组织、纪律监督与内容审核等工作，保证本校竞赛的规范性和公正性”；每位作者在每个大类中只能提交1件作品",
      "scoring_points": [
        "原创承诺与素材授权（字体、图片、音视频、开源代码合规）",
        "每作者每大类限1件、不重复参赛",
        "指导教师≤2人、团队2-5名同校本科生",
        "AI生成内容使用符合当届规定并如实说明"
      ],
      "common_deductions": [
        "一稿多投、重复参赛",
        "侵权素材被举报",
        "隐瞒AI代写/代做情况"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "参赛作品（按类别）",
      "format": "软件/物联网/大数据/AI类：可运行的系统或应用+作品说明；微课与AI辅助教学类：微课视频+教学设计；数媒类：静态/动漫短片/游戏作品文件；计算机音乐类：音频作品+工程文件",
      "page_limit": "微课视频、动画或演示视频不超过10分钟",
      "deadline_note": "校级赛与省级赛3-5月；省赛上推国赛作品数据5月底前提交"
    },
    {
      "item": "作品报名信息与承诺材料",
      "format": "大赛报名系统填报；团队2-5名同校本科生，指导教师≤2人；每作者每大类限1件",
      "page_limit": "未明确",
      "deadline_note": "以省赛通知为准（3-5月）"
    },
    {
      "item": "答辩材料（决赛）",
      "format": "PPT/演示环境，现场答辩：陈述含演示≤10分钟，答辩作者≥2人",
      "page_limit": "未明确",
      "deadline_note": "国赛决赛7-8月分赛区举行（如第18届2025年7月17日-8月17日，全部线下答辩）"
    }
  ],
  "process_stages": [
    {
      "stage": "校级赛",
      "format": "各校自行组织评选推荐",
      "notes": "由学校职能部门负责组织、纪律监督与内容审核；3-5月"
    },
    {
      "stage": "省级赛",
      "format": "各省赛区组织评审（网评/会评/答辩，各省细则不一）",
      "notes": "国赛只接受省级赛上推的本科生作品；按省赛成绩排序上推"
    },
    {
      "stage": "国家级赛（决赛）",
      "format": "按类别分赛区现场答辩（第18届设上海、杭州、南京等6个决赛区，全部线下答辩）",
      "notes": "7-8月举行；奖项：一等奖≤有效作品数5%、二等奖≥25%、三等奖70%；结果9-10月公示"
    }
  ],
  "review_format": "三级评审：校赛推荐→省赛评审上推→国赛分赛区现场答辩（专家评审组独立打分），陈述含演示不超过10分钟",
  "judge_preferences": [
    "选题小而实：真实需求驱动、演示看得见效果",
    "技术自研度与难度（AI/大数据类重模型与数据工作真实性）",
    "数媒类重文化内涵+艺术完成度双优",
    "答辩陈述紧凑、演示稳定、问答坦诚"
  ],
