{
  "competition_id": 120,
  "competition_name": "世界大学生桥梁设计大赛",
  "judging_dimensions": [
    {
      "dimension": "设计理念与环境协调性",
      "weight": "约33%（2024年通知评审三项指标之一，三项并列综合评审、官方未公布分值比例，等分处理为推断）【推断】",
      "official_wording": "2024年大赛通知（设计竞赛网转载官方全文）：评审标准\"1.设计理念与环境协调性——安全、适用、耐久、美观、环保、节能等理念\"。",
      "scoring_points": [
        "体现安全、适用、耐久、美观、环保、节能等设计理念",
        "桥址选择特征突出（跨越江河湖海、深山峡谷等），与环境景观协调",
        "方案说明中明确桥址条件与技术标准（2023年自由命题时由参赛者自定）",
        "契合固定命题的场地与功能设定（2025/2026年为固定命题赛制）"
      ],
      "common_deductions": [
        "不符合赛题要求（固定命题年份视为无效作品）",
        "理念空泛、与桥址环境脱节",
        "缺少必要的技术标准设定"
      ]
    },
    {
      "dimension": "桥梁结构体系设计",
      "weight": "约33%（三项指标之一，含合理性、功能性、创新性；分值比例同上为推断）【推断】",
      "official_wording": "2024年大赛通知：评审标准\"2.桥梁结构体系设计——合理性、功能性、创新性\"；作品内容\"含构件设计、材料设计、施工方案\"。",
      "scoring_points": [
        "结构体系（悬索、斜拉、拱、梁及组合、新概念、未来之桥等）选型合理",
        "构件设计、材料设计有依据，力学概念清晰",
        "施工方案可行",
        "结构创新性与功能实现统一",
        "满足规模约束：跨径20m以上，桥长50~5000m，桥宽4~50m"
      ],
      "common_deductions": [
        "结构体系明显不合理或无法实现",
        "超出规模限定（桥长/桥宽/跨径）",
        "只有概念造型、无结构与施工内容"
      ]
    },
    {
      "dimension": "设计图纸、作品简介、效果图水平",
      "weight": "约33%（三项指标之一，含完整性、合规性、美观协调；分值比例同上为推断）【推断】",
      "official_wording": "2024年大赛通知：评审标准\"3.设计图纸、作品简介、效果图水平——完整性、合规性、美观协调\"。",
      "scoring_points": [
        "图纸完整：平纵横布置、构件构造表达齐全",
        "表达合规、制图规范",
        "效果图美观协调、准确传达方案意象",
        "作品简介逻辑清晰、突出亮点",
        "演示文稿（PPT）质量（总决赛材料之一）"
      ],
      "common_deductions": [
        "图纸缺项、表达不清",
        "效果图与设计内容不符",
        "评审材料中出现学校、姓名信息（匿名要求）"
      ]
    },
    {
      "dimension": "现场总决赛表现（争夺特等奖）",
      "weight": "定性（总决赛\"分专家评审和现场总决赛两步进行\"，特等奖由现场总决赛产生；专家评审阶段的书面评审为主）",
      "official_wording": "2024年大赛通知：\"特等奖需由总决赛专家评审委员会评选出前10部作品，参加6月举行的现场总决赛后诞生\"；2026年通知：\"一等奖优秀作品参加现场总决赛争夺特等奖\"。",
      "scoring_points": [
        "方案陈述的完整性与感染力",
        "对结构、施工、经济等问题问辩的应对",
        "团队成员协作与表达",
        "对评审专家意见的回应质量"
      ],
      "common_deductions": [
        "陈述与书面材料不符",
        "问辩中暴露方案硬伤",
        "超时或演示文稿无法播放"
      ]
    },
    {
      "dimension": "合规性与原创性（资格底线）",
      "weight": "定性（不满足要求的作品不予受理或视为无效，属一票否决性质）",
      "official_wording": "2024年通知：\"中国籍学生须免费注册成为中国公路学会学生会员，非会员参赛资料不予受理\"；2026年通知：\"不符合赛题要求视为无效\"、\"未按赛区投稿或一稿多投视为无效\"；\"作品须为原创，违者取消参赛资格并自行承担法律责任\"。",
      "scoring_points": [
        "参赛资格合规（世界范围普通高校全日制在校生：博士生、硕士生、本科生及高职高专学生）",
        "组队合规：每队学生最多5人，指导教师最多2人且为高校在职教师；每人参赛作品数量不限但每部单独提交",
        "原创承诺与报名表盖章（第一参赛学校或院系公章）",
        "按规定赛区投稿、邮件标题与压缩包命名规范"
      ],
      "common_deductions": [
        "非会员资料不予受理（2024年规则）",
        "一稿多投、未按赛区投稿",
        "抄袭或代做取消资格"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "参赛报名表",
      "format": "word版＋加盖第一参赛学校或院系公章的扫描件，与作品同时提交（不单独提前报名）",
      "page_limit": "未明确",
      "deadline_note": "随作品在片区赛（复赛）截止前提交（2026年为5月10日前）"
    },
    {
      "item": "参赛作品设计文件册（图纸＋作品简介＋效果图等详细资料）",
      "format": "仅电子版（2026年明确不需实物模型），按当年附件2/3规格制作；语言为中文简体或英文；评审材料中不得显示学校、姓名",
      "page_limit": "未明确（详细规格见当年通知附件）",
      "deadline_note": "片区赛作品提交5月10日前；总决赛作品提交5月30日前（2026年）"
    },
    {
      "item": "演示文稿（PPT）",
      "format": "电子版，勿显示学校、姓名",
      "page_limit": "未明确",
      "deadline_note": "与设计文件册同时打包提交；现场总决赛时用于陈述"
    },
    {
      "item": "作品规模与选题",
      "format": "按当年赛题（自由命题或固定命题）；最小跨径20m以上，桥长50~5000m，桥宽4~50m；内容含构件设计、材料设计、施工方案",
      "page_limit": "未明确",
      "deadline_note": "同作品提交截止"
    }
  ],
  "process_stages": [
    {
      "stage": "宣传报名与校级预赛",
      "format": "学校单独组织预赛/校内选拔（省级公路学会指导）",
      "notes": "2024年：4月28日前各学校向省级公路学会推荐复赛作品；2026年改为不组织提前单独报名、报名表与作品同时提交"
    },
    {
      "stage": "复赛/片区赛",
      "format": "分赛区电子版投稿＋专家线下评审",
      "notes": "2024年分东部、西部、南部、北部四大片区（5月10日前报送组委会）；2026年分南部赛区（18省市区，重庆交通大学承办）、北部赛区（16省市区，长安大学承办），5月10日前提交、5月20日前评审；获奖比例原则上不超过片区申报作品总数的45%（一等≤10%、二等≤15%、三等≤20%）；2024年复赛一等奖不超过赛区作品总数15%"
    },
    {
      "stage": "总决赛作品提交与专家评审",
      "format": "承办单位推荐二等奖以上作品报组委会，组委会专家评审",
      "notes": "2026年总决赛作品提交5月30日前；全部总决赛作品均获奖，评一、二、三等奖，等级比例根据推荐作品总数研究决定"
    },
    {
      "stage": "现场总决赛暨颁奖典礼",
      "format": "现场答辩/陈述，争夺特等奖",
      "notes": "通常在世界交通大会（WTC）期间举行：2023年6月17日武汉、2024年6月29日青岛；特等奖由现场总决赛诞生（2024年为专家评审前10部作品参加现场总决赛）"
    }
  ],
  "review_format": "中国公路学会组织的评审委员会（遴选世界范围内知名桥梁专家）依据\"设计主旨、设计理念、设计效果、设计价值\"对作品进行校级预赛—片区复赛—总决赛三级综合评审，书面匿名评审为主，特等奖由现场总决赛答辩产生",
  "judge_preferences": [
    "理念先行的综合价值：安全、适用、耐久、美观、环保、节能缺一不可，突出方案与桥址环境的对话",
    "结构体系合理性与创新并重：新颖造型须有可实现的构件、材料与施工方案支撑",
    "表达完整规范：图纸、作品简介、效果图三位一体，演示文稿质量影响现场总决赛表现",
    "鼓励多学科、跨国跨校组队和新概念、未来之桥等前瞻桥型探索",
    "严格契约意识：赛题、规模、赛区、命名等程序性要求不满足即无效"
  ],
  "past_winning_patterns": [
    "特等奖作品兼顾标志性造型与完整结构施工论证（2024年长安大学单校获特等奖3项，显示系统性训练与多作品策略有效）",
    "获奖作品普遍在环境理念表达上叙事完整、效果图表现力强（依据评审三项指标结构与历届获奖新闻推断）"
  ],
  "forbidden_or_risky": [
    "作品非原创、抄袭，取消参赛资格并自行承担法律责任",
    "评审材料（设计文件册、演示文稿）显示学校、姓名等身份信息",
    "一稿多投或未按所属赛区投稿视为无效（国际高校投组委会邮箱）",
    "不符合当年赛题要求视为无效（固定命题年份）",
    "中国籍学生未注册中国公路学会学生会员则资料不予受理（2024年规则）；作品使用权归组委会、不另付稿酬"
  ],
