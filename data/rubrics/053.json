{
  "competition_id": 53,
  "competition_name": "未来设计师·数字艺术设计大赛",
  "judging_dimensions": [
    {
      "dimension": "主题契合度与创意性",
      "weight": "约30%（以专项赛道XR赛官方权重'作品创意30%'为参照；命题/公益赛道强调符合大赛主题）",
      "official_wording": "各命题赛道任务书评审标准列为'符合大赛主题、创意性、设计表现等'；2024 NCDA'图壤杯'XR未来空间设计赛公布权重：作品创意30%、艺术表现30%、制作质量30%、作品规范10%。【推断：非命题赛道未公布统一权重，参照专项赛道权重结构推断创意维度约30%】",
      "scoring_points": [
        "切题准确：命题/公益赛道对主题、命题单位需求的理解与回应",
        "创意原创性：概念独特、避免与往届获奖作品及市面方案雷同",
        "设计思维完整：从洞察到方案的推导链条清晰",
        "社会/文化价值：非遗、乡村振兴、可持续等议题的深度介入"
      ],
      "common_deductions": [
        "作品文件、宣传海报中出现学校名称、作者姓名、其他赛事标识（官方扣分项：每项扣5分）",
        "跑题：未回应命题要求或自由发挥过度",
        "创意同质化、模板化拼贴"
      ]
    },
    {
      "dimension": "艺术性与设计表现",
      "weight": "约30%（参照XR赛'艺术表现30%'）",
      "official_wording": "XR赛官方权重'艺术表现30%'；宁夏大学赛区AIGC实践挑战赛通知列评审维度含'艺术性'。【推断：为各赛道通用维度】",
      "scoring_points": [
        "视觉语言品质：构图、色彩、字体、造型等专业功底",
        "风格自洽：整体调性与主题气质匹配",
        "叙事与情感表达：作品讲故事的能力",
        "文化审美的当代转译（国潮·非遗等方向）"
      ],
      "common_deductions": [
        "视觉粗糙、版式混乱、字体使用不当",
        "风格拼接痕迹重、调性不统一",
        "审美低龄化/套模板"
      ]
    },
    {
      "dimension": "技术性与制作质量",
      "weight": "约30%（参照XR赛'制作质量30%'）",
      "official_wording": "XR赛官方权重'制作质量30%'；AIGC等赛道通知列评审维度含'技术性'。【推断：为各赛道通用维度】",
      "scoring_points": [
        "软件技术与制作精度：渲染、动效、交互实现、模型质量",
        "AIGC类：提示词工程与生成结果的打磨程度、AI辅助过程可说明",
        "交互/游戏类：功能逻辑、用户体验流程完整性",
        "技术方案与创意目标的匹配度"
      ],
      "common_deductions": [
        "技术硬伤：模型破面、动效卡顿、交互断链",
        "AIGC作品明显未加修饰、瑕疵未处理",
        "分辨率/精度不达标"
      ]
    },
    {
      "dimension": "作品规范性与实用性",
      "weight": "约10%（参照XR赛'作品规范10%'；含AIGC赛道的'实用性'与'团队合作'等）",
      "official_wording": "XR赛官方权重'作品规范10%'；命题赛通知要求版面'不得包含组织机构徽标及作者姓名、图像等信息'；评审含'是否符合作品要求（提交材料、规格、标准等）'；地图不规范重大错误作零分处理。",
      "scoring_points": [
        "按赛道任务书规格提交（如A3竖版、JPG≤5M、≥150-300dpi、MP4无水印、H5附二维码）",
        "版面匿名、无第三方赛事标识",
        "地图使用规范（涉及地图的作品重大错误作零分）",
        "实用落地性（产教融合/企业命题赛道看商业可行性）"
      ],
      "common_deductions": [
        "文件格式/大小/精度不合规",
        "地图不规范（重大错误零分）",
        "未使用大赛官方提供素材（命题/公益赛要求）",
        "提交材料缺设计说明或信息填写不全"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "平面/海报/IP/文创类作品",
      "format": "JPG，不小于A3幅面、300dpi、RGB/CMYK，单文件≤5M；部分赛道A3竖版最多5张、≥150dpi",
      "page_limit": "单件或系列（按赛道任务书）",
      "deadline_note": "每年12月-次年6月报名投稿，约6月省赛、8月出国赛结果（第14届国奖公示2026-08-26）"
    },
    {
      "item": "视频/动画/影像类作品",
      "format": "MP4格式、无水印",
      "page_limit": "按时长要求（各赛道任务书）",
      "deadline_note": "同上"
    },
    {
      "item": "交互/H5/游戏类作品",
      "format": "可运行文件或链接，H5需在版面提供二维码；附操作说明",
      "page_limit": "未明确",
      "deadline_note": "同上"
    },
    {
      "item": "作品信息与设计说明",
      "format": "提交系统在线填写：作品名称、设计说明、作品寓意等；由参赛单位集中统一提交",
      "page_limit": "未明确",
      "deadline_note": "与作品同步提交"
    }
  ],
  "process_stages": [
    {
      "stage": "校赛",
      "format": "高校组织校内外专家分组评审，择优上推",
      "notes": "通过'未来设计师大学生艺术设计作品云平台'由参赛单位集中统一提交"
    },
    {
      "stage": "省赛",
      "format": "组委会联合分赛区承办单位组织资格审查、内容审核、查重检测及多轮专家评审",
      "notes": "评出省级一二三等奖；省一、二等奖进入国赛"
    },
    {
      "stage": "国赛",
      "format": "全国专家评审+统计汇总+作品公示（'五轮三级双公示'机制）",
      "notes": "部分赛项设全国总决赛现场创作与答辩（如90/180分钟双题并行创作），现场决出总决赛一等奖"
    },
    {
      "stage": "国际赛IIDA衔接",
      "format": "与国赛贯通的国际赛事通道",
      "notes": "构成校-省-国-国际四级贯通体系"
    }
  ],
  "review_format": "三级赛制（校赛-省赛-国赛）+'五轮三级双公示'评审机制，线上作品评审为主、部分赛项加现场创作与答辩。",
  "judge_preferences": [
    "切题第一：命题与公益赛道严格审主题回应，跑题基本出局",
    "创意与完成度并重：概念好且落地打磨精的作品最占优",
    "规范匿名意识：版面出现校名人名是高频失分点（官方明文每项扣5分）",
    "关注社会议题与本土文化：非遗、乡村、可持续方向在国奖中占比高",
    "AIGC等新技术赛道看重'人机协同'的完整创作过程说明而非纯生成结果"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
