{
  "competition_id": 58,
  "competition_name": "iCAN创新创业大赛",
  "judging_dimensions": [
    {
      "dimension": "创新性",
      "weight": "占总分30%（满分100分制，大赛通行评审规则）",
      "official_wording": "德州学院转发大赛评审规则原文：'比赛以应用创新为主要考察目标和评审原则，按照100分进行评审……1）创新性30分:强调原始创意的价值，在思维模式、技术研发、管理方法等方面的突破和创新'（多高校转发的iCAN规程一致）。",
      "scoring_points": [
        "原始创意的价值与原创性（学生原创，谢绝导师课题包装）",
        "思维模式的突破与创新",
        "技术研发层面的创新（自主完成的创新实践）",
        "管理方法/模式层面的创新（创业赛道）"
      ],
      "common_deductions": [
        "作品为导师课题成果包装或非学生原创",
        "创意与市面已有产品同质化",
        "侵犯他人知识产权"
      ]
    },
    {
      "dimension": "商业性",
      "weight": "占总分25%（满分100分制，大赛通行评审规则）",
      "official_wording": "评审规则原文：'2）商业性25分: 强调商业模式设计的可行性及产品的实用性，并具备社会和市场价值'。",
      "scoring_points": [
        "商业模式设计的可行性",
        "产品实用性（解决真实需求）",
        "市场价值与市场分析可信度",
        "社会价值（助力学生实现社会价值与商业价值双赢）"
      ],
      "common_deductions": [
        "商业模式空想、无盈利逻辑",
        "市场需求论证缺失或数据造假",
        "创业赛道公司股权结构不符要求（队长持股<10%）"
      ]
    },
    {
      "dimension": "技术方案",
      "weight": "占总分25%（满分100分制，大赛通行评审规则）",
      "official_wording": "评审规则原文：'3）技术方案25分: 强调项目产品的技术洞见及产品的完成程度'。材料要求佐证：创新赛道须提交'近2年内完成的产品实物……产品介绍（产品说明PPT及实物演示视频）、原创材料（开发日志及其他原创证明材料）'（三江学院转发2026年第二十届大赛通知）。",
      "scoring_points": [
        "技术路线的洞见与合理性",
        "产品原型的完成程度（可实现基本功能并可现场演示操作）",
        "开发日志与原创证明材料的完整可信",
        "AI辅助材料须加'AI辅助制作'标识（未标识视为违规）"
      ],
      "common_deductions": [
        "无实物原型或原型无法演示（无作品不得报名参赛）",
        "产品非近2年内完成（如第20届要求2024年4月1日以后完成）",
        "开发日志缺失、原创证明不足"
      ]
    },
    {
      "dimension": "产品介绍（展示答辩）",
      "weight": "占总分20%（满分100分制，大赛通行评审规则）",
      "official_wording": "评审规则原文：'4）产品介绍20分: 强调对产品和项目的表达能力，并对团队成员的整体协作进行考核'。",
      "scoring_points": [
        "产品说明PPT/商业计划书PPT的逻辑与表达力",
        "实物演示视频与现场演示的效果",
        "答辩应答准确、临场应变",
        "团队成员整体协作与分工展现"
      ],
      "common_deductions": [
        "介绍冗长抓不住重点、超时",
        "演示视频与实物功能不符",
        "答辩时成员分工混乱、互相矛盾"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "创新赛道项目材料",
      "format": "近2年内完成的产品实物（第20届要求2024年4月1日以后完成）+产品介绍（产品说明PPT及实物演示视频）+原创材料（开发日志及其他原创证明材料）；使用AI辅助的材料须添加'AI辅助制作'标识",
      "page_limit": "团队2-5名队员，指导教师≤2人；同一人不可同时报创新与创业赛道（可兼报挑战赛道）",
      "deadline_note": "第20届（2026年）：6月30日前在官网 www.g-ican.com 提交报名材料，报名结束后不可修改"
    },
    {
      "item": "创业赛道项目材料",
      "format": "近2年内完成的产品实物+产品介绍（商业计划书PPT、实物演示视频及其他证明材料）；须以自主完成的创新项目注册公司，队长为企业创始人或核心成员且持股比例不低于10%",
      "page_limit": "同上",
      "deadline_note": "同上"
    },
    {
      "item": "项目说明书（原型配套文档）",
      "format": "详细的项目说明书，与可演示、可操作的产品原型配套提交（'无作品不得报名参赛'）",
      "page_limit": "未明确",
      "deadline_note": "随校级选拔/分赛区报名提交"
    },
    {
      "item": "挑战赛道（企业命题赛项）",
      "format": "大赛联合企业发布前沿技术课程和赛题并提供软硬件支持，含人工智能、机器人、商业管理、电子信息等赛项，按各赛项命题方案提交",
      "page_limit": "各赛项可同时报名",
      "deadline_note": "命题方案由组委会另行通知"
    }
  ],
  "process_stages": [
    {
      "stage": "校级选拔/院内遴选",
      "format": "各高校组织校赛或院内遴选，按名额推荐分赛区",
      "notes": "校赛按100分制评审（创新30/商业25/技术25/介绍20）；无实物作品不得报名"
    },
    {
      "stage": "分赛区（省赛）评审",
      "format": "网络初评+分赛区决赛，按分数高低排名设一二三等奖、单项奖、成功参赛奖（优胜奖）",
      "notes": "网络初评不对各校参赛项目数量限制；全国组委会按分赛区报名情况设定晋级总决赛配额"
    },
    {
      "stage": "全国总决赛",
      "format": "现场展示答辩（实物演示+PPT陈述+评委问答），由总决赛评委按同一评审规则打分",
      "notes": "分赛区晋级配额制；参赛材料全程不得出现院校、指导教师、单位名称，仅可体现参赛学生姓名"
    },
    {
      "stage": "国际赛道",
      "format": "国际参赛项目经全球青年创新领袖共同体促进会（PILC）渠道报名参赛",
      "notes": "iCAN发源于北京大学（国际大学生iCAN创新创业大赛），现由iCAN组委会/PILC体系运营"
    }
  ],
  "review_format": "分赛区网络初评与现场决赛+全国总决赛现场展示答辩；以'应用创新'为主要考察目标和评审原则，按创新性30分+商业性25分+技术方案25分+产品介绍20分的100分制打分排名",
  "judge_preferences": [
    "强调'应用创新'：能演示、可操作的实物原型是第一门槛，PPT项目不受欢迎",
    "学生原创属性严格核查（开发日志、原创证明），反感导师课题包装的'成果参赛'",
    "看中技术完成度与商业可行性的平衡（各占25分）",
    "创业赛道要求真实公司运营与股权绑定（队长持股≥10%），看重落地性",
    "现场表达与团队协作（20分）：演示流畅、分工清晰、应答自然"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "参赛材料中禁止出现院校、指导教师、单位名称，仅可体现参赛学生姓名（匿名违规取消资格）",
    "参赛作品务必是学生原创，谢绝任何形式的导师课题参赛；无作品（原型）不得报名参赛",
    "使用AI辅助的材料必须添加'AI辅助制作'标识",
    "产品实物须为近2年内完成（逾期作品不符合报名条件）",
    "报名结束后不可修改报名信息；同一人不可在同一赛道/赛项重复报名"
  ],
