{
  "competition_id": 85,
  "competition_name": "成图大赛个人赛",
  "judging_dimensions": [
    {
      "dimension": "尺规绘图（手工绘图）",
      "weight": "单环节100分/个人三环节共约300分（约33%）",
      "official_wording": "各校校赛/省赛通知与历年试题评分一览表通行结构：根据零件轴测图/投影图'用尺规正确绘制'专业工程图，满分100分、A3图纸；评分按'绘图评分一览表'逐项扣分（黑龙江省级赛试题、夸克文档历届试题卷面评分说明）。分值为100分制官方惯例，逐项分值以当届试卷评分标准为准。",
      "scoring_points": [
        "投影关系正确、视图选择与剖视表达合理",
        "图线线型分层规范、粗细分明、等宽浓淡一致",
        "字体端正清晰（汉字长仿宋体、数字字母规范）",
        "尺寸标注齐全、合理、符合国标",
        "布图均衡、图面整洁、图框标题栏规范"
      ],
      "common_deductions": [
        "投影错误/漏线多线（按处扣分）",
        "线型用错（虚实线不分）、字迹潦草",
        "尺寸漏标错标、箭头与数字不规范",
        "图面脏污、工具痕迹，卷面分扣减"
      ]
    },
    {
      "dimension": "计算机二维绘图",
      "weight": "单环节100分/个人三环节共约300分（约33%）",
      "official_wording": "武汉生物工程学院第十五届校赛通知原文：工程图绘制'90分钟、100分'，评判因素为'图示表达的完整性与正确性、图线绘制与标注的完整性与规范性、卷面的整洁美观'；并注明'分值比重仅作为参考，具体以最终试卷评分标准为准'。",
      "scoring_points": [
        "图示表达完整正确（视图数量与剖切方案）",
        "图层、线型、颜色设置规范",
        "标注样式与尺寸齐全、文字与国标一致",
        "图形界限/比例/图框设置正确，出图整洁"
      ],
      "common_deductions": [
        "使用非指定软件或文件格式无法打开",
        "图层混乱、线宽不分",
        "标注缺失或比例失真",
        "超时未保存提交"
      ]
    },
    {
      "dimension": "计算机三维建模（产品/建筑信息建模）",
      "weight": "单环节100分/个人三环节共约300分（约33%）",
      "official_wording": "同上校赛通知原文：三维建模'120分钟、100分'，以'模型完整性与正确性、规范性、三维环境与整体效果'为主要评判因素；要求'以考号命名的文件夹'提交，'正确建模并赋材质、渲染及后期处理'。",
      "scoring_points": [
        "模型结构完整、尺寸与图纸一致（特征树/构件逻辑清晰）",
        "建模方法规范、参数化程度与可编辑性",
        "装配/材质/渲染与整体视觉效果",
        "按考号命名归档提交（匿名评审要求）"
      ],
      "common_deductions": [
        "模型漏件、尺寸与给定图纸不符",
        "破面/烂面、特征树杂乱",
        "文件命名不符规定、渲染缺失",
        "超时未提交"
      ]
    },
    {
      "dimension": "图学基础与制图规范素养",
      "weight": "定性贯穿维度（扣分制，无独立分值）",
      "official_wording": "大赛宗旨为'以赛促教、以赛促学、以赛促改'全面提升图学能力（南京工程学院转发第十八届通知称其为'图学类课程最高级别的国家级赛事'）；各环节评分均以国家制图标准为基准，规范素养体现为【推断：由各环节评分因素（投影/线型/标注/国标符合性）归纳】。",
      "scoring_points": [
        "全程符合技术制图国家标准（GB）与行业表达惯例",
        "读图理解准确：由轴测图/施工图正确还原三维或二维信息",
        "作图效率：限时内完成全部要求内容"
      ],
      "common_deductions": [
        "国标知识性错误（比例、图幅、字体号数）",
        "为速度牺牲准确性导致多处扣分",
        "未按试卷规定的表达方案作图"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "尺规绘图试卷",
      "format": "A3图纸手绘，自带图板/丁字尺/绘图仪器",
      "page_limit": "A3，限时（常见90分钟内环节）",
      "deadline_note": "个人赛第一环节（省赛约5月下旬，2026届省赛5月29-30日）"
    },
    {
      "item": "计算机二维绘图文件",
      "format": "AutoCAD/中望/浩辰等DWG文件，按规定命名",
      "page_limit": "90分钟/100分",
      "deadline_note": "与尺规同日机考"
    },
    {
      "item": "三维建模文件",
      "format": "SolidWorks/UG/Creo/Revit/SketchUp等（按类别指定），以考号命名文件夹提交，含渲染",
      "page_limit": "120分钟/100分",
      "deadline_note": "个人赛环节（2026届国赛7月25-28日，东北大学秦皇岛分校承办通知）"
    },
    {
      "item": "报名",
      "format": "校赛选拔→省赛（官网chengtudasai.com统一报名）→国赛",
      "page_limit": "未明确",
      "deadline_note": "2026届：校赛报名4月上旬截止，省赛报名4月1-25日，国赛报名6月5-25日（第十八届口径）"
    }
  ],
  "process_stages": [
    {
      "stage": "校级选拔赛",
      "format": "按类别组织尺规/二维/三维上机选拔",
      "notes": "约3-4月；推荐名额入省赛"
    },
    {
      "stage": "省级赛（国赛预选赛）",
      "format": "统一命题上机+手绘，各环节独立计分",
      "notes": "约5月下旬；机械/建筑/道桥/水利/电子五类分卷"
    },
    {
      "stage": "全国总决赛",
      "format": "个人赛（尺规绘图+计算机建模等环节）与团体赛（先进成图技术+创新设计）分别评审",
      "notes": "约7月下旬（2026届7月25-28日）；个人奖按环节成绩评定一、二、三等奖"
    }
  ],
  "review_format": "封闭限时现场作图：手绘卷按评分一览表逐项扣分人工评审，机考文件按模型/图纸正确性、规范性与图面效果评定，环节独立计分。",
  "judge_preferences": [
    "国家标准符合性第一：投影、线型、字体、标注任何一项不规范均逐处扣分",
    "准确性优先于速度：错漏线扣分累计远快于完成度加分",
    "三维建模看重特征树逻辑与参数化质量，而非只看渲染外观",
    "建筑/水利等类别重工程图表达完整性，机械类重剖视与装配表达",
    "匿名评审：一切文件仅以考号命名，任何身份信息视为违规"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "不得在图纸/文件上出现姓名、学校等身份信息（违者成绩作废）",
    "使用非指定软件版本或插件自动化生成（按当届规程界定）可能被取消成绩",
    "抄袭他人图纸/模型文件判作弊",
    "逾期提交或不按规定命名归档导致无法评审",
    "获奖比例：先进成图技术主赛道外的其他创新赛道一、二、三等奖约为参赛组数5%/8%/12%（官网简介口径），个人赛比例以当届规程为准"
  ],
