{
  "competition_id": 64,
  "competition_name": "水利创新设计大赛",
  "judging_dimensions": [
    {
      "dimension": "选题与主题契合（合理性）",
      "weight": "15%【推断：官方公布评审方面未公布分值，选题为基础维度估较低权重】",
      "official_wording": "评审委员会按\"公平、公正、公开、科学、规范\"的原则，通过资料审阅、现场答辩和实物演示等程序，从选题、方案设计、结构设计和制作等方面评审作品的合理性、创新性、实用性及先进技术应用（首届全国大学生水利创新设计大赛通知，河海大学承办官网）",
      "scoring_points": [
        "作品紧扣当届主题（历届如\"绿色水利\"\"生态水利\"\"高效用水\"\"智慧水利\"\"新阶段新水利\"）",
        "选题面向水利行业真实问题：水应用、水利结构、水力机械等规定内容范围",
        "选题大小适中，本科团队能在赛期内完成实物验证",
        "不符合主题内容的作品不能参赛（硬性门槛）"
      ],
      "common_deductions": [
        "偏离当届主题或超出三类规定内容范围",
        "选题过大无法用实物模型验证",
        "与教师科研成果界限不清"
      ]
    },
    {
      "dimension": "方案设计与创新性",
      "weight": "30%【推断：创新性为赛事名称与评审核心，按同类设计赛惯例估最高权重】",
      "official_wording": "评审作品的创新性（首届大赛通知评审原文）；作品必须为在校大学生的原创作品，不得侵犯他人的知识产权",
      "scoring_points": [
        "核心原理或结构创新：针对水工结构、水力机械、节水/水处理装置提出新构思",
        "与现有技术/产品的对比论证：专利查新、文献对比",
        "设计说明书质量：方案比选、计算依据（水力学/结构计算）、图纸规范",
        "创新点表述聚焦，能被评委快速理解"
      ],
      "common_deductions": [
        "创新点实为教师科研成果包装",
        "方案只有概念没有计算与图纸支撑",
        "与历届获奖作品或专利高度雷同"
      ]
    },
    {
      "dimension": "结构设计与实物制作完成度",
      "weight": "25%【推断：实物模型为本赛区分 anderer设计赛的核心特征，权重高】",
      "official_wording": "作品实物体积不超过2立方米且最长方向尺寸不超过2米；报到时提交实物及展板，展板面积不超过1米×2米（首届大赛通知作品要求）",
      "scoring_points": [
        "实物模型能真实演示工作原理（可动、可操作）",
        "制作工艺与结构合理性：材料选择、密封、传动等细节",
        "现场运行稳定，演示不怯场不故障",
        "展板表达清晰（限1米×2米），与实物互相印证",
        "功能介绍视频3分钟以内，直观展示"
      ],
      "common_deductions": [
        "实物超尺寸限制（2立方米/2米）或无法运输到场",
        "现场演示失败或只带图纸不带实物",
        "制作粗糙、演示时频繁故障"
      ]
    },
    {
      "dimension": "实用性与先进技术应用",
      "weight": "15%【推断：官方评审语言中与合理性并列的维度】",
      "official_wording": "评审作品的实用性及先进技术应用（首届大赛通知评审原文）",
      "scoring_points": [
        "工程实用性：造价、施工/安装可行性、维护成本有初步估算",
        "应用场景明确：灌区、河道、农村供水等具体场景",
        "先进技术应用：传感监测、自动化控制、智慧水利技术等与水利场景的结合度",
        "节水/生态/防灾等实际效益的量化论证"
      ],
      "common_deductions": [
        "效益只有定性口号，无任何量化测算",
        "智能技术仅为噱头，与水利需求脱节",
        "完全没有成本与可行性分析"
      ]
    },
    {
      "dimension": "现场答辩与实物演示表现",
      "weight": "15%【推断：答辩与演示为官方规定评审程序，按同类赛惯例估权重】",
      "official_wording": "通过资料审阅、现场答辩和实物演示等程序（首届大赛通知评审程序原文）",
      "scoring_points": [
        "陈述逻辑：问题-方案-验证-效益的完整叙事，时间控制得当",
        "答辩应答准确，团队成员分工清楚、均能回答",
        "演示与讲解配合：边演示边讲解关键结构",
        "材料审阅环节说明书与图纸的规范性"
      ],
      "common_deductions": [
        "超时严重或照本宣科",
        "答辩只有队长一人能答，队员游离",
        "评委追问原理细节时暴露不熟悉自己作品"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "实物模型或样机",
