      "item": "功能介绍视频",
      "format": "3分钟以内",
      "page_limit": "未明确",
      "deadline_note": "随说明书同批报送"
    },
    {
      "item": "展板",
      "format": "面积不超过1米×2米",
      "page_limit": "未明确",
      "deadline_note": "报到时随实物提交"
    }
  ],
  "process_stages": [
    {
      "stage": "校内选拔赛",
      "format": "各承办/参赛高校自行组织评审（资料审阅+答辩+演示）",
      "notes": "选拔三等奖以上或主题契合作品推荐参赛；每两年举办一届，报名一般5月10日前"
    },
    {
      "stage": "全国决赛",
      "format": "集中现场赛：资料审阅、现场答辩、实物演示",
      "notes": "历届由水利类强校承办（河海大学、华北水利水电大学、四川大学等）；每校推荐一般不超过5件；报名费每队500元、不得向学生个人收费"
    },
    {
      "stage": "评奖与公示",
      "format": "评审委员会集体评审产生奖项",
      "notes": "设优秀作品奖（特等奖、一等奖、二等奖）、优秀指导教师奖、优秀组织奖；一等奖作品指导教师获优秀指导教师奖"
    }
  ],
  "review_format": "现场集中评审：评审委员会按资料审阅、现场答辩、实物演示三程序打分，强调实物模型的可运行演示",
  "judge_preferences": [
    "实物能现场转起来是硬道理——纯图纸方案很难获奖",
    "偏好紧扣当届主题且面向真实水利场景（灌区、河道、供水）的应用型创新",
    "欣赏有计算依据（水力/结构计算）的工程严谨性",
    "智慧水利技术应用加分，但必须服务于水利功能而非炫技",
    "学生全程主导，警惕教师科研项目包装参赛"
  ],
