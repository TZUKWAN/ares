{
  "competition_id": 113,
  "competition_name": "化学实验邀请赛",
  "judging_dimensions": [
    {
      "dimension": "实验理论笔试",
      "weight": "总分=笔试+实验操作合成（当届比例未公开）；推断笔试约占30%-40%",
      "official_wording": "第十一届第二轮通知（山东大学官网PDF）：赛程设'学生实验理论笔试'（半天）与'学生实验操作竞赛'（全天）两大环节。【推断】笔试占总分约30%-40%，以当届为准。",
      "scoring_points": [
        "化学实验基本原理与理论知识",
        "实验方案设计与条件选择依据",
        "仪器原理、使用规范与实验安全知识",
        "数据处理与误差分析方法"
      ],
      "common_deductions": [
        "安全知识题失分（赛前专设'学生安全指导'环节，安全为硬性要求）",
        "实验条件选择只记结论不懂原理",
        "数据处理公式与有效数字错误"
      ]
    },
    {
      "dimension": "实验基本技能与操作规范",
      "weight": "约30%（推断：实验操作竞赛为全天核心环节，操作规范为主要给分项）",
      "official_wording": "知乎赛事介绍：实验操作考试考察范围包括'化学实验基本技能、实验设计与操作、数据采集和分析'。历届操作赛设无机、有机综合实验（福州大学第十三届报名通知：'实验操作设无机、有机两个综合实验'）。【推断】操作规范约占30%。",
      "scoring_points": [
        "基本操作（称量、滴定、蒸馏、重结晶、无水无氧操作等）规范熟练",
        "仪器选用与装置搭建正确",
        "实验过程条理清晰、时间安排合理",
        "突发情况处置得当"
      ],
      "common_deductions": [
        "操作动作不规范（如移液、加热方式错误）",
        "装置搭建错误导致返工",
        "超时未完成规定实验步骤"
      ]
    },
    {
      "dimension": "实验结果与数据质量",
      "weight": "约30%（推断：历届评分标准对产率/纯度等结果指标按分值直接给分）",
      "official_wording": "第五届全国大学生化学实验邀请赛实验A评分标准（豆丁网存档）显示单场实验满分50分，评分项涉及'纯度、折光率'等结果指标。【推断】结果与数据质量约占30%。",
      "scoring_points": [
        "产品产率、纯度达到要求（如熔点/折光率/滴定结果在允差内）",
        "原始数据真实完整、记录规范（当场签字确认）",
        "数据处理与结果分析正确",
        "实验报告结论有据"
      ],
      "common_deductions": [
        "产率或纯度超出允许误差范围",
        "篡改/誊抄数据、记录不完整",
        "有效数字与单位错误"
      ]
    },
    {
      "dimension": "实验安全与行为规范",
      "weight": "定性：安全为一票否决式硬性要求（章程明示评分标准必须包含安全事项）",
      "official_wording": "全国大学生化学实验竞赛章程（试行）（浙江大学化学实验中心网站存档）：要求评分标准必须包含安全事项；第十一届赛程专设'学生安全指导'环节。",
      "scoring_points": [
        "护目镜、手套等防护装备全程规范佩戴",
        "危化品取用、废液分类处理合规",
        "遵守实验室纪律与监考指令"
      ],
      "common_deductions": [
        "违规操作引发安全事故（取消资格）",
        "废液乱倒、危险品处置违规",
        "未按要求佩戴防护装备"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "实验理论笔试答卷",
      "format": "闭卷笔试",
      "page_limit": "未明确",
      "deadline_note": "赛程第2天下午（第十一届为7月7日下午）"
    },
    {
      "item": "实验操作（无机+有机综合实验）",
      "format": "现场实验操作+原始数据记录+实验报告",
      "page_limit": "未明确",
      "deadline_note": "赛程第3天全天（第十一届为7月8日）"
    },
    {
      "item": "候选选手名单（参赛校提交）",
      "format": "按附件表格填写，Email至组委会",
      "page_limit": "未明确",
      "deadline_note": "第十一届要求5月31日前提交，6月中旬网上抽签产生每校3名正式选手"
    }
  ],
  "process_stages": [
    {
      "stage": "校内推荐与抽签定员",
      "format": "各校提交化学类三年级候选学生名单，组委会网上抽签",
      "notes": "按学生规模提交30%名单或30名（不足30人全报）；抽签产生每校3名正式参赛选手（另有1-2名带队教师），保证公平、防止应试集训"
    },
    {
      "stage": "实验理论笔试",
      "format": "闭卷笔试（半天）",
      "notes": "考察实验原理、设计、安全等；同期举行教师实验教学研讨会/全国大学化学实验教学研讨会"
    },
    {
      "stage": "实验操作竞赛",
      "format": "现场实验（全天），历届设无机、有机两个综合实验",
      "notes": "评委按操作规范、结果指标、数据记录现场评分；赛前进行学生安全指导"
    },
    {
      "stage": "闭幕式暨颁奖典礼",
      "format": "现场颁奖",
      "notes": "个人奖一、二、三等奖；以个人奖统计确定团体名次（历届做法取前6名；有届次为减少功利性不评集体奖，以当届为准）"
    }
  ],
  "review_format": "笔试统一阅卷评分，实验操作由评委依据评分表对操作规范、结果指标、原始记录与安全行为现场打分，两部分合成个人总分排序评奖。",
  "judge_preferences": [
    "基本功扎实：操作规范娴熟远胜花哨技巧（选手由抽签随机产生，无法突击包装）",
    "安全意识内化为本能，任何环节不违规",
    "数据真实：原始记录当场确认，误差在允差内",
    "笔试与操作均衡发展、总分制下无短板",
    "心理素质稳定，能按规定时间独立完成陌生综合实验"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "选手必须由组委会从候选名单中随机抽签产生，校方内定或替换选手属违规",
    "实验数据造假、篡改原始记录（原始记录需当场确认）",
    "违反实验安全规程可能被直接取消资格（评分标准必须包含安全事项）",
    "仅限化学类专业三年级在校本科生参赛（历届资格口径）",
    "竞赛为邀请制：仅受邀高校（历届以南开、吉大、北大、厦大、中山、浙大、武大、复旦、兰大、南大等轮值承办校为核心邀请约40余所）参赛，非受邀高校不可报名"
  ],
