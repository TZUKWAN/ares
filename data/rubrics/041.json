{
  "competition_id": 41,
  "competition_name": "BIM毕业设计创新大赛",
  "judging_dimensions": [
    {
      "dimension": "BIM模型质量（完整性、准确性、规范性）",
      "weight": "约35%【推断】",
      "official_wording": "官方未公开分项评分表；【推断】依据：大赛以\"BIM建模与应用\"为作品核心（各模块任务书要求土建/机电/深化设计建模），网络评审对象为提交的BIM模型+毕设报告，模型质量为首要评分对象；同类BIM赛事（如高校BIM应用技能大赛）模型准确性与规范性占最高权重",
      "scoring_points": [
        "模型几何与构件信息准确（轴网、标高、构件尺寸与图纸一致）",
        "建模完整性覆盖模块任务书范围（土建、机电、深化等按模块）",
        "构件命名、分类编码与模型拆分符合出图/算量规范",
        "模型可用于后续应用（出图、算量、施工模拟）而非展示壳"
      ],
      "common_deductions": [
        "模型与图纸/图纸会审口径不符、缺漏构件",
        "碰撞未检查、管线排布不合理",
        "模型精度虚高标注而实际LOD不符"
      ]
    },
    {
      "dimension": "模块任务应用深度与成果质量",
      "weight": "约25%【推断】",
      "official_wording": "大赛按模块分赛项（如A模块施工BIM建模与应用、F模块施工深化设计建模与应用、G模块BIM+工程项目管理应用等A-H模块，官网发布模块任务书）；【推断】依据：模块任务书规定的应用成果（出图、算量计价、施工方案、项目管理文档）是各模块差异化评审的依据",
      "scoring_points": [
        "按所报模块任务书要求逐项完成应用成果",
        "专业应用深度（如造价模块的工程量与计价准确性、项目管理模块的进度/成本联动）",
        "成果文件齐套（图纸、报表、模拟动画、应用文档）",
        "与毕业设计选题结合、体现毕设真实项目载体"
      ],
      "common_deductions": [
        "任务书要求的成果缺项",
        "应用停留在软件默认输出、无专业判断",
        "成果与模型脱节（模型一套、报表另一套）"
      ]
    },
    {
      "dimension": "创新性与新技术应用",
      "weight": "约20%【推断】",
      "official_wording": "大赛名称含\"创新\"，官方定位为推进教育数字化战略、BIM方向创新应用（第十一届更名公告及大赛宗旨）；【推断】依据：历届获奖作品报道均强调新技术与协同创新（BIM+、数字化、AI辅助）为亮点",
      "scoring_points": [
        "BIM+新技术融合（数字孪生、AI、GIS、IoT等）",
        "多专业协同工作模式与协作平台应用",
        "对实际工程痛点的创新解决方案",
        "自主二次开发/插件应用"
      ],
      "common_deductions": [
        "创新点仅是软件自带功能演示",
        "与工程实际脱节的炫技",
        "创新点无成果支撑"
      ]
    },
    {
      "dimension": "毕业设计报告与过程文档",
      "weight": "约10%【推断】",
      "official_wording": "网络评审提交材料含毕设报告（线上提交模型+报告，院校及企业专家线上综合评分——大赛评审流程报道）；【推断】报告规范性权重低于模型与应用",
      "scoring_points": [
        "报告结构完整（项目概况、技术路线、建模过程、应用成果、总结）",
        "图文对应、能复现工作过程",
        "符合毕业设计文档规范与查重要求"
      ],
      "common_deductions": [
        "报告模板化、图文不符",
        "工作过程不可追溯",
        "查重不达标"
      ]
    },
    {
      "dimension": "总决赛答辩与汇报",
      "weight": "约10%【推断】",
      "official_wording": "全国总决赛采用现场答辩形式，根据答辩评审结果按评分从高到低评奖（大赛流程：海选赛/晋级赛—全国总决赛，总决赛通过作品评审与答辩评定成绩——大赛官网及承办报道）",
      "scoring_points": [
        "汇报逻辑清晰、重点展示模型与应用成果",
        "现场操作演示真实流畅",
        "质询回答准确、团队全员参与",
        "作品与汇报内容一致"
      ],
      "common_deductions": [
        "汇报念稿、超时",
        "现场打不开模型或演示失败",
        "回答不出建模细节（疑似外包代做）"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "BIM模型成果",
      "format": "按所报模块任务书用指定/自选BIM软件建模（官网设软件下载专区），提交模型文件",
      "page_limit": "未明确",
      "deadline_note": "全国赛预报名（第十二届2025年9月16日-10月10日）后按赛程提交"
    },
    {
      "item": "毕业设计报告及成果包",
      "format": "毕设报告+图纸/报表/应用文档等模块规定成果，线上提交参加网络评审",
      "page_limit": "未明确",
      "deadline_note": "晋级赛后、全国总决赛前（约次年3-5月）"
    },
    {
      "item": "总决赛答辩材料",
      "format": "汇报PPT+现场/线上模型演示",
      "page_limit": "未明确",
      "deadline_note": "全国总决赛（常规赛道总决赛名单于赛前公布，决赛多在5月前后）"
    }
  ],
  "process_stages": [
    {
      "stage": "校赛/校内选拔（9-12月）",
      "format": "校级组织选拔（校赛获奖比例示例：一、二、三等奖按参赛队数10%、20%、40%）",
      "notes": "第十二届预报名2025年9月16日启动、10月10日结束；各校按大赛规定名额推荐晋级"
    },
    {
      "stage": "晋级赛/海选赛（网络评审）",
      "format": "线上提交BIM模型+毕设报告，院校及企业专家网络评审筛选",
      "notes": "按模块分组评审，公布常规赛道总决赛入围名单"
    },
    {
      "stage": "全国总决赛（约次年4-6月）",
      "format": "作品评审+现场答辩，按评分从高到低评奖",
      "notes": "本科组、专科组分别评奖；设特等奖/一等奖/二等奖/三等奖/优秀奖；大赛由行业企业（广联达等）支持承办"
    }
  ],
  "review_format": "网络评审（线上模型与毕设报告综合评分）+全国总决赛现场答辩，按A-H模块分赛项、本科/专科组分赛道从高到低评奖。",
  "judge_preferences": [
    "模型可用性优先：能出图、能算量、能支撑后续应用的模型重于展示模型",
    "严格对照模块任务书逐项验收成果，缺项直接失分",
    "看重真实项目载体与毕业设计的结合度",
    "答辩现场抽查建模过程，代做痕迹是红线",
    "BIM+新技术（AI、数字孪生、协同平台）是加分亮点"
  ],
