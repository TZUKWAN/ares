{
  "competition_id": 131,
  "competition_name": "“花旗杯”金融创新应用大赛",
  "judging_dimensions": [
    {
      "dimension": "创新性与商业价值（金融场景创新+商业计划）",
      "weight": "35%【推断权重，官方未公布评分细则】",
      "official_wording": "【推断】官方要求最终报告包含“项目报告（精益画布）”和“商业计划”（第二十届大赛报名通知，东北财经大学金融学综合实验教学中心发布），大赛主旋律为“创新与完善”（花旗杯百科词条）。推断依据：精益画布与商业计划文档占提交物一半，评审必然考核金融业务场景的创新价值与商业可行性",
      "scoring_points": [
        "选题切中银行/金融业务真实痛点，与花旗业务场景相关",
        "商业计划完整：用户画像、价值主张、盈利模式、市场分析",
        "精益画布逻辑清晰，假设-验证路径合理",
        "创新性突出而非成熟产品的简单复制"
      ],
      "common_deductions": [
        "选题空泛、与金融业务结合牵强",
        "商业计划只有技术描述没有市场与运营分析",
        "创意与市面既有金融产品同质化"
      ]
    },
    {
      "dimension": "技术实现与方案可行性",
      "weight": "35%【推断权重】",
      "official_wording": "【推断】官方要求最终报告提交“技术文档”，大赛前身为“‘花旗杯’金融与信息技术应用大赛”，由花旗软件发起、鼓励金融信息创新（第二十届报名通知；花旗杯百科）。推断依据：技术文档为独立提交物，评审重点包括系统方案与可实现的工程能力",
      "scoring_points": [
        "系统架构与技术选型合理，文档规范",
        "作品可演示、功能闭环（原型/系统可用）",
        "对数据安全、隐私合规等金融科技特有问题有处理",
        "合理运用大数据/AI/区块链等技术解决业务问题"
      ],
      "common_deductions": [
        "技术文档缺失或与作品脱节",
        "作品仅为概念演示、无法运行",
        "忽视金融数据合规与安全性设计"
      ]
    },
    {
      "dimension": "总决赛陈述与答辩表现",
      "weight": "30%【推断权重】",
      "official_wording": "官方原文：总决赛每队“10分钟陈述（由最多两名同学完成）和最多15分钟问答（由最多五名同学完成）”（第二十届大赛决赛安排）",
      "scoring_points": [
        "10分钟陈述讲清痛点-方案-价值主线，时间控制精准",
        "问答环节应答专业，最多五名队员可分工应答",
        "展示材料（PPT/演示）质量与团队专业形象",
        "对评委提出的业务与技术追问应对沉稳"
      ],
      "common_deductions": [
        "陈述超时或流于念稿",
        "答辩仅个别队员能答、其余队员不了解项目细节",
        "回答回避问题、业务理解浅薄"
      ]
    },
    {
      "dimension": "合规与原创性",
      "weight": "一票否决制（不单独计分，违规视同弃赛/取消资格）",
      "official_wording": "官方原文：最终报告须含“作品原创性声明”，“没有提交‘作品原创性声明’的团队视同弃赛”；每支参赛团队只可递交一份参赛作品（第二十届大赛报名通知）",
      "scoring_points": [
        "按时提交作品原创性声明",
        "作品为团队原创，无抄袭、无侵权",
        "每队仅递交一份参赛作品，符合组队与指导教师人数规定"
      ],
      "common_deductions": [
        "漏交原创性声明直接视同弃赛",
        "作品涉嫌抄袭或使用未授权数据/代码",
        "一队多投或队伍构成不符合规定"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "中期报告",
      "format": "项目报告（精益画布），线上提交，仅一份",
      "page_limit": "未明确",
      "deadline_note": "第二十届为2025年2月28日；仅供评委会参考，不计入最终成绩"
    },
    {
      "item": "最终报告（作品提交）",
      "format": "四件套：项目报告（精益画布）、商业计划、技术文档、作品原创性声明（缺声明视同弃赛），线上提交",
      "page_limit": "未明确",
      "deadline_note": "第二十届为2025年3月24日中午12时前"
    },
    {
      "item": "总决赛陈述材料",
      "format": "陈述PPT与作品演示（10分钟陈述，最多2人；15分钟问答，最多5人）",
      "page_limit": "10分钟+15分钟",
      "deadline_note": "全国总决赛及颁奖典礼于5-6月举行（第二十届为线上）"
    }
  ],
  "process_stages": [
    {
      "stage": "启动仪式与报名",
      "format": "当届在合作高校举行启动仪式（第二十届2024年11月2日于南京大学、第二十一届2025年12月1日于东北财经大学启动），全国在校大学生组队报名（每队至少3人，建议跨IT与金融专业，≤2名指导教师）",
      "notes": "第二十届报名截止2025年1月3日中午12时；花旗2004年4月设立花旗金融信息科技教育项目，大赛2005年创立于上海，2025-2026年为第二十一届"
    },
    {
      "stage": "中期报告与系列研讨会",
      "format": "线上提交项目报告（精益画布）；赛前组织技术、业务、就业与创业等专题研讨培训",
      "notes": "中期报告不计入最终成绩；研讨会自1月持续至总决赛前"
    },
    {
      "stage": "全国预选赛",
      "format": "组委会与评委会对最终报告（精益画布+商业计划+技术文档+原创性声明）书面评审，评出全国20强",
      "notes": "第二十届评选期2025年3月25日至5月8日，5月9日揭晓；20强中最多10个名额优先预留给“花旗挑战”选题作品，其余不分选题按作品评分高低依次决出"
    },
    {
      "stage": "全国总决赛与颁奖典礼",
      "format": "每队10分钟陈述+最多15分钟问答，评出最终奖项；“花旗挑战”设单项特别奖",
      "notes": "第二十届总决赛暨颁奖典礼2025年6月在南京大学举行；前20强队伍获证书与奖金，计算机/软件/信息管理专业学生经面试通过可获花旗金融信息实习机会，其他专业优先推荐至花旗银行"
    }
  ],
  "review_format": "书面预选赛评审（精益画布、商业计划、技术文档，评出全国20强）+总决赛现场（或线上）陈述答辩评审（10分钟陈述+15分钟问答），花旗挑战选题享有晋级名额倾斜。",
  "judge_preferences": [
    "跨IT与金融的复合型组队和复合视角方案（官方明文建议跨专业组队）",
    "接受“花旗挑战”命题的作品优先晋级20强，紧扣花旗给出的业务命题更占优",
    "商业计划与技术文档并重：既有金融业务洞察又有可信的技术路线",
    "精益画布方法论规范、假设清晰、验证路径完整",
    "陈述答辩体现团队协作与专业素养，与花旗业务场景结合度高的作品受青睐"
  ],
