    {
      "item": "决赛演示设备与PPT",
      "format": "自带作品、文档及测试设备现场演示；承办方提供因特网接入",
      "page_limit": "答辩30分钟（PPT陈述+演示+测试+专家提问）",
      "deadline_note": "第十八届决赛2025年8月14-15日（西安交通大学承办）"
    }
  ],
  "process_stages": [
    {
      "stage": "报名与校内认可（作品赛）",
      "format": "官网注册报名，每队≤4名学生（含1名组长）+1名指导教师，不可跨校组队，每生限1队",
      "notes": "2025年5月20日—6月25日；参赛队须报本校教学管理部门认可；参赛费200元/队"
    },
    {
      "stage": "初赛（全国网络评审，作品赛）",
      "format": "全国专家网评：每件作品至少3位专家按评审规则打分并给出评审意见，专家组据此确定决赛名单",
      "notes": "2025年7月20日公示决赛名单；决赛名额由专家组根据参赛队伍总数及作品质量确定"
    },
    {
      "stage": "决赛（作品演示+答辩，作品赛）",
      "format": "现场演示+30分钟答辩（PPT陈述、演示、测试、专家提问+源代码检查）；分项打分、集体讨论、结合网评结果综合评定获奖等级",
      "notes": "一等奖原则上不超过进入决赛队伍的1/5，二等奖不超过1/3；第十八届2025年8月14-15日西安交通大学承办"
    },
    {
      "stage": "创新实践能力赛（CTF对抗赛，与作品赛并列赛道）",
      "format": "线上初赛→分赛区半决赛→全国决赛：CTF夺旗模式按Flag分值实时排名（Web/Reverse/Pwn/Crypto/Misc），决赛另设分组对抗赛（封闭环境AWD攻防）",
      "notes": "第十六届CTF赛决赛时间为7月25-26日；按分值客观排名，无答辩环节；与作品赛在报名、赛制、评审上完全独立"
    }
  ],
  "review_format": "作品赛：'网评（≥3位专家依评审规则打分）+决赛现场演示答辩（30分钟含源代码检查）分项打分、集体讨论、结合网评结果综合评定'；CTF对抗赛：平台按Flag得分实时排名的纯客观评审",
  "judge_preferences": [
    "作品赛看重'原创性+完成度+性能数据'三位一体，文档与可执行程序必须对得上",
    "选题前沿：AI安全、数据安全、内容安全等新兴领域受鼓励；国产密码与国产软硬件为加分导向",
    "答辩敢让专家翻源码：工程实现真实可复现是最强说服力",
    "应用价值讲落地：真实场景、可部署、有测试数据",
    "CTF赛只认成绩：解题硬度、速度与AWD攻防综合实力"
  ],
