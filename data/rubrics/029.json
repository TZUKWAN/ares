{
  "competition_id": 29,
  "competition_name": "信息安全竞赛",
  "judging_dimensions": [
    {
      "dimension": "原创性与创新性（作品赛）",
      "weight": "网评首要维度（官方定性：'专家网络评审的主要内容包括：作品的原创性与创新性、作品完成程度、作品的性能、作品的应用价值、相关文档的规范性等'，未公开分值）",
      "official_wording": "第十八届作品赛参赛指南（官网原文）：'专家网络评审的主要内容包括：作品的原创性与创新性、作品完成程度、作品的性能、作品的应用价值、相关文档的规范性等'；'参赛作品要体现一定的创新性和实用性'。",
      "scoring_points": [
        "自主命题、自主设计：选题有新意，鼓励人工智能安全等新兴前沿领域",
        "核心技术点原创：算法/机制/工具链有明确创新，非开源项目拼装",
        "创新点在安全攻防场景中有真实意义（检测能力、防御强度、性能提升）",
        "结合国产密码技术、国产软硬件获得导向加分"
      ],
      "common_deductions": [
        "抄袭、剽窃、一稿多投→取消参赛资格并追责指导教师和高校",
        "已在其他公开竞赛获奖或已具商业价值的产品参赛（违规不得参赛）",
        "创新点经不起专家现场质询与源代码检查"
      ]
    },
    {
      "dimension": "作品完成程度与性能（作品赛）",
      "weight": "网评+决赛双环节权重项（官方定性；决赛答辩30分钟含演示、测试与专家提问）",
      "official_wording": "第十八届作品赛参赛指南：初赛需提交'竞赛作品的设计报告、测试报告、作品简介等文档资料和可执行程序'，含'系统设计方案：功能、指标、实现原理、硬件框图、软件流程等'与'系统测试方案：测试设备、测试数据、结果分析'；决赛'答辩时间为30分钟，包括PPT陈述、演示、测试与专家提问，专家会现场检查源代码'。",
      "scoring_points": [
        "功能完整可运行：可执行程序现场演示流畅、与设计报告一致",
        "性能指标有实测数据：检测率/误报率/吞吐/时延等量化验证",
        "系统架构合理：硬件框图、软件流程、模块划分清晰可追溯",
        "测试方案严谨：测试设备、测试数据、结果分析齐备"
      ],
      "common_deductions": [
        "现场演示失败或功能与文档不符",
        "专家现场检查源代码时无法对应演示功能",
        "宣称指标无测试数据支撑"
      ]
    },
    {
      "dimension": "应用价值与文档规范性（作品赛）",
      "weight": "网评维度（官方定性；文档含设计报告/测试报告/作品简介/参赛作品声明）",
      "official_wording": "第十八届作品赛参赛指南：需提交'参赛作品声明：版权，技术公开等'；决赛'评审专家对每个竞赛作品实行分项打分，集体讨论，结合网评结果综合评定'；作品内容以信息安全技术与应用设计为主，覆盖系统安全、应用安全（内容安全）、网络安全、数据安全和安全检测五大类。",
      "scoring_points": [
        "应用场景真实：解决行业/社会的实际安全问题",
        "推广价值：可部署性、兼容性与成本考量",
        "设计报告结构完整、术语规范、图示清晰",
        "版权与技术公开声明完备，无知识产权纠纷"
      ],
      "common_deductions": [
        "文档潦草、缺测试报告或版权声明",
        "应用场景空泛、无真实需求论证",
        "涉及知识产权纠纷"
      ]
    },
    {
      "dimension": "攻防解题能力（创新实践能力赛/CTF对抗赛）",
      "weight": "客观计分：按获取Flag分值实时排名（平台自动判定），非答辩制评审",
      "official_wording": "第十六届全国大学生信息安全竞赛通知（官网）：'赛中，参赛队伍通过与在线环境交互或文件离线分析，解决网络安全技术挑战并获取题目预设的Flag值从而获取相应分值'，'排名采用CTF夺旗赛规则，按分值实时排名'；赛程为线上初赛→分赛区半决赛→决赛，另设分组对抗赛在封闭真实对抗环境（AWD攻防模式）进行。",
      "scoring_points": [
        "Web漏洞挖掘与渗透、二进制逆向、Pwn（漏洞利用）、密码学、Misc五大类解题得分",
        "解题速度与一血奖励（先解出队伍可获额外加分/领先优势）",
        "团队分工协作：方向专精互补、题目调度策略",
        "决赛分组对抗（AWD）：攻守兼备——加固自家靶机、攻击他队得分"
      ],
      "common_deductions": [
        "使用平台外攻击手段、干扰他人比赛环境",
        "flag作弊、共享解题脚本（成绩作废）",
        "对抗赛中只攻不守或宕机失分"
      ]
    },
    {
      "dimension": "合规性与防御性导向（两赛通用红线）",
      "weight": "否决性维度：题目与内容违规直接丧失资格",
      "official_wording": "第十八届作品赛参赛指南：'本赛事只接受防御性的题目，不接受任何具有攻击性质或与国家有关法律、法规相违背的题目'；指导教师须'确保其不具攻击性，以及不与国家法律、法规相违背'；'凡在其他公开竞赛（不含校内比赛）中获奖的作品不得参赛'。",
      "scoring_points": [
        "作品定位为防御/检测/防护类技术",
        "遵守《网络安全法》《数据安全法》等法规",
        "作品为队员独立设计开发的原创成果",
        "团队信息真实：在校生身份、不可跨校组队"
      ],
      "common_deductions": [
        "题目含攻击性质或涉违法内容→要求修改或取消资格",
        "队员身份不符（非全日制在校生）→取消参赛或获奖资格",
        "参赛队未按时交纳200元/队参赛费或高校未提交离线光盘备案→取消比赛资格"
      ]
    }
  ],
