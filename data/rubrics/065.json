{
  "competition_id": 65,
  "competition_name": "化工实验大赛",
  "judging_dimensions": [
    {
      "dimension": "化工原理理论考试（机考）",
      "weight": "40%（官方明文）",
      "official_wording": "总决赛团体成绩为所有参赛队员个人总成绩的加权平均值。（A）化工原理理论成绩占40%。（B）化工单元仿真操作成绩占20%，（C）化工原理实验成绩占40%（关于第三届全国大学生化工实验大赛总决赛的通知，中国化工教育协会官网）；第七届报道同样载明\"参赛团队总成绩由理论（40%）、仿真（20%）和实验（40%）组成\"",
      "scoring_points": [
        "流体流动、传热、精馏、吸收、萃取、干燥等化工原理核心知识点覆盖",
        "客观题机考，答题速度与准确率并重",
        "对单元操作原理、设备结构与影响因素的概念清晰",
        "工程计算能力：物料衡算、热量衡算、塔板/填料层计算"
      ],
      "common_deductions": [
        "概念辨析题失分（如返混、液泛、漏液等机理表述）",
        "计算题单位换算与有效数字错误",
        "偏重记忆忽视理解，综合分析题崩盘"
      ]
    },
    {
      "dimension": "化工单元仿真操作（机考，软件智能评分）",
      "weight": "20%（官方明文）",
      "official_wording": "（B）化工单元仿真操作成绩占20%（第三届总决赛通知）；仿真考核成绩由仿真操作软件评分系统评分（第十四届全国大学生化学实验竞赛通知对同类考核的表述）",
      "scoring_points": [
        "开车、正常运行、停车的标准操作顺序",
        "关键工艺参数（流量、温度、压力、液位）控制平稳度",
        "事故诊断与排除的响应正确性",
        "操作质量由仿真软件自动评分：步骤分+质量分+时间分"
      ],
      "common_deductions": [
        "操作顺序颠倒导致连锁报警扣分",
        "参数超调频繁、稳定时间过长",
        "冷态开车漏步骤（如未暖管、未建立回流）"
      ]
    },
    {
      "dimension": "化工原理实验操作（现场实操+实验报告）",
      "weight": "40%（官方明文）",
      "official_wording": "（C）化工原理实验成绩占40%（第三届总决赛通知）；实验操作采用现场实操并撰写实验报告（赛事规程表述）",
      "scoring_points": [
        "实验设计合理性：流程组织、测量点位与变量控制",
        "规范操作：设备启停顺序、读数规范、安全意识（含防护用品佩戴）",
        "数据记录与处理：原始数据规范、作图、回归、误差分析",
        "实验报告质量：结果讨论与现象解释的深度",
        "团队分工协作与时间管理"
      ],
      "common_deductions": [
        "操作顺序错误引发安全风险（评委重点扣分项）",
        "数据记录涂改、编造平滑数据",
        "报告分析浅表，只报数据不解释",
        "超时未完成规定实验内容"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "无作品类提交物，全程为考核式竞赛",
      "format": "理论机考+仿真机考+现场实验操作及实验报告",
      "page_limit": "未明确",
      "deadline_note": "以各环节当场完成时限为准"
    },
    {
      "item": "报名（以学校为单位组队）",
      "format": "每支参赛队3名本科在校生，设指导教师；官网注册报名",
      "page_limit": "未明确",
      "deadline_note": "各分赛区通知发布后报名；总决赛通常8月中旬举行（第九届2026年8月8-11日郑州大学）"
    }
  ],
  "process_stages": [
    {
      "stage": "校内选拔（学校推选）",
      "format": "各校自行组织（部分校赛如理论70%+仿真30%）",
      "notes": "推选队伍代表学校进入赛区"
    },
    {
      "stage": "分赛区初赛",
      "format": "按华北、华东、中南、西南等赛区组织，考核内容与总决赛相同（理论+仿真+实验）",
      "notes": "赛区获奖并按名额推荐晋级全国总决赛；如深圳大学获中南赛区特等奖后晋级总决赛"
    },
    {
      "stage": "全国总决赛",
      "format": "集中现场赛（约18所高校团队入围，第九届于郑州大学举行）",
      "notes": "团体成绩=队员个人总成绩（理论40%+仿真20%+实验40%）的加权平均值"
    },
    {
      "stage": "评奖与证书",
      "format": "总决赛设特等奖、一等奖、二等奖及优秀组织奖",
      "notes": "成绩达标者可自愿申请中国化工教育协会颁发的化工技术基础实验能力证书"
    }
  ],
  "review_format": "客观化考核式评审：理论机考、仿真软件自动评分、实验操作由评委现场按规程评分并结合实验报告，按官方权重加权计算个人与团体成绩",
  "judge_preferences": [
    "实验操作规范性与安全意识是一票否决式的底线偏好",
    "偏好数据真实、误差分析扎实的学生（反感编造\"漂亮\"数据）",
    "仿真操作追求稳、准、顺序正确而非抢速度",
    "团队三人水平均衡比一人拔尖更重要（团体成绩为个人加权平均）"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "实验操作违反安全规程（如未佩戴防护用品、违规操作带压设备）将被严厉扣分甚至取消资格",
    "弄虚作假（编造实验数据、替考）取消成绩",
    "总决赛须由入围学校原队参赛，队员替换须按规程报批",
    "不得向学生个人收取参赛费用（由学校承担）为通行要求"
  ],
