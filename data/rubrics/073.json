{
  "competition_id": 73,
  "competition_name": "能源经济学术创意大赛",
  "judging_dimensions": [
    {
      "dimension": "研究成果及创新性（论文类）",
      "weight": "35%（官方）",
      "official_wording": "第十一届全国大学生能源经济学术创意大赛通知（浙江财经大学经济学院转发，引自组委会附件1评分标准）：研究论文类\"研究成果及创新性35%、选题意义15%、写作能力15%、表达演讲15%、规范性10%、领域相关性10%\"。",
      "scoring_points": [
        "研究结论有新意：新问题、新数据、新方法或新机制解释",
        "实证/建模结果严谨，研究贡献明确",
        "紧扣能源经济前沿议题（双碳、能源转型、电力市场、能源金融等）",
        "理论分析与经验证据相互支撑"
      ],
      "common_deductions": [
        "选题陈旧、直接套用现成模板无增量",
        "模型与结论脱节，为创新而创新",
        "泛能源大数据类作品若创新性不足（该类创新性占45%权重）失分更重"
      ]
    },
    {
      "dimension": "选题意义（论文类）",
      "weight": "15%（官方）",
      "official_wording": "同上第十一届通知附件1评分标准。",
      "scoring_points": [
        "选题服务国家能源战略与\"双碳\"目标",
        "问题有明确现实背景与政策含义",
        "研究对象属于能源经济领域核心议题",
        "切口具体，避免大而空"
      ],
      "common_deductions": [
        "选题与能源经济领域关联弱",
        "问题含糊、研究目的不清",
        "纯思辨题目无数据支撑"
      ]
    },
    {
      "dimension": "写作能力与规范性（论文类）",
      "weight": "25%（官方：写作能力15%+规范性10%）",
      "official_wording": "同上第十一届通知附件1评分标准（写作能力15%、规范性10%）；作品必须匿名、查重率不超过15%（第十一届通知）。",
      "scoring_points": [
        "学术论文结构完整（摘要、引言、文献、方法、实证、结论）",
        "图表公式规范，参考文献与数据来源标注完整",
        "匿名合规：全文不出现学校、姓名、导师信息",
        "查重率不超过15%，附《诚信承诺书》"
      ],
      "common_deductions": [
        "出现学校/姓名/导师信息，初审直接淘汰",
        "查重超15%被取消资格",
        "格式不符、缺承诺书"
      ]
    },
    {
      "dimension": "表达演讲（现场展示，论文类/决赛）",
      "weight": "15%（官方）",
      "official_wording": "同上第十一届通知附件1评分标准（表达演讲15%）；校赛决赛形式为\"展示5分钟+答疑4分钟\"，全国总决赛采取\"书面评审+现场决赛\"模式。",
      "scoring_points": [
        "陈述逻辑清晰，能讲清问题—方法—结论链条",
        "PPT专业精炼，核心结果一目了然",
        "限时展示内完成（超时扣分）",
        "答疑回应准确沉稳"
      ],
      "common_deductions": [
        "答辩口径与论文数据不符",
        "严重超时或念稿",
        "核心成员答不上方法细节"
      ]
    },
    {
      "dimension": "领域相关性（论文类）",
      "weight": "10%（官方）",
      "official_wording": "同上第十一届通知附件1评分标准。",
      "scoring_points": [
        "研究对象、数据与政策场景属于能源经济范畴",
        "跨学科作品（泛能源大数据类）需体现\"能源+X\"交叉属性",
        "调研报告类需针对能源经济领域重要议题与社会现状"
      ],
      "common_deductions": [
        "与能源领域无关的泛经管题目",
        "交叉类作品交叉点牵强"
      ]
    },
    {
      "dimension": "非论文类作品评审口径（调研报告/创新创业设计/泛能源大数据）",
      "weight": "官方权重：调研报告类创新性40%+可行性30%+规范性20%+领域相关性10%；创新创业类创新/创意/创业/演讲/文案各20%；大数据类创新性45%+立项依据20%+相关性20%+规范性15%",
      "official_wording": "第十一届通知（浙江财经大学）：\"调研报告类：创新性40%、可行性30%、规范性20%、领域相关性10%\"；\"创新创业类：创新、创意、创业、演讲、文案各20%\"；\"泛能源大数据类：创新性45%、立项依据20%、相关性20%、规范性15%\"；组委会对非研究论文类作品评审给予适当倾斜。",
      "scoring_points": [
        "调研报告类：一手数据扎实、方案可执行、结论可信",
        "创新创业类：商业创意与能源场景结合，演讲与文案均衡",
        "泛能源大数据类：数据规模与处理能力、AI/大数据方法运用、立项依据充分"
      ],
      "common_deductions": [
        "调研报告缺一手数据、拼凑二手资料",
        "创业类作品只有点子无落地路径",
        "大数据类只堆技术指标无能源业务含义"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "研究论文类作品（能源经济类/能源金融与管理类）",
      "format": "规范学术论文（中英文均可，自行命题），匿名PDF，按组委会附件1排版",
      "page_limit": "未明确（按附件1格式要求）",
      "deadline_note": "提交窗口约2月底-3月中旬（第十一届为2025年2月24日-3月11日24:00），仅限官网提交且递交后不可撤回修改"
    },
    {
      "item": "调研报告类作品",
      "format": "调研报告，匿名，含一手调研数据说明",
      "page_limit": "未明确",
      "deadline_note": "同上统一提交窗口"
    },
    {
      "item": "创新创业设计类/泛能源大数据类作品",
      "format": "按当届通知附件要求（创业计划书/大数据作品及说明）",
      "page_limit": "未明确",
      "deadline_note": "同上统一提交窗口"
    },
    {
      "item": "诚信承诺书与查重报告",
      "format": "手签或电子签承诺书；知网等查重报告",
      "page_limit": "查重率≤15%",
      "deadline_note": "随作品提交，超15%取消资格；赛后2小时内可书面申诉"
    },
    {
      "item": "决赛展示PPT",
      "format": "PPT现场展示",
      "page_limit": "未明确",
      "deadline_note": "晋级校赛决赛/区域赛/总决赛后按要求提交；展示约5分钟+答疑4分钟（以当届规程为准）"
    }
  ],
  "process_stages": [
    {
      "stage": "报名（官网实名注册）",
      "format": "唯一报名渠道为大赛官网报名系统",
      "notes": "约10-11月报名（第十一届2024年10月14日-11月17日）；团队不超过3人、指导教师不超过2人；每生最多参与2个作品、作为第一作者仅限1项"
    },
    {
      "stage": "校赛（校内选拔）",
      "format": "形式审查（匿名材料）→专家书面评审→\"书面评审+现场决赛\"（展示5分钟+答疑4分钟）",
      "notes": "按成绩排序，有效作品的35%晋级区域赛（非论文类作品不低于40%）；论文组与非论文组分别排序推荐"
    },
    {
      "stage": "区域赛（省赛）",
      "format": "分赛区专家评审",
      "notes": "约3-4月进行；评出区域赛奖项并按名额推荐入围全国总决赛"
    },
    {
      "stage": "全国总决赛",
      "format": "书面评审+现场决赛（现场展示与答辩）",
      "notes": "约5月中下旬（第十一届总决赛承办：山西财经大学）；第十届561所院校8963项有效作品，研究论文类特等奖仅10项；获奖证书赛后一周内官网可下载"
    }
  ],
  "review_format": "匿名作品专家书面评审（统一评审标准表）+ 晋级赛段现场展示答辩，按四类作品分别适用官方权重评分。",
  "judge_preferences": [
    "创新性为第一权重（论文类35%、大数据类45%），首选新问题、新数据、新方法",
    "紧扣\"双碳\"与能源转型政策语境，领域相关性是门槛",
    "非论文类作品（调研报告、创业设计、大数据）评审有适当倾斜，鼓励多元形态",
    "学术规范红线意识强：匿名、查重≤15%、承诺书缺一不可",
    "现场表达与答疑能力影响决赛名次"
  ],
