  "process_stages": [
    {
      "stage": "网络报名与立项（前一年8月-当年1-3月）",
      "format": "官网/官方平台注册报名，上传研究综述与实验设计，缴纳报名费",
      "notes": "2026届：8月1日下发通知开始报名，1月15日报名截止，1月31日综述与实验设计截止"
    },
    {
      "stage": "研究实施与过程记录（3-6月）",
      "format": "开展实验并在平台持续上传实验记录，撰写论文",
      "notes": "实验记录为网评最重要材料（50分）"
    },
    {
      "stage": "网络评审（网评）",
      "format": "专家网上评审：科学探究类按立项报告20+实验记录50+论文25+心得5打分",
      "notes": "无省赛的省份依据网评成绩组织省级选拔（网评成绩占比不低于50%）"
    },
    {
      "stage": "决赛（省赛决赛与全国决赛，约7-8月）",
      "format": "现场答辩，专家独立评分；最终成绩=网评50%+答辩50%",
      "notes": "同一学院推荐国赛团队数不超过所在省推荐总数的15%；创新创业类决赛为项目路演答辩"
    }
  ],
  "review_format": "以官方平台材料为基础的专家网络评审（探究类立项20/记录50/论文25/心得5）加现场答辩，决赛成绩网评与答辩各占50%，创新创业类按创新组/创业组网评参考标准评审后路演答辩。",
  "judge_preferences": [
    "高度重视原始实验记录的真实性与连续性（占网评一半），这是本赛事区别于其他竞赛的最大特点",
    "探究类重学术规范：统计正确、数据可溯源、结论克制",
    "警惕包装式申报，过程材料与论文不一致会被重点质疑",
    "创新创业类创业组关注技术壁垒与商业逻辑自洽，而非纯概念",
    "答辩考察学生真实参与度，教师包办是扣分重灾区"
  ],
