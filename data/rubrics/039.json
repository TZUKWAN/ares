{
  "competition_id": 39,
  "competition_name": "全国大学生生命科学竞赛",
  "judging_dimensions": [
    {
      "dimension": "立项与研究设计（立项报告/研究综述与实验设计）",
      "weight": "网评成绩的20%（立项报告20分/网评总分100分，科学探究类官方网评标准）",
      "official_wording": "第九届全国大学生生命科学竞赛（科学探究类）通知（高校转发组委会通知）：\"网络评审的总分为100分，包括立项报告20分、实验记录50分、论文25分、心得5分\"",
      "scoring_points": [
        "选题的科学意义与创新性（生命科学前沿或实际问题）",
        "研究综述全面、假说与科学问题清晰",
        "实验设计逻辑严密、技术路线可行",
        "立项依据与参考文献规范"
      ],
      "common_deductions": [
        "科学问题模糊、综述堆砌无评述",
        "实验设计与假设脱节",
        "技术路线不可行、样本量与对照缺失"
      ]
    },
    {
      "dimension": "实验记录与过程真实性",
      "weight": "网评成绩的50%（实验记录50分/网评总分100分，单项权重最高）",
      "official_wording": "同上通知：\"实验记录50分\"为网评占比最高项；竞赛要求实验记录在官方平台持续上传，体现对\"真实、完整、原始实验过程记录\"的重视",
      "scoring_points": [
        "原始记录真实完整（日期、条件、原始数据/图像）",
        "记录连续性好、覆盖研究全程（平台按节点上传）",
        "失败与异常数据如实记录并分析",
        "记录与最终论文数据可互相印证"
      ],
      "common_deductions": [
        "记录拼凑、集中补记、字迹与时间明显不符",
        "只有成功结果、无失败与重复记录",
        "记录数据与论文数据对不上"
      ]
    },
    {
      "dimension": "研究成果与论文质量",
      "weight": "网评成绩的25%（论文25分/网评总分100分）",
      "official_wording": "同上通知：\"论文25分\"",
      "scoring_points": [
        "结论由数据严格支撑、统计学方法正确",
        "创新发现或验证价值明确",
        "论文结构规范、图表与文献引用规范",
        "成果与立项目标呼应"
      ],
      "common_deductions": [
        "数据统计处理错误或过度解读",
        "论文写成综述/实验报告体",
        "署名与实际贡献不符"
      ]
    },
    {
      "dimension": "学习心得与人才培养过程",
      "weight": "网评成绩的5%（心得5分/网评总分100分）",
      "official_wording": "同上通知：\"心得5分\"",
      "scoring_points": [
        "真实反映科研训练过程与收获",
        "团队分工与个人成长可考",
        "对科学研究的理解与反思"
      ],
      "common_deductions": [
        "心得空洞套话、与项目脱节",
        "由教师或AI代写痕迹明显"
      ]
    },
    {
      "dimension": "决赛现场答辩",
      "weight": "决赛总成绩的50%（网评成绩占50%）",
      "official_wording": "云南赛区决赛报道：\"决赛最终成绩和名次根据网评成绩和专家组现场给出的答辩成绩各占50%的记分规则评定，各评审专家独立评分\"；四川赛区决赛报道同口径；第十一届通知：\"省赛决赛中网络评审成绩占50%\"（第八届通知表述为\"不低于50%\"）",
      "scoring_points": [
        "陈述逻辑清晰、重点突出（限时汇报）",
        "回答质询准确、学术基本功扎实",
        "PPT与讲解数据一致、图表规范",
        "全员参与，主讲人应为实际贡献者"
      ],
      "common_deductions": [
        "超时被截断汇报",
        "回答不出实验细节（怀疑未实际参与）",
        "答辩内容与上传材料不一致"
      ]
    },
    {
      "dimension": "创新创业类（创新组/创业组）网评与路演",
      "weight": "按组委会《创新组和创业组作品网评参考标准》百分制打分（网评分数与决赛答辩成绩综合评定，具体分值官方未公开）【推断】",
      "official_wording": "组委会通知随附《创新组和创业组作品网评参考标准.pdf》（浙江树人学院第十届等高校转发）；参赛材料包括\"作品申报书、项目介绍文档、展板设计、演示视频\"等；创新创业类分创新组（学术论文/作品）与创业组（创业计划书，含实践类和创意类）",
      "scoring_points": [
        "创新组：作品的科学性、创新性与学术价值",
        "创业组：技术可行性、商业模式与市场分析、财务与团队",
        "成果转化潜力与产业结合度",
        "展板、演示视频与路演表达"
      ],
      "common_deductions": [
        "创业组商业计划流于概念、无技术壁垒论证",
        "知识产权归属不清",
        "路演与书面材料数据不一致"
      ]
    }
  ],
