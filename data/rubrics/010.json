{
  "competition_id": 10,
  "competition_name": "全国大学生广告艺术大赛",
  "judging_dimensions": [
    {
      "dimension": "命题契合度（策略单理解与品牌诉求达成）",
      "weight": "30%【推断权重，官方未公布分值细则】",
      "official_wording": "参赛作品必须按照大广赛组委会统一指定的命题和规定的企业背景资料进行创作（大广赛官网参赛指南；北京市教委第十八届大广赛北京赛区通知）",
      "scoring_points": [
        "是否准确理解命题策略单中的品牌背景、营销目标与目标人群",
        "作品传达的信息与品牌诉求/公益主张一致",
        "对策略单限定条件（口号、必现元素、禁用情形）的完整执行",
        "科技类作品须使用AI工具辅助并附原始输出"
      ],
      "common_deductions": [
        "偏离命题、自拟题目创作（非命题类外一律按命题要求）",
        "遗漏策略单必现品牌元素或口号",
        "公益/科技单元未按对应命题创作"
      ]
    },
    {
      "dimension": "创意水平（洞察力与原创性）",
      "weight": "30%【推断权重】",
      "official_wording": "大赛坚持原创，鼓励广告新思维、新形式、新媒介（大广赛章程/参赛指南精神）",
      "scoring_points": [
        "核心创意的独特性与记忆点",
        "对消费者洞察的新颖与深度",
        "创意与品牌卖点的关联强度（不牵强）",
        "系列作品的统一创意概念"
      ],
      "common_deductions": [
        "创意俗套、与历届获奖作品雷同",
        "卖点与创意脱节、为创意而创意",
        "涉嫌抄袭或过度模仿已有广告"
      ]
    },
    {
      "dimension": "表现力与制作质量",
      "weight": "25%【推断权重】",
      "official_wording": "各类作品须符合类别规格与制作要求（北京市教委第十八届通知对各类别格式/时长/清晰度的规定）",
      "scoring_points": [
        "画面/镜头语言/剪辑节奏/配乐等专业完成度",
        "文案类作品的语言功力（长文案100-500字的表达质量）",
        "策划案的结构完整性、可执行性与媒介策略合理性",
        "技术规格达标（A3 300dpi、16:9、24帧/秒、二维码可跳转等）"
      ],
      "common_deductions": [
        "画面粗糙、音画不同步、字幕错误",
        "策划案只有创意没有执行计划与预算媒介排期",
        "文件规格不达标（尺寸、时长、文件超限）影响评审"
      ]
    },
    {
      "dimension": "规范性与合规性",
      "weight": "15%【推断权重】",
      "official_wording": "作品须为本人原创，拥有独立知识产权，遵守《广告法》；作品不得出现院校姓名等信息（大广赛参赛指南、北京赛区通知）",
      "scoring_points": [
        "原创性与独立知识产权",
        "符合《广告法》对广告内容的要求",
        "署名/人数/报送程序合规（一次参赛、两次提交）",
        "不出现学校与个人信息"
      ],
      "common_deductions": [
        "一稿多投（同一作品按不同类别提交、创意雷同按不同命题提交、他赛作品转投）取消资格",
        "作品出现院校或作者信息",
        "跨赛区、跨学校组队"
      ]
    },
    {
      "dimension": "营销创客单元实战数据（该单元单独适用）",
      "weight": "官方未公布权重（定性评审+运营数据量化指标综合；命题类作品不适用此项，前四项加总100%）",
      "official_wording": "营销创客类（电商短视频、网络直播）实战阶段评分标准包含：视频发布数量、总播放量、点赞量、评论量、转发量、截止日期直播间粉丝量、选品等实际运营数据（大广赛官网营销创客类竞赛文件）",
      "scoring_points": [
        "短视频/直播的真实运营数据（播放、点赞、评论、转发、粉丝量）",
        "选品策略与带货转化",
        "微短剧/AIGC微短剧的完成度与传播效果",
        "分区域选拔赛-实战竞技赛-全国总决赛逐级表现"
      ],
      "common_deductions": [
        "数据造假或刷量",
        "未在规定平台/截止日期前完成发布",
        "内容违规被平台下架"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "平面类作品",
      "format": "A3、RGB、300dpi，jpg格式，一组不超过3张页面，单文件≤5MB",
      "page_limit": "一组≤3幅",
      "deadline_note": "2026年5月10日平台开放，6月12日16:00线上提交关闭（第十八届）"
    },
    {
      "item": "视频类/动画类作品",
      "format": "mp4；影视广告15/30秒、微电影60-180秒（16:9）、短视频15-60秒（竖屏9:20至9:16）、动画15/30秒24帧/秒；微电影≤50MB、其余≤30MB，动画须配音配乐",
      "page_limit": "时长按类别15秒-180秒",
      "deadline_note": "同上；作者≤3人（短视频），微电影等≤5人"
    },
    {
      "item": "文案类作品",
      "format": "创意长文案或种草长文案，官网文本框或doc/PDF",
      "page_limit": "100-500字（含标点）",
      "deadline_note": "同上；作者≤2人、指导教师≤1人"
    },
    {
      "item": "策划案类作品",
      "format": "PDF（16:9）≤100MB，另交纸质版29.7×16.7cm",
      "page_limit": "正文≤30页，附件≤10页",
      "deadline_note": "线上提交+纸质报送，内容须一致否则无效；全国一等奖经现场提案产生"
    },
    {
      "item": "互动/广播/UI/科技类作品",
      "format": "互动类线上≤15页或线下≤180秒演示视频；广播类mp3（15/30秒，≤3MB）；UI类A4 PDF主流程界面10-15个；科技类A4 PDF≤40页（≤100MB）须附AI原始输出及使用说明",
      "page_limit": "见各格式",
      "deadline_note": "科技类仅限'AI无界 创意赋新章'命题且必须使用AI工具"
    }
  ],
  "process_stages": [
    {
      "stage": "命题发布与校级初评",
      "format": "组委会统一发布企业命题与策略单（官网www.sun-ada.net），学生按命题创作并经本校初评推荐",
      "notes": "一次参赛、两次提交：先全国官网线上提交，再经学校报送赛区，缺一无效；各校提交数量受限（不超过近五年赛区获奖平均数的2.5倍等）"
    },
    {
      "stage": "赛区评审（省赛）",
      "format": "学界+业界专家评审，评选赛区一、二、三等奖并公示，获奖作品推荐全国评审",
      "notes": "2026年北京赛区6月18日前完成校级初评，6月22日报送赛区"
    },
    {
      "stage": "全国评审与颁奖",
      "format": "全国组委会组织总评审（第十七届全国总评审于2025年8月3日结束），评出全国奖并公示；策划案类全国一等奖经现场提案答辩产生",
      "notes": "营销创客单元分区域选拔赛、实战竞技赛、全国总决赛，奖项与全国奖同等待遇"
    }
  ],
  "review_format": "命题制作品评审：按平面/视频/动画/互动/广播/策划案/文案/UI/科技/营销创客等类别分组，院校初评-赛区评审-全国评审三级评选，专家（学界+业界）按创意、命题契合、表现制作与规范综合评价；营销创客单元叠加真实运营数据考核。",
  "judge_preferences": [
    "紧扣策略单：品牌营销诉求+目标人群洞察是第一道门槛",
    "创意优先于制作复杂度：历届一等奖常见手法朴素但点子出色",
    "视频类开头15秒的冲击力决定第一印象",
    "系列化、完成度高的作品更易突围",
    "策划案重可执行性：策略-创意-媒介-预算闭环"
  ],
  "past_winning_patterns": [
    "紧扣命题策略单做品牌年轻化转译：将产品卖点转译为青年情感/文化洞察（历届命题品牌如HBN、爱华仕、Canva可画等的一等奖多为'卖点→洞察'转换取胜）",
    "一等奖作品制作未必复杂，核心拼创意点子与洞察深度（竞赛社区对历届获奖作品的共性分析）",
    "视频类获奖作品普遍在开头15秒内抛出强冲突/强悬念画面抓住评委注意力",
    "策划案类全国一等奖自第15届（2023）起通过现场提案答辩产生，要求提案表达与文档同样出色",
    "营销创客单元（2023年第15届新增网络直播类）获奖须以真实运营数据支撑，当年61组作品获全国奖",
    "公益命题获奖作品多以社会议题共鸣与正向价值观表达取胜，避免口号化说教"
  ],
  "forbidden_or_risky": [
    "严禁抄袭、一稿多投、购买作品参赛，违者取消资格",
    "作品不得出现院校名称、作者姓名等任何可识别信息",
    "严禁跨赛区、跨学校组队；作者与指导教师人数超限不受理",
    "未按统一命题创作、或未同时完成官网提交与学校报送的作品无效",
    "作品内容须遵守《广告法》，不得含违法违规内容"
  ],
