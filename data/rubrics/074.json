{
  "competition_id": 74,
  "competition_name": "基础医学创新研究暨实验设计论坛",
  "judging_dimensions": [
    {
      "dimension": "作品内容——选题（科学性与原创性）",
      "weight": "20%（官方评分表：选题20分/满分100分，科学性10分+原创性10分）",
      "official_wording": "全国大学生基础医学创新研究暨实验设计论坛评分标准（宁夏医科大学实验中心官网公布的官方附件，附件6/附件7）：创新研究项目\"内容50分：选题20分（科学性10分、原创性10分）、结果20分、结论10分；汇报答辩30分；团队合作20分\"。",
      "scoring_points": [
        "针对真实医学问题（疾病机制、防治、诊断新技术），科学假说清晰",
        "选题有原创性，非低水平重复",
        "鼓励多学科交叉与整合研究，呼应健康中国战略",
        "实验设计类要求自主设计、立项依据充分"
      ],
      "common_deductions": [
        "选题为导师课题简单切割、学生原创性贡献低",
        "假说含糊、科学问题不成立",
        "与国际已发表工作高度雷同"
      ]
    },
    {
      "dimension": "作品内容——结果/可行性（论证严谨、数据处理、技术路线）",
      "weight": "20%（官方评分表：结果20分；实验设计类对应\"可行性20分：立项依据5分+技术路线方案10分+预实验结果5分\"）",
      "official_wording": "同上官方评分标准附件：创新研究项目\"结果20分（论证严谨及结果丰富10分、数据处理10分）\"；实验设计项目\"可行性20分（立项依据5分、技术路线方案10分、预实验结果5分）\"。",
      "scoring_points": [
        "实验论证严谨、结果丰富且逻辑自洽",
        "数据处理统计方法正确、图表规范",
        "实验设计类：技术路线完整可执行，含对照与统计设计",
        "有预实验数据支撑可行性（设计类）；实验材料经费预算一般限10万元以内"
      ],
      "common_deductions": [
        "结果只有阳性数据、无重复与统计检验",
        "技术路线缺关键步骤或不可操作",
        "设计类预算严重超标（如超10万元上限）"
      ]
    },
    {
      "dimension": "作品内容——结论与分析（分析合理、结论正确、实用价值）",
      "weight": "10%（官方评分表：结论10分，分析合理5分+结论正确5分；实验设计类对应\"实用性10分：应用价值意义\"）",
      "official_wording": "同上官方评分标准附件：创新研究项目\"结论10分（分析合理5分、结论正确5分）\"；实验设计项目\"实用性10分（应用价值意义）\"。",
      "scoring_points": [
        "结论由数据严格支撑，不夸大",
        "讨论部分有机制阐释与文献对话",
        "设计类阐明临床/公共卫生应用前景"
      ],
      "common_deductions": [
        "结论超出数据支持范围",
        "讨论与结果脱节",
        "应用价值空泛"
      ]
    },
    {
      "dimension": "汇报答辩（PPT与现场问答）",
      "weight": "30%（官方评分表：汇报答辩30分）",
      "official_wording": "同上官方评分标准附件：\"汇报答辩30分：PPT的逻辑性与美观2.5分、仪表与语言表达2.5分、汇报思路与逻辑5分、回答问题准确性10分、基础知识扎实10分\"。答辩要求：汇报5分钟、答辩5分钟；PPT须匿名，违规取消资格或扣3-5分。",
      "scoring_points": [
        "汇报思路与逻辑完整（背景—假说—方法—结果—结论）",
        "PPT专业、逻辑清晰美观",
        "回答评委提问准确（占10分），能应对方法学与统计追问",
        "汇报人基础知识扎实（占10分），限时完成不超时"
      ],
      "common_deductions": [
        "PPT出现学校/姓名等匿名违规信息（取消资格或扣3-5分）",
        "超时、念稿",
        "主汇报人答不上核心实验细节",
        "PPT内容与提交论文摘要不符"
      ]
    },
    {
      "dimension": "团队合作（分工协作与贡献度）",
      "weight": "20%（官方评分表：团队合作20分，团队分工协作10分+贡献度10分）",
      "official_wording": "同上官方评分标准附件：\"团队合作20分：团队分工协作10分、贡献度10分\"。每队3-5名学生、指导教师不超过2人。",
      "scoring_points": [
        "成员分工明确（实验、数据、汇报各环节）",
        "所有成员能回答相关问题，非单打独斗",
        "队内贡献度说明真实"
      ],
      "common_deductions": [
        "仅一人包办、其余成员答不上问题",
        "分工描述与实际汇报表现矛盾"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "作品摘要（创新研究类/实验设计类）",
      "format": "中英文双语摘要",
      "page_limit": "各不超过800字",
      "deadline_note": "校赛/分区赛报名时提交；PPT内容须与提交摘要相符"
    },
    {
      "item": "作品全文/实验设计方案",
      "format": "学术论文或实验设计方案（含立项依据、技术路线、预期结果；设计类需含经费预算）",
      "page_limit": "不超过8000字；实验设计经费预算一般不超过10万元",
      "deadline_note": "按校赛与赛区赛通知节点提交"
    },
    {
      "item": "答辩PPT",
      "format": "PPT，须匿名（不得出现学校、姓名、指导教师信息）",
      "page_limit": "未明确（汇报5分钟）",
      "deadline_note": "分区赛/总决赛现场使用；匿名违规取消资格或扣3-5分"
    }
  ],
  "process_stages": [
    {
      "stage": "校赛（校内选拔）",
      "format": "各高校基础医学院/实验中心组织，材料评审+现场答辩",
      "notes": "多在3-4月完成（第十一届要求2026年4月30日前完成校赛）；报名截止约4月中旬"
    },
    {
      "stage": "分区赛（复赛，省/地区赛）",
      "format": "分赛区现场答辩评审（PPT汇报5分钟+答辩5分钟），按官方评分表评分",
      "notes": "5-7月进行（第十一届要求7月27日前完成复赛）；按学科赛道（基础临床、法医学、口腔医学、预防医学、药学中医药、医学+X交叉等）分组，择优晋级总决赛（整体晋级率约10%）"
    },
    {
      "stage": "全国总决赛（暨\"一带一路\"国际竞赛）",
      "format": "现场汇报答辩，专家按评分表现场打分",
      "notes": "约8月中旬（第十一届2026年8月14-18日）；评出金银铜奖等奖项；第十届267所高校7482支队伍32348名医学生报名，876支队伍晋级总决赛；中南大学第十届获7金3银1铜"
    }
  ],
  "review_format": "官方百分制评分表现场打分：作品内容50分+汇报答辩30分+团队合作20分，分区赛与总决赛均以现场PPT汇报答辩为核心评审形式。",
