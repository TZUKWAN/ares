  "process_stages": [
    {
      "stage": "报名",
      "format": "经官方报名平台（ilinki）以高校为单位组队报名，每队1名指导老师+3名学生（最多1名研究生）",
      "notes": "每校报名不超过2支参赛队，同一院系选手最多1支；不设报名费；第八届报名截止2022年4月30日"
    },
    {
      "stage": "初赛（分区网络赛）",
      "format": "全国分东北、华北、华东、华西、华南、华中、港澳台及海外7个赛区；线上完成台达自动化产品知识测试+项目方案书提交，区域承办高校（沈阳化工大学、北京科技大学、江苏科技大学、西安交通大学、华南理工大学、湖北工业大学等）组织书面及线上会评",
      "notes": "初赛100分制=方案书80分+知识考核20分；每个区域选出实际参赛队伍数量的25%进入决赛（预计共约100队入围）；各区域前80%分获一、二、三等奖及参与奖初赛奖状"
    },
    {
      "stage": "决赛·小组赛",
      "format": "线上/线下结合；动手操作、方案展示和回答评委提问，评审组按选题质量、作品质量、作品演示评分",
      "notes": "评选出15支队伍进入冠军争霸赛"
    },
    {
      "stage": "决赛·冠军争霸赛",
      "format": "PPT方案介绍（英文）+动态展品展示+专家答辩，评委由业界知名专家、资深教师和台达资深技术主管共同担任",
      "notes": "决出特等奖（15000元）、一等奖（5000元）、二等奖（3000元）、三等奖（2000元），只设团队奖"
    },
    {
      "stage": "停办",
      "format": "组委会公告",
      "notes": "2023年2月8日官网公告即日起停办“台达杯”国际高校绿色智造大赛，台达转向与高校共建自动化&AI实验室、师资培训、合作教学等产教融合形式；2022年第八届为最后一届"
    }
  ],
  "review_format": "初赛由赛区承办高校组织书面评+腾讯会议线上会评（高校自动化专家），决赛采用小组赛（选题质量/作品质量/作品演示三维评判）+冠军争霸赛（英文PPT展示、动态展品、专家答辩）两级评审，争霸赛评委含业界专家与台达资深技术主管。",
  "judge_preferences": [
    "作品须真用、用好台达自动化产品（PLC、变频器、触摸屏等），系统级集成落地是硬门槛",
