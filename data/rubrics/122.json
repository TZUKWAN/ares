{
  "competition_id": 122,
  "competition_name": "全国高等学校人工环境学科奖",
  "judging_dimensions": [
    {
      "dimension": "本科生赛道：专业基础知识笔试（四门核心课程客观题）",
      "weight": "客观题计分（工程热力学、传热学、流体力学、建筑环境学四门课程考题分量各占四分之一；往届网络选拔赛每门20道选择题，按成绩全国排名）",
      "official_wording": "往届《人环奖初试知识要点及参考试题》（人人人文档，2021）：\"内容覆盖以下四门专业基础课程，考题分量各占四分之一：1工程热力学 2传热学 3流体力学 4建筑环境学\"；知乎2021年参赛者回忆：四本书分别为《流体力学》《工程热力学》《传热学》《建筑环境学》，每门20题（每题1.5分，回忆帖仅供参考）。第32届官方新闻：本科生赛道为专业基础竞赛，\"共吸引全国107所院校共计1130名本科生参加，30名学生入围决赛\"。",
      "scoring_points": [
        "工程热力学基本概念与计算（约占1/4）",
        "传热学三种传热方式与综合应用（约占1/4）",
        "流体力学基础理论与管路计算（约占1/4）",
        "建筑环境学（湿空气、热舒适、室内环境参数）（约占1/4）",
        "答题速度与准确率（网络答题、按分数排名）"
      ],
      "common_deductions": [
        "概念混淆（如热力学各定律适用条件）",
        "计算失误、单位换算错误",
        "网络答题超时未提交"
      ]
    },
    {
      "dimension": "决赛（现场竞答/面试环节）",
      "weight": "客观题与现场作答相结合（初赛网络选拔赛排名前30名进入决赛；决赛具体分值构成未公开）",
      "official_wording": "360百科摘要（2025）：\"决赛入围门槛为成绩排名前30所高校的30名学生\"；第32届官方新闻：\"30名学生入围决赛\"，决赛暨颁奖典礼于2026年8月（第31届为2025年8月29日）在北京同方科技广场举行。",
      "scoring_points": [
        "基础知识的深度与临场反应",
        "对人工环境领域前沿与工程问题的理解",
        "现场表达与心理素质"
      ],
      "common_deductions": [
        "基础题失分（决赛多以基础功底论高下）",
        "答题规范问题导致争议题不计分"
      ]
    },
    {
      "dimension": "研究生赛道：创新创意方案竞赛",
      "weight": "定性评审（以方案作品评审+决赛答辩方式评出，第32届30所高校72个作品中7组晋级决赛；评分细则未公开）",
      "official_wording": "第32届人环奖官方新闻（同方官网，2026-09-01）：\"研究生赛道为创新创意方案竞赛，'以锚定行业痛点、赋能技术革新'为核心导向\"，\"共收到全国30所高校72个优秀作品，7组作品晋级决赛\"，研究生组最高奖（白金奖）授予清华大学团队《空气源热泵制冷剂循环充注量自适应调节技术研究》。",
      "scoring_points": [
        "选题针对行业真实痛点（如热泵、制冷剂充注量、智慧运维等）",
        "技术路线创新性与可行性",
        "研究/方案完成度与验证数据",
        "决赛答辩表达与问辩表现"
      ],
      "common_deductions": [
        "选题空泛、与行业痛点脱节",
        "缺少验证数据或可行性质疑无法回应",
        "作品学术不端"
      ]
    },
    {
      "dimension": "参赛资格与赛道合规",
      "weight": "定性（通过制：仅限建环及同类专业在校学生，本科生、研究生分赛道）",
      "official_wording": "第25届网络选拔赛通知（河北工程大学能源与环境工程学院转载，2017）：报名资格为\"建筑环境与能源应用工程学科（或同类专业）在校学生\"；第32届官方新闻确认本科生、研究生两大赛道分设。",
      "scoring_points": [
        "专业与学籍符合要求（建环或同类专业在校生）",
        "经所在高校组织报名/校赛选拔",
        "按节点完成网络报名与考试"
      ],
      "common_deductions": [
        "非建环同类专业学生参赛",
        "代考、替考等违纪取消成绩"
      ]
    }
  ],
