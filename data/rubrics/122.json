  "process_stages": [
    {
      "stage": "启动与校赛报名",
      "format": "各高校组织校赛/模拟赛并统一报名",
      "notes": "1992年由清华同方倡导并支持设立；主办单位为建环学科教指委（第32届为教育部高等学校建筑环境与能源应用工程、建筑电气与智能化专业教学指导分委员会），同方（能源）共同主办/承办；很多高校先办校内选拔赛"
    },
    {
      "stage": "网络选拔赛（初赛）",
      "format": "线上客观题统考",
      "notes": "四门课程（工程热力学、传热学、流体力学、建筑环境学）各占1/4；第32届107所院校1130名本科生参加，30名学生入围决赛"
    },
    {
      "stage": "决赛",
      "format": "现场决赛（本科生基础知识竞答；研究生方案答辩）",
      "notes": "第32届研究生赛道72个作品中7组晋级决赛；第31届决赛2025年8月29日在北京举行"
    },
    {
      "stage": "颁奖典礼",
      "format": "同方科技广场颁奖典礼暨大师讲堂",
      "notes": "设本科生特等奖、一等奖、二等奖、三等奖；研究生设白金奖等奖项；历届颁奖典礼常与行业大师讲堂联合举行"
    }
  ],
  "review_format": "本科生赛道以四门专业基础课客观题线上统考+全国排名的纯考试制评审，前30名入围现场决赛；研究生赛道以创新创意方案作品评审+现场答辩评审，两条赛道分别颁奖",
  "judge_preferences": [
    "基本功扎实：四门基础课概念与计算准确是本科生赛道的绝对主线",
    "知识面覆盖均匀（四门课等权重，偏科难以入围）",
    "研究生赛道看重行业痛点真问题与技术创新落地性（如空气源热泵、制冷剂自适应调节方向曾获白金奖）",
    "答辩临场沉稳、表达清晰（决赛为现场公开进行）"
  ],
  "past_winning_patterns": [
    "特等奖获得者多来自建环传统强校（第32届本科生特等奖为太原理工大学，研究生白金奖为清华大学团队），系统复习四门教材与历年试题是普遍路径",
    "历届试题重复率高，往届真题（如2011年传热学试卷）被广泛用作备考材料"
  ],
  "forbidden_or_risky": [
