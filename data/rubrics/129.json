{
  "competition_id": 129,
  "competition_name": "韩素音国际翻译大赛",
  "judging_dimensions": [
    {
      "dimension": "忠实与准确（对原文的理解与传达）",
      "weight": "55%【推断权重，官方未公布量化评分细则】",
      "official_wording": "【推断】官方竞赛规则未公布评分细则，仅要求“译文内容须与所选参赛组别一致，否则无效”，并公示参考译文与评析供对照（第三十六届竞赛规则）；获奖一等奖历届存在空缺（第36届法译汉、德译汉一等奖空缺，第38届法译汉一等奖空缺），显示评审对忠实准确要求极高。推断依据：翻译质量评估通行标准“信”（准确理解、完整传达、无误译漏译）为首要维度",
      "scoring_points": [
        "对原文词句、语法、逻辑的理解准确，无硬伤性误译",
        "无漏译、增译，语义完整覆盖原文",
        "专有名词、文化负载词、术语处理正确",
        "长难句拆解与重组恰当，不歪曲原意"
      ],
      "common_deductions": [
        "关键概念误译或张冠李戴",
        "整段漏译或随意删改原文",
        "逐字硬译导致语义不通"
      ]
    },
    {
      "dimension": "表达质量与风格再现（达与雅）",
      "weight": "45%【推断权重】",
      "official_wording": "【推断】大赛逐届发布“参考译文”并附评析（《中国翻译》杂志社承办、获赠《中国翻译》杂志的设置体现期刊对译文质量的导向），终审会以“认真的讨论和科学、严谨的筛选”逐篇定奖（第三十一届终审会报道）。推断依据：评审区分一二三等奖主要看译文是否地道流畅、再现原文文体风格",
      "scoring_points": [
        "译文符合目标语表达习惯，自然地道无翻译腔",
        "再现原文的文体、语气与修辞风格（文学性文本尤甚）",
        "标题与关键句的神似处理，有亮点译法",
        "用词精准多样，句式节奏得当"
      ],
      "common_deductions": [
        "语法正确但行文生硬、翻译腔明显",
        "文体与原文错位（如文学散文译成说明文）",
        "表达平淡平庸、与参考译文水平差距明显而无亮点"
      ]
    },
    {
      "dimension": "规范与诚信合规",
      "weight": "一票否决制（不单独计分，违规即取消资格/译文无效）",
      "official_wording": "官方原文：文档内容只包含译文，“请勿添加脚注、尾注、译者姓名、地址等任何个人信息”；“每项参赛译文一稿有效，不接收修改稿”；译文须自主独立完成，“杜绝抄袭和人工智能翻译，截稿前不得在任何媒体公布译文，违者取消资格”（第三十八届大赛公告）",
      "scoring_points": [
        "译文匿名：不含姓名、地址、脚注尾注等个人信息",
        "独立完成：无抄袭、无机器/AI翻译痕迹",
        "格式合规：组别一致，英汉互译粘贴文本框、其他语种docx≤2M",
        "在截止时间前经官方专栏提交，一稿有效"
      ],
      "common_deductions": [
        "文档含个人信息或脚注尾注，视为无效",
        "使用AI翻译或抄袭被识破，取消资格",
        "截稿前在媒体公布译文，取消资格；提交修改稿不被受理"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "参赛译文（每组别一份）",
      "format": "英汉互译直接粘贴至官网文本框；其他语种须为word文档.docx格式，不超过2M；文档只含译文，任何个人信息不得出现",
      "page_limit": "译文须完整覆盖竞赛原文（原文约千字/篇，当届公告发布于每年1月）",
      "deadline_note": "第38届为2026年4月30日24时前在中国翻译研究院官网大赛专栏在线提交；一稿有效不收修改稿"
    },
    {
      "item": "报名凭据",
      "format": "国内选手经“中国翻译”微信公众号输入“竞赛报名”填写报名表并支付报名费30元，获12位数字报名凭据号码；外籍选手经中国翻译研究院官网外籍通道报名（审核约5个工作日）",
      "page_limit": "每人每个组别仅一次报名机会",
      "deadline_note": "截稿前完成；历届截稿多在4月底至5月底"
    }
  ],
  "process_stages": [
    {
      "stage": "发布公告与竞赛原文",
      "format": "每年1月中旬经中国翻译协会官网/公众号发布竞赛规则与十个语种竞赛原文",
      "notes": "第38届由中国外文局指导，中国翻译协会、当代中国与世界研究院、苏州大学联合主办，苏州大学外国语学院承办；各届联合主办高校轮换（第36届湖南师范大学、第37届大连外国语大学）"
    },
    {
      "stage": "报名与译文提交",
      "format": "先报名缴费获凭据号，再经官网专栏在线提交译文",
      "notes": "可任选一项或多项参赛；2026年4月30日24时截稿，逾期视为自动放弃且不延期"
    },
    {
      "stage": "评审（三轮阅卷+终审会）",
      "format": "匿名编号评审：前三轮阅卷筛选，再由高校及中国外文局、媒体等单位的30余位中外专家组成终审会现场评审",
      "notes": "终审逐篇讨论、科学严谨筛选；评审于每年6月启动，结果8-10月公布（第38届获奖名单2026年8月24日公布）"
    },
    {
      "stage": "公布获奖名单与颁奖典礼",
      "format": "获奖名单经中国翻译协会官网、微信公众号及小红书账号公布，年底举行颁奖典礼",
      "notes": "一、二、三等奖设证书、奖金及《中国翻译》杂志一本；另设最佳组织奖（面向高校或企事业单位）"
    }
  ],
  "review_format": "分语种组别的匿名译文评审：三轮阅卷加中外专家现场终审会，逐篇讨论定奖，一等奖可空缺；获奖率约4.5%（第38届21984份译文评出989名获奖者）。",
  "judge_preferences": [
    "“信”为第一门槛：理解准确、无漏译误译是无硬伤底线，一等奖可因无满意译文而空缺",
    "区分奖项档次看“达与雅”：地道自然的目标语表达与原文风格再现，忌翻译腔",
    "亮点译法（标题、警句、文化负载词的神处理）是获奖译文共性",
    "非通用语种组别参赛量少，语种红利明显（小语种方向获奖比例远高于英汉）",
    "译文的学术与文学并重：历届原文多为散文、评论、学术随笔类严肃文本"
  ],
