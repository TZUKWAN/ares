{
  "competition_id": 20,
  "competition_name": "全国大学生机器人大赛（RM/RC）",
  "judging_dimensions": [
    {
      "dimension": "【RoboMaster赛项】对抗赛成绩（小组赛+淘汰赛名次，裁判系统计分）",
      "weight": "约35%（RM赛项占系列赛约50%，对抗成绩直接决定奖项归属，赛项内占比推断）",
      "official_wording": "《RoboMaster 2025机甲大师超级对抗赛比赛规则手册V1.1.0》（robomaster.com赛事引擎页引用）规定比赛机制、场地、机器人类型及判罚；比赛由裁判系统自动统计血量/伤害/基地值等判定胜负，采用小组赛+淘汰赛赛制（3V3联盟赛亦设小组赛与淘汰赛）。系列赛内权重【推断】。",
      "scoring_points": [
        "英雄/步兵/工程/哨兵/无人机/飞镖/雷达等多兵种协同执行战术",
        "裁判系统客观数据：剩余血量、输出伤害、资源岛采集、基地摧毁",
        "小组赛积分与净胜优势决定淘汰赛签位",
        "淘汰赛胜场直接决定全国赛名次与奖项"
      ],
      "common_deductions": [
        "违规机构/超功率/弹速超标被判罚",
        "场地违规（越界、撞人）处罚",
        "场上死机、断控等可靠性问题导致失分"
      ]
    },
    {
      "dimension": "【RoboMaster赛项】技术评审与开源（技术评审报告+开源审查答辩）",
      "weight": "约15%（RM赛项内占比推断；开源奖本身按分数区间评级：≥95特等、(90,95]一等、(85,90]二等）",
      "official_wording": "官方参赛须知：\"队伍需在近半年的研发周期内提交《技术评审报告》，向组委会展示机器人研发进度\"，须通过技术评审方可获得参赛资格（robomaster.com/zh-CN/robo/know、/zh-CN/robo/rm）；官方《参赛手册》载明开源奖评分区间：特等奖95分以上、一等奖(90,95]、二等奖(85,90]；2023年开源审查流程要求收到通知后6小时内（赛前）/1小时内（赛期）准备答辩材料。",
      "scoring_points": [
        "研发周期内按节点提交视频/图片/文档展示备赛进度",
        "机械、电控、视觉算法的技术方案完整性与创新性",
        "开源资料的代码/图纸质量、可复现性与文档规范",
        "开源审查答辩中对技术细节的现场解释"
      ],
      "common_deductions": [
        "技术评审材料逾期或造假，丧失参赛资格",
        "开源资料抄袭上游开源项目未注明",
        "开源文档空泛，无法复现关键功能"
      ]
    },
    {
      "dimension": "【RoboCon赛项】竞技赛成绩（稳态赛/排位+小组赛+复赛+决赛）",
      "weight": "约35%（RC赛项占系列赛约50%，竞技成绩决定竞赛类奖项，赛项内占比推断）",
      "official_wording": "ROBOCON官网（robocon.org.cn/cnrobocon.net）每年发布年度主题规则（第二十四届设\"颗粒归仓\"等三项目，第二十五届为\"武林探秘\"竞技赛规则V4）；第二十三届赛事总结报告载明赛制按\"预选赛—小组赛—复赛—决赛\"梯度推进，设评审委员会、裁判委员会、竞赛委员会。赛项内权重【推断】。",
      "scoring_points": [
        "年度任务完成度（如\"武林探秘\"各类得分装置的稳定获取）",
        "稳态/排位阶段得分积累决定小组赛签位",
        "自动段与手动段策略配合，机器人可靠性与速度",
        "淘汰赛轮次胜场决定最终名次（冠军代表中国出战ABU亚太赛）"
      ],
      "common_deductions": [
        "违例接触、超界、损坏场地装置被判罚",
        "双机协同失误、卡死等稳定性缺陷",
        "上场机器人数量/尺寸/功率不符规则"
      ]
    },
    {
      "dimension": "【RoboCon赛项】技术审查与评审类奖项（技术资料、视频、单项奖）",
      "weight": "约15%（RC赛项内占比推断；评审类奖项独立于竞赛名次）",
      "official_wording": "第二十四届ROBOCON参赛手册（官网PDF）规定参赛流程、技术审查与视频提交要求；官网获奖名单注明\"评审类奖项\"与竞赛类奖项分列（如2025深圳单项奖申请：大疆教育基金、库犸奖金等）。",
      "scoring_points": [
        "技术审查：机器人安全性、合规性现场检查一次通过",
        "按要求提交技术视频与资料，展示设计与制作过程",
        "单项奖（设计、技术、精神风尚等）的申报材料质量",
        "技术方案的原创性与工程难度"
      ],
      "common_deductions": [
        "技术审查不通过须整改，占用练习/上场时间",
        "技术视频超时、内容与实机不符",
        "安全缺陷（裸露高压、防护缺失）被勒令停机整改"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "RoboMaster《技术评审报告》及阶段性材料",
      "format": "视频、图片、文档（研发周期内分节点线上提交）",
      "page_limit": "未明确（按当年技术评审细则）",
      "deadline_note": "赛季研发期内分阶段提交，逾期影响参赛资格"
    },
    {
      "item": "RoboMaster开源资料",
      "format": "代码仓库+技术文档（机械/电控/视觉方向分类申报开源奖）",
      "page_limit": "未明确",
      "deadline_note": "赛前提交，开源审查答辩于赛时随机触发（6小时/1小时内备材料）"
    },
    {
      "item": "RoboCon技术审查材料与技术视频",
      "format": "技术资料文档+视频（按参赛手册要求）",
      "page_limit": "未明确",
      "deadline_note": "全国赛前按手册节点提交，现场接受技术审查"
    },
    {
      "item": "比赛机器人整机",
      "format": "RM：英雄/步兵/工程/哨兵/无人机/飞镖/雷达等多兵种；RC：按年度主题双机/多机",
      "page_limit": "尺寸、重量、功率、弹速等按当年规则手册硬性限制",
      "deadline_note": "验车/技术审查合格后方可上场"
    }
  ],
  "process_stages": [
    {
      "stage": "RoboMaster：校园俱乐部/校内赛→区域赛（联盟赛分区/3V3）→全国赛",
      "format": "区域赛小组赛+淘汰赛，优胜队晋级全国赛对抗",
      "notes": "高校系列赛分超级对抗赛（RMUC）、高校联盟赛（RMUL）、高校人工智能挑战赛等类别；2025全国赛冠军上海交大交龙、亚军中科大RoboWalker、季军华南理工华南虎"
    },
    {
      "stage": "RoboCon：预选赛（稳态赛/排位）→小组赛→复赛→决赛",
      "format": "按年度主题规则进行机器人对抗任务赛，淘汰制推进",
      "notes": "第二十四届（2025，深圳）33所高校76支队伍1200余名选手参赛；冠军队代表中国参加ABU亚太大学生机器人大赛"
    },
    {
      "stage": "颁奖与评审类奖项",
      "format": "竞赛类奖项按名次；评审类/单项奖（开源奖、设计奖等）由评审委员会评定",
      "notes": "RoboMaster另设开源奖、杰出贡献奖、组织奖等；RoboCon官网明确\"评审类奖项\"另行公布"
    }
  ],
  "review_format": "RM/RC均以裁判系统与现场裁判判罚的对抗成绩为主体，叠加赛前技术评审/技术审查与开源、单项奖的专家评审；对抗部分为客观计分，评审部分为专家打分或评级。",
  "judge_preferences": [
    "可靠性优先：场上稳定运行、少死机比单点性能激进更受认可",
    "技术评审节点材料如实反映进度，工程过程管理规范",
    "开源与答辩重真实理解：算法/结构能现场讲透、可复现",
    "战术执行与兵种协同的成熟度是对抗赛层面最受关注的亮点"
  ],
