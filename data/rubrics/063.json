{
  "competition_id": 63,
  "competition_name": "工业设计大赛",
  "judging_dimensions": [
    {
      "dimension": "设计主旨（主题契合与问题洞察）",
      "weight": "20%【推断：官方公布三方面评审框架未公布分值，主旨为基础性维度估较低权重】",
      "official_wording": "遵照\"符合本次大赛主题、可用、易用、环保、审美、经济\"等评价标准从设计主旨、设计效果、设计价值三方面对参赛作品进行综合评审（2025年北京市大学生工业设计竞赛通知，北京市教委官网）",
      "scoring_points": [
        "作品紧扣当届大赛主题（如第七届\"新质·生产力 新生·设计力\"）",
        "目标用户与使用场景界定清晰，洞察真实需求痛点",
        "设计定位合理：概念组/产品组与作品成熟度匹配",
        "作品属于大赛规定类别（工作、生活、学习、沟通、出行、健康、娱乐、服务与公共设施、服饰配件等）"
      ],
      "common_deductions": [
        "偏离大赛主题或自拟主题",
        "伪需求：场景虚构、痛点站不住脚",
        "类别报错导致评审错位"
      ]
    },
    {
      "dimension": "创新性与设计效果（造型、功能与人机）",
      "weight": "40%【推断：工业设计赛事通行权重区间，创新通常为最高权重】",
      "official_wording": "大赛旨在提升大学生工业设计能力，考察作品创新性（大赛宗旨与设计效果评审方面；全国赛事未公布数值权重）【推断】",
      "scoring_points": [
        "核心创意新颖：功能原理、交互方式或形态语言有独到之处",
        "人机工程考量：尺度、操作方式、交互逻辑符合目标用户",
        "CMF（色彩/材料/工艺）运用恰当且有表现力",
        "设计方案完成度：三视图、使用场景图、细节表达完整",
        "技术可行性：结构与制造工艺基本合理，概念组亦需逻辑自洽"
      ],
      "common_deductions": [
        "创意与已有市场产品高度雷同",
        "效果图炫但结构/人机硬伤明显",
        "版面信息混乱、缺三视图或使用说明，评委无法理解作品",
        "模仿导师或企业已量产方案"
      ]
    },
    {
      "dimension": "设计价值（可用、易用、环保、经济）",
      "weight": "25%【推断：官方评价标准关键词合并为价值维度，未公布分值】",
      "official_wording": "\"可用、易用、环保、审美、经济\"等评价标准中的设计价值方面（2025年北京市大学生工业设计竞赛通知）",
      "scoring_points": [
        "可用性：功能真实解决用户问题而非概念堆砌",
        "易用性：操作流程简明、学习成本低",
        "环保与可持续：材料选择、生命周期、可维修性",
        "经济性：成本意识与量产可行性",
        "社会价值：适老化、无障碍、文化传承等公共利益切入点"
      ],
      "common_deductions": [
        "功能堆砌、为智能而智能",
        "环保仅停留在口号，无材料/工艺依据",
        "概念天马行空完全没有成本与可行性论述"
      ]
    },
    {
      "dimension": "审美与版面呈现质量",
      "weight": "15%【推断：审美为官方评价标准关键词，版面为唯一评审载体故单列】",
      "official_wording": "按组委会提供的版面编排格式提交每件参赛作品（全国大赛及各省赛区参赛办法通用条款）",
      "scoring_points": [
        "版面按组委会统一编排格式制作（A3幅面、jpg、300dpi为通行要求）",
        "版面叙事逻辑：从问题洞察到方案表达的阅读动线",
        "效果图与排版的专业度：透视、光影、字体、信息层级",
        "辅助材料（视频、模型照片）与版面互相印证"
      ],
      "common_deductions": [
        "未按统一版面格式、分辨率或文件大小不达标影响评审",
        "版面出现学校/个人信息（匿名评审要求）",
        "效果图粗糙或过度渲染失真"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "参赛作品版面（核心评审载体）",
      "format": "按组委会提供的版面编排格式制作，A3幅面jpg、300dpi以上为通行要求",
      "page_limit": "每件作品1块版面（按组委会版式模板）",
      "deadline_note": "校级选拔5-6月，省赛区7-10月，全国终评10-11月"
    },
    {
      "item": "辅助材料（按赛区要求）",
      "format": "作品源文件、设计图、展示视频（部分赛区要求）、报名表及汇总表",
      "page_limit": "未明确",
      "deadline_note": "随版面同批提交至分赛区平台"
    },
    {
      "item": "实物模型（非强制）",
      "format": "平面图版为主，可以实物模型、视频等形式为辅",
      "page_limit": "未明确",
      "deadline_note": "仅部分赛区终评或展览环节需要"
    }
  ],
  "process_stages": [
    {
      "stage": "校内选拔赛",
      "format": "各校自行评审，择优推选至省赛区",
      "notes": "5-6月发布通知并报名；不收取学生任何费用"
    },
    {
      "stage": "省赛区评审（32个分赛区）",
      "format": "分赛区组织初评与终评（网评+会议评审）",
      "notes": "如河南赛区一、二、三等奖分别为进入终评作品的10%、20%、30%；省赛获奖后推荐国赛"
    },
    {
      "stage": "全国总决赛（总赛区复评）",
      "format": "各分赛区推荐作品入围（第七届近4万件报名、1412件入围全国总决赛）",
      "notes": "晋级终评作品在cuidc.net公示，异议实名邮件受理"
    },
    {
      "stage": "全国终评与颁奖",
      "format": "专家终评，产生中国新锐设计金、银、铜奖及优秀奖",
      "notes": "颁奖典礼及优秀作品展通常于11-12月举行"
    }
  ],
  "review_format": "以作品版面为载体的匿名专家评审：省赛区初评+终评，全国总赛区复评+终评，全程网评/会议评审为主，一般无现场答辩",
  "judge_preferences": [
    "第一眼看主题契合与问题真实性，其次才是形式美感",
    "偏好完整的设计过程呈现：洞察-定义-方案-验证的版面叙事",
    "反感纯效果图竞赛：无使用场景与人机论证的概念难入围",
    "欣赏有社会价值切入（适老、无障碍、可持续）且能落地的方案",
    "版面专业度直接影响打分——评委平均在每件作品停留时间极短"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "作品必须原创，抄袭、代做或一稿多投（同时报其他在审赛事）有被公示取消资格风险",
    "版面与报名信息中不得出现学校名称、作者姓名等身份信息（匿名评审）",
    "内容须健康向上，符合国家法律法规",
    "异议须在公示期内实名提出（含姓名、身份证号、联系方式及图文材料），否则不予受理",
    "参赛作品知识产权归作者，但组委会享有展示宣传使用权，提交即视为同意"
  ],
