{
  "competition_id": 43,
  "competition_name": "“学创杯”创业综合模拟大赛",
  "judging_dimensions": [
    {
      "dimension": "软件模拟经营绩效（系统评分）",
      "weight": "70%（主体赛两部分相加中模拟环节满分70分：小组第一名70分、第二名69分，依次递减）",
      "official_wording": "官网通知页原文：“主体赛分为创业综合模拟与创业计划书两个环节分别计分，最终成绩由两部分得分相加确定。创业综合模拟小组成绩第一的团队得70分，第二名69分，以此类推”；高校通知补充：“系统根据各参赛队伍的经营模拟情况计算得分，通过平衡计分卡的综合评价分数衡量模拟企业的经营绩效，团队最终成绩以此确定”（武汉工程大学第十二届通知）",
      "scoring_points": [
        "《创业之星》平台若干虚拟年度经营结束后的平衡计分卡综合评价分数",
        "盈利表现：净利润、累计盈利、所有者权益等经营成果指标",
        "财务表现：现金流安全、负债结构、财务稳健性",
        "市场表现：市场份额、销售收入、订单交付",
        "投资与成长表现：研发投入、产能建设、企业成长性",
        "同组对抗中相对排名决定得分，第一名满分后逐名递减"
      ],
      "common_deductions": [
        "经营中现金断流、企业破产导致评分大幅下滑或提前出局",
        "单一维度畸重（只压产能不做市场/只借债不控风险）拖累平衡计分卡总分",
        "未按时提交当期决策，系统按默认/空决策处理造成损失"
      ]
    },
    {
      "dimension": "创业计划书/模拟策略（方案）评审",
      "weight": "30%（与模拟环节70分相加构成百分制，据官网“两部分得分相加”及70分递减规则推断计划书部分满分约30分）【推断】",
      "official_wording": "官网赛事手册：“总决赛前，组委会将组织专家、学者、企业界人士组成评审团，对创业计划书进行书面评审，评出计划书部分得分”；官网通知：“若省赛通知里写明模拟策略（方案），参赛团队需进入官网递交模拟策略书……申报地址：学创杯官网—赛事报名—省赛模拟策略书递交系统”",
      "scoring_points": [
        "项目/商业模式逻辑完整：市场分析、产品定位、营销与运营方案",
        "财务规划合理性：融资、成本、盈利预测与模拟经营数据相互印证",
        "团队分工与执行可行性",
        "创新性与社会价值",
        "文本规范：按官网《策略书申报指南》模板撰写并按时在系统递交"
      ],
      "common_deductions": [
        "未按官网指南模板或逾期未在递交系统提交策略书",
        "计划书内容与软件模拟经营数据明显脱节",
        "套模板、抄袭，数据造假"
      ]
    },
    {
      "dimension": "现场答辩与综合展示（总决选评金奖/特等奖环节）",
      "weight": "定性评分（总决选现场环节，用于评出计划书金奖、特等奖/学创之星，不计入常规排名分）",
      "official_wording": "官网赛事手册：“全国大学生优秀创业计划书金奖评选办法——总决赛前……对创业计划书进行书面评审，评出计划书部分得分”并在总决赛现场答辩综合评定；历届回顾：“总决赛经过‘软件模拟经营’和‘创业策划书答辩’两方面比拼，综合评审裁定和软件系统打分结果”评定特等奖",
      "scoring_points": [
        "陈述逻辑与表达感染力、时间控制",
        "对评委质询的应答准确性与应变",
        "PPT/展示材料专业度",
        "团队协作与精神面貌"
      ],
      "common_deductions": [
        "超时或陈述流于背诵",
        "答非所问、核心数据记不清",
        "展示材料与计划书内容矛盾"
      ]
    },
    {
      "dimension": "比赛纪律与合规",
      "weight": "扣分制（违规扣分直至取消参赛资格，不计入常规分数权重）",
      "official_wording": "官网报名页：“如冒用他人姓名报名参与比赛，一经发现即取消该队参赛资格”；第十三届通知：“各团队切勿付费参与其他非官方训练与交流平台，以免被误导及上当受骗”",
      "scoring_points": [
        "真实学生身份报名、不跨校组队、每人限1队",
        "线上赛按要求关闭远程工具与拦截软件",
        "遵守线上赛网络与设备要求"
      ],
      "common_deductions": [
        "冒用身份、跨校组队——取消参赛资格",
        "比赛期间使用远程控制/作弊工具",
        "代打、多队串通共享决策数据"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "模拟策略书/创业计划书",
      "format": "按官网《策略书申报指南》模板，经官网“省赛模拟策略书递交系统”线上递交",
      "page_limit": "未明确",
      "deadline_note": "省赛前按省赛通知截止时间递交（省级演训活动8-10月）"
    },
    {
      "item": "软件模拟经营决策",
      "format": "《创业之星》《营销之道》《理财之道》平台线上对抗，系统自动记录各期决策与成绩",
      "page_limit": "未明确",
      "deadline_note": "校级1-9月，省级8-10月，全国半决选（在线）与总决选（现场）于11月"
    },
    {
      "item": "报名信息与团队组建",
      "format": "官网 www.xcbds.com 报名，团队1-3名学生+1-2名指导教师，分研究生组/本科组/职教组",
      "page_limit": "未明确",
      "deadline_note": "以官网报名系统通知为准"
    }
  ],
  "process_stages": [
    {
      "stage": "校级演训活动（校赛）",
      "format": "各院校自行组织校内选拔或直接由校级管理员推荐晋级",
      "notes": "组委会发放免费训练账号；每校每赛项按省赛通知推选名额晋级省赛"
    },
    {
      "stage": "省级演训活动（省赛）",
      "format": "以省/直辖市为单位统一组织线上模拟对抗+模拟策略（方案）评审",
      "notes": "本科组与职教组分组；未安排省级选拔的地区参加全国网络选拔；研究生组统一参加全国初赛"
    },
    {
      "stage": "全国半决选（在线）",
      "format": "全国网络模拟对抗",
      "notes": "每项演训活动一所学校最多2支团队晋级总决选"
    },
    {
      "stage": "全国总决选（现场）",
      "format": "现场软件模拟对抗+创业计划书/策略书评审与答辩",
      "notes": "两部分得分相加定名次；现场另评优秀创业计划书金奖、特等奖（学创之星）"
    }
  ],
  "review_format": "软件平台自动评分（平衡计分卡综合评价分数按名次折算）+ 专家评审团对计划书/策略书书面评审，两部分得分相加；总决选另设现场答辩用于金奖与特等奖评定",
  "judge_preferences": [
    "平衡计分卡五维度（盈利、财务、市场、投资、成长）均衡发展而非单点冒进",
    "全程现金流安全、不破产、稳健经营到最后一期",
    "计划书与模拟经营实际数据逻辑一致、可执行",
    "答辩中能讲清决策逻辑与经营复盘，而非背诵模板"
  ],
