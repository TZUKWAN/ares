{
  "competition_id": 68,
  "competition_name": "花园设计建造竞赛",
  "judging_dimensions": [
    {
      "dimension": "方案设计创意与主题契合",
      "weight": "35%【推断：官方公布评审方向未公布分值，设计创意为设计类赛事核心维度】",
      "official_wording": "围绕共同关切、特色主题和共建总结三个方向进行最终打分，并考量设计创新性、功能性及与周边环境的融合度（2026年社区花园赛道通知，同济大学建筑与城市规划学院承办页面）；赛事主题历届如\"鲜花与梦想\"\"生命花园\"",
      "scoring_points": [
        "紧扣当届主题的概念立意与叙事完整性",
        "空间设计创新性：布局、竖向、构筑物形式的原创构思",
        "功能性：满足使用人群行为需求（休憩、互动、科普等）",
        "与场地及周边环境的融合度（因地制宜）",
        "植物配置方案的科学性与景观效果"
      ],
      "common_deductions": [
        "概念与主题脱节、堆砌网红元素",
        "方案美图但完全不考虑建造可行性与预算",
        "植物选择不符合季节与场地条件"
      ]
    },
    {
      "dimension": "建造完成度与搭建工艺",
      "weight": "30%【推断：现场建造为本赛事区别于纯图纸赛的核心，权重高】",
      "official_wording": "各组花园需由团队成员亲自设计并参与现场搭建（2026年社区花园赛道通知）；入围团队赴北京南苑森林湿地公园等地现场建造，终评答辩（历届建造节流程）",
      "scoring_points": [
        "建成效果与方案的还原度",
        "搭建工艺质量：结构安全、节点处理、构筑物稳定性",
        "材料运用：竹木等指定/环保材料的建构表现力",
        "规定建造时间内的进度管理与团队协作",
        "预算控制与材料损耗管理"
      ],
      "common_deductions": [
        "请工人代建或队员不参与搭建（明文取消资格风险）",
        "结构不稳存在安全隐患",
        "工期拖延致建成效果与方案严重缩水"
      ]
    },
    {
      "dimension": "生态可持续与运维成效",
      "weight": "20%【推断：社区赛道明文\"运维成效纳入核心评审标准\"，主赛道按同类惯例估权重】",
      "official_wording": "自主运维周期不少于7天，运维成效纳入核心评审标准（2026年社区花园赛道通知）",
      "scoring_points": [
        "植物成活状态与养护记录（自主运维周期不少于7天）",
        "生态性：乡土植物、雨水利用、可降解/可回收材料",
        "可持续运维路径设计（汇报文件必含内容）",
        "社区参与和共建过程记录（共建总结为打分方向之一）"
      ],
      "common_deductions": [
        "评审前植物枯萎、花园荒废（运维不达标）",
        "生态只停留在口号，材料大量使用不可回收物",
        "共建/运维记录缺失无法佐证"
      ]
    },
    {
      "dimension": "成果表达与终评答辩",
      "weight": "15%【推断：展板/汇报/视频为评审载体】",
      "official_wording": "展板为一张横向A0图版（高841mm宽1189mm）JPG格式300dpi、不超30M，中英双语；汇报文件PDF 16:9限35页以内；视频10分钟内MP4、500MB以内、不低于1080P且汇报人勿露脸（2026年社区花园赛道通知提交要求）",
      "scoring_points": [
        "A0展板的图面表达与中英双语说明质量",
        "汇报逻辑：主题阐述-设计-建造-共建总结-可持续运维路径",
        "视频对建造过程与建成效果的真实记录（共建片段不超3分钟）",
        "终评答辩应答（主赛道终评答辩全程直播，临场表现可见度高）"
      ],
      "common_deductions": [
        "文件规格不达标（超30M/超35页/分辨率不足/压缩包未按要求命名）",
        "提交材料中出现作者、学校等身份信息（匿名要求）",
        "视频露脸或时长超限"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "设计展板（A0横版）",
      "format": "JPG，300dpi，不超过30M，含设计图、说明、共建记录与建成实景，中英双语",
      "page_limit": "1张横向A0（841mm×1189mm）",
      "deadline_note": "2026社区赛道：10月28日23:59前提交"
    },
    {
      "item": "汇报文件（PDF）",
      "format": "16:9，35页以内，含主题阐述、可持续运维路径、创新意义等",
      "page_limit": "≤35页",
      "deadline_note": "同批提交至指定邮箱（如tjlandscape2018@126.com），压缩包按编号命名（如C001.zip）"
    },
    {
      "item": "视频与照片",
      "format": "视频MP4≤10分钟、≤500MB、≥1080P、汇报人勿露脸；照片2张横版3:2、5-10MB、≥300dpi",
      "page_limit": "未明确",
      "deadline_note": "同批提交"
    },
    {
      "item": "报名（3-7人团队+1名指导教师）",
      "format": "国内外风景园林及相关专业在校本科生及研究生，鼓励跨国跨校跨专业；每人限报一组、每组限交一份作品",
      "page_limit": "未明确",
      "deadline_note": "2026社区赛道报名截止10月20日23:59；主赛道方案征集通常上半年、现场建造暑期进行"
    }
  ],
  "process_stages": [
    {
      "stage": "方案设计征集与初评",
      "format": "提交设计方案/展板，专家初评选出入围团队（主赛道约10支）",
      "notes": "入围团队获得现场建造资格"
    },
    {
      "stage": "现场建造",
      "format": "入围团队赴指定场地（历届如北京南苑森林湿地公园、温榆河公园）限时实地搭建花园",
      "notes": "须团队成员亲自搭建；社区赛道为选定社区地块设计营建并运维不少于7天"
    },
    {
      "stage": "终评答辩",
      "format": "评委现场打分/投票，终评答辩全程直播",
      "notes": "围绕共同关切、特色主题、共建总结打分；运维成效纳入核心评审标准"
    },
    {
      "stage": "颁奖",
      "format": "设一等奖、二等奖、三等奖及特别奖项",
      "notes": "获奖团队获颁证书；颁奖阶段单独安排"
    }
  ],
  "review_format": "两阶段评审：方案初评（图版评审）+现场建造后终评（评委打分/投票+公开答辩直播），建造实景为直接评审对象",
  "judge_preferences": [
    "偏好\"建得出来、立得住、活得久\"的作品：方案创意必须经得起建造与运维检验",
    "竹木等生态材料的建构表现力与工艺细节受风景园林专家青睐",
    "运维成效一票性权重高——花园在评审时的实际状态直接影响名次",
    "团队亲自搭建的过程记录（共建叙事）是重要加分项",
    "反感AI生成方案与外包施工"
  ],
  "past_winning_patterns": [],
