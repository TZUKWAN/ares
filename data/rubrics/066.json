{
  "competition_id": 66,
  "competition_name": "化学实验创新设计竞赛",
  "judging_dimensions": [
    {
      "dimension": "创新性与内容价值（作品质量）",
      "weight": "作品质量占复赛/决赛总成绩50%（官方明文）；其中创新性为校内参照评分的最大分项（约50%）【推断细分】",
      "official_wording": "由专家组结合答辩表现（占50%）和提交作品的质量（占50%）评定参赛作品的成绩（\"微瑞杯\"西南赛区竞赛通知第二轮，南京大学赛区平台）；大赛由 中国化学会 和 教育部高等学校国家级实验教学示范中心联席会 主办（大赛章程第一条）",
      "scoring_points": [
        "新创实验赛道：实验选题与方法的原创性（反应体系、催化剂、表征手段、绿色化程度）",
        "改进实验赛道：对经典实验的改进有实质意义（毒性降低、成本下降、现象更明显、产率提高）",
        "科普实验赛道：科学性准确且形式新颖、贴近生活、安全性可控",
        "实验与科研前沿/实际应用结合的价值",
        "作品论文的学术规范与深度（原理阐述、表征数据、文献引用）"
      ],
      "common_deductions": [
        "改进幅度过小，仅更换试剂用量或微小参数（不构成\"改进\"）",
        "创新点与已有文献/教材实验雷同",
        "论文数据不完整、无表征支撑结论"
      ]
    },
    {
      "dimension": "可操作性与科学严谨性",
      "weight": "校内参照评分约40%【推断细分：全国赛并入作品质量50%与答辩50%之中】",
      "official_wording": "东莞理工学院校内赛（参照全国赛标准）新创实验赛道评分：内容价值、创新性50%，可操作性40%，格式规范性10%；全国赛章程未公布维度级分值【推断】",
      "scoring_points": [
        "实验方案可复现：试剂仪器为本科实验室可及，操作步骤明确",
        "安全性：危险试剂替代、通风防护、废液处理方案完整",
        "适合本科教学：4-8学时内可完成、成本可控",
        "实验结果经真实验证（视频证明实验实际跑通）"
      ],
      "common_deductions": [
        "方案漂亮但视频显示实验未真正成功",
        "存在重大安全隐患（如违规使用剧毒品、无废液处置）",
        "超出本科实验室条件无法复现"
      ]
    },
    {
      "dimension": "现场答辩表现（双盲）",
      "weight": "答辩表现占复赛/决赛总成绩50%（官方明文）",
      "official_wording": "复赛要求被选拔出来的队伍以答辩的形式向专家组汇报，由专家组结合答辩表现（占50%）和提交作品的质量（占50%）评定参赛作品的成绩（西南赛区通知）；全国总决赛采用双盲评审制度（中国科学技术大学赛事报道）",
      "scoring_points": [
        "汇报逻辑：设计动机-方案-验证结果-教学价值的完整闭环",
        "PPT质量与表达清晰度（全程隐去学校/姓名信息）",
        "回答专家追问的准确性与临场应变（原理、数据、误差来源）",
        "团队成员分工与全员参与度"
      ],
      "common_deductions": [
        "答辩中泄露学校、指导教师或队员信息（章程明文规定视严重程度在总成绩中扣分）",
        "回答不了自己作品的表征数据与原理细节",
        "汇报超时、答辩由单人包办"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "实验作品论文/方案",
      "format": "Word/PDF 按章程格式，匿名（隐去学校、选手、指导教师姓名）",
      "page_limit": "未明确（按当届通知模板）",
      "deadline_note": "分赛区比赛前提交；赛程通常2月发通知、6-7月分赛区、8月总决赛"
    },
    {
      "item": "实验视频",
      "format": "视频记录实验真实操作与现象；视频答辩要求两个摄像机位",
      "page_limit": "未明确",
      "deadline_note": "与作品论文同批提交分赛区"
    },
    {
      "item": "答辩PPT",
      "format": "现场汇报或视频答辩，匿名",
      "page_limit": "未明确",
      "deadline_note": "复赛/决赛答辩前提交"
    },
    {
      "item": "报名（每队一件作品）",
      "format": "每队只能提交一件作品；每校最多两件且不能为同一赛道",
      "page_limit": "未明确",
      "deadline_note": "按分赛区通知时间（如华南赛区9月30日前提交校级材料）"
    }
  ],
  "process_stages": [
    {
      "stage": "校内选拔",
      "format": "参照全国赛三赛道评分（创新50%/可操作40%/规范10%为常见校内参照）",
      "notes": "选拔作品按每校限额（最多2件、不同赛道）报送分赛区"
    },
    {
      "stage": "分赛区初赛（作品网评）",
      "format": "作品匿名编号后保密送交专家组评审，可现场集中评审或网上评审",
      "notes": "初赛按作品质量遴选约70%进入复赛"
    },
    {
      "stage": "分赛区复赛（答辩）",
      "format": "答辩形式向专家组汇报；作品质量50%+答辩表现50%",
      "notes": "可现场或视频答辩，视频答辩要求两个摄像机位；双盲评审"
    },
    {
      "stage": "全国总决赛",
      "format": "现场作品汇报+答辩，双盲评审",
      "notes": "总成绩=实验作品成绩（论文+视频）50%+答辩成绩50%；设一、二、三等奖"
    }
  ],
  "review_format": "双盲评审：作品匿名网评（约70%进复赛）+现场/视频答辩，总成绩=作品质量50%+答辩表现50%",
  "judge_preferences": [
    "偏好\"真做出来\"的实验：视频与论文互相印证，反感纸面创新",
    "绿色化学与安全设计是化学学科评审的独特加分点",
    "改进实验要讲清改进的量化收益，科普实验要兼顾准确与趣味",
    "答辩考察对表征数据和原理的真实理解，忌背稿",
    "作品须适合本科教学推广——评委会问\"其他学校能复现吗\""
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "作品、视频、PPT、答辩全程须隐去学校名称、选手姓名、指导教师姓名，泄露信息按章程在总成绩中扣分",
    "每队限一件作品，人员与指导教师不得重复参赛",
    "作品须为原创且无版权争议，参赛队对材料真实性负责",
    "视频答辩须两个摄像机位，不合规将影响答辩成绩",
    "涉及危险化学反应须符合安全管理规定，重大安全隐患直接淘汰风险"
  ],
