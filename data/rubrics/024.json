{
  "competition_id": 24,
  "competition_name": "中国高校计算机大赛（4项）",
  "judging_dimensions": [
    {
      "dimension": "【大数据挑战赛】线上赛榜单成绩（评测指标客观排名）",
      "weight": "约15%（四赛项各占系列赛约1/4，赛项内部以线上榜单为主、决赛答辩为辅；占比推断）",
      "official_wording": "大数据挑战赛官网（2024.ncccu.org.cn）：整体流程为\"线上报名组队→区域赛设计与提交→线上评审→国赛答辩\"四阶段，国赛采用现场或网络答辩方式；线上赛在评测平台以评测指标（如AUC等）实时排行，每天提供固定评测次数、排行榜定时更新（天池类平台通用规则，2025年通知载明线上赛排名前70名及71—110名区间前30支学生队伍晋级）。赛项内权重【推断】。",
      "scoring_points": [
        "评测指标（准确率/AUC/F1等）在A/B榜上的客观排名",
        "模型方法的有效性与工程效率（训练资源约束）",
        "晋级名额内的名次决定决赛资格",
        "B榜（最终榜）成绩为主要依据"
      ],
      "common_deductions": [
        "每日评测次数用尽无法修正提交",
        "代码查重发现榜单作弊（ leaks/外部数据违规）取消成绩",
        "未按要求提交可复现代码"
      ]
    },
    {
      "dimension": "【大数据挑战赛】决赛答辩（方案陈述与问辩）",
      "weight": "约10%（推断，与上项合计为该赛项1/4）",
      "official_wording": "官网规程：晋级国赛后以现场或网络答辩方式进行（2024.ncccu.org.cn）；2026年通知：线上赛B榜前三名等晋级，决赛（8月中下旬）以现场答辩形式进行。",
      "scoring_points": [
        "特征工程与模型方案的技术含量与原创性",
        "答辩对模型细节、数据处理的真实验证",
        "结果与榜单成绩的一致性（防止答辩包装）",
        "展示表达的清晰度"
      ],
      "common_deductions": [
        "答辩无法解释榜单成绩来源",
        "核心成员答不上实现细节",
        "超时与材料不符"
      ]
    },
    {
      "dimension": "【团体程序设计天梯赛】机评客观计分（个人成绩之和=团体总分）",
      "weight": "约25%（天梯赛为完全机器评判的客观题赛事，团体总分即成绩）",
      "official_wording": "天梯赛\"竞赛题目均为在线编程题，由搭建在网易服务器上的PAT在线裁判系统自动评判\"，\"个人独立竞技、团体计分\"，时长150分钟；题目分三个梯级：基础级8题满分100分（5/10/15/20分题各2道）、进阶级4题各25分满分100分、登顶级3题各30分满分90分，全卷290分；每队10人，团体总分为队员个人得分之和，且进阶级/登顶级得分须在基础级总分达标后方可计入团体总分（百度百科词条及武汉理工大学等校通知）。",
      "scoring_points": [
        "基础级题目的快速全对（团队基本盘）",
        "进阶级L2题目的覆盖人数与得分率",
        "登顶级L3难题的突破情况",
        "团队总分位次决定高校/团队奖项"
      ],
      "common_deductions": [
        "评测罚时（错误提交累计罚时）影响同分排名",
        "作弊（代打、多账号）取消团队资格",
        "分工失衡导致高梯级无人覆盖"
      ]
    },
    {
      "dimension": "【移动应用创新赛】作品创新性与体验（App设计与开发）",
      "weight": "约25%（该赛项占系列赛约1/4；初复赛线上评审看作品，决赛公开答辩）",
      "official_wording": "移动应用创新赛由苹果公司与浙江大学联合主办，以iOS/iPadOS应用设计与开发为主，2—3人一队提交原创App原型；\"初赛和复赛采用线上评审，决赛采用公开答辩方式，具体评审规则按赛道不同在官网公布\"（章程转载页），评审结果由竞赛专家委员会审定，设\"最具创新奖\"等专项奖。",
      "scoring_points": [
        "创意与选题价值：解决真实需求的原创App想法",
        "设计体验：UI/UX完成度与交互流畅性",
        "技术实现：功能可运行、技术栈运用恰当",
        "答辩演示：现场Demo流畅、叙事完整"
      ],
      "common_deductions": [
        "原型仅剩效果图、核心功能不可演示",
        "抄袭现有App或模板项目",
        "未使用指定平台/技术要求"
      ]
    },
    {
      "dimension": "【网络技术挑战赛】双盲作品评审+总决赛答辩（创意类A/攻关类B）",
      "weight": "约25%（该赛项以作品双盲评审为主体；占比推断）",
      "official_wording": "竞赛规程：网络技术挑战赛分资格赛、选拔赛与挑战赛（全国总决赛）三阶段，\"选拔赛和挑战赛阶段的作品评审一律以'双盲'方式进行\"（赛氪第八届规程、哈工大威海2026规程）；选拔赛按赛区以10%、20%、40%比例设一、二、三等奖；曾获全国性奖项的作品将被取消选拔赛或挑战赛参赛资格。",
      "scoring_points": [
        "作品创新性与技术难度（A创意类重方案创意，B攻关类重工程实现）",
        "完成度：系统可演示、功能闭环",
        "应用价值与产业场景契合度（物联网、工业互联网等赛题方向）",
        "文档与答辩在双盲条件下的表达完备性"
      ],
      "common_deductions": [
        "使用曾获全国性奖项的作品参赛被取消资格",
        "双盲材料中出现学校/姓名等身份信息",
        "作品与赛题要求方向不符"
      ]
    },
    {
      "dimension": "【通用维度】学术诚信与规程合规",
      "weight": "定性（各赛项均实行资格审核与违纪取消机制）",
      "official_wording": "C4各赛事均要求以学生报名时在校学籍为准、分本科生组和研究生组，评审专家从专家库随机抽取、组委会全程监督，秉持公平公正原则（各赛项规程）。",
      "scoring_points": [
        "队员学籍与组别合规",
        "作品原创、代码可复现",
        "按阶段节点完成报名与提交"
      ],
      "common_deductions": [
        "跨校组队、学籍造假",
        "榜单/评测作弊",
        "逾期提交视为弃权"
      ]
    }
  ],
