{
  "competition_id": 37,
  "competition_name": "华为ICT大赛",
  "judging_dimensions": [
    {
      "dimension": "ICT理论知识（实践赛初赛）",
      "weight": "客观题机考：60分钟60道题，初赛阶段按理论成绩100%排名晋级",
      "official_wording": "华为ICT大赛中国区赛制（高校通知与官方赛事页）：校赛与省初赛为理论考试，\"60分钟，60道题\"（郑州铁路职院校赛通知载明省初赛同规格）；实践赛考察\"ICT理论知识储备、上机实践能力、团队协作能力\"",
      "scoring_points": [
        "路由交换/数据通信基础知识（网络赛道）",
        "云计算、openEuler/麒麟等基础软件知识（云/基础软件赛道）",
        "昇腾AI与人工智能基础知识（昇腾AI赛道）",
        "题量大时间紧，作答速度与准确率并重"
      ],
      "common_deductions": [
        "机考切屏/作弊行为触发系统判罚",
        "超时自动交卷，未答题目零分",
        "赛道报错后成绩不跨赛道累计"
      ]
    },
    {
      "dimension": "实验实操能力（实践赛复赛与总决赛）",
      "weight": "省复赛按理论+实验LAB合计分数排名；全球总决赛为8小时综合实验，实验成绩构成主要得分",
      "official_wording": "华为官网2025-2026全球总决赛页面：\"实践赛全球总决赛比赛形式为8小时综合实验，其中网络赛道使用eNSP模拟器软件进行实验；云赛道和基础软件赛道使用华为云进行实验；昇腾AI赛道使用华为云及香橙派开发板进行\"",
      "scoring_points": [
        "按任务书完成设备配置与业务开通（网络赛道eNSP）",
        "云上资源部署、服务搭建与调优（云/基础软件赛道）",
        "昇腾AI应用开发与模型部署（香橙派+华为云）",
        "故障排查与验收测试通过率",
        "长时程（8小时）任务的时间管理与分工"
      ],
      "common_deductions": [
        "前置配置错误导致后续任务连锁失分",
        "保存/提交环节遗漏，配置未落盘",
        "违规访问非授权资源被中止实验"
      ]
    },
    {
      "dimension": "创新赛作品（创新性/完整性/应用价值）",
      "weight": "创新赛官方细则未公开；参照华为系创新类赛事评审模型：创新性约30%、完整性约30%、商业/应用价值约30%、展示答辩约10%【推断】",
      "official_wording": "官方未公布创新赛评分细则表；【推断】依据：华为LiteOS Hackathon等华为系创新赛事公开评分表为\"创新性30%+完整性30%+商业价值30%+展示10%\"，与历届参赛队伍复盘所述评审导向（技能水平、职业素养、应用价值、团队合作、创新创意）一致；创新赛须作品提交+现场答辩",
      "scoring_points": [
        "选题新颖性：基于华为AI/云/昇腾等技术的差异化方案",
        "作品完成度：核心功能可演示、技术栈真实落地",
        "应用价值与产业结合度（行业痛点、推广前景）",
        "答辩表现：演示流畅、回答到位",
        "使用华为技术栈的深度与规范度"
      ],
      "common_deductions": [
        "PPT包装华丽但原型空洞",
        "未使用或浅层使用华为技术栈",
        "答辩由非核心成员应付、问题答不上"
      ]
    },
    {
      "dimension": "团队协作与赛纪",
      "weight": "团体成绩为唯一评定标准（每队3名学生+1名指导教师），个人违纪扣减团队分数直至取消成绩",
      "official_wording": "东南大学教务处转发第十届中国赛通知：\"各赛道以组队方式报名，以团体成绩为评定标准，依据成绩排名确定晋级队伍\"",
      "scoring_points": [
        "三人分工合理，理论与实验环节互补",
        "遵守诚信考试公约与实验环境规则",
        "晋级环节材料（报名信息、学籍证明）真实有效"
      ],
      "common_deductions": [
        "报名信息与学籍不符被取消资格",
        "考试作弊或实验违规取消全队成绩",
        "跨校组队或人数不符被驳回"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "理论考试（校赛/省初赛）",
      "format": "线上/考点机考客观题，60分钟60道题",
      "page_limit": "60题",
      "deadline_note": "省初赛约2025年11月中旬（第十届为11月15-16日）"
    },
    {
      "item": "实验LAB实操（省复赛/全国赛）",
      "format": "上机实验：eNSP模拟器（网络）/华为云（云、基础软件）/华为云+香橙派（昇腾AI）",
      "page_limit": "未明确",
      "deadline_note": "省复赛至全国总决赛阶段（约12月-次年4月）"
    },
    {
      "item": "创新赛作品包",
      "format": "项目方案+可演示作品+演示视频/材料，并参加现场答辩",
      "page_limit": "未明确",
      "deadline_note": "初赛材料截止约2025年12月初（第十届为12月7日），晋级名单约2026年1月公布"
    }
  ],
  "process_stages": [
    {
      "stage": "校赛/报名（9-11月）",
      "format": "华为ICT学院高校组织报名与校赛理论选拔（60分钟60题）",
      "notes": "第十届中国区报名2025年9月10日-11月30日；实践赛设网络、云、基础软件、昇腾AI四个赛道"
    },
    {
      "stage": "省赛（初赛+复赛，11-12月）",
      "format": "省初赛理论机考；省复赛理论+实验LAB",
      "notes": "按团体成绩排名确定晋级全国总决赛队伍"
    },
    {
      "stage": "中国全国总决赛（约次年3-4月）",
      "format": "综合实验与作品答辩（创新赛）分赛道进行",
      "notes": "晋级队伍代表中国区参加全球总决赛"
    },
    {
      "stage": "全球总决赛（约5-6月）",
      "format": "实践赛8小时综合实验；创新赛、编程赛分别评审",
      "notes": "第九届48个国家和地区179支队伍晋级、18支获特等奖；第十届49个国家和地区获奖，特等奖18支"
    }
  ],
  "review_format": "实践赛全程机评（理论客观题+上机实验）按团体成绩排名晋级；创新赛以作品评审加现场答辩由评委打分；编程赛按程序判定结果评分。",
  "judge_preferences": [
    "实践赛完全以任务完成结果与实验通过率说话，容错率低",
    "赛道知识体系以华为认证（HCIA/HCIP/HCIE）大纲为蓝本",
    "创新赛重视华为技术栈（昇腾、华为云、鸿蒙等）的真实深度应用",
    "团体赛强调分工与协作过程可验证",
    "长时实验考查工程规范：配置备份、文档、验收测试"
  ],
