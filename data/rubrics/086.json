{
  "competition_id": 86,
  "competition_name": "金相技能大赛个人赛",
  "judging_dimensions": [
    {
      "dimension": "金相图像质量",
      "weight": "80分/100分（80%；早期版本为70分）",
      "official_wording": "《全国大学生金相技能大赛评分标准》（经百度百科第十三届词条及河北科技大学教务处公布的评分标准附件转述）：总分100分，金相图像质量80分、样品表面质量10分、操作规范10分；郑州大学公布的早期细则中'组织正确与组织清晰度占40分，几乎看不清组织计0-5分'。图像质量权重为官方评分标准口径。",
      "scoring_points": [
        "组织正确：观察到的显微组织与试样材料应有的平衡/热处理组织一致（如45钢退火态铁素体+珠光体）",
        "组织清晰：晶界、相界清晰，浸蚀深浅适中、衬度好",
        "无明显划痕、无麻坑、无假象（如水迹、脏物、过蚀）",
        "视场选择具代表性，拍照取景与对焦准确"
      ],
      "common_deductions": [
        "组织判定错误（显示错误相区/未显出组织）重扣",
        "划痕贯穿视场、腐蚀不均或过蚀发黑",
        "图像离焦、视场选在边缘缺陷区"
      ]
    },
    {
      "dimension": "样品表面质量",
      "weight": "10分/100分（10%）",
      "official_wording": "《全国大学生金相技能大赛评分标准》转述：样品表面质量10分；清华大学材料学院赛事报道原文：'评委则从金相图像质量、样品表面质量和操作规范等三大方面对选手的实验技能进行评比考察'。",
      "scoring_points": [
        "磨面平整、无塌边倒角",
        "抛光后表面光亮无肉眼可见划痕与残留",
        "腐蚀后表面洁净、无氧化皮与污渍残留"
      ],
      "common_deductions": [
        "磨面呈斜面或塌角",
        "抛光不充分留有旧磨痕（假划痕）",
        "水迹、指纹、腐蚀液残留污染表面"
      ]
    },
    {
      "dimension": "操作规范",
      "weight": "10分/100分（10%），按三环节违规现场扣分",
      "official_wording": "评分标准原文（桂林航天工业学院校内选拔赛通知转述）：操作按'预磨、抛光及腐蚀、显微镜观察'三个环节评定，'每环节出现违规情况各扣分一次'，违规包括'可能导致身体受到伤害的危险操作、违反安全卫生及设备使用规程的操作'；'评分标准明确列出可现场扣分的所有操作，未列出的操作原则上不予直接扣分'。",
      "scoring_points": [
        "预磨环节：水冷磨制、逐级换砂纸并转90°、砂纸选用与更换规范",
        "抛光及腐蚀环节：抛光织物与悬浮液使用规范、试样清洗、腐蚀时间与通风防护",
        "显微镜观察环节：按规程操作物镜/载物台，防止镜头与试样碰撞",
        "全程安全意识：护目镜/手套佩戴、危险操作规避"
      ],
      "common_deductions": [
        "干磨过热、越级跳换砂纸",
        "试样未洗净即腐蚀或镜检、腐蚀液滴洒",
        "镜头触碰试样、随意调节他人设备",
        "危险操作（徒手处理腐蚀液等）每环节记一次扣分"
      ]
    },
    {
      "dimension": "制样效率与时间控制",
      "weight": "定性门槛（规定时间内完成为前提，超时按规则处理，不单独计分）",
      "official_wording": "各校选拔赛通知通行表述：'参赛者需在30分钟内（校赛口径）完成样品的粗磨、细磨、抛光、腐蚀（浸蚀）等工序，制备出可供金相显微镜观察、评委评分的样品'；国赛时间以当届竞赛规程为准。时间要求为官方规程口径，具体分钟数各届有别。",
      "scoring_points": [
        "工序衔接紧凑，全程在规定时间内完成",
        "合理安排各级磨制时间，为抛光腐蚀留足余量",
        "在时间约束下兼顾质量：以图像质量为主要得分点"
      ],
      "common_deductions": [
        "超时未完成，图像质量自然失分",
        "前松后紧导致抛光/腐蚀草率",
        "重复返工（回退粗磨）浪费时间"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "金相试样",
      "format": "现场按规定工序完成的金相试样（常见工业纯铁、20/45钢、T8/T12碳工钢、球墨铸铁等，当届指定试样由组委会统一公布），试样上按规则标记考号",
      "page_limit": "未明确",
      "deadline_note": "现场限时制备（校赛常见30分钟；国赛时间以当届规程为准）"
    },
    {
      "item": "金相显微图像",
      "format": "在指定金相显微镜上选取视场并现场拍摄/供评委现场观察评分",
      "page_limit": "未明确",
      "deadline_note": "制样完成后即时提交观察"
    },
    {
      "item": "报名",
      "format": "校级预选→省级复赛（按名额推荐，如陕西赛区按校赛前8名）→全国决赛；个人报名经由学校统一组织",
      "page_limit": "未明确",
      "deadline_note": "第十四届决赛2025年7月25-30日在成都工业学院宜宾校区举行"
    }
  ],
  "process_stages": [
    {
      "stage": "校级预选赛",
      "format": "现场制样+显微镜观察评分，采用与国赛相同的评分标准",
      "notes": "约4-5月；分级赛制（东莞理工学院获奖报道确认'大赛采取分级赛制'）"
    },
    {
      "stage": "省级复赛/赛区选拔",
      "format": "统一试样、限时制样，按成绩推荐国赛名额",
      "notes": "约5-6月"
    },
    {
      "stage": "全国决赛",
      "format": "现场独立完成磨制、抛光、腐蚀、显微观察，评委按图像质量/表面质量/操作规范三方面现场评分",
      "notes": "教育部高等学校材料类专业教学指导委员会主办，2025年7月25-30日第十四届（徕卡杯）在成都工业学院宜宾校区举行，同期第三届'金相大会'（理论赛道：复赛、半决赛、决赛）"
    }
  ],
  "review_format": "现场限时独立制样，评委依据全国统一的《评分标准》就金相图像质量（80分）、样品表面质量（10分）与操作规范（10分）三方面当场打分，操作违规按环节记录扣分。",
  "judge_preferences": [
    "以金相图像质量为绝对主导（80分）：组织正确且清晰远胜表面美观",
    "组织判定是核心功力：能依据材料与状态说出应显示的组织并正确显出",
    "操作规范看安全与规程，违规只按列明情形扣分，不搞主观泛化扣分",
    "同分倾向比较图像清晰度与划痕水平",
    "反感投机：套用他人制备参数而不根据材料特性调整腐蚀时间等"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "不得请他人代磨代制或与他人交流试样，独立操作否则取消成绩",
    "试样、砂纸、抛光盘等不得互换使用（防作弊与交叉污染）",
    "违反安全规程的危险操作将被现场扣分直至终止比赛资格",
    "超时未完成制样直接造成图像质量失分",
    "获奖比例按当届规程执行（业内通行说法一等奖约10%、二等奖约20%、三等奖约30%，属转述未经官方确认）"
  ],
