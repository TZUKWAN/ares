{
  "competition_id": 8,
  "competition_name": "全国大学生机械创新设计大赛",
  "judging_dimensions": [
    {
      "dimension": "选题评价（新颖性、实用性、意义或前景）",
      "weight": "定性综合评价，官方未公布各观测点权重",
      "official_wording": "参赛作品的评审采用综合评价，评价观测点：1.选题评价（1）新颖性（2）实用性（3）意义或前景（第十二届常规赛参赛须知）",
      "scoring_points": [
        "选题是否切合当届主题与内容（如第十二届：特定水产品初加工机械、叶菜洁净化处理包装一体化机械、高性能仿生蝴蝶）",
        "功能原理与方案的新颖程度",
        "实际应用价值与推广前景（是否源于真实生产场景调研）",
        "选题意义（服务渔业/农业机械化等当届导向）"
      ],
      "common_deductions": [
        "选题偏离当届主题和内容（全国决赛作品必须与主题内容相符）",
        "功能与市场现有产品同质化、无明显新意",
        "应用场景不成立（如把家用场合机械用于批量化加工命题）"
      ]
    },
    {
      "dimension": "设计评价（创新性、结构合理性、工艺性、智能数字技术应用、说明书与图纸质量）",
      "weight": "定性综合评价，官方未公布权重",
      "official_wording": "2.设计评价（1）创新性（2）结构合理性（3）工艺性（4）智能、数字和5G通信技术的应用（5）设计说明书、图纸质量（第十二届常规赛参赛须知）；评审观测点主要包括……设计的创新性、结构合理性、技术文件的质量、设计理论和方法的应用、数字化智能化技术的应用（大赛评审规则2023年修订稿）",
      "scoring_points": [
        "机构方案创新性与运动方案巧妙程度（灵巧与智能结合，结构越简单越好）",
        "机构自由度计算、运动学与动力学分析的准确性",
        "机械原理、机械设计课程设计理论与方法的正确运用",
        "智能技术、数字（孪生）技术、5G通信技术的合理融入",
        "设计说明书完整性与图纸符合国家标准"
      ],
      "common_deductions": [
        "结构复杂臃肿、为创新而堆砌机构",
        "运动分析或强度刚度设计计算错误",
        "说明书与图纸内容矛盾、图面不规范"
      ]
    },
    {
      "dimension": "制作评价（功能实现、制作水平与完整性、作品性价比）",
      "weight": "定性综合评价，官方未公布权重",
      "official_wording": "3.制作评价（1）功能实现（2）制作水平与完整性（3）作品性价比（第十二届常规赛参赛须知）；对作品的功能、设计、结构、工艺制作、性能价格比、先进性、创新性、实用性等多方面进行综合评价（同文件）",
      "scoring_points": [
        "样机能否现场完整实现命题要求的加工/处理/飞行功能",
        "加工节拍、单位时间加工量等功能指标的达成",
        "零部件加工装配质量与运行可靠性",
        "成本控制与性价比"
      ],
      "common_deductions": [
        "现场演示失败或功能缩水",
        "过度小型化模型、与工程实际脱节",
        "过度使用3D打印，缺少机械加工工艺体现（须知明确提醒切勿过度）"
      ]
    },
    {
      "dimension": "现场评价（介绍及演示、答辩与质疑）",
      "weight": "定性综合评价，官方未公布权重",
      "official_wording": "4.现场评价（1）介绍及演示（2）答辩与质疑（第十二届常规赛参赛须知）；评委通过审阅设计资料、观摩实物演示与问辩、学生答辩等过程……进行综合评价（评审规则2023年修订稿）",
      "scoring_points": [
        "作品介绍重点突出、在限定时间内讲清创新点",
        "演示流畅、可视性强（不能提供特殊环境的须备演示录像）",
        "回答评委质疑有理有据、队员分工清楚"
      ],
      "common_deductions": [
        "演示环境苛刻导致无法现场展示且无录像备份",
        "答辩由指导教师代答、队员对设计细节不熟悉",
        "介绍空洞、回避作品缺陷"
      ]
    },
    {
      "dimension": "高性能仿生蝴蝶专项（飞行比赛+设计评审加权）",
      "weight": "飞行比赛60% + 仿生设计评审40%（第十二届官方规定）",
      "official_wording": "飞行比赛得分=飞行距离（单位:m）×1分/m+调头次数×2分/次，总成绩为：飞行比赛得分（占60%）+仿生设计评审分（占40%）（第十二届常规赛参赛须知）",
      "scoring_points": [
        "2分钟内飞行距离与调头次数（得分公式直接计分）",
        "满足四翅并拢竖立、摆翅≥90°等5点设计要求",
        "结构合理性和性能分析、创新性、设计图纸（含效果图）质量、智能数字技术应用、答辩表现（设计评审5个观测点）"
      ],
      "common_deductions": [
        "尺寸超0.4m、电池电压超24V或总质量超2kg即不符合设计要求",
        "无法起飞或飞行失控得零距离分"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "设计说明书及主要设计图纸",
      "format": "纸质+电子文档；图纸含（A0或A1）总装配图、部件装配图和若干重要零件图，仿生蝴蝶另附外观效果图",
      "page_limit": "未明确（图纸须正确规范，国家标准要求均为评价要素）",
      "deadline_note": "随赛区预赛报名材料提交；主要图纸不合格在全国决赛初评中直接淘汰"
    },
    {
      "item": "实物样机或放缩实物模型（决赛）",
      "format": "决赛展台布置，体积一般不超过1.2×1.2×1.2立方米，特殊情况单方向可放大至2米但体积不得增加",
      "page_limit": "未明确",
      "deadline_note": "全国决赛现场评审前按组委会要求布置（第十二届现场评审2026年7月中下旬于哈尔滨工业大学）"
    },
    {
      "item": "展页",
      "format": "面积不超过1.8×1平方米",
      "page_limit": "≤1.8m×1m",
      "deadline_note": "决赛布展时提交"
    }
  ],
  "process_stages": [
    {
      "stage": "校内选拔",
      "format": "各校组织校内选拔赛（本科院校预赛作品上限15项、专科7项）",
      "notes": "学校统一向赛区组委会报名，禁止跨赛区参赛；作品名称必须用中文表述"
    },
    {
      "stage": "赛区预赛",
      "format": "每省（自治区、直辖市）一个赛区，实物演示+问辩评审；全国组委会派巡视员督查",
      "notes": "第十二届要求2026-05-10前完成预赛，05-20前上报决赛名单；赛区开幕式20天前须报送组委会/评委会名单与作品数"
    },
    {
      "stage": "全国决赛初评（网评）",
      "format": "评审专家按赛区上报材料分组进行初步评审，确定现场评审名单和部分获奖名单",
      "notes": "第十二届2026-06-15前公布参加全国决赛作品名单"
    },
    {
      "stage": "全国决赛现场评审",
      "format": "实物演示+问辩+答辩，分小组评审与集中评审两步；评委回避与保密制度",
      "notes": "2026年7月中下旬在哈尔滨工业大学举行；设慧鱼专项竞赛组；数字孪生设计挑战赛季另轨举办"
    }
  ],
  "review_format": "综合评价制：评委依据《评审规则（2023年修订）》对选题、设计、制作、现场表达四方面观测点独立打分，小组评审按得分排序提出获奖建议名单，评委会集中复审并投票确定奖次；仿生蝴蝶按飞行60%+设计评审40%加权。",
  "judge_preferences": [
    "严格切题：作品必须紧扣当届主题与三项内容，离题作品直接失去竞争力",
    "灵巧+智能：功能相同下机械结构越简单越好，提倡智能/数字/5G技术提升时代性",
    "工程实现力：功能真实可实现、加工节拍可量化、图纸完全符合国标",
    "强调调研与实用价值，鼓励到水产品/蔬菜生产基地实地调研获取设计灵感",
    "答辩重原理与数据，评委常就机构自由度、强度设计、节拍计算质疑"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "禁止用社会上现有产品或整套产品部件自行组装出作品参赛",
    "主要设计图纸不合格的作品将在全国决赛初评中直接淘汰",
    "实物演示不能对决赛现场造成环境污染或场地破坏",
    "不允许参赛队擅自参加其他赛区预赛；各校不得向学生个人收取参赛费用",
    "评委实行回避制度和保密制度，评审结束前不得泄露评审情况与结果"
  ],
