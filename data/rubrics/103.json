{
  "competition_id": 103,
  "competition_name": "GIS应用技能竞赛",
  "judging_dimensions": [
    {
      "dimension": "空间数据采集、编辑与集成处理（空间数据库建库）",
      "weight": "全国赛历届为上、下午两场各一道综合题、合计100分，本模块对应上午场，约占50%【推断：依据武汉大学获奖新闻'比赛内容涵盖从空间数据编辑、集成处理到空间分析'及承办高校校内选拔通知'1.空间数据采集编辑与集成处理 2.空间分析技术的应用'的两段式赛题结构；全国赛未公开分值分配表】",
      "official_wording": "全国赛未公开评分细则原文。推断依据①：武汉大学遥感信息工程学院获奖新闻（2024-11-28）：'比赛内容涵盖了从空间数据编辑、集成处理到空间分析等多个方面'；推断依据②：与全国赛内容对接的省级赛通知（安徽省教育厅）原文：'考查参赛队伍的空间数据处理、分析与可视化能力……实现空间数据的采集与编辑（如点、线、面采集、属性信息采集、栅格分析等）、存储与管理（如空间数据库建库、空间查询、数据更新等）、处理与变换（如数据格式转换、比例尺及投影变换、数据校正等）'。",
      "scoring_points": [
        "图像纠正、定向、图层创建与点/线/面要素采集的准确性与完整性",
        "坐标/投影变换、格式转换、数据校正与拓扑处理结果正确",
        "多源异构数据（矢量、遥感影像、地形数据等）整合入库满足空间数据库规范",
        "属性数据采集与挂接无误、字段结构合理",
        "操作流程归纳总结、过程文档撰写清晰"
      ],
      "common_deductions": [
        "要素采漏、采错或几何拓扑错误（悬挂点、自相交等）",
        "坐标系/投影定义错误导致成果无法叠加",
        "数据库分层命名与结构不规范",
        "成果中出现学校或个人信息违反匿名要求"
      ]
    },
    {
      "dimension": "空间分析技术的应用",
      "weight": "对应下午场，约占50%【推断：同上，依据'从空间数据编辑、集成处理到空间分析'的两段式赛题结构与省级对接赛'空间分析技术的应用'模块；全国赛未公开分值分配表】",
      "official_wording": "全国赛未公开评分细则原文。推断依据①：武汉大学新闻'比赛内容涵盖了从空间数据编辑、集成处理到空间分析等多个方面'；推断依据②：安徽省赛通知原文：'空间分析与统计（如矢量数据的叠加分析、缓冲区分析、网络分析，栅格数据的水文分析、地形分析、聚类聚合分析，空间统计分析、三维分析等）……完成诸如选址分析、区域规划、地理过程模拟、资源管理、生态评价、灾害预警、国土监测等应用'。",
      "scoring_points": [
        "分析方法选型正确（叠置、缓冲区、网络分析、地形/水文分析等切合题意）",
        "参数设置与中间结果正确，分析链路可复现",
        "应用结论（选址/规划/评价类问题）有数据支撑、逻辑自洽",
        "建模思路对实际地学问题的抽象合理"
      ],
      "common_deductions": [
        "工具/参数误用导致分析结果整体偏差",
        "仅给结果无分析过程，无法按步给分",
        "结论与数据矛盾或缺乏空间思维、套用模板",
        "未在规定时限内提交完整成果"
      ]
    },
    {
      "dimension": "地图制图与成果表达（专题图与文档报告）",
      "weight": "定性评分项，占比低于两大操作模块，含在各场计分内【推断：省级对接赛单列'地图制图与表达能力。考察学生在地图制图表达……'及'能对整个操作过程做出归纳总结，并撰写文档材料'，全国赛历届要求提交成果数据与文档】",
      "official_wording": "全国赛未公开评分细则原文。推断依据：安徽省赛通知原文：'地图制图与表达能力。考察学生在地图制图表达……'、'能对整个操作过程做出归纳总结，并撰写文档材料'、'显示与输出（如报表导出、专题制图等）'；武汉大学新闻提及队员训练'文档的撰写能力'。",
      "scoring_points": [
        "专题地图符号化、配色、注记与图面整饰规范美观",
        "图名、图例、比例尺、指北针等制图要素齐全",
        "报告/文档结构完整：技术路线、关键步骤、结果说明",
        "图表与成果数据一致，无自相矛盾"
      ],
      "common_deductions": [
        "制图要素缺失（无图例/比例尺/坐标信息）",
        "文档描述与提交的数据成果不符",
        "版面混乱、符号压盖、可读性差"
      ]
    },
    {
      "dimension": "竞赛合规与诚信（匿名、限时、软件限定）",
      "weight": "资格性要求，违者取消评审资格或扣分（一票否决性质的合规项）【推断：依据官方通知'提交参赛学生诚信竞赛承诺书'与'参赛单位须选用易智瑞或超图的相关软件'】",
      "official_wording": "官方通知原文（中国地理信息产业协会，第十三届）：'参赛学校请务必于2024年9月30日之前扫码报名，并提交参赛学生诚信竞赛承诺书'；'参赛单位须选用易智瑞或超图的相关软件（即ArcMap、ArcGIS Pro、GeoScene Pro、SuperMap iDesktop）'；省级对接赛同款规则：'参赛队伍……在规定时间内完成大赛试题、提交竞赛作品（作品中不得出现任何与参赛单位、个人有关的信息），组委会聘请专家对各参赛队伍作品匿名评审，并根据成绩高低排序，产生奖项'。",
      "scoring_points": [
        "作品与文档中不出现任何单位、姓名等身份信息（匿名评审前提）",
        "签署并按时提交诚信竞赛承诺书",
        "在规定比赛时段内独立完成并提交全部成果",
        "仅使用指定范围内软件（ArcMap/ArcGIS Pro/GeoScene Pro/SuperMap iDesktop）"
      ],
      "common_deductions": [
        "成果或文件属性中泄露单位/个人信息",
        "逾期提交或缺失规定成果文件",
        "使用非指定软件处理导致成果无法核验",
        "代做、抄袭等违反诚信承诺行为（取消资格）"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "赛题成果数据（空间数据库/分析结果）",
      "format": "指定GIS软件（ArcMap、ArcGIS Pro、GeoScene Pro、SuperMap iDesktop）生成的空间数据成果，按试题要求组织提交",
      "page_limit": "未明确",
      "deadline_note": "大赛为期约2天：第1天注册报到，第2-3天比赛、颁奖（第十三届2024年11月8-10日）；各场赛题限时当场提交"
    },
    {
      "item": "过程文档/成果报告与专题图",
      "format": "文档编排软件撰写的操作总结与制图成果（历届惯例）",
      "page_limit": "未明确",
      "deadline_note": "随各场赛题在规定时间内提交"
    },
    {
      "item": "报名与诚信竞赛承诺书",
      "format": "队长扫码报名（每校限报1队，学生不超过4人、指导教师不超过2人，限在读本科生）+ 诚信竞赛承诺书",
      "page_limit": "未明确",
      "deadline_note": "第十三届报名截止2024年9月30日"
    }
  ],
  "process_stages": [
    {
      "stage": "校内选拔",
      "format": "各参赛单位自行举办校内选拔赛，选拔优秀在读本科生组队",
      "notes": "每校限报1支队伍；武汉大学2024年6月22日校赛、9月初模拟赛、11月初省赛逐级训练，可作典型节奏参考"
    },
    {
      "stage": "报名与备赛",
      "format": "队长扫码报名并提交诚信承诺书；无相应软件可向易智瑞/超图申请参赛版本",
      "notes": "报名截止（第十三届为2024-09-30）后组委会协助网络设备调试与模拟测试"
    },
    {
      "stage": "正式比赛",
      "format": "线上线下一体化模式（举办地周边高校建议线下），在规定时段内完成上、下午两道综合操作题",
      "notes": "统一题目与数据；主要考察空间数据编辑/建库与空间分析两大板块；用时约每半天一道综合题（历届惯例）"
    },
    {
      "stage": "评审与颁奖",
      "format": "组委会聘请专家匿名评审，按成绩高低排序产生奖项",
      "notes": "依实际参赛队伍数量设特等奖、一等奖、二等奖、三等奖，颁发证书及奖品；比赛结束后随即颁奖（第十三届11月8-10日内完成）"
    }
  ],
  "review_format": "组委会聘请专家对按规定时间提交的竞赛作品进行匿名评审，依成绩高低排序评奖（专家评审+成果计分制）。",
  "judge_preferences": [
    "成果数据正确性与规范性优先：坐标、拓扑、数据库结构等硬指标错一处扣一处",
    "空间分析思路与题意契合，重建模过程而非软件炫技",
    "专题图与文档表达专业、要素齐全，体现地学素养",
    "全部成果在时限内完整提交，操作链路可复现",
    "严格遵守匿名与诚信要求"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "作品或文件属性中出现学校、姓名等身份信息（匿名评审红线）",
