{
  "competition_id": 97,
  "competition_name": "海洋航行器设计与制作大赛",
  "judging_dimensions": [
    {
      "dimension": "创意设计与创新性（A类：新概念创意设计）",
      "weight": "专家评审定性打分+现场答辩计分（主观类，官方分项权重见当届评分细则，通行构成为创新性/设计方案/展示答辩）",
      "official_wording": "各高校转发的大赛章程：A类为新概念海洋航行器、海洋工程装备创意设计介绍与演示，需PPT演讲，现场答辩作品介绍一般不超过5分钟；上海海事大学校赛通知要求『按全国海洋航行器设计与制作大赛评分细则及要求完成比赛作品，并填写相应比赛类别的作品说明书』。官方分项分值未公开检索到，属专家主观评审【推断依据：历届章程与评分细则文档结构】",
      "scoring_points": [
        "新概念方案原创性与前瞻性（新构型、新原理、新用途）",
        "设计方案的完整性与可实现性（总体布置、性能估算、关键技术）",
        "创新点凝练与对比现有装备的先进性",
        "PPT演讲与现场答辩表现（限时约5分钟）",
        "作品说明书撰写质量（按当届模板）"
      ],
      "common_deductions": [
        "概念空泛、无量化性能论证",
        "答辩超时、答不清关键技术细节",
        "说明书未按模板或工作量明显不足",
        "与往届获奖作品或已有装备高度雷同"
      ]
    },
    {
      "dimension": "实物制作与航行性能（B类设计与制作—水面/水下组、E类船模竞速）",
      "weight": "客观成绩为主：竞速类按计时/计分排名（成绩为客观分数）；设计与制作类按航行任务完成度+制作工艺综合评定（主观+客观结合）",
      "official_wording": "历届章程将船模竞速赛类列为使用自行制作船模进行竞速比拼，按比赛成绩计时/计分；『设计与制作—水面组/水下组』按组别评审（澳门城市大学等获奖报道出现该组别名）。评分细则按类别单列（上海海洋大学《第十三届评分细则》36页文档）【推断依据：章程类别设置与客观类计分惯例】",
      "scoring_points": [
        "航行器总体设计合理性（浮性、稳性、快速性、操纵性）",
        "制作工艺水平：结构强度、水密性、外观质量",
        "动力与控制系统可靠性：完整完成航行任务不故障",
        "竞速类：航速计时成绩、航线完成度、犯规次数",
        "水下组：潜浮控制精度与定向定深表现"
      ],
      "common_deductions": [
        "航行中途故障、无法完成规定航线",
        "水密失效进水、结构损坏",
        "试航调试超时占用比赛资源",
        "船模尺寸/动力超规被取消该轮成绩"
      ]
    },
    {
      "dimension": "模型仿真制作与考证（D类：名船名舰外观模型仿真制作）",
      "weight": "专家评审定性打分（第十四届国赛通知要求晋级作品另提交宣传海报电子版；官方分项权重见当届细则）",
      "official_wording": "新华网第十五届大赛报道明确D组评审维度为：外观还原度、结构合理性、制作精细度、考证准确性；上海海洋大学《第十三届评分细则》含D组比赛形式（自行设计制作指定船型的仿真模型）、流程及对提交材料、答辩环节、最终效果的打分排名方式",
      "scoring_points": [
        "外观还原度：与真实舰船外形、涂装、标识一致",
        "考证准确性：历史/技术资料依据充分、细节有出处",
        "结构合理性与制作精细度：做工、比例、几何精度",
        "展示效果与答辩（制作过程介绍、回答评委提问）",
        "国赛晋级作品提交制作宣传海报电子版"
      ],
      "common_deductions": [
        "比例失真、明显外观错误",
        "考证无依据、张冠李戴",
        "工艺粗糙、表面处理差",
        "使用成品模型改装冒充自制"
      ]
    },
    {
      "dimension": "智能航行与任务能力（C类：舰船模型智能航行/海上争锋智能舰艇挑战赛）",
      "weight": "客观分数计分为主：按自主航行任务完成度与用时计分排名，辅以技术方案评审",
      "official_wording": "历届章程设舰船模型智能航行类及『海上争锋』智能舰艇挑战赛，与主观类竞赛并行；队伍参加新概念创意设计类、海洋航行器设计与制作类、舰船模型智能航行类、名船名舰外观模型仿真制作类、船模竞速类等（高校参赛通稿）【推断依据：章程类别设置，智能航行类按任务完成客观计分】",
      "scoring_points": [
        "自主识别、避障、航线跟踪等任务完成度",
        "完成任务用时与精度",
        "感知与控制算法的技术先进性（技术方案书+答辩）",
        "系统稳定性：全程无人工干预、无死机搁浅"
      ],
      "common_deductions": [
        "任务失败、人工干预（按轮次计零分/扣分）",
        "传感器失灵未在检录调试阶段解决",
        "技术方案与实物功能不符"
      ]
    },
    {
      "dimension": "海洋产业调研与工程论证（F类调研分析/游艇设计等）",
      "weight": "报告评审+答辩（主观类定性评议，权重见当届细则）",
      "official_wording": "大连海事大学船海文化节竞赛细则列有F海洋产业发展调研分析与E游艇设计类【推断依据：高校转发章程类别清单，此类按调研报告质量与答辩综合评定】",
      "scoring_points": [
        "选题贴近海洋装备产业真实问题",
        "数据与论据充分、分析方法科学",
        "结论与建议的工程/产业价值",
        "报告规范性与答辩表达"
      ],
      "common_deductions": [
        "数据陈旧、来源单一",
        "报告结构混乱、规范性差",
        "结论空泛无落地建议"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "作品说明书",
      "format": "按当届通知附件模板填写相应比赛类别的作品说明书（各校转发通知均要求）",
      "page_limit": "未明确（按当届模板）",
      "deadline_note": "如上海海事大学校赛说明书提交截止2024年6月下旬；全国赛以当届通知为准"
    },
    {
      "item": "实物作品/船模",
      "format": "按类别完成实物（创意设计类可为方案+PPT；设计制作/竞速/智能航行/仿真制作为实物船模），并按评分细则完成比赛作品",
      "page_limit": "不适用",
      "deadline_note": "随区域赛/国赛报到现场检录"
    },
    {
      "item": "答辩材料（主观类）",
      "format": "PPT演讲+现场答辩，作品介绍一般不超过5分钟",
      "page_limit": "介绍约5分钟",
      "deadline_note": "区域赛/国赛现场"
    },
    {
      "item": "国赛补充材料",
      "format": "第十四届国赛要求晋级国赛的名船名舰外观模型仿真制作（D组）作品提交制作宣传海报电子版",
      "page_limit": "未明确",
      "deadline_note": "国赛前按通知截止时间提交"
    }
  ],
  "process_stages": [
    {
      "stage": "校级选拔赛",
      "format": "各校自行组织校赛并按国赛评分细则执行（如上海海事大学『瓦锡兰』杯船模大赛暨第十三届国赛选拔）",
      "notes": "校赛晋级后方可参加区域赛；部分类别每校每组别有名额限制（第六届规定舰船模型智能航行、名舰名船模型仿真制作、船模竞速类每校每组别最多2支队伍）"
    },
    {
      "stage": "区域赛",
      "format": "分长三角（上海交大承办）、环渤海（大连理工）、华南（广州航海学院）、齐鲁（威海）等赛区，含现场比赛与答辩",
      "notes": "创意设计类报名超量时先网上初评决定决赛名单（第六届规则）"
    },
    {
      "stage": "全国总决赛",
      "format": "现场作品展示/比赛+答辩，评出特等奖、一等奖、二等奖等",
      "notes": "2025年第十四届总决赛8月9-10日在武汉理工大学举行，全国近400家单位3345支队伍、16000余名选手参赛；第十三届某届共收到568件参赛作品；华南区域赛同期举办首届全国青少年海洋航行器竞赛"
    }
  ],
  "review_format": "分类别双轨评审：主观类（创意设计、仿真制作、调研）采用作品评审+约5分钟现场答辩的专家打分制，客观类（竞速、智能航行）按计时与任务完成度机器/裁判计分排名，经校赛—区域赛—国赛三级选拔。",
  "judge_preferences": [
    "创新点明确且有工程可实现性支撑的方案最受青睐",
    "实物可靠：能在现场完整跑完任务/航线的作品远胜『纸面强队』",
    "仿真制作类重视考证有据、细节见功力",
    "答辩限时内讲清创新点与技术路线，答问干脆",
    "说明书与图纸规范、工作量饱满"
  ],
