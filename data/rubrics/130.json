{
  "competition_id": 130,
  "competition_name": "园冶杯大学生国际竞赛",
  "judging_dimensions": [
    {
      "dimension": "创新性与选题立意",
      "weight": "30%【推断权重，官方未公布量化评分细则】",
      "official_wording": "【推断】官方宗旨原文：“Increase students' innovation and design ability…show their creativity and academic exchange”（旨在提升学生创新与设计能力，搭建展示创意与学术交流的平台，官网参赛须知）。推断依据：竞赛以“创新与设计能力”为首要目标，且主题竞赛设“未来城市与绿色基础设施”等四大前沿主题，创新立意是首要筛选标准",
      "scoring_points": [
        "选题呼应当届主题竞赛方向（未来城市与绿色基础设施/健康空间规划设计/城市更新与社区治理/乡村振兴与文旅融合）",
        "设计概念新颖，回应真实的场地问题与社会需求",
        "体现生态、低碳、文化传承等前沿价值导向"
      ],
      "common_deductions": [
        "概念俗套、套用模板化方案",
        "选题与所报类别/主题方向脱节",
        "过度借鉴建成项目被认定缺乏原创"
      ]
    },
    {
      "dimension": "设计质量（功能、空间与技术合理性）",
      "weight": "30%【推断权重】",
      "official_wording": "【推断】评审主席团由“国内外知名专家学者、著名设计大师及地产、设计、工程企业技术负责人”组成，下设建筑、城乡规划、风景园林、环境艺术评审委员会（官网参赛须知原文）。推断依据：学术专家与工程企业技术负责人并重的评审构成，表明除创意外同样考核设计的技术与功能合理性",
      "scoring_points": [
        "场地调研与问题分析扎实，设计逻辑自洽",
        "功能布局、空间组织、交通流线合理",
        "植物配置/材料构造/技术措施可行",
        "设计成果对既有环境的负面影响控制与生态策略"
      ],
      "common_deductions": [
        "只有概念没有深化，平面与理念两张皮",
        "技术性错误（比例失真、规范冲突、植物选用不当）",
        "图纸信息无法支撑设计判断"
      ]
    },
    {
      "dimension": "图面表达与成果呈现",
      "weight": "25%【推断权重】",
      "official_wording": "【推断】竞赛面向建筑设计、城乡规划、风景园林、环境艺术等专业，每年有数百所国内外高校、近万名学生参加，获奖作品结集出版（官网及360百科）。推断依据：设计类竞赛以图面为唯一评审载体，表达质量直接影响评分，且作品需达到出版标准",
      "scoring_points": [
        "版面构图、排版层级清晰，视觉冲击力强",
        "分析图逻辑化、过程图完整（从调研到方案推演）",
        "效果图/表现图水准与整体风格统一",
        "图纸信息量与可读性平衡"
      ],
      "common_deductions": [
        "排版杂乱、字体字号混乱、拼贴痕迹重",
        "图面信息过载或空洞无物",
        "渲染与设计脱节、风格不统一"
      ]
    },
    {
      "dimension": "研究深度与学术规范（毕业论文类侧重）",
      "weight": "15%【推断权重】",
      "official_wording": "【推断】竞赛设毕业论文类（城乡规划与城市设计、园林规划设计、生态植物三个方向），与毕业设计类并列评审（官网参赛须知原文）。推断依据：论文类以研究方法、数据与论证为评审核心；设计类则考核调研分析深度",
      "scoring_points": [
        "研究问题明确、方法得当（论文类）",
        "数据/案例支撑充分，结论有说服力",
        "文献综述与学术引用规范",
        "设计类作品的调研分析章节完整深入"
      ],
      "common_deductions": [
        "论文结构松散、论证薄弱",
        "数据来源不明或分析浅表",
        "引用不规范、涉嫌学术不端"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "毕业设计类/课程设计类作品",
      "format": "设计图纸与展板（历届通行A0竖版展板、JPG格式，具体尺寸与张数以当届章程为准）【推断】；经官网大学生报名入口或高校联络员提交",
      "page_limit": "未明确（历届常见1-5张展板）",
      "deadline_note": "2023届报名时间为4月20日至7月10日；每年通知约2月发布、7月上旬截稿"
    },
    {
      "item": "毕业论文类",
      "format": "毕业论文全文（城乡规划与城市设计、园林规划设计、生态植物方向），按官网要求格式提交",
      "page_limit": "未明确",
      "deadline_note": "同上，随当届通知"
    },
    {
      "item": "主题竞赛作品",
      "format": "围绕四大主题方向的设计方案图纸（当届主题以通知为准）",
      "page_limit": "未明确",
      "deadline_note": "同上"
    },
    {
      "item": "报名信息",
      "format": "经官网报名系统或校级选拔（多所高校设校内选拔赛并经校级科研/教务平台报名），通过高校联络员统一组织",
      "page_limit": "不适用",
      "deadline_note": "报名期4-7月；获奖名单及公示约10月公布"
    }
  ],
  "process_stages": [
    {
      "stage": "通知发布与报名",
      "format": "约每年2-3月发布当届竞赛通知（第十四届通知2023年2月20日经中国风景园林网发布），4-7月报名",
      "notes": "园冶杯创立于2010年，每年一届，2026年为第十七届；面向建筑学、城乡规划、风景园林、环境艺术等专业，全球数百所高校、近万名学生参加"
    },
    {
      "stage": "校级选拔与作品提交",
      "format": "多所高校组织校内选拔（如西北农林科技大学、西安工业大学等），经校级平台遴选后统一报名提交",
      "notes": "报名截止约7月上旬（2023年为7月10日）"
    },
    {
      "stage": "评审",
      "format": "评审主席团（国内外知名专家学者、著名设计大师及地产、设计、工程企业技术负责人）下设建筑、城乡规划、风景园林、环境艺术四个评审委员会分类评审，评审委员由参赛院校推荐，名单评审前公布",
      "notes": "8-9月评审；期间常配套“园冶讲坛”学术活动；第十一届有400多位国内外专家学者参与评审"
    },
    {
      "stage": "公示、颁奖与成果出版",
      "format": "评审结果分批公示（第十六届课程设计类2025年10月20日公示、第十七届2026年6月公布），年底颁奖盛典颁发奖牌、证书或奖杯；获奖作品结集出版并巡展",
      "notes": "对一、二等奖及单项奖的指导教师授“年度优秀指导教师奖”；获奖学生可由组委会向行业知名企业推荐"
    }
  ],
  "review_format": "评审主席团下设建筑、城乡规划、风景园林、环境艺术四个专业评审委员会，分类别（毕业设计/毕业论文/课程设计/主题竞赛）匿名评审，评委由参赛院校推荐的专家学者、设计大师与企业技术负责人组成。",
  "judge_preferences": [
    "创新概念与前沿议题（绿色基础设施、健康空间、城市更新、乡村振兴）契合度高者占优",
    "从调研到方案的完整设计逻辑，忌“概念图拼贴”",
    "图面表达专业、版面有设计感，达到可出版水准",
    "生态与低碳策略落地、植物与材料等细节经得起推敲",
    "学生独立完成的原创设计，指导教师作用适度"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "官方参赛须知明文“禁止抄袭或过度借鉴”，违者取消评审资格",
    "参赛资料著作权归参赛者，但组委会拥有出版权和使用权，参赛相关资料不予退还（介意者慎投）",
    "需通过高校联络员/官网报名系统正规报名，警惕收费代办与虚假“保奖”中介",
    "勿将高校组（学生竞赛）与企业专业奖（专业组）混淆报名",
    "作品署名、指导教师信息须按当届章程填写，跨校拼队或信息不实可能被取消资格"
  ],
