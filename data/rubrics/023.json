{
  "competition_id": 23,
  "competition_name": "服务外包创新创业大赛",
  "judging_dimensions": [
    {
      "dimension": "创新性（技术、产品、模式创新点）",
      "weight": "约30%（校赛官方评分表中\"项目创新点30%\"，全国赛细则未公开，沿用该口径并注明）",
      "official_wording": "中国民航飞行学院第十四届通知载明校赛评分标准：\"填写及描述（20%）、项目创新点（30%）、市场前景（20%）、商业逻辑性（30%）\"；第十六届大赛通知要求参赛项目\"在技术、产品、模式等方面有创新\"（东南大学教务处转发）。",
      "scoring_points": [
        "针对企业命题（A类）提出超出赛题基线的技术方案或功能创新",
        "B类创业项目在细分领域有差异化竞争点",
        "AI、大数据等新技术与业务场景结合的真实深度",
        "创新点表述具体可验证，非概念堆砌"
      ],
      "common_deductions": [
        "创新点与赛题要求无关",
        "套壳开源项目宣称自研",
        "创新描述空泛，无技术证据支撑"
      ]
    },
    {
      "dimension": "专业能力与命题契合度（A类：专业技能与赛题完成度；B类：创业能力与成熟度）",
      "weight": "约25%（推断，对应官方\"重点考察专业技能及专业竞争力水平\"与\"创业能力和成熟度\"表述）",
      "official_wording": "大赛通知对A类（企业命题类）定位为\"重点考察参赛团队的专业技能及专业竞争力水平\"，B类（创业实践类）\"重点考察团队的创业能力和成熟度，侧重考查项目细分领域的竞争力和商业模式的创新性\"（各校转发的当届通知）。",
      "scoring_points": [
        "A类：对赛题需求的理解准确，交付物覆盖赛题全部功能点",
        "A类：技术架构合理，演示系统可现场运行",
        "B类：已有实际创业项目，有运营数据、用户或订单佐证",
        "团队知识结构与任务匹配，核心工作由队员完成"
      ],
      "common_deductions": [
        "演示系统崩溃或录屏代替真机演示",
        "交付物缺项，未覆盖赛题考核点",
        "B类项目无实际进展，仅停留在计划书"
      ]
    },
    {
      "dimension": "商业逻辑与市场前景",
      "weight": "约25%（对应校赛评分表\"市场前景20%+商业逻辑性30%\"口径的折中推断）",
      "official_wording": "校赛评分标准含\"市场前景（20%）、商业逻辑性（30%）\"（中国民航飞行学院第十四届通知）；A类企业命题本身即来源于企业真实需求场景。",
      "scoring_points": [
        "目标市场与用户画像清晰，需求痛点真实",
        "商业模式/盈利路径成立，成本收益测算有依据",
        "A类方案对企业降本增效或业务升级价值明确",
        "市场分析有数据来源，不凭空估计"
      ],
      "common_deductions": [
        "市场规模估算拍脑袋、引用来源缺失",
        "商业模式自相矛盾",
        "与命题企业实际业务脱节"
      ]
    },
    {
      "dimension": "作品完成度与展示答辩（填写及描述+路演问辩）",
      "weight": "约20%（对应校赛评分表\"填写及描述20%\"及区域赛/决赛答辩表现，综合推断）",
      "official_wording": "大赛采取\"作品线上初审+线下答辩+线下评审\"相结合的方式（第十六届，电子科技大学中山学院转发）；区域赛分东部、中部、西部、北部四赛区，全国总决赛在无锡以路演答辩形式进行（官网新闻及承办信息）。",
      "scoring_points": [
        "报名与作品材料填写完整、规范，按手册模板提交",
        "路演PPT逻辑清晰，演示聚焦核心功能",
        "答辩准确回应技术与商业双重追问",
        "时间控制与团队配合"
      ],
      "common_deductions": [
        "材料填写缺项或与系统信息不一致",
        "超时、念稿、答辩成员与作品贡献不符",
        "演示环境准备不足"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "A类企业命题作品（方案+系统）",
      "format": "按赛题手册要求的方案文档、演示系统/原型（可运行）",
      "page_limit": "未明确（按当届A类赛题手册模板）",
      "deadline_note": "初赛作品于规定窗口经官网系统提交，进入线上评审"
    },
    {
      "item": "B类创业实践类材料",
      "format": "创业项目说明书/商业计划书+项目佐证材料（运营数据等）",
      "page_limit": "未明确",
      "deadline_note": "同上；B类须已有实际创业项目"
    },
    {
      "item": "路演PPT与演示视频",
      "format": "PPT/MP4",
      "page_limit": "未明确",
      "deadline_note": "区域赛及全国总决赛阶段使用"
    },
    {
      "item": "官网报名信息",
      "format": "www.fwwb.org.cn 线上报名组队",
      "page_limit": "未明确",
      "deadline_note": "第十六届报名2024年12月—2025年3月20日，各届时间相近"
    }
  ],
  "process_stages": [
    {
      "stage": "校赛",
      "format": "校内选拔，按\"填写及描述20%/创新点30%/市场前景20%/商业逻辑30%\"等标准评审（各校参照执行）",
      "notes": "大赛分A类企业命题类、B类创业实践类、C类创响无锡类（单独组织评审，不参加区域赛）"
    },
    {
      "stage": "初赛（线上评审）",
      "format": "官网提交作品，初筛后进入线上专家评审",
      "notes": "第十六届初赛线上评审于2025年4月16日—5月6日进行"
    },
    {
      "stage": "区域赛（四赛区）",
      "format": "分东部、中部、西部、北部四个赛区，以线上/线下答辩形式角逐，胜出队晋级全国总决赛",
      "notes": "第十六届区域赛于2025年5月中下旬举行"
    },
    {
      "stage": "全国总决赛（无锡）",
      "format": "路演+答辩（线下），分本科生组等组别评审，决出一、二、三等奖",
      "notes": "历届总决赛8月在江苏无锡举行，第十七届由江南大学承办；大赛由教育部、商务部等指导，商务部服务贸易网发布赛事动态"
    }
  ],
  "review_format": "作品线上初审（专家网络评审）+区域赛答辩+全国总决赛现场路演问辩，校赛阶段普遍采用\"创新点30%/商业逻辑30%/市场前景20%/填写描述20%\"式评分表。",
  "judge_preferences": [
    "A类最看重对命题企业需求的理解深度与系统真实可运行，功能覆盖完整度优先",
    "B类重点看真实运营数据与创业团队成熟度，计划书华丽但无进展的项目不被认可",
    "技术创新必须落到业务场景价值，评委常为来自企业的实务专家",
    "答辩表达与临场应变明显影响名次，核心成员须能独立回答技术细节"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "作品须为团队原创，抄袭、购买代码或外包开发一经查实取消资格",
    "A类作品仅限选择一个赛题，多题重复投稿或一稿多队违规",
    "虚报成员分工、指导教师信息或冒用企业资质将取消成绩",
    "B类项目存在知识产权、股权纠纷不得参赛",
    "竞赛纪律：同一作品重复使用往届获奖成果二次参赛被取消资格"
  ],
