{
  "competition_id": 78,
  "competition_name": "数智化企业经营沙盘大赛",
  "judging_dimensions": [
    {
      "dimension": "实操得分——所有者权益（沙盘模拟对抗主成绩）",
      "weight": "客观题类赛事：实操得分由系统按规则自动生成，Z=所有者权益+数智化建设得分，按总分排名（所有者权益为其中主体项）",
      "official_wording": "2026年全国高等院校数智化企业经营沙盘大赛校赛通知（渤海大学创新创业管理学院）：\"竞赛评分采用系统按规则自动生成的方式进行。各小组实际得分计算方法为：（1）实操得分：Z=【所有者权益+数智化建设得分（即数智化相关模块得分）…\"。",
      "scoring_points": [
        "经营周期结束时所有者权益最大化（盈利、资产结构优化）",
        "战略规划与市场订单获取的匹配（广告投放、市场选择）",
        "生产与采购计划的精益性（产能、原料、交期不违约）",
        "财务稳健：贷款结构、现金流不断裂、按期还本付息"
      ],
      "common_deductions": [
        "经营亏损导致所有者权益缩水甚至破产",
        "订单违约金、生产线闲置等运营失误扣减权益",
        "现金流断裂被迫高息融资"
      ]
    },
    {
      "dimension": "实操得分——数智化建设得分",
      "weight": "客观题类赛事：数智化建设模块得分由系统按规则自动生成，计入实操总分Z",
      "official_wording": "同上渤海大学校赛通知：实操得分\"Z=【所有者权益+数智化建设得分（即数智化相关模块得分）】\"；大赛依托新道数智企业管理沙盘平台，\"还原真实的企业数智化转型改造应用场景\"（南京邮电大学2025年校赛通知）。",
      "scoring_points": [
        "数智化模块（数字化管理系统/智能设备改造等）的投入与产出平衡",
        "数智化转型进度与经营节奏匹配，避免盲目烧钱或滞后",
        "运用数智工具提升决策质量（市场预测、成本核算）"
      ],
      "common_deductions": [
        "忽视数智化建设得分项，单拼传统经营权益",
        "数智化投入过度拖垮当期权益",
        "不会操作数智化模块白白丢失得分"
      ]
    },
    {
      "dimension": "管理创新路演（全国总决赛第二赛段）",
      "weight": "定性评分：总决赛设\"沙盘模拟对抗+管理创新路演\"两赛段，路演段为评委定性打分（分值构成以当届规程为准）",
      "official_wording": "全国总决赛设\"沙盘模拟对抗\"和\"管理创新路演\"两个赛段，考查经营决策与数智化管理综合能力（中国民航飞行学院经济与管理学院竞赛汇总及总决赛报道综合）。",
      "scoring_points": [
        "经营复盘逻辑完整，能说清战略得失",
        "数智化管理创新点有真实经营数据支撑",
        "路演表达与PPT质量，限时完成",
        "答辩回应评委追问准确"
      ],
      "common_deductions": [
        "路演内容与沙盘经营结果脱节",
        "复盘只讲成功回避失误",
        "超时、念稿"
      ]
    },
    {
      "dimension": "经营合规与竞赛纪律",
      "weight": "分数制：违规按规则扣分直至取消成绩（一票否决式纪律条款）",
      "official_wording": "各校赛通知（南京邮电大学、上海理工大学等）均要求比赛依托统一平台进行、服从系统规则与监考纪律；具体罚则【推断】自沙盘竞赛通行规程。",
      "scoring_points": [
        "每经营年度按规则完成决策提交",
        "不进行队外串谋与信息交换",
        "遵守现场纪律与平台操作规范"
      ],
      "common_deductions": [
        "逾期未交决策按系统默认处理",
        "串谋、代操作被取消成绩",
        "扰乱赛场秩序"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "沙盘模拟对抗决策（线上平台内完成）",
      "format": "新道数智企业经营沙盘平台在线决策（战略、市场、生产、采购、财务、人力及数智化建设模块），无纸质提交物",
      "page_limit": "按系统界面规则",
      "deadline_note": "完整模拟企业四年经营周期，按赛程规定时间内完成各年度经营"
    },
    {
      "item": "管理创新路演材料（总决赛）",
      "format": "路演PPT（经营复盘与数智化管理创新）",
      "page_limit": "未明确",
      "deadline_note": "晋级全国总决赛后按要求提交并现场路演"
    }
  ],
  "process_stages": [
    {
      "stage": "校赛（校内选拔）",
      "format": "依托新道沙盘平台校内对抗，系统按规则自动生成得分（Z=所有者权益+数智化建设得分），按分数排名",
      "notes": "多在4-9月间进行；每队4人，分设财务总监（默认队长）、生产总监、营销总监、人力总监4个岗位，接手一个创业模拟企业完成四年经营周期模拟"
    },
    {
      "stage": "省赛（省级总决赛）",
      "format": "分省组织的沙盘对抗（部分省份由省教育厅或承办高校组织），系统自动评分排名",
      "notes": "按省赛成绩择优晋级全国总决赛；本科组与高职组分组进行"
    },
    {
      "stage": "全国总决赛",
      "format": "现场沙盘模拟对抗+管理创新路演两个赛段",
      "notes": "约10-11月（2025年本科组全国总决赛于10月19日在南京航空航天大学举行）；按两赛段综合评定全国一、二、三等奖；大赛由中国商业联合会等主办、新道科技提供技术支持，连续进入《全国普通高校大学生竞赛分析报告》竞赛目录"
    }
  ],
  "review_format": "沙盘对抗段为系统按规则自动评分（实操得分Z=所有者权益+数智化建设得分，按总分排名）；总决赛另设管理创新路演段由评委定性打分，两赛段综合定奖次。",
  "judge_preferences": [
    "结果导向：权益与数智化建设合计得分是硬排名依据",
    "数智化转型与传统经营的平衡能力是本赛事特色考点",
    "团队四岗位协同与财务总监（队长）统筹能力受关注",
    "总决赛路演看重复盘真实性与经营数据支撑",
    "全程无违规操作、按时完成各年度经营是底线"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "每队一般固定4名学生，岗位分工按规程设置，不得跨校组队或一人多队",
    "未按期提交年度决策按系统默认方案处理，损失自负",
    "严禁队间串谋、代操作、使用外挂，取消成绩",
    "总决赛路演不得伪造经营数据",
    "不同组别（本科/高职）不得混报"
  ],
