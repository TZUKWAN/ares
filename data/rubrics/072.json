{
  "competition_id": 72,
  "competition_name": "统计建模大赛",
  "judging_dimensions": [
    {
      "dimension": "选题的有效性（选题价值与年度主题契合度）",
      "weight": "约20%（官方五标准之一；百分制内部权重为评分惯例推断）",
      "official_wording": "大赛官方评审标准（华东师范大学研究生院转发通知）：\"统计建模类论文以选题的有效性、假设的合理性、建模的创造性、结果的正确性和表述的清晰性为主要标准\"；每届通知要求围绕年度主题（2023年\"中国式现代化的统计测度\"、2024年\"大数据与人工智能时代的统计研究\"、2025年\"统计创新应用 数据引领未来\"）结合实际自主选题。内部权重【推断】。",
      "scoring_points": [
        "紧扣当届官方主题词，问题有现实与政策含义",
        "研究问题界定清晰具体，可用统计数据回答",
        "选题有统计学科属性（测度、推断、预测），避免纯计算机工程题",
        "切口适中，数据可得性与团队工作量匹配"
      ],
      "common_deductions": [
        "偏离年度主题或主题只贴标签、内容两张皮",
        "选题过大过空，问题无法界定",
        "同质化热点堆砌（直接套用现成公开分析框架）"
      ]
    },
    {
      "dimension": "假设的合理性（指标构建与数据质量）",
      "weight": "约20%（官方五标准之一；内部权重【推断】）",
      "official_wording": "官方评审主要标准之一\"假设的合理性\"（同上）；参赛须知要求正文包括\"问题描述、指标选择、数据描述\"等部分，并须提交原始数据包（含数据来源、收集过程、分析程序）备查（2023年第九届通知，stats.gov.cn）。",
      "scoring_points": [
        "模型假设与统计性质（分布、独立性、平稳性等）有依据",
        "指标体系构建有文献与理论支撑，口径一致",
        "数据来源权威可核验（官方统计、权威数据库、规范爬取）",
        "缺失值、异常值处理方法透明"
      ],
      "common_deductions": [
        "数据来源不明或与附录不一致",
        "为结论需要随意取舍样本/指标",
        "关键假设违背常识且未做稳健性讨论"
      ]
    },
    {
      "dimension": "建模的创造性（方法运用与创新）",
      "weight": "约25%（官方五标准之一；内部权重【推断】）",
      "official_wording": "官方评审主要标准之一\"建模的创造性\"（同上）；国赛设通讯评审与现场会议评审两轮，评委侧重方法创新（历届获奖论文综述支撑）。",
      "scoring_points": [
        "方法与研究问题匹配，而非高级模型堆砌",
        "有方法论改进或组合创新（如传统统计+机器学习融合）",
        "模型可解释性讨论充分，统计思想突出",
        "对不同模型/设定做敏感性或稳健性比较"
      ],
      "common_deductions": [
        "为建模而建模，模型与结论脱节",
        "直接套用黑箱模型、无可解释性分析",
        "复现已发表模型无任何增量"
      ]
    },
    {
      "dimension": "结果的正确性（求解、检验与结论）",
      "weight": "约20%（官方五标准之一；内部权重【推断】）",
      "official_wording": "官方评审主要标准之一\"结果的正确性\"（同上）；参赛须知要求包含\"求解和检验、模型结果分析解释、结论\"部分（第十一届参赛须知，北京理工大学研究生院转载）。",
      "scoring_points": [
        "参数估计、检验过程规范，统计显著性解释正确",
        "结论由数据严格支撑，因果表述谨慎",
        "有模型检验（拟合优度、交叉验证、稳健性检验等）",
        "结果有管理或政策建议，回到研究问题"
      ],
      "common_deductions": [
        "显著性误读、相关当因果",
        "结论超出数据支持范围",
        "结果无法用提交的数据程序复现"
      ]
    },
    {
      "dimension": "表述的清晰性与论文规范（含查重与匿名合规）",
      "weight": "约15%（官方五标准之一；查重与匿名条款为官方硬性规定）",
      "official_wording": "官方评审主要标准之一\"表述的清晰性\"（同上）；2023年第九届通知（stats.gov.cn）：论文须提交Word完整版（封面、摘要关键词、目录、图表清单、正文、参考文献、附录、致谢八部分）与PDF匿名版；\"重复率超20%取消资格，超40%视为学术不端并通报院校\"；组委会另发生成式AI使用规范：严禁用AI直接生成研究选题、研究假设、研究框架及论文正文。",
      "scoring_points": [
        "结构完整、图表编号与参考文献规范",
        "摘要准确概括方法与结论",
        "匿名合规（PDF匿名版无任何单位/姓名信息）",
        "语言精炼、逻辑连贯"
      ],
      "common_deductions": [
        "查重率超20%直接取消资格，超40%按学术不端通报",
        "匿名版泄露学校/姓名信息取消资格",
        "格式不符、缺图表清单或数据包"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "参赛论文Word完整版",
      "format": "Word，八部分：封面页、摘要与关键词、章节目录、表格与插图清单、论文正文、参考文献、附录、致谢",
      "page_limit": "未明确（以当届通知为准）",
      "deadline_note": "论文提交截止约5月下旬（第九届为5月26日20:00前）"
    },
    {
      "item": "参赛论文PDF匿名版",
      "format": "PDF，去掉封面页与致谢，其余六部分与完整版一致；队号等信息不得出现在正文其他位置",
      "page_limit": "同上",
      "deadline_note": "与Word版同步提交，匿名违规取消资格"
    },
    {
      "item": "知网查重报告",
      "format": "知网查重（本科组选\"毕业设计\"、研究生组选\"职称评审\"体系）",
      "page_limit": "重复率≤20%",
      "deadline_note": "随论文提交；超20%取消资格、超40%学术不端通报院校"
    },
    {
      "item": "原始数据包与承诺书",
      "format": "数据包含数据来源、收集过程、分析程序；承诺书为队员共同创作承诺",
      "page_limit": "未明确",
      "deadline_note": "与论文同步提交，供复核复现"
    }
  ],
  "process_stages": [
    {
      "stage": "报名与培训（校赛选拔）",
      "format": "官网报名（免费，tjjmds.ai-learning.net），分本科生组与研究生组单独组队、不可混合；部分高校设校内选拔",
      "notes": "报名截止约3月底（第九届为3月31日20:00）；每名参赛者限报一支队，每队指导教师不超过2人；3月有线上主题解读培训"
    },
    {
      "stage": "省赛（省级评审）",
      "format": "专家论文评审",
      "notes": "6月进行；入围全国赛的论文同时获省赛一等奖（不占省赛名额），省赛其余论文按10%、20%、30%评一二三等奖"
    },
    {
      "stage": "全国赛（国赛评审）",
      "format": "通讯评审（网评）→现场会议评审→现场答辩",
      "notes": "7月评审、8月现场答辩（第九届在承办高校）；入围国赛论文按10%、20%、70%评一二三等奖，一等奖须参加现场答辩；一、二等奖队伍指导教师获优秀指导教师奖；论文择优汇编公开出版"
    }
  ],
  "review_format": "论文匿名双版本送审：省赛专家评审，国赛通讯评审+现场会议评审，一等奖经现场答辩（自述+专家提问）最终确定。",
  "judge_preferences": [
    "紧扣年度主题且问题具体、有统计测度或推断价值",
    "统计思想与方法创新并重，反对黑箱堆砌",
    "数据真实可复现（提交原始数据与分析程序备查）",
    "答辩考核论文原创性、合理性和正确性，关注方法细节",
    "规范严谨：查重、匿名、AI使用红线是硬约束"
  ],
  "past_winning_patterns": [
    "选题高度贴合年度主题词并做统计测度类切口：如围绕\"中国式现代化的统计测度\"的《中国式现代化绿色发展水平测度及分析》类作品获省赛/国赛奖项",
    "热点领域集中于双碳与碳排放、数字经济与新质生产力测度、共同富裕与居民幸福感、环境与空气质量预测等（2023-2024年一等奖论文高频方向）",
    "方法上呈\"经典统计建模+机器学习\"融合路线：如图注意力网络做谣言检测、生成式AI辅助的碳排放研究等（2024年获奖论文方向举例）",
    "数据多用国家统计年鉴、权威数据库面板/时序数据，强调指标体系构建（熵权法、DEA、空间计量等测度类工具组合）",
    "获奖规模参考：2024年第十届国赛一等奖60队、二等奖119队、三等奖408队（约10%/20%/70%），一等奖全部经现场答辩产生",
    "写作规范完整：摘要结构化、稳健性检验充分，论文被择优收入获奖论文集公开出版"
  ],
  "forbidden_or_risky": [
    "论文重复率超20%取消资格与成绩，超40%视为学术不端并在官网通报院校",
    "匿名版泄露姓名、学校等信息直接取消资格",
    "严禁用生成式AI直接生成研究选题、研究假设、研究框架及论文正文，违者按违规处理",
    "数据造假、伪造结果将取消成绩；原始数据包须与论文结果一致",
    "本科生组与研究生组不得混合组队，每名参赛者限报一支队"
  ],
