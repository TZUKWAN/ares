{
  "competition_id": 56,
  "competition_name": "中国好创意数字艺术设计大赛",
  "judging_dimensions": [
    {
      "dimension": "原创创意",
      "weight": "40%（官方评审标准-视传应用类/数智影像类原文）",
      "official_wording": "大赛官网《评审标准-视传应用类》原文：'（一）原创创意——40%，评审重点考察作品的创意原创性与思维独特性：创意新颖性……视角独特性……概念转化力……思维深度'。数智影像类标准同为'原创创意（40%）：评估作品的独创性与突破性'。",
      "scoring_points": [
        "创意新颖性：设计概念有独特见解与创新思维，'眼前一亮'",
        "视角独特性：从独特角度切入主题",
        "概念转化力：将抽象价值理念转化为具象视觉语言（'从抽象概念到生活场景'）",
        "思维深度：具备思想深度与认知高度，体现文明基因解码与社会共识重塑",
        "数智影像类：在概念构思、叙事方式、视觉语言或交互体验上有探索性突破"
      ],
      "common_deductions": [
        "创意与已有作品或往届获奖作品雷同、套模板",
        "仅技法展示无原创概念",
        "AI生成内容未按赛道规定标注/超出允许范围"
      ]
    },
    {
      "dimension": "价值理念",
      "weight": "30%（官方评审标准-视传应用类/数智影像类原文）",
      "official_wording": "《评审标准-视传应用类》原文：'（二）价值理念——30%，评审重点考察作品所传递的文化价值与精神内涵：价值观可视化……文化传承……叙事能力……社会共鸣'。第20届大赛主题为'提升思维认知，促进内心向善'（哈工大转发通知）。",
      "scoring_points": [
        "价值观可视化：将社会主义核心价值观、时代精神有效表达，'更具时代性、温度感、传播力'",
        "文化传承：鲜明的文化符号与元素，体现文化自信（中国风传统文化类、文化遗产类等赛道）",
        "叙事能力：用视觉语言'讲故事、塑场景'而非'说理念'",
        "社会共鸣：传递的理念有社会共识基础，引发情感共鸣与思想认同"
      ],
      "common_deductions": [
        "立意浅薄、价值观偏差或内容低俗",
        "文化元素符号堆砌、无当代转译",
        "作品与年度大赛主题气质脱节"
      ]
    },
    {
      "dimension": "设计制作",
      "weight": "5%（官方评审标准-视传应用类/数智影像类原文）",
      "official_wording": "《评审标准-视传应用类》原文：'（三）设计制作——5%，评审重点考察作品的设计完成度与制作质量：设计逻辑……制作精度……规范符合度：是否严格按照赛事提交要求完成作品……完整性'。",
      "scoring_points": [
        "作品包含完整设计逻辑与清晰视觉呈现",
        "图形绘制、文字排版、色彩运用等技术精度",
        "严格按赛事提交要求完成（格式、分辨率、命名）",
        "作品完整饱满、无明显缺陷"
      ],
      "common_deductions": [
        "格式/规格不符提交要求（技术性筛除）",
        "制作粗糙、有明显技术硬伤",
        "文件残缺、无法正常播放或打开"
      ]
    },
    {
      "dimension": "视觉美学",
      "weight": "10%（官方评审标准-视传应用类原文）",
      "official_wording": "《评审标准-视传应用类》原文：'（四）视觉美学——10%，评审重点考察作品的审美品质与视觉表现力：视觉美感……风格独特性……形式与内容统一……视觉冲击力'。",
      "scoring_points": [
        "构图均衡、稳定、有规律的整体审美价值",
        "艺术风格独特鲜明，具备实验性与探索性",
        "视觉形式与内容主题有机统一",
        "视觉吸引力和感染力（冲击力）"
      ],
      "common_deductions": [
        "审美陈旧、套用流行模板风格",
        "形式与内容割裂、堆砌特效",
        "画面失衡、信息过载"
      ]
    },
    {
      "dimension": "可转化率（产业转化潜力）",
      "weight": "15%（官方评审标准-视传应用类原文）",
      "official_wording": "《评审标准-视传应用类》原文：'（五）可转化率——15%，评审重点考察作品的应用价值与产业转化潜力：应用场景明确……产业转化可行性……IP开发潜力……媒介适应性'。",
      "scoring_points": [
        "有明确应用场景与目标受众",
        "设计具备行业应用与产业转化可行性",
        "具备IP化开发与品牌延伸潜力（大赛与迪士尼、百度、TCL、创维等企业冠名赛道呼应）",
        "在数字媒介与实体空间中的适用性与延展性"
      ],
      "common_deductions": [
        "纯观念表达、无应用场景",
        "与冠名企业/命题赛道的产业需求无关",
        "媒介适配性差、无法落地展示"
      ]
    },
    {
      "dimension": "动画短片类差异化维度（四大维度计分制）",
      "weight": "故事创意与叙事表达35分+视听艺术与画面质感30分+思想立意与价值传递20分+作品完整度与衍生潜力15分，四维合计占总分100%（官方评审标准-动画短片类原文）",
      "official_wording": "《评审标准-动画短片类》原文：'本赛道以动画影像创作为核心，重点评判作品的故事表达、视听质感、创新表现力与大众传播价值，采用四大差异化评审维度，无固定模板化细分'：'1、故事创意与叙事表达（35分）……2、视听艺术与画面质感（30分）……3、思想立意与价值传递（20分）……4、作品完整度与衍生潜力（15分）'。",
      "scoring_points": [
        "剧本原创度、题材新颖度与叙事完整性，杜绝抄袭、洗稿、拼接剧情",
        "美术风格、色彩构图、镜头运用、动作设计、音效配乐五大视听板块质量",
        "紧扣时代正能量、传统文化传承、社会人文关怀等正向主题",
        "剪辑规范、字幕清晰、特效自然；新媒体传播适配度与IP孵化潜力"
      ],
      "common_deductions": [
        "剧情逻辑混乱、空洞、立意浅薄",
        "画面风格不统一、音画不同步",
        "制作漏洞明显、字幕粗糙"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "参赛作品（常规赛道24类）",
      "format": "经大赛官网 www.cdec.org.cn 统一免费报名并上传作品；类别含视传应用、动画影片、漫画插画、数智影像、数字摄影、思辨艺术、艺术疗愈、高阶文明、认知境界、人居环境与可持续生态空间设计、数字化素养、大爱中国、社会创新、数字生态图谱、创艺科普、AI情感陪伴装置、符号化IP产品、海洋文化、中国风传统文化、交通艺术、时尚生活、数字应用新场景、文化遗产、一带一路类",
      "page_limit": "以二级学院为投稿单位（需1名教师任管理员审核）；每个二级学院本科生、研究生作品经审核提交到省赛区的各类别均不超过20项；教师投稿数量不限并直通国赛",
      "deadline_note": "第20届：2025年10月20日—2026年6月30日17:00报名投稿；2026年7月1日评奖；获奖名单8月25日之前公布（官网时间线8月15日）"
    },
    {
      "item": "专项赛道作品",
      "format": "企业/政府冠名专项赛道（如AIGC专项、数字艺术医学绘图、文旅主题等），按各赛道简章要求提交，不同赛道有不同截止时间",
      "page_limit": "以各赛道简章为准",
      "deadline_note": "关注各赛道简章截止时间"
    },
    {
      "item": "版权存证",
      "format": "大赛免费为参赛作品提供版权保护与存证（官方特色服务）",
      "page_limit": "未明确",
      "deadline_note": "投稿时按官网流程办理"
    }
  ],
  "process_stages": [
    {
      "stage": "院校投稿与院级审核",
      "format": "以二级学院为单位，教师管理员审核管理本院投稿，限额报送（本研各类别≤20项）",
      "notes": "学生单元（团队/个人）面向在校学生；教师单元单独设置并直通国赛"
    },
    {
      "stage": "省赛区评审",
      "format": "按省赛区组织专家评审，评选省级奖项与晋级国赛作品",
      "notes": "第19届常规赛道投稿量358601件、专项赛与计时赛66470件，合计425071件、覆盖3950所院校"
    },
    {
      "stage": "全国评审（国赛）",
      "format": "按官方'评审标准-类别'分赛道评审（如视传应用类五维40/30/5/10/15、动画短片类四维35/30/20/15计分）",
      "notes": "评审标准按类别在官网'资料下载/获奖查询'专栏公布"
    },
    {
      "stage": "获奖公布与颁奖",
      "format": "官网公布获奖名单、证书下载；国赛颁奖暨数媒年会",
      "notes": "2026年获奖名单8月25日之前公布"
    }
  ],
  "review_format": "院校限额报送后分省赛区评审、全国分赛道专家评审；按官网公布的分类别量化评审标准（原创创意40%+价值理念30%+设计制作5%+视觉美学10%+可转化率15%等）打分",
  "judge_preferences": [
    "把'原创创意'置于最高权重（40%），偏好独特视角与思想深度的原创概念",
    "高度重视价值理念与文化内涵（30%），契合'提升思维认知，促进内心向善'的哲学化办赛理念",
    "看重作品的产业转化与IP开发潜力（15%），与众多企业冠名赛道呼应",
    "制作权重占比低（5%）但为合规硬门槛，严格按提交规格执行",
    "限制投稿数量、强调质量优先；教师作品与学生作品分开评审"
  ],
