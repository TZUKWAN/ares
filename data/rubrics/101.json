{
  "competition_id": 101,
  "competition_name": "制冷空调行业大学生科技竞赛",
  "judging_dimensions": [
    {
      "dimension": "基础知识竞答（理论知识）",
      "weight": "占决赛总成绩的30%（30分）；三环节合计100分（实践35+创新设计35+知识竞答30）",
      "official_wording": "第十七届竞赛通稿（微信公众号）：创新设计作品成绩占决赛总成绩的35%，35分；马鞍山学院第十八届校赛通知：团队实践技能操作成绩占决赛总成绩的35%，35分；北方工业大学《全国制冷空调行业大学生科技竞赛指导手册》：实践技能操作（成绩占决赛总成绩35%）及创新设计作品答辩环节；太原理工大学第十一届报道：比赛分为实践技能操作、创新作品答辩、基础知识竞答三个环节【推断依据：三环节权重之和100%，知识竞答为余下30%】",
      "scoring_points": [
        "工程热力学、传热学、流体力学基础（制冷原理、热力循环计算）",
        "制冷空调设备与系统知识（压缩机、换热器、节流装置、冷媒特性）",
        "节能环保知识：替代制冷剂、双碳政策与行业标准（GB/T、CRAA标准）",
        "现场竞答的反应速度与正确率（团队计分）"
      ],
      "common_deductions": [
        "基础概念错误、循环计算失误",
        "竞答抢答违规被扣分",
        "对新冷媒、新标准知识更新滞后"
      ]
    },
    {
      "dimension": "团队实践技能操作",
      "weight": "占决赛总成绩的35%（35分）",
      "official_wording": "马鞍山学院第十八届校赛通知原文：『团队实践技能操作（成绩占决赛总成绩的35%，35分）』；北方工业大学竞赛指导手册：实践技能操作成绩占决赛总成绩35%；第十七届决赛通稿：实践操作环节含测试试题、评分标准、评委人员、设备场地等安排",
      "scoring_points": [
        "实际设备操作规范：制冷机组/热泵装置的运行调节、故障诊断与排除",
        "仪器测量与数据处理：温度、压力、流量测量及性能计算（COP等）",
        "操作安全规范（制冷剂安全、用电安全、压力容器操作）",
        "团队分工协作与完成时间"
      ],
      "common_deductions": [
        "违反安全操作规程（重大者取消该项成绩）",
        "仪表读数/记录不规范、数据失真",
        "超时完成或未能排除故障",
        "操作步骤颠倒损坏设备"
      ]
    },
    {
      "dimension": "创新设计作品及答辩",
      "weight": "占决赛总成绩的35%（35分）",
      "official_wording": "第十七届竞赛通稿原文：『创新设计作品成绩占决赛总成绩的35%，35分』，该届创新设计答辩线上进行；第二十届『汉钟精机杯』决赛通稿（上海交大制冷所公众号）：设研究生组和本科生组创新设计一等奖，竞赛分创新设计、实践应用等环节",
      "scoring_points": [
        "选题价值：面向制冷空调行业真实问题的节能、环保、智能化方案",
        "方案科学性：热力循环/传热设计正确，参数计算与仿真支撑",
        "创新性与实用前景：新技术融合（热泵、储能、AI调控等）与落地可行性",
        "作品文档规范性与PPT答辩表达、回答评委质询"
      ],
      "common_deductions": [
        "选题陈旧、与现有产品雷同",
        "方案存在原理性错误或计算硬伤",
        "答辩与文档不符、工作量明显不足",
        "创意未紧扣制冷空调行业主题"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "创新设计作品材料",
      "format": "创新设计作品报告/PPT+答辩（部分届次答辩线上进行，如第十七届）",
      "page_limit": "未明确（按当届通知模板）",
      "deadline_note": "赛前按通知截止提交，随决赛答辩"
    },
    {
      "item": "校内选拔",
      "format": "各校先办校赛（笔试/个人赛为主，如东南大学第一届校赛以笔试等环节选拔），按名额推荐参加全国赛",
      "page_limit": "不适用",
      "deadline_note": "校赛多在3-4月（马鞍山学院2024年3月13日通知、兰州交通大学2024年3月26日通知、上海海事大学第十九届2025年5月7日通知）"
    },
    {
      "item": "全国决赛",
      "format": "三环节现场比拼：基础知识竞答、团队实践技能操作（指定设备场地与测试试题）、创新设计作品答辩",
      "page_limit": "不适用",
      "deadline_note": "全国决赛多在6-7月（第十三届2019年6月、第二十届2026年7月通稿）"
    }
  ],
  "process_stages": [
    {
      "stage": "校内选拔赛",
      "format": "面向全日制本科生（及部分届次研究生）的笔试/实操选拔，按细则评分排序产生推荐名额",
      "notes": "由各高校能源动力类/建环类学院组织；官方为公益属性群众性科技活动，不收取高额参赛费用"
    },
    {
      "stage": "全国决赛—基础知识竞答",
      "format": "现场竞答（占30分），覆盖制冷空调基础理论与行业知识",
      "notes": "三环节之一的团队计分项"
    },
    {
      "stage": "全国决赛—实践技能操作+创新设计答辩",
      "format": "实践操作在指定设备场地进行（占35分）；创新设计作品PPT答辩（占35分），按总分排名评奖",
      "notes": "设本科生组、研究生组创新设计一、二、三等奖（第二十届『汉钟精机杯』）；历届由企业冠名协办（天加、汉钟精机、海悟等），决赛规模约十余至二十所高校（第十三届19所高校）"
    }
  ],
  "review_format": "专家评委按环节细则现场打分：基础知识竞答30分+团队实践技能操作35分+创新设计作品答辩35分，合计100分排名，分本科生组/研究生组评奖。",
  "judge_preferences": [
    "创新设计紧扣行业痛点：节能、环保冷媒替代、热泵与智能化应用最受青睐",
    "实践操作安全规范第一，其次是故障诊断的准确性与速度",
    "方案要有热力学计算与数据支撑，忌概念空谈",
    "团队协作与现场表达：答辩能讲清原理、答准质询",
    "关注双碳与最新标准动态的选手更受认可"
  ],
