{
  "competition_id": 52,
  "competition_name": "米兰设计周高校展",
  "judging_dimensions": [
    {
      "dimension": "创意维度（创新性/原创性）",
      "weight": "约30%（业界通行的三三制参考：创意30%+技术30%+审美30%，另约10%为完成度与规范）",
      "official_wording": "官网《大赛章程》未公布维度权重，仅规定'专家评审；国际展示'及'作品上不得出现院校、系部、姓名及其他特殊标记'。第九届公开说明及多个备赛指南提到评审从创意、技术、审美三方面评分（各约30%）。【推断：权重为业界/平台转述，未见官方红头文件原文，建议以当届赛场参赛须知为准】",
      "scoring_points": [
        "选题立意的原创性：本土文化转译（如非遗、阳明文化等命题赛道主题）有独到视角",
        "概念生成逻辑清晰，设计说明能讲清'为什么这样做'",
        "命题赛道：对命题主题的理解深度与回应准确度",
        "避免同质化模板（获奖比例仅省赛35%/国赛10%，创意区分度是关键）"
      ],
      "common_deductions": [
        "作品上出现院校、姓名等特殊标记（章程明确禁止，直接违规）",
        "创意雷同市面已有设计或往届获奖作品",
        "使用现有素材未在报名表标明出处"
      ]
    },
    {
      "dimension": "技术维度（专业技法与工艺实现）",
      "weight": "约30%（同上三三制参考）",
      "official_wording": "章程未列明；第九届公开说明中'技术'维度涵盖设计表现技法、材料工艺、软件实现等专业能力。【推断依据：设计学科展赛通行评审框架+第九届公开说明转述】",
      "scoring_points": [
        "表现技法与专业功底：制图、渲染、版式、色彩控制的规范与精度",
        "材料/工艺/技术路线在产品、环境类作品中的可行性",
        "数字媒体/视频类的技术完成度（动效、剪辑、交互实现）",
        "系列作品（不超过6件）的内在技术一致性"
      ],
      "common_deductions": [
        "渲染/制图有明显技术硬伤、比例失真",
        "视频类画面粗糙、分辨率不达标",
        "技术堆砌但与设计概念脱节"
      ]
    },
    {
      "dimension": "审美维度（艺术表现力）",
      "weight": "约30%（同上三三制参考）",
      "official_wording": "章程未列明；第九届公开说明转述'审美'维度考察作品的艺术性、视觉感染力与文化品位。【推断依据：设计展赛通行框架】",
      "scoring_points": [
        "整体视觉格调与文化气质，符合米兰设计周的国际展示定位",
        "展板版式编排（单幅A3竖式）的信息层级与美感",
        "色彩、字体、图形语言的自洽与品质感",
        "文化元素的当代转译而非符号堆砌"
      ],
      "common_deductions": [
        "版式杂乱、信息过载或大段文字说明挤占画面",
        "审美取向陈旧、套用模板化国风",
        "色调质感与命题主题气质不符"
      ]
    },
    {
      "dimension": "完整度与规范维度",
      "weight": "约10%（差额补足项；合规性为一票否决性质的硬门槛）",
      "official_wording": "章程第十三条：'作品上不得出现院校、系部、姓名及其他特殊标记'；'若创作过程中使用到现有素材，请在报名表处标明出处'。各赛场通知要求按A3幅面、300dpi、JPG（RGB或CMYK）提交。【推断：完成度占比为按三三制权重补足推断】",
      "scoring_points": [
        "按官方规格提交：单幅A3竖式、300dpi、JPG、RGB/CMYK",
        "设计说明完整，方案从调研到落地的闭环呈现",
        "报名信息准确（获奖信息以系统上传信息为准）",
        "匿名要求达标，无任何身份信息泄露"
      ],
      "common_deductions": [
        "格式不合规（尺寸/分辨率/格式错误）被技术性筛除",
        "设计说明缺失或与画面矛盾",
        "报名信息与作品信息不一致"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "作品展示版面（展板）",
      "format": "单幅A3幅面、竖式构图、300dpi、JPG格式（RGB或CMYK），平面图/效果图/设计说明编排于版面内",
      "page_limit": "1张展板；系列作品不超过6件",
      "deadline_note": "第十届线上投稿2025年10月启动、2026年3-4月截稿（非命题赛场约3月31日，部分赛道至4月30日）"
    },
    {
      "item": "视频/动态类作品及海报",
      "format": "视频文件+按要求截取不少于5个作品画面排版成A3竖式JPG海报",
      "page_limit": "作者不超过5人",
      "deadline_note": "同各赛场截稿时间"
    },
    {
      "item": "报名信息与素材出处",
      "format": "官网在线注册投稿，按院校（学院）管理；使用现有素材须在报名表标明出处",
      "page_limit": "作品创作类作者不超过3人、指导教师不超过2人",
      "deadline_note": "每年9月注册、10月起投稿"
    },
    {
      "item": "论文（另设类别）",
      "format": "按大赛各赛场具体参赛信息提交",
      "page_limit": "未明确",
      "deadline_note": "以当届通知为准"
    }
  ],
  "process_stages": [
    {
      "stage": "校赛（院校管理）",
      "format": "院校组织推荐/初审，官网按院校账号管理投稿",
      "notes": "作品按院校（学院）管理，获奖信息以系统上传信息为准"
    },
    {
      "stage": "省赛（赛区评审）",
      "format": "组委会遴选评审专家跨区域交叉评审（盲评性质）",
      "notes": "等级奖不超过各省赛区作品总数35%，一二三等奖原则上为6%/12%/17%；一二等奖及部分三等奖（经网络投票选拔）晋级国赛"
    },
    {
      "stage": "国赛（全国评审）",
      "format": "组委会遴选全国知名专家评审作品创作类",
      "notes": "等级奖不超过入围国赛作品总数10%（一二三等奖2%/3%/5%），不设优秀奖；官网公示，实行实名举报与最终裁决机制"
    },
    {
      "stage": "米兰展出与国际交流",
      "format": "获奖优秀作品赴米兰设计周期间展出，配套巡展、研讨会、工作坊",
      "notes": "累计在米兰展出优秀作品1550余件；评审结果约7月揭晓"
    }
  ],
  "review_format": "线上盲评式三级评审（校赛-省赛-国赛），省赛跨区域专家交叉评审+国赛全国知名专家评审，作品匿名、全程监控公示。",
  "judge_preferences": [
    "重视文化主题的当代转译：命题赛道（非遗、阳明文化等）中本土文化的创新解读是获奖主线",
    "作品完整度与整合性：从概念到表现的闭环质量优先于单点炫技",
    "国际视野下的审美品质：契合米兰设计周展示定位的格调与完成度",
    "规范匿名、干净利落的版面传达，评委单件浏览时间短，第一眼信息层级决定命运"
  ],
