{
  "competition_id": 112,
  "competition_name": "制药工程设计竞赛",
  "judging_dimensions": [
    {
      "dimension": "工艺流程设计",
      "weight": "约30%（推断：参照历届评分表及同类化工设计竞赛评分体系，工艺设计为评分主体）",
      "official_wording": "官网/组委会未公开量化评分细则。湘潭大学竞赛介绍页：题目'涵盖原料药生产车间、口服固体制剂车间、中药提取车间、生物制剂车间等工艺设计'，'有较大的灵活性供参赛者发挥其创造能力'。【推断】工艺流程设计（工艺路线选择、物料/能量衡算、PFD与PID）为评分主体，约30%。",
      "scoring_points": [
        "工艺路线选择合理，符合产品反应/生产特点",
        "物料衡算与能量衡算完整、数据自洽",
        "工艺流程图（PFD）与管道仪表流程图（PID）绘制规范",
        "关键工艺参数有依据，工艺可控可放大"
      ],
      "common_deductions": [
        "衡算前后数据矛盾、单位混乱",
        "流程图不符合制图规范（图例、标注缺失）",
        "工艺路线明显不合理或与任务书要求脱节"
      ]
    },
    {
      "dimension": "车间布置与设备选型（GMP合规）",
      "weight": "约25%（推断：制药工程设计区别于普通化工设计的核心在于GMP洁净车间设计，历届题目均围绕车间工艺设计）",
      "official_wording": "竞赛题目范围为原料药/制剂/中药提取/生物制剂等生产车间工艺设计（湘潭大学介绍页）。【推断】车间布置设计（人流物流分流、洁净分区、GMP合规）与设备选型计算约25%。",
      "scoring_points": [
        "车间布置满足GMP要求：洁净级别划分、人流物流分开、防止交叉污染",
        "设备选型有计算依据（产能匹配、材质合规）",
        "设备一览表完整、关键设备参数合理",
        "车间布置图深度达到初步设计要求"
      ],
      "common_deductions": [
        "洁净分区错误、人流物流交叉",
        "设备选型拍脑袋、无选型计算过程",
        "布置图与说明书文字描述不一致"
      ]
    },
    {
      "dimension": "设计说明书与图纸质量",
      "weight": "约20%（推断：初评阶段为匿名评审设计交付物，交付物文本与图纸质量直接决定初评成绩）",
      "official_wording": "重庆工商大学竞赛介绍页：'初赛提交设计交付物电子文档及书面材料各1份'，'作品初评：完全匿名评审'。图纸与说明书深度要求由当届《设计任务书》下达。【推断】文本与图纸规范质量约20%。",
      "scoring_points": [
        "说明书结构完整（设计依据、范围、工艺叙述、附表附图）",
        "编制符合工程设计文件规范、文字图表规范",
        "CAD图纸质量高（图框、比例、标注、图签齐全）",
        "参考文献与设计规范引用准确"
      ],
      "common_deductions": [
        "说明书拼凑感强、章节缺失",
        "图纸为截图拼贴、非正规制图",
        "匿名评审中泄露学校信息（违规风险）"
      ]
    },
    {
      "dimension": "安全环保与经济分析",
      "weight": "约10%（推断：工程设计类竞赛普遍将HSE与经济核算纳入评分）",
      "official_wording": "官方未公开细则。【推断】依据工程设计类竞赛（化工设计竞赛等）通用评审模型，安全环保措施、三废处理与投资/成本经济分析约占10%。",
      "scoring_points": [
        "安全设计：防爆、消防、职业健康措施到位",
        "三废治理方案与清洁生产考虑",
        "投资估算与成本核算方法正确",
        "符合国家产业政策与药品生产法规"
      ],
      "common_deductions": [
        "安全环保章节泛泛而谈、无具体措施",
        "经济分析数据无来源、估算粗糙"
      ]
    },
    {
      "dimension": "现场汇报与答辩",
      "weight": "约15%（推断：决赛采用现场汇报与答辩方式评奖，初赛成绩计入决赛总评）",
      "official_wording": "湘潭大学竞赛介绍页：'全国总决赛：现场汇报与答辩，评出一等奖、部分二等奖及单项奖'；重庆工商大学介绍页：'初赛成绩计入决赛总评成绩'。【推断】答辩表现约15%。",
      "scoring_points": [
        "汇报重点突出、逻辑清晰、时间控制得当",
        "答辩回答准确、队员分工应答合理",
        "壁报/展示材料专业（设最佳壁报奖）",
        "对评委指出的设计问题回应有据"
      ],
      "common_deductions": [
        "汇报超时或念稿",
        "答辩时队员互相推诿、答不出自己负责部分",
        "汇报内容与提交交付物不一致"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "竞赛设计交付物（设计说明书+设计图纸）",
      "format": "电子文档（压缩包按'学校-队名'命名发送竞赛邮箱）+书面材料（邮寄）各1份",
      "page_limit": "由当届《设计任务书》（第二轮通知）下达，未明确",
      "deadline_note": "作品提交截止约9-10月，逾期按自动放弃处理"
    },
    {
      "item": "决赛交付物",
      "format": "电子文档1份+书面材料若干份（按评审专家人数）",
      "page_limit": "未明确",
      "deadline_note": "入围决赛后按决赛通知提交"
    },
    {
      "item": "队员变更申请（如适用）",
      "format": "纸质申请并加盖学校/二级学院公章，随交付物提交",
      "page_limit": "未明确",
      "deadline_note": "随作品提交时一并提交，队员变更不超过2人"
    },
    {
      "item": "决赛汇报PPT与壁报",
      "format": "现场汇报+壁报展示",
      "page_limit": "未明确",
      "deadline_note": "全国总决赛（10-11月）现场"
    }
  ],
  "process_stages": [
    {
      "stage": "报名与校内选拔",
      "format": "每校报名队伍数量不限，校内赛/选拔后择优推选",
      "notes": "每队不超过6人、队长1名，研究生占比不超过1/2；指导教师不超过2人且至少1人为本校专任教师；作品提交阶段每校择优选送不超过2-3支（各届要求2或3支，以当届通知为准）"
    },
    {
      "stage": "初赛（作品初评）",
      "format": "设计交付物完全匿名评审",
      "notes": "评出全部三等奖及部分二等奖，并推选入围总决赛作品；初赛成绩计入决赛总评"
    },
    {
      "stage": "全国总决赛",
      "format": "现场汇报+答辩（+壁报展示）",
      "notes": "历届于10-11月举行（第十二届2024年11月在重庆理工大学举行）；评出一等奖、部分二等奖及单项奖（最佳现场答辩奖、最佳壁报奖、最佳组织奖）"
    }
  ],
  "review_format": "初赛由竞赛专家委员会对匿名设计交付物函评，决赛由专家委员及行业专家现场评审汇报答辩，初赛成绩计入决赛总评。",
  "judge_preferences": [
    "GMP合规性过硬：洁净分区、人流物流、防交叉污染等细节经得起行业专家追问",
    "图纸与说明书达到初步设计深度、制图规范（评委多来自国药工程、东富龙等工程/装备企业）",
    "衡算数据完整自洽，选型有计算依据",
    "答辩分工与设计贡献对应，能现场修正指出的问题",
    "设计体现行业前沿（连续制造、生物制品车间等）与创造能力（题目官方明示留较大发挥空间）"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "每队仅限提交1份设计交付物，须队员亲自完成，抄袭/委托设计机构代做属违规",
    "初评完全匿名，交付物中出现学校/队员姓名等身份信息将被取消资格或扣分",
    "报名后队员变更超过2人、教师变更超过1人，或变更未盖章申请，按弃权处理",
    "每位学生限报1队、每位教师最多指导1-2队（各届要求不同），重复报名违规",
    "作品提交逾期按自动放弃处理"
  ],
