{
  "competition_id": 102,
  "competition_name": "矿物加工工程实践作品大赛",
  "judging_dimensions": [
    {
      "dimension": "科学性（原理与技术方案正确性）",
      "weight": "专家评审定性打分核心维度：评审会与网评围绕作品科学性、创新性等打分，决赛网评+答辩综合排序（官方未公布量化权重）",
      "official_wording": "安徽理工大学校赛评审会通稿（第七届、第八届）：评委『就作品的科学性、创新性等方面进行评审/点评』；山东科技大学第九届获奖通稿：作品经校内评审、网上函评、现场答辩等环节评选奖项。官方未见公开分值权重表【推断依据：高校评审会通稿，科学性为首要维度】",
      "scoring_points": [
        "矿物分离/分选原理正确（浮选、重选、磁选、电选及化学提纯等机理阐述无误）",
        "试验设计与方法科学：变量控制、数据量与重复性充分",
        "结论有试验数据、检测表征（XRD、粒度分析、品位-回收率等）支撑",
        "论文类作品符合学术规范（引用、图表、单位）"
      ],
      "common_deductions": [
        "数据不足或自相矛盾、试验无重复",
        "原理性错误、概念混用",
        "图表不规范、数据处理透明度差",
        "引用缺失或格式混乱"
      ]
    },
    {
      "dimension": "创新性与实用价值",
      "weight": "专家评审定性比较核心维度：与创新性并列的重点评审方面（官方未公布量化权重）",
      "official_wording": "安徽理工大学校赛评审会通稿：评委就作品的『科学性、创新性等方面』评审并提出修改建议；南华大学第八届参赛通稿：大赛旨在提升学生科技创新兴趣【推断依据：评审通稿与办赛宗旨，创新性与实用性为通行并列维度】",
      "scoring_points": [
        "选题面向行业真实问题：难选煤/复杂矿高效分选、绿色选矿、智能选煤、二次资源利用",
        "工艺/药剂/设备/软件的创新点明确并与现有技术对比",
        "发明创造类作品的专利检索与新颖性论证",
        "成果的应用前景与经济环保效益（降碳、节水、尾矿综合利用）"
      ],
      "common_deductions": [
        "重复已有课程实验、缺乏新意",
        "创新点未经验证或与数据脱节",
        "应用价值论述空泛",
        "与往届获奖作品高度雷同"
      ]
    },
    {
      "dimension": "作品完成度与答辩表现",
      "weight": "决赛答辩环节（定性评议）：决赛按科技论文、物理模型、电子作品（软件）、发明创造四类分组评审，经网评初审的作品进入现场（或线上）答辩（官方未公布量化权重）",
      "official_wording": "贵州大学第四届决赛通稿：『评审专家分组对科技论文类、物理模型类、电子作品（软件）及发明创造类』进行评审；中国矿业大学校赛通知：作品经竞赛组委会初审合格后进入决赛进行现场答辩；第七届决赛2022年8月16日线上答辩【推断依据：分组评审+答辩为决赛固定形式，完成度与答辩计入综合评定】",
      "scoring_points": [
        "物理模型类：结构合理性、制作工艺与展示效果",
        "电子作品（软件）类：功能完整、可现场演示",
        "发明创造类：样机/实物完成度与演示",
        "答辩陈述条理、限时内讲清创新点，回答评委质询的能力",
        "团队分工与多学科协作体现"
      ],
      "common_deductions": [
        "演示失败或作品与申报材料不符",
        "答辩超时、核心问题答不出",
        "模型/软件粗制滥造仅应付展示",
        "主要工作由他人代做被质询暴露"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "参赛作品（四类专题）",
      "format": "科技论文类（研究论文）、物理模型类、电子作品（软件）类、发明创造类，按当届通知选择专题报送",
      "page_limit": "未明确（论文类按通知版式要求）",
      "deadline_note": "校内选拔多在5-6月，全国决赛多在7-8月（第九届2024年7月10-12日福州、第十一届2026年7月19日西安）"
    },
    {
      "item": "申报与推荐材料",
      "format": "经校内大赛选拔、组委会初审合格后报送（各校限额报送，如西安科技大学第十一届征集11件、报送9件）",
      "page_limit": "各校限额",
      "deadline_note": "随当届通知截止（校赛报名约4-5月，报送约6月）"
    },
    {
      "item": "决赛答辩材料",
      "format": "PPT答辩（历届为现场答辩或线上答辩，如第七届2022年8月16日线上答辩）",
      "page_limit": "未明确",
      "deadline_note": "全国决赛期间进行"
    }
  ],
  "process_stages": [
    {
      "stage": "校级选拔",
      "format": "各矿物加工工程专业相关高校举办校内大赛，专家评审会就科学性、创新性等评审并推荐优秀作品",
      "notes": "如中国矿业大学将校赛认定为『一级乙等课外竞赛』；安徽理工大学、中国矿业大学等每年举办校赛"
    },
    {
      "stage": "全国赛初审与网评",
      "format": "竞赛组委会初审合格后进入全国评审，经专家网评/函评初选入围作品",
      "notes": "山东科技大学通稿：校内初评—专家网评—现场答辩三段式；沈阳理工大学通稿：网评和会评初审、决赛答辩"
    },
    {
      "stage": "全国决赛（分组评审+答辩）",
      "format": "评审专家按科技论文、物理模型、电子作品（软件）、发明创造四类分组评审并现场（或线上）答辩，评出一、二、三等奖",
      "notes": "大赛由教育部高等学校矿业类专业教学指导委员会、中国高校矿物加工工程专业协同合作联盟发起，承办高校轮值（第九届福州大学，第十一届西安科技大学、西安建筑科技大学、长安大学联合承办）；被称为全国矿物加工工程专业级别最高、影响力最大的年度赛事"
    }
  ],
  "review_format": "专业专家评审制：组委会初审+专家网评（函评）+按四类作品分组的决赛答辩综合评定，围绕科学性、创新性等维度打分排序，无客观计分环节。",
  "judge_preferences": [
    "选题贴近行业前沿：智能选煤、难选矿高效分选、绿色低碳与固废资源化最受青睐",
    "数据扎实：有完整试验方案、表征数据和重复验证的作品更有说服力",
    "实物/软件能现场稳定演示，模型工艺细节到位",
    "答辩讲清『为什么新、新在哪、怎么验证』",
    "学生独立完成度高、工作量真实可查"
  ],
