{
  "competition_id": 90,
  "competition_name": "湖北省信息技术创新大赛",
  "judging_dimensions": [
    {
      "dimension": "创新性（创意水平）",
      "weight": "【推断约30%】官方未公布分项权重；作品类赛事通行首要维度",
      "official_wording": "官方文件（鄂教信〔2017〕17号，武汉商学院转发）仅公布大赛内容为'数字艺术类、创客创新类、创新教学类、商业模拟类四大类'及竞赛规则附件，未公开各评审维度分值。本维度及权重依据同类省级大学生作品类赛事评审惯例推断，特此注明【推断】。",
      "scoring_points": [
        "选题立意新颖，体现信息技术与创意结合（对应创客创新、数字艺术类赛项）",
        "方案/作品有独到的创意表达，非模板化套用",
        "鼓励原创内容与自研技术成分",
        "对教学、生活、产业场景有新解法（创新教学类关注教学设计创新）"
      ],
      "common_deductions": [
        "作品明显套用网络模板或往届获奖作品",
        "创意点与赛项主题脱节",
        "创新表述空泛，答辩追问无法说明创作思路"
      ]
    },
    {
      "dimension": "作品完成度与内容质量",
      "weight": "【推断约30%】",
      "official_wording": "官方通知含《竞赛规则》附件（中国地质大学转发2017年通知页面列出'竞赛规则.doc'），要求作品材料完整、由学校管理员'检查作品材料完整后提交省级管理员'。【推断：完成度与内容质量为网评主要考查面】",
      "scoring_points": [
        "作品主题表达完整、结构清晰（微电影/动画成片叙事完整，视觉传达/工业设计图面完整）",
        "技术制作质量：画面、声音、渲染、代码运行等技术指标达标",
        "按要求格式与规格提交，材料齐全（源文件、说明文档等）",
        "内容健康向上，符合大赛'青春与创新相约，梦想与创业同行'主题导向"
      ],
      "common_deductions": [
        "文件格式、分辨率、时长等不符赛项规格",
        "作品半成品、关键功能无法演示",
        "材料缺项被校级管理员退回，影响评审"
      ]
    },
    {
      "dimension": "专业水准与技术应用",
      "weight": "【推断约20%】",
      "official_wording": "大赛分数字艺术类、创客创新类等赛项（鄂教信〔2017〕17号），赛项含工业设计、微电影创作、视觉传达设计、动画等（武汉生物工程学院承办分工通知）；智能车、机器人赛项'按国赛规则'执行（中国地质大学转发通知：通过NOC高校国赛网站报名）。【推断：按赛项专业标准评审技术应用水平】",
      "scoring_points": [
        "数字艺术类：艺术表现力、专业软件运用与版面/镜头语言水平",
        "创客创新类：软硬件结合的技术难度与实现可靠性",
        "商业模拟类：模拟系统中的经营决策水平（以系统成绩为准）",
        "智能车/机器人赛项：按全国NOC高校赛项规则的技术评分执行"
      ],
      "common_deductions": [
        "技术运用停留在表面堆砌、与创意无关",
        "作品存在明显技术错误（如穿帮镜头、程序崩溃）",
        "商业模拟类操作记录异常或违反模拟规则"
      ]
    },
    {
      "dimension": "现场决赛答辩表现",
      "weight": "【推断约20%】大赛设现场决赛（含答辩）环节",
      "official_wording": "官方评审流程：'大赛评委会对全省1250件作品进行远程网上评审'（2016年，长江大学文理学院转发鄂教信〔2016〕27号）；网评入围作品参加现场决赛（曾于华中师范大学举办，含答辩环节）。【推断：答辩占决赛成绩的一部分，具体比例未公开】",
      "scoring_points": [
        "陈述清晰：创作思路、技术路线、创新点表达有条理",
        "回答评委提问准确，能证明作品的原创与本人参与",
        "PPT/演示与作品本身相互印证",
        "团队成员分工与贡献真实"
      ],
      "common_deductions": [
        "答辩表现与作品水平明显不符（代做嫌疑）",
        "答不上基本创作与技术细节",
        "未按时到场或超时陈述"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "参赛作品文件",
      "format": "按赛项要求：数字艺术类（设计图/源文件/成片视频）、创客创新类（实物+演示）、微电影/动画（视频文件）等，经大赛官网（dxsjs.e21.cn）注册提交",
      "page_limit": "未明确（以当届竞赛规则附件为准）",
      "deadline_note": "历届报名及提交约在上半年，现场决赛下半年举行"
    },
    {
      "item": "报名信息与校级审核材料",
      "format": "学生身份证注册→作品分配至校级管理员→学校审核学生与指导教师信息、材料完整性后提交省级管理员",
      "page_limit": "未明确",
      "deadline_note": "按当届通知截止时间"
    },
    {
      "item": "商业模拟类报名表",
      "format": "注册后选择项目、下载报名表填写发送至指定邮箱（部分赛项无初赛）",
      "page_limit": "未明确",
      "deadline_note": "按当届通知；智能车、机器人按国赛网站另行报名"
    }
  ],
  "process_stages": [
    {
      "stage": "校级提交与审核",
      "format": "学生官网注册提交作品，学校管理员审核信息与材料完整性后上报省级",
      "notes": "以学校为单位组织申报；部分赛项（商业模拟、智能车、机器人）不设初赛直接报名"
    },
    {
      "stage": "省级网上初评",
      "format": "大赛评委会对全省作品远程网上评审（2016年评审作品约1250件）",
      "notes": "按赛项类别分组评审，择优入围现场决赛"
    },
    {
      "stage": "省级现场决赛",
      "format": "现场决赛含作品展示与答辩（曾在华中师范大学举办）",
      "notes": "决出一、二、三等奖；长江大学首届18件作品参赛获一等奖1项、二等奖4项、三等奖9项；武汉工程大学曾将省一等奖及以上认定为本校学科竞赛B类"
    }
  ],
  "review_format": "大赛评委会远程网上评审（初评）+现场决赛作品展示与答辩，按赛项类别分组评审",
