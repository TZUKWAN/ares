{
  "competition_id": 62,
  "competition_name": "百度之星",
  "judging_dimensions": [
    {
      "dimension": "初赛（省赛）算法解题：通过题数与用时排名",
      "weight": "客观题计分：每场8道算法题、3小时，ACM赛制按AC题数优先、总用时次之的机器自动排名；两场初赛各取前约400名（合计约800名）晋级决赛；获奖比例：金奖5%、银奖10%、铜奖15%（按绝对分数划定，不再分省、分组别）",
      "official_wording": "百度官方赛事通知（青岛科技大学转发）：'初赛比赛时长：3小时/场（2场），题目数：8题/场''按AC题数和总时长排名，两场比赛的成绩分开排名''初赛获奖比例约为：金奖5%、银奖10%、铜奖15%。初赛获奖比例按实际分数划定，不再分省份，不再分组别'；'初赛（每场）排名前400名（预计）晋级决赛，两场初赛共晋级800人'。",
      "scoring_points": [
        "AC题数：每通过一题记一题，是排名第一关键字",
        "总罚时/总用时：同题数下用时短者排名靠前（含错误提交罚时）",
        "算法基本功：数据结构、动态规划、图论、数学等全面覆盖",
        "编码速度与一次通过率：减少错误提交次数",
        "独立参赛：初赛单人单机、在线监考诚信作答"
      ],
      "common_deductions": [
        "题数相同但罚时长导致排名大幅下滑（ACM赛制罚时惩罚）",
        "编译错误/超时/内存超限反复提交浪费时间",
        "作弊、代打、多账号经查实取消成绩",
        "未在规定场次完成实名认证或资格不符"
      ]
    },
    {
      "dimension": "决赛算法解题",
      "weight": "客观题计分：12道算法题、5小时，按AC题数与总用时排名；决赛按大学组/高中组/小星星组分组评奖，金、银、铜奖比例分别为10%、20%、30%（约计），另设加速营/专项激励",
      "official_wording": "百度官方赛事通知：'决赛比赛时长：5小时/场（1场），题目数：12题/场''决赛按大学组、高中组、小星星组分别排名''决赛获奖比例约为：金奖10%、银奖20%、铜奖30%（约计，以实际情况为准）'。",
      "scoring_points": [
        "决赛12题的难度梯度适应：中低档题快速清空，难题争取部分突破",
        "5小时长时间作战的体能与策略分配",
        "同组别内AC题数与总用时排名",
        "线下决赛的现场调试与环境适应能力"
      ],
      "common_deductions": [
        "难题缠身导致中档题失守、总题数落后",
        "罚时劣势：同分情况下因错误提交多而落榜",
        "现场赛纪律违规（通讯、资料）直接取消资格"
      ]
    },
    {
      "dimension": "参赛资格与诚信合规",
      "weight": "通过制：在校生成绩计入且可获评奖；非在校生（百度员工等）可参赛但只显示'star marker'不参与评奖；每单位最多20名非在校学生进决赛",
      "official_wording": "百度官方赛事通知：'初赛不限学历，在校学生（包括小学、初中、高中、职业学校、大学及研究生）皆可报名参赛''非在校学生（含百度员工）也可报名参赛，但成绩只作star marker显示，不参与评奖''每个单位（企业、学校）最多20名非在校学生可以进入决赛'。",
      "scoring_points": [
        "在校学生身份核验通过",
        "报名信息真实（学校、学籍）",
        "遵守独立作答与平台防作弊规则",
        "按组别（大学组/高中组/小星星组）正确归组"
      ],
      "common_deductions": [
        "非在校学生冒充在校生参赛评奖",
        "代考、共享账号、使用AI或他人代码被判作弊",
        "同一选手多场次重复占晋级名额违规"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "线上赛题代码提交",
      "format": "C、C++、Python、Java等支持语言，在指定OJ（马蹄集/百度之星平台）在线提交",
      "page_limit": "未明确",
      "deadline_note": "第二十一届（2025）：第一场初赛7月5日、第二场初赛8月16日；决赛9月（合肥）；第二十二届（2026）：初赛第一场2026年9月20日、第二场11月14日"
    },
    {
      "item": "报名与考试服务费",
      "format": "官网star.baidu.com报名，报名费80元/人/场（通过马蹄集缴纳，用于防作弊等考试服务）",
      "page_limit": "未明确",
      "deadline_note": "报名截止一般在开赛前2小时"
    }
  ],
  "process_stages": [
    {
      "stage": "初赛（省赛）",
      "format": "线上个人赛，两场可选（报一场或两场），3小时8题，ACM赛制排名；每场前约400名晋级",
      "notes": "两场成绩分开排名；获奖比例金5%/银10%/铜15%按绝对分数划定、不分省分组；已晋级选手参加第二场不再占名额"
    },
