{
  "competition_id": 30,
  "competition_name": "周培源力学竞赛",
  "judging_dimensions": [
    {
      "dimension": "个人赛笔试：基础题（对应教学大纲B类要求）",
      "weight": "卷面计分：历届试卷满分120分、共5-6道大题（第九届官网试题原文：'本试卷共5题 满分120分 时间3小时30分'），基础题约占半数；无官方公开的分值分配表",
      "official_wording": "竞赛简介（郑州航空工业管理学院转载）：'考试范围请见教育部基础力学课程教学指导委员会所颁布的理论力学和材料力学的教学大纲（基础题部分B类；提高题部分A类）'；第九届试题（竞赛官网）：'本试卷共5题 满分120分 时间3小时30分'。",
      "scoring_points": [
        "静力学、运动学、动力学基本概念的准确建模（受力图/运动分析图规范）",
        "材料力学内力图（轴力、扭矩、剪力、弯矩）绘制正确",
        "基本变形与组合变形的应力/变形计算无误",
        "步骤完整、逻辑清晰：中间过程分步给分，结果用分数或小数表示均可"
      ],
      "common_deductions": [
        "受力图缺失或约束反力方向错误（模型分直接损失）",
        "内力图突变位置/数值错误",
        "纯结果对但无过程、或公式套用与题设条件不符"
      ]
    },
    {
      "dimension": "个人赛笔试：提高题（对应教学大纲A类要求）",
      "weight": "卷面计分：提高题为区分度主项（大赛'着重考核灵活运用基础知识、分析和解决问题的能力'）",
      "official_wording": "竞赛简介：竞赛'着重考核灵活运用基础知识、分析和解决问题的能力'；第十五届个人赛第二题曾被作为研究对象指出其'属于基础题，结合了刚体动力学与运动学中的多个核心知识点'（中国力学学会 costing 文章），说明试卷设基础与综合提高两个层次。",
      "scoring_points": [
        "综合建模能力：动力学普遍定理、达朗贝尔原理、虚位移等方法的正确选用",
        "能量法与超静定问题的综合分析",
        "对工程场景抽象简化后的数学求解与讨论",
        "一题多解时的方法优劣与结果自洽性"
      ],
      "common_deductions": [
        "方法选错导致全程无有效得分点",
        "数值计算粗心、量纲不一致",
        "跳步严重、关键方程缺失无法按步给分"
      ]
    },
    {
      "dimension": "团体赛：理论设计与操作",
      "weight": "团体赛两大板块之一（自第九届起设置）；以团体课题研究方式进行，细则每届另行发布",
      "official_wording": "上海大学第十二届报名通知：'竞赛包括个人赛和团体赛，个人赛采用闭卷笔试方式，理论力学和材料力学综合为一套试卷'；多所高校通知一致载明：'团体赛分为理论设计与操作和基础力学实验两部分，采取团体课题研究（实验测试）的方式进行'。",
      "scoring_points": [
        "给定课题的理论建模与设计方案质量【推断：依据'团体课题研究'赛制定性评估，分值未公开】",
        "理论计算与现场操作（制作/调试）结果的一致性",
        "团队分工协作与时间管理",
        "答辩/报告中力学原理阐述的深度"
      ],
      "common_deductions": [
        "理论方案与实测结果严重偏离且无法解释",
        "操作违规或超时",
        "团队成员参与度失衡、答辩无人能答"
      ]
    },
    {
      "dimension": "团体赛：基础力学实验",
      "weight": "团体赛两大板块之一；参赛团队按个人赛成绩选拔产生；'本科单科组、专科组个人赛及本科综合组基础力学实验团体赛只设省级奖'",
      "official_wording": "高校通知汇编：'自第九届起，团体赛分为理论设计与操作和基础力学实验两部分'；'基础力学实验团体赛由中国力学学会教育工作委员会承办，参赛团队按个人赛成绩选拔产生'。【推断：实验赛通常考察实验方案设计、操作规范、数据处理与误差分析、分析报告，具体评分表每届由组委会发布】",
      "scoring_points": [
        "实验方案设计：原理正确、方法可行（电测法等基础力学实验手段）",
        "现场操作规范：仪器使用、贴片/加载/采集流程",
        "数据记录与处理：误差分析、结果表达",
        "实验报告的完整性与力学分析深度"
      ],
      "common_deductions": [
        "违规操作损坏仪器",
        "数据造假或抄录他队数据",
        "报告数据处理错误、结论与数据矛盾"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "个人赛答卷（闭卷笔试）",
      "format": "全国统一闭卷笔试，理论力学+材料力学综合一套试卷，满分120分",
      "page_limit": "试卷5-6道大题（历届惯例）",
      "deadline_note": "考试时长3小时30分（如第十三届2021年5月23日8:30-12:00全国统考）；每两年一届（逢奇数年前后，第十五届2025年）"
    },
    {
      "item": "团体赛课题研究成果（理论设计与操作）",
      "format": "按当届组委会发布的课题要求提交设计方案、实物/装置与现场操作演示",
      "page_limit": "未明确",
      "deadline_note": "个人赛成绩公布后按选拔名单组队参加，时间约在个人赛后数月"
    },
    {
      "item": "基础力学实验记录与报告",
      "format": "现场实验测试+数据记录+实验报告",
      "page_limit": "未明确",
      "deadline_note": "团体赛（基础力学实验）由中国力学学会教育工作委员会承办，具体日期见当届通知"
    },
    {
      "item": "报名表与参赛费",
      "format": "以学校为单位经赛区（省力学学会）报名，个人赛与团体赛分别报名",
      "page_limit": "未明确",
      "deadline_note": "第十五届通知于2025年初发布（如北京科技大学2025年1月转发），开赛约5月"
    }
  ],
  "process_stages": [
    {
      "stage": "校内报名与选拔",
      "format": "以学校为单位组织报名（部分高校校内选拔培训），经省力学学会赛区上报",
      "notes": "每两年一届；分本科综合组、本科单科组（理论力学单科/材料力学单科）、专科组"
    },
    {
      "stage": "个人赛（全国统考笔试）",
      "format": "闭卷笔试，全国统一命题统一时间；理论力学与材料力学综合一套试卷，满分120分，时长3小时30分",
      "notes": "全国奖由组委会组织专家根据个人赛成绩评出；省级奖由各赛区评定（辽宁赛区：一、二、三等奖与优秀奖比例为参赛学生3%、6%、10%、15%）"
    },
    {
      "stage": "团体赛（实验/课题决赛）",
      "format": "按个人赛成绩选拔组队；分'理论设计与操作'与'基础力学实验'两部分，采取团体课题研究（实验测试）方式现场比赛",
      "notes": "团体奖按赛区规则评定（江苏赛区以报名学校数为基准：特等奖10%、一等奖20%、二等奖30%，由理论赛成绩评定）；基础力学实验团体赛只设省级奖（本科综合组）"
    }
  ],
  "review_format": "个人赛为全国统一闭卷笔试、专家流水阅卷按卷面分排名；团体赛为课题研究与现场实验测试，按当届组委会评分细则评审",
  "judge_preferences": [
    "阅卷按步骤给分：建模图、方程、代入、结果缺一不可，过程规范性直接影响得分",
    "看重灵活运用：能用最适方法（能量法、虚位移、动力学定理）解题而非硬套公式",
    "实验赛重视规范与严谨：操作细节、误差分析是区分度所在",
    "理论与实验互相印证的能力（团体赛课题研究导向）",
    "对试卷工程背景的理解：试题常以真实工程部件为情境"
  ],
