{
  "competition_id": 110,
  "competition_name": "全国大学生版权征文活动",
  "judging_dimensions": [
    {
      "dimension": "论文主题（选题价值与版权相关性）",
      "weight": "专家百分制定性评分四方面之一（论文主题、论文内容、论文表达、论文创新），各维具体分值以官方评分表（未公开图片表格）为准；形式审查阶段'内容与版权无关'即被剔除",
      "official_wording": "《第十三届全国大学生版权征文活动评审工作办法》（承办方中国人民大学国家版权贸易基地官网）原文：'第八条 评审专家从论文主题、论文内容、论文表达和论文创新等四个方面对参赛论文进行评分'；'第七条（一）形式审查：组委会对所有投稿论文进行形式审查，剔除内容与版权无关、结构不完整、行文不规范、质量不合格的论文'。通知原文征文主题含'版权法基本理论研究；版权行政保护研究；版权司法保护研究；著作权集体管理制度研究；版权产业相关问题研究；国际版权法治研究；版权热点问题研究（自媒体、网络文学、体育赛事节目、短视频、直播等）；其他版权相关问题研究'。",
      "scoring_points": [
        "选题属于征文主题范围（八类版权研究主题之内，内容与版权无关直接淘汰）",
        "选题有理论与现实意义，切中版权法治前沿（如人工智能生成物、短视频、直播、体育赛事节目等热点）",
        "问题意识明确：小切口深挖掘优于大而全综述",
        "结合新法适用与典型案例（获奖名单中大量选题以具体制度、司法案件切入）"
      ],
      "common_deductions": [
        "内容与版权无关（形式审查直接剔除）",
        "选题陈旧、重复研究无新问题",
        "泛泛综述、缺乏明确研究问题"
      ]
    },
    {
      "dimension": "论文内容（论证质量与学术规范）",
      "weight": "专家评分四方面之一；形式审查剔除'结构不完整、行文不规范、质量不合格'论文，软件查重率不得高于12%方可进入专家评审",
      "official_wording": "《评审工作办法》原文：'（二）软件查重：组委会对通过形式审查的论文进行软件查重，根据查重率的高低选取不超过1000篇论文进入专家评审。进入专家评审的论文查重率不得高于12%'。通知原文要求'所投论文内容需与版权相关，题目不限，每人限投一篇，每篇字数控制在6000字以内，参赛作品须为独著，体裁为学术论文'。",
      "scoring_points": [
        "论点明确、论据充分、论证逻辑严密，结构完整",
        "文献综述与学理对话充分，注释引证规范",
        "案例/实证材料运用得当（裁判文书、执法数据等）",
        "结论有解释力与落地建议（立法、司法或执法完善路径）",
        "全文独著、6000字以内，格式统一（标题三号黑体加粗、正文四号宋体、单倍行距）"
      ],
      "common_deductions": [
        "查重率高于12%（不得进入专家评审）",
        "结构不完整、行文不规范、质量不合格（形式审查剔除）",
        "超出字数限制或合著投稿",
        "引注缺失或格式不符合统一排版要求"
      ]
    },
    {
      "dimension": "论文表达（写作规范与可读性）",
      "weight": "专家百分制定性评分四方面之一（评分等级：特优95分及以上、优秀85-94、良好75-84、及格60-74、不及格60分以下）",
      "official_wording": "《评审工作办法》原文：'评分标准分为五个等级（百分制）：特优得95分及以上，优秀得85-94分，良好得75-84分，及格得60-74分，不及格得60分以下'；通知原文：'论文需遵照统一格式排版，标题为三号黑体加粗，正文为四号宋体，单倍行距'。",
      "scoring_points": [
        "学术语言准确、法言法语规范",
        "标题与各级结构层次清晰、摘要问题凝练",
        "行文流畅、详略得当（6000字内完整论证）",
        "排版符合统一格式要求"
      ],
      "common_deductions": [
        "表述口语化、概念使用不准确",
        "结构混乱、段落逻辑断裂",
        "格式不符合统一排版要求"
      ]
    },
    {
      "dimension": "论文创新（创新程度与贡献）",
      "weight": "专家百分制定性评分四方面之一；每组盲审平均分前两名参评特等奖，特等奖经专家复评会讨论决定",
      "official_wording": "《评审工作办法》原文：'（三）专家评审：征文系统将通过软件查重的论文进行分组，并将各组论文随机分配给两位评审专家进行背靠背式盲审，两位专家盲审的平均分为最终得分。每组最终得分的前两名参评特等奖。（四）专家复评：组委会邀请若干名知识产权领域专家召开复评会，讨论决定特等奖论文。其他奖项以专家评审得分高低确定'。",
      "scoring_points": [
        "观点、视角或方法有创新（新问题、新材料、新论证路径）",
        "对既有学说的检讨与推进，而非重复通说",
        "回应版权实践新问题（获奖论文如网络作品融梗定性、人工智能生成物可版权性、古籍点校著作权等前沿题目）",
        "理论贡献或制度建议有独创价值"
      ],
      "common_deductions": [
        "观点与前人研究雷同、无增量贡献",
        "仅堆砌案例或法条释义",
        "与作者已发表或已参赛作品重复（取消资格情形）"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "参赛论文（学术论文）",
      "format": "独著学术论文，PDF版+Word版在线提交（thesis.copyrightruc.com 注册投稿）；统一格式：标题三号黑体加粗、正文四号宋体、单倍行距；论文任何位置不得出现姓名、学校、指导老师姓名",
      "page_limit": "每篇字数控制在6000字以内；每人限投一篇",
      "deadline_note": "第十三届：2021年3月下发通知，7月31日截止收稿，8-9月评审，10月颁奖；征文不收取任何费用"
    },
    {
      "item": "原创与授权承诺",
      "format": "须保证原创、未发表、未参加过同类型征文比赛、未与第三方签署授权协议；投稿即同意组委会汇编出版（不同意需说明）",
      "page_limit": "未明确",
      "deadline_note": "随投稿在线提交时生效；违反即取消参赛资格，来稿不退、自留底稿"
    }
  ],
  "process_stages": [
    {
      "stage": "通知发布与校内组织",
      "format": "国家版权局下发通知（如国版发函〔2020〕4号），各省版权局、高校组织学生参赛，高校常发鼓励参赛通知",
      "notes": "参赛对象为全国（含港澳台）在校本科生、硕士研究生及博士研究生，分本科生组和研究生组"
    },
    {
      "stage": "线上投稿与形式审查",
      "format": "官网注册在线提交（PDF+Word）；组委会形式审查，剔除内容与版权无关、结构不完整、行文不规范、质量不合格的论文",
      "notes": "免费参赛；匿名要求为硬性门槛"
    },
    {
      "stage": "软件查重",
      "format": "软件查重，按查重率高低选取不超过1000篇进入专家评审；进入专家评审者查重率不得高于12%",
      "notes": "查重为刚性淘汰环节"
    },
    {
      "stage": "专家匿名评审",
      "format": "分组后随机分配两位评审专家背靠背盲审，取平均分为最终得分；每组前两名参评特等奖",
      "notes": "评审专家来自国内立法、行政、司法和版权实务部门及高校科研机构；从论文主题、内容、表达、创新四方面百分制打分"
    },
    {
      "stage": "专家复评与公示颁奖",
      "format": "知识产权领域专家复评会讨论决定特等奖；其余奖项按得分高低确定；结果经组委会审议后在国家版权局官网公示，颁奖仪式暨青年交流研讨",
      "notes": "第十三届奖项：特等奖3名，本科生组与研究生组一等奖各10名、二等奖各20名、三等奖各30名、优秀奖若干、优秀指导教师奖与优秀组织奖若干；获奖名单在国家版权局官网、《中国版权年鉴》公布"
    }
  ],
  "review_format": "形式审查+软件查重（≤12%）+两位专家背靠背匿名盲审（平均分）+专家复评会定特等奖的四级评审制，全程匿名。",
  "judge_preferences": [
    "选题切中版权法治前沿与真问题（人工智能生成物、短视频、直播、体育赛事节目、网络文学融梗等近年获奖热门）",
    "小切口制度研究与案例研究受青睐：获奖论文多以具体制度或典型案件切入深挖",
    "论证规范、文献与注释扎实，6000字内完成完整论证",
    "创新性与学术贡献是特等奖与一等奖的分水岭（组内前两名方能参评特等奖）",
    "严格匿名与学术诚信，查重率、原创性一票否决"
  ],
