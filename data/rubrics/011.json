{
  "competition_id": 11,
  "competition_name": "全国大学生智能汽车竞赛",
  "judging_dimensions": [
    {
      "dimension": "现场竞速成绩（完赛时间）",
      "weight": "100%决定名次（竞速赛名次评定的主项）",
      "official_wording": "参赛队伍的名次（成绩）由赛车现场成功完成赛道比赛时间来决定（第二十一届竞速比赛规则；名次评定以现场成功完成赛道比赛时间为主，技术方案及制作工程质量评分为辅）",
      "scoring_points": [
        "赛车成功完成全赛道运行的时间（越短名次越高）",
        "出界、冲出锥桶边界、漏元素等按组别细则判罚（加时或取消该轮成绩）",
        "缩微赛道组车模重量参与成绩计算：超出100克的部分除以20换算成秒叠加到完赛成绩（每轮发车前称重）",
        "两轮运行取最好成绩的组别按最优轮计"
      ],
      "common_deductions": [
        "车模出界或未按规定通过赛道元素",
        "缩微组超重导致罚时",
        "发车违规（车模越线、抢跑）"
      ]
    },
    {
      "dimension": "技术报告（技术方案与制作工程质量）",
      "weight": "评分辅项分数（总决赛队伍必须提交，作为评审辅项）",
      "official_wording": "参加全国总决赛的队伍同时须提交车模技术报告（第二十一届竞速比赛规则第一章）；名次评定以现场比赛时间为主，技术方案及制作工程质量评分为辅",
      "scoring_points": [
        "方案设计：传感器布局、控制算法（循迹、PID/滤波、决策）论述",
        "机械结构与电路设计的优化过程",
        "程序设计与调试数据记录",
        "工程制作质量的规范性表述"
      ],
      "common_deductions": [
        "未按时提交技术报告影响总决赛资格与评审",
        "报告与实车方案明显不符",
        "结构混乱、缺少调试数据支撑"
      ]
    },
    {
      "dimension": "综合创意赛任务完成（创意组别）",
      "weight": "按任务完成度与作品评审计分数（创意赛各赛项细则规定，权重随赛项设置未统一公开）",
      "official_wording": "综合创意赛以机器视觉、人工智能、ROS等为主要开发内容，在配备复杂传感器的运动平台上部署，完成无人系统相关任务（第二十一届竞赛规则；设智慧医疗、智慧工厂、智慧救援等赛项）",
      "scoring_points": [
        "任务完成率与完成质量（识别、抓取、配送、救援等任务指标）",
        "人工智能与视觉算法的创新性与工程化水平",
        "系统稳定性与现场演示效果",
        "技术方案答辩表现"
      ],
      "common_deductions": [
        "任务环节失败或漏做",
        "依赖人工干预、不满足自主性要求",
        "现场演示与申报方案不符"
      ]
    },
    {
      "dimension": "车模合规性检查",
      "weight": "通过制（赛前检查不合格不得上道比赛）",
      "official_wording": "参赛选手使用竞赛秘书处统一指定的竞赛车模套件、微控制器平台，自主构思控制方案进行系统设计；传感器种类按组别允许清单选用（第二十一届竞速比赛规则：比赛器材与组别一览表）",
      "scoring_points": [
        "车模平台与尺寸符合组别规定（自制车模限缩微组等特定组别）",
        "传感器种类在组别允许清单内",
        "MCU平台符合指定型号（如英飞凌AURIX/TRAVEO、NXP、STC等）",
        "安全防护：高速风扇（含四旋翼）须防护遮挡"
      ],
      "common_deductions": [
        "使用超规传感器或非指定MCU平台",
        "车模尺寸/驱动改装超出组别限制",
        "单车定向等组别使用违规平衡辅助手段"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "智能车参赛作品（车模）",
      "format": "统一指定车模套件或组别允许的自制车模+指定MCU平台，自主完成控制方案设计",
      "page_limit": "未明确",
      "deadline_note": "第21届分赛区报名至2026年6月14日前后（各校通知），暑期7-8月比赛"
    },
    {
      "item": "车模技术报告",
      "format": "文档形式（含方案设计、机械、电路、程序与调试）",
      "page_limit": "未明确（按当届秘书处模板要求）",
      "deadline_note": "进入全国总决赛的队伍随总决赛提交"
    },
    {
      "item": "参赛队伍",
      "format": "按组别3-5人/队（如飞檐走壁3人、蚂蚁搬家4人、轮腿穿越4人、单车定向3人），专科组别单独排名",
      "page_limit": "未明确",
      "deadline_note": "规则版本每年6月15日前固定不再修订"
    }
  ],
  "process_stages": [
    {
      "stage": "校内选拔与报名",
      "format": "高校组织校内选拔并在竞赛系统报名（第21届竞速赛设约11个组别+综合创意赛赛项）",
      "notes": "组别含缩微赛道（飞檐走壁、疯狂电路、蚂蚁搬家等）、室内赛道（飞跃雷区、人工智能视觉/模型等）、室外赛道（卡丁快跑、轮腿穿越、单车定向等）；本专科分组排名"
    },
    {
      "stage": "分/省赛区比赛",
      "format": "现场赛道竞速计时，按组别评出晋级全国总决赛名额",
      "notes": "2026年7月在各承办学校举行；分赛区获奖证书于各赛区完毕公示后发放电子版"
    },
    {
      "stage": "全国总决赛",
      "format": "现场竞速+技术报告评审（第21届总决赛2026年8月21-23日在安徽大学举行）",
      "notes": "名次以现场完赛时间为主、技术方案与制作工程质量评分为辅"
    }
  ],
  "review_format": "客观计时制：现场成功完成赛道的比赛时间直接决定名次（缩微组叠加车重罚时），辅以总决赛技术报告评审；综合创意赛按任务完成度评分。",
  "judge_preferences": [
    "稳定完赛优于单圈极限速度，裁判看重全部元素零失误",
    "传感器融合与控制算法的工程实现力（电磁/摄像头/GPS/IMU按组别选用）",
    "缩微组轻量化设计直接转化为成绩优势",
    "创意赛重AI与视觉任务的真实完成度及自主性",
    "现场调试与临场应变（赛道参数变化后的快速适配）"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "车模平台、MCU、传感器必须符合组别一览表限定，超规即取消成绩",
    "缩微赛道车模重量超出100克部分按1/20换算罚秒，故意减重到危险程度亦有安全审查风险",
    "除室外组别外使用负压风扇增加抓地力须做好安全防护遮挡，否则禁止上场",
    "规则每年6月15日前固定，赛前务必核对当届修订版本，按旧版规则准备易违规",
    "高速风扇与四旋翼无防护遮挡不得参赛"
  ],
