{
  "competition_id": 95,
  "competition_name": "湖北省网络空间安全实践能力竞赛",
  "judging_dimensions": [
    {
      "dimension": "解题能力/攻防技术实力（CTF得分）",
      "weight": "客观计分：成绩=解题分数合计，初赛线上CTF按解题得分排名（如第四届预赛总分300分），决赛AWD按攻击得分与防守得分实时累计",
      "official_wording": "第四届竞赛通知（武汉科技大学信息化办转发）：预赛2019年9月29日采用线上CTF模式，总分300分；预赛成绩不带入决赛。第五届（湖北大学新闻）：预赛为线上CTF『只攻不防』模式，决赛通过统一平台连入主办方搭建的实际系统进行技能竞赛。官方未公布权重式评分细则，属客观计分赛制【推断依据：历届通知与新闻通稿，评分即得分排名】",
      "scoring_points": [
        "Web渗透、二进制漏洞挖掘利用（Pwn/Reverse）、密码分析、取证分析（Misc/Forensics）、逆向分析等方向题目完成度",
        "解题数量与难度加权得分（一血加分，CTF通行规则）",
        "AWD模式下攻击得分（拿下对手靶机）与防守得分（守住本方靶机、及时修补漏洞）",
        "决赛AWDP赛制下Break（攻破题靶）与Fix（修复并提交补丁，系统定时Check验证）双线得分",
        "提交Flag的准确率与时效性"
      ],
      "common_deductions": [
        "违规使用劫持他人Flag、攻击比赛平台本身等行为直接取消成绩",
        "作弊（多队串通共享Flag、使用外挂脚本）一票否决",
        "AI/机器人大流量扫描导致平台判罚扣分"
      ]
    },
    {
      "dimension": "实战渗透与综合攻防（决赛AWD/靶场实战）",
      "weight": "决赛环节计分：以统一平台实时排行榜为准（客观计分，占决赛成绩100%权重）",
      "official_wording": "第五届竞赛报道：决赛通过统一平台连入实际系统（主办方搭建的真实环境）进行技能竞赛；省内同类赛事（湖北大学『奇安信杯』）决赛采用AWD Plus及靶场综合渗透模式，楚慧杯决赛亦采用AWD/AWDP形式【推断依据：历届公开Writeup与承办方平台（安恒、绿盟等）赛制说明】",
      "scoring_points": [
        "对主办方搭建实际系统的渗透深度（权限提升、横向移动、拿到核心Flag）",
        "防御响应速度：漏洞修补、后门清除、弱口令整改",
        "流量分析与其他实战类题目完成情况",
        "攻守策略平衡（不能只攻不防，防守失分会拖累总分）"
      ],
      "common_deductions": [
        "破坏赛题环境、篡改他人靶机系统文件被判罚",
        "防守环节长时间宕机持续扣分",
        "提交无效补丁通过不了Check"
      ]
    },
    {
      "dimension": "团队协作与合规参赛",
      "weight": "资格性要求：不单独计分，但违规一票否决；组队类别（本科院校、职业院校、企事业单位、网络安全技术爱好者4类）分开评优",
      "official_wording": "竞赛按本科高等院校、职业院校、企事业单位、网络安全（含技术爱好者）4个类别分组选拔优胜队进入决赛（中国地质大学赛事报道）；报名须提交加盖单位公章的报名表扫描件【推断依据：历届通知及新闻稿】",
      "scoring_points": [
        "队员分工明确（Web/Pwn/Reverse/Misc方向互补）",
        "遵守比赛纪律与平台使用规则",
        "报名信息真实、单位盖章材料齐全"
      ],
      "common_deductions": [
        "队员跨队重复报名",
        "信息填写不实或盖章材料缺失",
        "比赛期间场外求助、代打"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "报名材料",
      "format": "加盖单位/学校公章的报名表扫描件+参赛选手证件照电子档（照片文件名须为本人姓名），发送至组委会指定邮箱",
      "page_limit": "未明确",
      "deadline_note": "报名时间一般在8-9月（历届通知，如2019年9月）"
    },
    {
      "item": "初赛（预赛）",
      "format": "线上CTF解题赛（如第四届总分300分），无需提交文档，以平台提交Flag计分",
      "page_limit": "不适用",
      "deadline_note": "2019年第四届预赛为9月29日；历届多在9月中下旬"
    },
    {
      "item": "决赛",
      "format": "线下/线上AWD或AWDP攻防赛+靶场综合渗透，平台实时计分，预赛成绩不带入决赛",
      "page_limit": "不适用",
      "deadline_note": "历届决赛多在9月底-10月（与湖北省国家网络安全宣传周同期），如2019年10月12日"
    }
  ],
  "process_stages": [
    {
      "stage": "报名与资格审查",
      "format": "以单位/学校组队报名，按本科院校、职业院校、企事业单位、网络安全技术爱好者4类分组",
      "notes": "覆盖全省高校、企事业单位、网安企业和全国爱好者；第六届吸引500多支参赛队"
    },
    {
      "stage": "线上预赛（CTF解题赛）",
      "format": "统一线上平台CTF『只攻不防』模式，按解题得分排名选拔优胜队晋级",
      "notes": "如第四届预赛总分300分，142支队伍报名、28支进入决赛"
    },
    {
      "stage": "决赛（AWD/AWDP攻防赛）",
      "format": "连入主办方搭建的实际系统进行综合攻防（含流量分析等实战题），平台实时排行榜，赛后即颁奖",
      "notes": "决赛成绩独立于预赛；评出一、二、三等奖（如第四届一等奖1名、二等奖3名、三等奖5名；第六届一等奖1名、二等奖若干、三等奖若干）"
    }
  ],
  "review_format": "全程机器客观计分：初赛线上CTF按解题得分排名晋级，决赛AWD/AWDP攻防赛按平台实时攻防得分排名，无人工主观评审。",
  "judge_preferences": [
    "得分即硬通货：解题速度与一血能力最受认可",
    "攻守均衡：决赛AWD只攻不防的队伍难以登顶",
    "题目方向覆盖面广的队伍（Web+Pwn+Reverse+Misc无短板）更占优",
    "遵守平台规则、稳定发挥胜过激进冒进"
  ],
