{
  "competition_id": 40,
  "competition_name": "物理实验竞赛",
  "judging_dimensions": [
    {
      "dimension": "科学性（物理原理与实验实现）",
      "weight": "约30%【推断】",
      "official_wording": "组委会通知附件《自选课题类作品评审标准》以\"评价维度/评分标准/分值（100分）\"表格呈现，\"科学性\"为首要维度（第十一届通知附件2.2）；《物理与工程》期刊记载初评专家从\"科学性、创新性、先进性等维度\"点评；具体分值未公开",
      "scoring_points": [
        "物理原理正确、概念表述严谨",
        "实验方案与方法合理、装置搭建可靠",
        "数据采集与处理规范（误差分析、不确定度）",
        "结论可信、可重复验证"
      ],
      "common_deductions": [
        "原理性错误或概念混用",
        "数据单次无重复、无误差分析",
        "现象无法在视频中复现"
      ]
    },
    {
      "dimension": "创新性（选题与设计思路）",
      "weight": "约30%【推断】",
      "official_wording": "同上官方评审标准附件，\"作品创新性\"为独立评价维度（选题是以往教学实验中缺少但有价值的课题为典型评分描述，经江西省赛采用同款标准的文件印证）",
      "scoring_points": [
        "选题新颖，为现有教学实验体系中缺少的内容",
        "实验思路/装置设计有独到之处",
        "命题类作品对命题的个性化深化与拓展",
        "跨领域方法迁移引入物理实验"
      ],
      "common_deductions": [
        "沿用经典教材实验无改进",
        "创新点仅为仪器昂贵化或复杂化",
        "与往届获奖作品雷同"
      ]
    },
    {
      "dimension": "先进性与推广应用价值",
      "weight": "约20%【推断】",
      "official_wording": "官方评审维度含\"先进性\"（期刊与省赛采用文件印证）；校赛选拔方案参考国赛评委培训标准含\"装置成品具有推广价值，性价比高（10分）\"\"作品的成熟程度及预期教学效果良好\"等表述",
      "scoring_points": [
        "技术手段先进（数字化测量、AI辅助、新器件）",
        "装置成本可控、具有在高校实验教学推广的可行性",
        "成熟度与预期教学效果",
        "命题第6题类作品体现AI与物理实验融合深度"
      ],
      "common_deductions": [
        "脱离教学实际、无法推广",
        "成本高昂且无性能优势",
        "成品粗糙仅是原理演示"
      ]
    },
    {
      "dimension": "作品材料与视频表达",
      "weight": "约20%【推断】",
      "official_wording": "网络初评方式为\"评阅项目资料和实验视频资料对每件作品进行评分\"（通知原文），材料与视频直接构成评审对象；往届细则要求视频720P、声音画面清晰、文件不超过200M",
      "scoring_points": [
        "实验报告结构完整、图表规范",
        "视频真实完整记录实验过程与现象，画面清晰",
        "时长与文件规格符合要求",
        "内容与报告互相印证"
      ],
      "common_deductions": [
        "视频剪辑痕迹重、关键过程缺失",
        "超时、超文件大小上限",
        "报告与视频数据不一致"
      ]
    },
    {
      "dimension": "讲课类教学能力（单列赛道标准）",
      "weight": "讲课类按组委会《物理实验讲课竞赛细则及评审标准》百分制评分，分数构成见细则，与作品类分赛道评奖",
      "official_wording": "组委会通知：\"大学生物理实验讲课比赛（细则及评审标准见附件3）\"；第十届通知\"不仅明确了讲课类竞赛细则和评审标准\"（ResearchGate论文记述）；讲课类每校最多2支队伍、学生不超过3人",
      "scoring_points": [
        "教学设计与课件质量（教案、PPT）",
        "讲课视频约20分钟的教学表达与示范性",
        "实验操作演示的规范性",
        "物理内容准确性与教学逻辑"
      ],
      "common_deductions": [
        "讲授有科学性错误",
        "演示实验与讲授脱节",
        "超时或视频制作粗糙"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "命题类创新作品",
      "format": "按组委会公布的命题题目（如虹与霓、粘滞系数测量、微视频、AI+物理实验等）提交实验报告+作品视频",
      "page_limit": "视频720P、约15分钟内、不超过200M（往届细则口径）",
      "deadline_note": "9月1-15日正式报名并上传参赛资料（第十二届口径）"
    },
    {
      "item": "自选课题类创新作品",
      "format": "自选题目，实验报告+作品视频，附自选类题目说明",
      "page_limit": "同上视频规格",
      "deadline_note": "9月1-15日上传"
    },
    {
      "item": "讲课类参赛材料",
      "format": "讲课视频（约20分钟）+讲课PPT+教案",
      "page_limit": "未明确",
      "deadline_note": "9月1-15日上传"
    },
    {
      "item": "预赛报名表",
      "format": "学校盖章报名表提交承办校",
      "page_limit": "未明确",
      "deadline_note": "5月15日前（第十二届为2026年5月15日前）"
    }
  ],
  "process_stages": [
    {
      "stage": "校级选拔与预赛报名（3-5月）",
      "format": "高校组织校赛，按名额推荐：命题类（1-4题）最多3支（每题限1支）、自选类最多3支、讲课类最多2支，三类合计不超过5支；命题第5题（微视频）、第6题（AI+物理实验）各1支，合计最多7支",
      "notes": "每队指导教师不超过2名；命题/自选类每队学生最多5人，讲课类不超过3人；每名学生只能参加1支队伍；多校区不同招生代码学校最多10支"
    },
    {
      "stage": "正式报名与材料上传（9月1-15日）",
      "format": "官方平台报名、上传作品材料并缴费（报名费1000元/队，含网络初评与远程答辩）",
      "notes": "曾获本竞赛二等奖以上学生、其他国家级竞赛二等奖以上作品不得参赛"
    },
    {
      "stage": "网络初评（9-10月）",
      "format": "评审专家评阅项目资料与实验视频，按百分制评审标准独立打分",
      "notes": "坚持公平、公正、科学、规范原则；10月中下旬公布初评结果与决赛通知"
    },
    {
      "stage": "全国决赛（10月-11月）",
      "format": "现场答辩（部分队伍远程答辩），展示并质询",
      "notes": "答辩后公示成绩；第十二届由哈尔滨工业大学承办，另设国际赛道（单独分组、单设获奖指标）；每届设现场展示交流环节"
    }
  ],
  "review_format": "网络初评（专家评阅报告与实验视频独立打分）+全国决赛现场答辩两阶段评奖，命题类/自选类/讲课类分别按附件评审标准评奖。",
  "judge_preferences": [
    "物理内涵优先：原理正确、数据处理规范是底线，花哨演示不能弥补科学性缺陷",
    "自选类最看重选题价值——教学体系中缺少但有推广价值的新实验",
    "视频必须真实完整可复现，反对剪辑包装",
    "命题类严格对照命题要求完成度评分",
    "讲课类看教学设计、表达与实验演示规范三位一体"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "曾获本竞赛二等奖及以上的学生不得再参赛；曾获其他国家级竞赛二等奖以上的作品不得参赛",
    "再次参赛作品须在申报时声明并明确说明改进之处，否则按违规处理",
    "讲课类获一等奖作品自获奖之日起2年内同校不得再报相同题目",
    "每生限报1队、不得跨队兼报，违规取消成绩",
    "报名费1000元/队须按时缴纳，逾期视为放弃"
  ],
