  "deliverable_requirements": [
    {
      "item": "A1设计图纸（本科组2张、专科组1张）",
      "format": "JPG，分辨率≥300dpi，横竖排版均可，须由Revit制作，含BIM节点大样图、剖视图、调研分析图、效果图等",
      "page_limit": "本科组2张A1；专科组1张A1",
      "deadline_note": "2022年为7月1日-7月31日18:00提交，截止后不可更改"
    },
    {
      "item": "辅助电子图片（效果图/现状照片/地形图各1张）",
      "format": "电子图片，建议3000×2000像素",
      "page_limit": "各1张",
      "deadline_note": "同作品提交截止"
    },
    {
      "item": "Revit模型（及当年要求的扩展数字成果）",
      "format": "Revit模型≤500M，打包为\"团队编码+模型\"；2021年另要求点云数据及可漫游VR模型",
      "page_limit": "≤500M",
      "deadline_note": "同作品提交截止；未提供BIM模型取消参赛资格（2021年）"
    },
    {
      "item": "设计说明文档",
      "format": "Word，含设计名称、学校院系、成员与指导教师信息、设计说明及经济技术指标",
      "page_limit": "未明确",
      "deadline_note": "同作品提交截止"
    }
  ],
  "process_stages": [
    {
      "stage": "公布题目与报名",
      "format": "官网（腿腿教学网guyubei.tuituisoft.com）公布年度主题，线上报名",
      "notes": "每年3月左右公布题目并启动报名，6月30日截止；主题历年各异：2021年\"空间折叠：疫情下的城市生活空间\"、2022年\"24节气——连接传统与未来的新型集市\"；有院校将其纳入三四年级课程设计或毕业设计"
    },
    {
      "stage": "作品提交",
      "format": "线上提交图纸、模型、说明文档（按命名规则打包）",
      "notes": "2022年提交期为7月1日-31日；截止后不可更改"
    },
    {
      "stage": "技术审查",
      "format": "组委会规格审查",
      "notes": "2022年为8月1日-15日；不合格者取消资格"
    },
    {
      "stage": "初审入围",
      "format": "三方协商邀请评委分组在线评审",
      "notes": "2022年为8月16日-31日；公布入围名单（第十六届入围作品曾于2023年5月公示）"
    },
    {
      "stage": "终评与答辩",
      "format": "教学指导分委员会、教授、知名建筑师、BIM专家组成评委会终评；本科组一、二等奖网络在线答辩定名次",
      "notes": "2022年终评答辩9月20日-25日（2021年为9月1日-26日，特等奖及一二等奖答辩）"
    },
    {
      "stage": "公示与颁奖",
      "format": "获奖名单公示后颁发奖金证书",
      "notes": "2021年本科组设特等奖1名（2万元）、一等奖3名（各8000元）、二等奖12名（各5000元）、三等奖34名（各1000元）、优秀奖40名、入围奖80名，另设学校组织奖；2022年本科组一等奖3名（8000元/队）、二等奖12名（5000元）、三等奖35名（1000元）"
    }
  ],
  "review_format": "年度主题制建筑设计竞赛：技术审查→专家组分组在线初评（入围制）→终评委员会（教指委专家、教授、知名建筑师、BIM专家）评审＋本科组一二等奖网络在线答辩定名次，全程匿名评审",
  "judge_preferences": [
    "切题与思辨优先：对年度主题（时空、节气、疫情空间等）的回应深度决定档次",
    "BIM硬门槛：Revit原生命图与模型深度是本届系竞赛区别于其他图面竞赛的核心特征",
    "绿色分析与可持续策略须可验证，拒绝装饰性表达",
    "关注空间的社会性与文化转译（公私权、市井生活、传统集市活力）",
    "方案可行与空间经济性并重，跨学科与新技术运用是加分方向"
  ],
  "past_winning_patterns": [
