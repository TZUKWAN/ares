{
  "competition_id": 123,
  "competition_name": "“谷雨杯”可持续建筑设计竞赛",
  "judging_dimensions": [
    {
      "dimension": "主题契合与设计理念创新",
      "weight": "定性（官方评审标准要点之首为\"符合竞赛要求\"与\"策略可行与创新\"、\"设计理念创新\"；未公布分值比例）",
      "official_wording": "2022年第十六届竞赛通知（设计竞赛网转载）：评审标准要点包括\"符合竞赛要求\"\"策略可行与创新\"\"关于公权和私权不同配比对建筑空间影响的研究与思考\"\"以数字技术思考人与社会、环境的关系\"\"表达可持续理念\"；当年主题为\"24节气——连接传统与未来的新型集市\"，要求提交\"有时空对应的设计对策\"。",
      "scoring_points": [
        "方案准确回应年度主题（如2021年\"空间折叠：疫情下的城市生活空间\"、2022年\"24节气——连接传统与未来的新型集市\"）",
        "对题眼（时空变化、行为活动与空间对应）提出针对性设计策略",
        "设计理念具有原创性与思辨性",
        "场地与建筑自选但须为真实场地并含调研分析"
      ],
      "common_deductions": [
        "方案与主题脱节、套用往届模板",
        "非真实场地或缺调研分析",
        "规模不符（本科组3000-6000㎡，专科组300-1000㎡）"
      ]
    },
    {
      "dimension": "功能、空间与使用合理性",
      "weight": "定性（官方评分参考项：\"功能符合实际需求、空间高效经济、环境舒适美观、空间灵活可变\"等；未公布分值比例）",
      "official_wording": "2022年第十六届竞赛通知评分参考项（官方转载列出十项）：\"功能符合实际需求、空间高效经济、环境舒适美观、文化内涵、新技术与多学科融合、绿色建筑分析、空间灵活可变、设计理念创新等十项\"。",
      "scoring_points": [
        "功能组织符合集市等真实使用需求",
        "空间高效经济、流线合理",
        "环境舒适美观（含物理环境考量）",
        "空间灵活可变、可应对时间性使用变化"
      ],
      "common_deductions": [
        "平面功能与概念脱节",
        "空间效率低、明显不经济",
        "仅有效果图无平立剖与节点支撑"
      ]
    },
    {
      "dimension": "可持续理念与绿色建筑分析",
      "weight": "定性（竞赛冠名\"可持续\"，官方评分参考项含\"绿色建筑分析\"\"表达可持续理念\"；未公布分值比例）",
      "official_wording": "2022年第十六届竞赛通知：评分参考项含\"绿色建筑分析\"，评审标准要点含\"表达可持续理念\"；竞赛定位为可持续建筑设计竞赛（360百科：由全国高等学校建筑学学科专业指导委员会主办、北京谷雨时代教育科技有限公司独家赞助的官方指定建筑设计类竞赛）。",
      "scoring_points": [
        "给出绿色建筑性能分析（日照、通风、能耗等）",
        "可持续策略（材料、建造、运营）与方案一体化",
        "回应气候与环境约束",
        "改建类方案体现存量资源的可持续利用"
      ],
      "common_deductions": [
        "绿色分析缺失或仅为装饰性图标",
        "可持续口号化、无设计支撑"
      ]
    },
    {
      "dimension": "文化内涵与人文思考",
      "weight": "定性（官方评分参考项含\"文化内涵\"及\"关于公权和私权不同配比对建筑空间影响的研究与思考\"；未公布分值比例）",
      "official_wording": "2022年第十六届竞赛通知：评分参考项含\"文化内涵\"；评审标准要点含\"关于公权和私权不同配比对建筑空间影响的研究与思考\"。",
      "scoring_points": [
        "对传统集市、节庆时间文化的当代转译",
        "空间社会性思考（公私权配比、市井生活）",
        "场地文脉的调研与回应"
      ],
      "common_deductions": [
