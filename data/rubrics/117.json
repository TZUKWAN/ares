{
  "competition_id": 117,
  "competition_name": "微信小程序应用开发赛",
  "judging_dimensions": [
    {
      "dimension": "创新性（创意与应用场景创新）",
      "weight": "约30%（推断：官方定位为'创新应用开发设计竞赛'，创新为首要评审取向）",
      "official_wording": "微信教育官方大赛页：'本次大赛的参赛作品应为具有适用场景和对应功能的原创性微信小程序，期望参赛队伍以微信小程序的开发技术为基础，结合实际应用需求进行创新设计与开发'。官方未公开量化分值。【推断】创新性权重约30%。",
      "scoring_points": [
        "选题创意新颖，切中真实未被满足的需求",
        "应用场景与小程序形态契合（即用即走、社交裂变、线下扫码等）",
        "功能/模式设计有独到之处，非市面同类产品复刻",
        "对微信开放能力（支付、LBS、AI、IoT等）的创新运用"
      ],
      "common_deductions": [
        "作品为模板改头换面、同质化严重",
        "创意宏大但与小程序场景不匹配（更适合App的功能）",
        "宣称原创但与已上线产品高度雷同"
      ]
    },
    {
      "dimension": "实用价值与应用前景",
      "weight": "约25%（推断：官方强调'结合实际应用需求''适用场景'）",
      "official_wording": "微信教育官方大赛页：作品应'具有适用场景和对应功能'，'结合实际应用需求'。腾讯评委关注作品的实际应用价值。【推断】权重约25%。",
      "scoring_points": [
        "解决真实痛点，目标用户明确",
        "有真实使用数据或试用反馈者更佳",
        "应用可持续运营，有推广前景",
        "兼顾社会价值（公益、校园服务等选题受青睐）"
      ],
      "common_deductions": [
        "无真实使用场景、为技术而技术",
        "目标用户空泛、需求论证缺失",
        "作品无法实际使用（只有截图演示）"
      ]
    },
    {
      "dimension": "技术实现与完成度",
      "weight": "约25%（推断：作品须为可运行的原创小程序，功能完成度是评审基础）",
      "official_wording": "官方要求作品为'对应功能的原创性微信小程序'，基于微信小程序平台开发（基于微信小程序平台的创新应用开发设计竞赛——2020大赛定义）。【推断】技术实现与完成度权重约25%。",
      "scoring_points": [
        "核心功能完整可运行、流程闭环",
        "架构与技术选型合理，代码质量好",
        "稳定性：无明显崩溃、加载异常",
        "合理运用云开发等小程序技术栈"
      ],
      "common_deductions": [
        "演示与实际提交作品不一致",
        "核心功能残缺、关键流程走不通",
        "技术含量低（纯静态页面堆砌）"
      ]
    },
    {
      "dimension": "用户体验与界面设计",
      "weight": "约10%（推断：小程序平台强调体验，腾讯产品评委视角）",
      "official_wording": "官方未列明。【推断】依据腾讯产品评审惯例及大赛'提升学生小程序设计与开发能力'的宗旨（高校通知语），体验与设计约占10%。",
      "scoring_points": [
        "界面美观、风格统一，符合WeUI设计规范",
        "交互流畅、操作路径简洁",
        "适配不同机型、异常态友好提示"
      ],
      "common_deductions": [
        "界面粗糙、交互混乱",
        "存在明显卡顿与体验硬伤",
        "未做兼容性测试"
      ]
    },
    {
      "dimension": "路演答辩与作品展示",
      "weight": "约10%（推断：赛区选拔赛组织'线上评审和答辩'、总决赛为现场路演，答辩表现计入评审）",
      "official_wording": "2022大赛开赛公告（微信公众号）：'赛区选拔赛7月1日-8月7日，各赛区组织专家进行线上评审和答辩'；电子科技大学校内赛经'初选和现场答辩'评选。总决赛为现场路演（历届2019年于广州举行）。【推断】权重约10%。",
      "scoring_points": [
        "演示流畅：现场真机演示核心场景",
        "讲清需求—方案—技术—价值主线",
        "答辩回答评委（高校专家+腾讯微信团队）提问到位",
        "团队分工与真实贡献清晰"
      ],
      "common_deductions": [
        "演示翻车、答辩答不出技术细节",
        "超时或照读PPT",
        "队员贡献失衡（搭车嫌疑）"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "原创微信小程序作品（可运行）",
      "format": "基于微信小程序平台开发的原创小程序（或小游戏赛道，二选一），在大赛官网注册提交",
      "page_limit": "不限（软件作品）",
      "deadline_note": "历届5月中旬开通提交、5月底截止（2019年为5月15日21:00-5月31日21:00）"
    },
    {
      "item": "作品介绍/说明材料与演示材料",
      "format": "作品说明文档+演示视频/PPT（以当届规程要求为准）",
      "page_limit": "未明确",
      "deadline_note": "随作品提交"
    },
    {
      "item": "决赛路演PPT与现场演示",
      "format": "现场路演答辩材料",
      "page_limit": "未明确",
      "deadline_note": "全国总决赛（历届8月）"
    },
    {
      "item": "报名组队信息",
      "format": "大赛官网（edu.weixin.qq.com/contest）注册组队",
      "page_limit": "每队最多4人，每人限1队",
      "deadline_note": "历届3月-5月中旬报名"
    }
  ],
  "process_stages": [
    {
      "stage": "报名组队",
      "format": "大赛官网注册、自由组队（个人或≤4人/队，可跨年级、跨专业、跨校组队）",
      "notes": "面向中国及境外高校在校生（本、研、高职高专）；每人只能加入一支队伍；每队限选小程序或小游戏一个类别"
    },
    {
      "stage": "作品开发与提交",
      "format": "基于微信小程序平台开发原创作品并在线提交",
      "notes": "历届5月底截止；作品须具有适用场景和对应功能"
    },
    {
      "stage": "赛区选拔赛",
      "format": "各赛区组织专家线上评审和答辩",
      "notes": "历届7月初-8月上旬；作品按统一的作品审查标准评审，遴选赛区晋级队伍"
    },
    {
      "stage": "全国总决赛",
      "format": "现场路演答辩（真机演示+评委提问）",
      "notes": "历届8月举行（2019年于广州）；高校专家与腾讯微信事业群代表联合评审；决出全国一二三等奖及大奖（2019年最高单项奖金10万元），获奖者享微信招聘绿色通道"
    }
  ],
  "review_format": "作品线上评审与赛区答辩相结合，全国总决赛以现场路演答辩评审；评委由高校专家与腾讯微信事业团队共同组成，按统一作品审查标准打分。",
  "judge_preferences": [
    "真场景真需求：能演示完整可用的小程序而非概念稿",
    "善用微信生态能力（社交传播、支付、云开发、AI接口）并有巧妙设计",
    "创新与完成度并重：评委既看创意也当场验货",
    "界面体验符合微信设计语言",
    "答辩真诚、团队真实分工（腾讯同时以赛选人，重视选手工程素养）"
  ],
