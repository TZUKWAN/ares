{
  "competition_id": 46,
  "competition_name": "交通科技大赛",
  "judging_dimensions": [
    {
      "dimension": "创新性",
      "weight": "四大评价方面之一，官方未公布分值，按同类科技作品竞赛惯例约30%【推断】",
      "official_wording": "第十九届实施方案（官网原文）：“本科生赛道作品将从创新性、专业知识综合运用、实用价值、完成度四个方面进行评价……提出具有新颖性、可行性、实用价值，具备完成度及一定难度的优化方法或解决方案”",
      "scoring_points": [
        "针对交通运输系统具体问题提出的新方法/新方案的新颖程度",
        "思路与技术路线的原创性",
        "相对现有方法/工程的改进幅度"
      ],
      "common_deductions": [
        "选题陈旧、与往届获奖作品或已参赛成果雷同",
        "将导师科研成果而非成员自身成果作为参赛作品（明令禁止）",
        "创新点与实际方案脱节"
      ]
    },
    {
      "dimension": "专业知识综合运用",
      "weight": "约25%【推断】",
      "official_wording": "同上实施方案：“针对交通运输系统中出现的具体问题，运用相关专业知识，提出……优化方法或解决方案”；研究生赛道“还需体现作品的学术性、理论方法的科学严谨性、作品方案的系统性”",
      "scoring_points": [
        "交通类专业理论方法的正确运用（交通工程、运输组织、载运工具等）",
        "建模/仿真/数据分析的科学性",
        "跨学科技术（AI、大数据、物联网）融合的合理性",
        "研究论文/报告的学术规范（研究生赛道重点考察学术性与严谨性）"
      ],
      "common_deductions": [
        "理论方法错误、数据支撑不足",
        "报告/论文结构混乱、不规范",
        "研究生赛道作品缺乏学术深度、系统性差"
      ]
    },
    {
      "dimension": "实用价值",
      "weight": "约25%【推断】",
      "official_wording": "同上实施方案将“实用价值”列为四大评价方面；作品可以是“实物模型、研究报告、设计图纸和计算机软件等”；大赛主题呼应“加快建设交通强国”",
      "scoring_points": [
        "对真实交通问题的针对性（主题响应程度，初评明确“综合考虑参赛作品对大赛主题的响应程度和作品自身质量”）",
        "方案可行性与工程落地条件",
        "经济、社会效益与推广前景",
        "实物/软件/图纸的展示效果"
      ],
      "common_deductions": [
        "选题偏离大赛主题或竞赛类内涵（视为无效作品）",
        "方案不可行、成本效益无从谈起",
        "作品与申报竞赛类内涵不符（组别以评审专家意见为准）"
      ]
    },
    {
      "dimension": "完成度",
      "weight": "约20%【推断】",
      "official_wording": "同上实施方案将“完成度”列为四大评价方面；决赛答辩要求“突出作品重点内容、可实现技术路线和创新之处”",
      "scoring_points": [
        "研究/设计/制作工作量与深度",
        "实物模型、软件或图纸的完整呈现",
        "研究报告或论文的完整性（申报材料含“参赛作品说明文档（包括论文）”）",
        "答辩中技术路线可实现性的论证质量"
      ],
      "common_deductions": [
        "作品半成品、关键环节缺失",
        "文档与实物/演示不符",
        "答辩超时（两环节共20分钟，超时停止答辩）"
      ]
    },
    {
      "dimension": "现场答辩表现",
      "weight": "决赛环节定性评分（在初评网评基础上现场公开答辩定奖级）",
      "official_wording": "第十九届实施方案：“决赛阶段：采用现场公开答辩方式进行，每一竞赛类或分赛道大约每20项作品划分一个竞赛组，由不少于5位专家组成答辩组”；“第一环节：参赛小组代表向评委介绍自己的作品……第二环节：回答评委的提问。两个环节共20分钟（第一环节不超过12分钟）”",
      "scoring_points": [
        "陈述重点突出：核心内容、可实现技术路线、创新点",
        "回答评委提问的准确性与应变",
        "团队协作与时间分配",
        "幻灯片与展示材料质量"
      ],
      "common_deductions": [
        "陈述超12分钟被叫停",
        "答非所问、核心数据不清",
        "展示材料制作粗糙"
      ]
    }
  ],
