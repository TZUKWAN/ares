  "process_stages": [
    {
      "stage": "校级选拔赛（预赛阶段）",
      "format": "各高校自行组织校赛并按名额推荐",
      "notes": "只接受高校组织推荐；每校每个竞赛类/分赛道推荐≤3件（获省级一等奖及以上可增推1件）；每作品≤5人、指导教师≤2人；推荐作品每件500元评审费"
    },
    {
      "stage": "初评（网评）",
      "format": "按竞赛类/分赛道组织专家网络函评",
      "notes": "按参赛作品数不超过20%的比例推荐进入决赛；综合主题响应程度与作品自身质量；承办高校无作品通过初评时可将其各组得分最高的限两件作品直进决赛"
    },
    {
      "stage": "决赛（现场公开答辩）",
      "format": "约每20项一组，≥5位专家答辩组（同组无同单位2人）；陈述≤12分钟+问答，共20分钟",
      "notes": "本科/研究生赛道分别评选；一等奖≤3%、二等奖≤5%、三等奖≤8%，其余决赛作品获优秀作品奖；2026年第二十一届决赛5月23-24日在北京建筑大学举行"
    }
  ],
  "review_format": "高校推荐制：初赛网评（≤20%晋级）+ 决赛现场公开答辩（5人以上专家组合议评定奖级），作品评审围绕创新性、专业知识综合运用、实用价值、完成度（研究生赛道另加学术性与严谨性）",
  "judge_preferences": [
    "选题紧扣当年大赛主题、直面交通运输真实问题",
