{
  "competition_id": 124,
  "competition_name": "UIA-霍普杯国际大学生建筑设计竞赛",
  "judging_dimensions": [
    {
      "dimension": "主题解读与概念创意",
      "weight": "定性（竞赛为评委会主席命题制，概念对题目的独特回应是评审核心；官方未公布分值权重）",
      "official_wording": "2025年题目由普利兹克奖得主刘家琨拟定：\"边边角角-未开发空间的无限可能\"，其指出\"社区里有许多边角余料，可能是一小块地，可能是一段墙\"，倡导\"个人观察、关注现实与可操作性\"；2026年题目\"何以栖居——城市、郊区与乡村\"要求\"从三种居住方式中择取其一\"（评委会主席菲利普·考克斯）。",
      "scoring_points": [
        "对主席命题的解读准确且角度独特（如2025年一等奖《首尔半地下室更新》以微小边角空间切入）",
        "概念原创、叙事清晰，避免套路化方案",
        "从题目限定的方向中做出明确选择并贯彻（2026年城郊乡三选一）",
        "问题意识与当代性（城市密度、居住方式、社区凝聚力）"
      ],
      "common_deductions": [
        "概念与题目脱节、泛化套题",
        "图面华丽但概念空洞",
        "未按题目限定（如三选一）作答"
      ]
    },
    {
      "dimension": "场所感营造与人文社会关怀",
      "weight": "定性（官方竞赛主旨：\"在破碎城市与乡村中构建具有场所感的人性化空间\"；未公布分值权重）",
      "official_wording": "UIA-霍普杯2025竞赛通知：竞赛主旨为\"在破碎城市与乡村中构建具有场所感的人性化空间、体现可持续理念、寻求适宜技术使方案可实施\"；2026年题目要求以\"村落\"理念支撑社区营造，乡村方向强调\"可持续与景观融合\"。",
      "scoring_points": [
        "空间与场地文脉、社区生活的真实关联",
        "对使用者与日常生活的细致观察（现实背景数据引用被官方建议）",
        "人性化尺度与公共空间品质",
        "社会议题（更新、密度、居住）的建设性回应"
      ],
      "common_deductions": [
        "形式游戏脱离场所与使用者",
        "缺乏现实背景支撑、自说自话",
        "对场地文脉粗暴处理"
      ]
    },
    {
      "dimension": "可持续理念与可实施性（适宜技术）",
      "weight": "定性（官方主旨要求\"体现可持续理念、寻求适宜技术使方案可实施\"；未公布分值权重）",
      "official_wording": "UIA-霍普杯2025竞赛通知：主旨含\"体现可持续理念、寻求适宜技术使方案可实施\"，并\"建议关注绿色环保理念、引用现实背景数据\"；2024年通知：\"建议关注绿色环保与新能源，鼓励新技术数据采集分析\"。",
      "scoring_points": [
        "可持续策略与建筑构思一体化（绿色环保、新能源）",
        "技术选择克制适宜、方案具有可实施性",
        "运用数据采集与分析支撑设计判断",
        "结构与建造逻辑可信"
      ],
      "common_deductions": [
        "为炫技堆砌复杂技术、不可建造",
        "可持续仅为口号或模板化分析图",
        "结构/建造逻辑明显错误"
      ]
    },
    {
      "dimension": "图面表达与视频叙事",
      "weight": "定性（提交三张A1展板＋不超过2分钟视频，视频须含轴测图、平面图、剖面图和效果图并配英文字幕；未公布分值权重）",
      "official_wording": "UIA-霍普杯2025/2026竞赛通知：\"三张A1展板，格式不限，可用平立剖面图和效果图\"；\"一段不超过2分钟的视频\"，\"视频禁止展示个人身份信息\"，需含轴测图、平面图、剖面图和效果图，\"提交作品须配英文字幕\"；\"使用AI工具生成图纸及视频须注明\"。",
      "scoring_points": [
        "三张A1版面构图、分析-平面-剖透视-效果图的叙事完整",
        "视频在2分钟内清楚呈现空间逻辑（轴测/平/剖/效果）",
        "图纸表达品质与风格自洽",
        "英文字幕与面向国际评委的表达可读性"
      ],
      "common_deductions": [
        "视频超时、缺规定视图或无英文字幕",
        "使用AI生成内容未注明（违规）",
        "版面信息过载或表达不清"
      ]
    },
    {
      "dimension": "合规与匿名",
      "weight": "定性（通过制/一票否决：身份信息、组队规则、AI使用注明等不符合者获奖后取消成绩及奖项）",
      "official_wording": "UIA-霍普杯2026竞赛通知：\"如不符合以上规则，获奖后将取消竞赛成绩及相应奖项\"；视频\"禁止展示个人身份信息\"；组队\"每组成员不超过4人\"，指导教师不超过2名且须为高校在职教师，参赛者为经教育部认证的建筑及相关专业学生（2024年通知另要求\"参赛选手所属高校不得超过两所，且作品来源为该报名院校\"）。",
      "scoring_points": [
        "参赛资格合规（建筑及相关专业在校生，含规定范围内的非全日制研究生与应届毕业生）",
        "组队人数与指导教师合规、跨校不超过两所",
        "全程匿名（展板、视频、文件命名）",
        "AI工具使用如实注明"
      ],
      "common_deductions": [
        "展板或视频出现姓名、院校等信息",
        "组队超员、跨校违规或资格不符（获奖后仍取消）",
        "AI生成未注明"
      ]
    },
    {
      "dimension": "评审会现场多轮评图",
      "weight": "定性（评委会为国内外著名建筑师与学院院长，经多轮评图与讨论投票确定获奖名单；结果公示7个工作日接受异议）",
      "official_wording": "2025年评审会报道（设计竞赛网，2025-10-27）：\"2025年10月25日在山东建筑大学举办评审会，14位国内外知名建筑师、建筑教育家担任评委，经多轮评图与讨论后确定结果\"，组委会主席孔宇航\"宣读评审规则后开始评审\"；\"获奖名单处于七个工作日的公示期，公示期内可向组委会提出异议\"。通知原文：\"竞赛评委为来自国内外的著名建筑师及学院院长\"。",
      "scoring_points": [
        "在多轮筛选中保持评委讨论关注点（概念、场所、可实施性）",
        "作品的国际可读性（评委含国际建筑师）",
        "经得起公示期异议检验的原创性"
      ],
      "common_deductions": [
        "首轮评图即因概念同质化被淘汰",
        "公示期被举报抄袭或身份违规"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "三张A1展板（设计图纸）",
      "format": "电子版，格式不限，可用平立剖面图和效果图；全程不得出现身份信息",
      "page_limit": "3张A1",
      "deadline_note": "作品提交截止2025/2026年10月10日24:00（北京时间），发至组委会邮箱uedmedia@163.com"
    },
    {
      "item": "设计视频（不超过2分钟）",
      "format": "视频含轴测图、平面图、剖面图和效果图，配英文字幕；禁止展示个人身份信息；AI生成须注明",
      "page_limit": "≤2分钟",
      "deadline_note": "同作品提交截止"
    },
    {
      "item": "报名信息",
      "format": "官网报名（hypcup.uedmagazine.net）；个人或小组（≤4人），指导教师≤2名（高校在职教师）",
      "page_limit": "不适用",
      "deadline_note": "报名截止当年9月20日24:00（北京时间）；答疑截止9月30日"
    }
  ],
  "process_stages": [
    {
      "stage": "题目发布与报名",
      "format": "评委会主席拟定题目，官网开通报名",
      "notes": "竞赛始于2012年，已办十三届以上；历届主席均为国际知名建筑师：2024年王澍（题目\"空间重构——重建城市密度\"）、2025年刘家琨（\"边边角角-未开发空间的无限可能\"）、2026年菲利普·考克斯（\"何以栖居——城市、郊区与乡村\"）；执行主席崔愷"
    },
    {
      "stage": "作品创作与提交",
      "format": "三张A1展板＋≤2分钟视频，电子版提交",
      "notes": "9月底前可向组委会答疑；10月10日24:00（北京时间）提交截止"
    },
    {
      "stage": "集中评审会",
      "format": "国际评委会现场评审（多轮评图、讨论、筛选）",
      "notes": "2025年10月25日在山东建筑大学评审，14位国内外知名建筑师、建筑教育家任评委，组委会主席孔宇航宣读评审规则；评委为国内外著名建筑师及学院院长"
    },
    {
      "stage": "公示与颁奖",
      "format": "获奖名单公示7个工作日（可提异议）后公布、颁奖",
      "notes": "2025年全球千余组报名，共评出56组获奖：一等奖1、二等奖5、三等奖12、优秀奖24、入围奖14；一等奖奖金8万元（2024年为10万元/二等奖3组各3万/三等奖6组各1万，历年金额有调整）"
    }
  ],
  "review_format": "国际主办（UIA）的年度命题制设计竞赛：普奖/大师级评委会主席命题，国内外著名建筑师与学院院长组成评委会在集中评审会上多轮匿名评图表决，获奖名单公示7个工作日接受异议",
  "judge_preferences": [
    "主席命题的解读深度与小切口观察：从日常边角、真实场所切入的概念往往胜出（2025年一等奖为首尔半地下室更新）",
    "场所感与人性化：破碎城市/乡村中重建生活意义，反对形式化炫技",
    "方案可实施性：适宜技术、可建造性是官方主旨明确要求",
    "国际表达：英文字幕视频、面向国际评委的叙事清晰度",
    "学术诚信：AI注明、匿名严格，公示期异议机制意味着违规会被追回奖项"
  ],
  "past_winning_patterns": [
    "一等奖作品常以具体而微的城市观察（半地下室、边角地、密度街区）承载大命题，图纸与视频叙事精炼（2025年一等奖由韩国汉阳大学学生获得，显示竞赛国际化竞争）",
    "获奖作品数量结构稳定为金字塔形（1+5+12+优秀奖），千余组报名中约5%获奖，概念同质化作品在首轮即被淘汰（据2025年获奖统计与多轮评审机制推断）"
  ],
  "forbidden_or_risky": [
    "展板或视频中展示姓名、院校等个人身份信息",
    "使用AI工具生成图纸及视频未注明",
    "组队超过4人、指导教师超过2名或非高校在职教师、跨校超过两所、资格不符（含非规定范围的非全日制研究生）——获奖后取消成绩及奖项",
    "抄袭、代做或重复提交往届作品",
    "错过报名（9月20日）与提交（10月10日）截止时间（北京时间24:00）"
  ],
