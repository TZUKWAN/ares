  "process_stages": [
    {
      "stage": "启动报名与项目征集",
      "format": "团中央联合部委发文，各省级团委组织征集推荐，官网报名",
      "notes": "2014年创办，每年一届；第十二届（2025）主题\"青春为中国式现代化挺膺担当\"，设科技创新、数字经济两个专项赛；第十三届（2026）设科技创新、消费新业态两个专项赛；历届曾设科技创新、乡村振兴、数字经济、社会企业等专项，赛道逐年调整"
    },
    {
      "stage": "初赛复赛（省级推荐/半决赛）",
      "format": "材料评审＋分赛道半决赛",
      "notes": "第十二届科技创新专项含\"未来产业及其他赛道\"等分赛道，2025年9月23-25日在地大（武汉）等高校举办半决赛"
    },
    {
      "stage": "全国决赛（路演答辩）",
      "format": "现场路演＋答辩，评委会评审",
      "notes": "第十二届科技创新专项决赛暨青年创新创业交流分享会2025年11月18-20日在武汉举办（共青团中央、商务部、国家卫健委、国家税务总局、湖北省人民政府主办）；数字经济专项决赛首次落地海口"
    },
    {
      "stage": "公示与授奖",
      "format": "按终评分数排名公示，接受社会质疑后确定获奖",
      "notes": "设金奖、银奖、铜奖及优秀作品奖（专项赛官网载明，名额由组委会视提交作品数调整）；违规查实取消资格并由后一位递补；同期举办青年创新创业交流分享会、实地考察等配套活动"
    }
  ],
  "review_format": "共青团中央牵头的全国性青年创新创业赛事：按年度专项赛分赛道评审，初赛材料评审＋半决赛/复赛遴选，全国决赛以现场路演答辩由评委会综合评定，结果公示接受异议、按排名递补",
