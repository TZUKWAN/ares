{
  "competition_id": 125,
  "competition_name": "“创青春”中国青年创新创业大赛",
  "judging_dimensions": [
    {
      "dimension": "创新性（项目原创性与技术含量）",
      "weight": "定性（全国赛评审综合考量因素之一；专项赛官方评审维度含\"创新性\"；分值权重未公开）",
      "official_wording": "中国青年创青春大赛文化旅游创意设计专项赛官网《评审机制》：专业初评从\"艺术水准、文化价值、创新性及实用性\"多个维度评审，\"每件作品初评专家不少于三人\"，\"取各评委打出分值的平均分作为专业初评分数\"；创青春系列赛事通行评审表述为\"评委会综合考虑项目创新性、商业性、团队表现等因素进行评审\"（同类赛事执行方案，属通行做法而非全国赛章程原文）【推断】。",
      "scoring_points": [
        "核心技术/模式的原创性与先进性（专利、软著等创新成果佐证）",
        "项目对所属赛道关键问题的突破性",
        "与国内外同类项目相比的差异化优势",
        "创新成果与产品的完成度"
      ],
      "common_deductions": [
        "项目为市场同质产品的简单复制",
        "知识产权归属不清或无自主知识产权",
        "夸大技术指标、答辩无法自证"
      ]
    },
    {
      "dimension": "商业性与可行性（市场、模式、财务）",
      "weight": "定性（全国赛评审综合考量因素之一；专项赛官方评审维度含\"实用性\"；分值权重未公开）",
      "official_wording": "专项赛官网评审机制将\"实用性\"列为四大评审维度之一；全国决赛以\"路演+答辩\"现场评审（中国青年创青春大赛系列新闻及同类赛事通行规则），商业计划书为路演基础材料。",
      "scoring_points": [
        "目标市场清晰、商业逻辑自洽",
        "盈利模式与财务预测合理",
        "项目已有落地进展（营收、订单、试点）",
        "风险识别与应对方案"
      ],
      "common_deductions": [
        "商业计划书数据虚构、前后矛盾",
        "只有概念无落地路径",
        "财务模型明显失真"
      ]
    },
    {
      "dimension": "团队表现与现场路演答辩",
      "weight": "定性（决赛以现场路演答辩定名次；团队表现为评委会综合考量因素；分值权重未公开）",
      "official_wording": "第十二届大赛（科技创新专项）决赛2025年11月18-20日在湖北武汉举办，全国决赛采取路演答辩形式（新华网湖北频道、经济日报2025年11月报道）；创青春系列赛事路演答辩通行做法为限时陈述＋评委问答。",
      "scoring_points": [
        "路演陈述的逻辑与感染力（限时）",
        "答辩中针对评委问题的准确回应",
        "团队成员分工、股权与组织结构合理",
        "项目负责人与核心成员的青年特质与执行力"
      ],
      "common_deductions": [
        "路演超时、PPT与计划书不符",
        "核心成员答辩缺位或答不上关键问题",
        "临时拼凑团队、分工虚假"
      ]
    },
    {
      "dimension": "社会价值与主题契合（赛道匹配度）",
      "weight": "定性（大赛年度主题与专项赛领域限定；专项赛官方评审维度含\"文化价值\"；分值权重未公开）",
      "official_wording": "第十二届大赛主题为\"青春为中国式现代化挺膺担当\"，\"围绕科技创新、数字经济两个领域分别举办专项赛\"（法治日报2025-07-09、科技日报2025-07-10报道，经360搜索摘要获取）；第十三届设科技创新和消费新业态两个专项赛（新华网2026-08-10）；文化旅游创意设计专项赛由共青团中央青年发展部、文化和旅游部产业发展司等主办（专项赛官网），评审维度含\"文化价值\"。",
      "scoring_points": [
        "项目与年度主题、所选专项赛领域高度契合",
        "带动就业、服务乡村振兴/区域发展等社会效益",
        "符合赛道命题导向（如科技创新专项的未来产业等分赛道）",
        "青年创业属性突出"
      ],
      "common_deductions": [
        "项目与所报赛道领域不符",
        "社会价值论述空洞",
        "赛道选择投机、跨赛道重复报名"
      ]
    },
    {
      "dimension": "资格合规与学术诚信",
      "weight": "定性（通过制/一票否决：年龄、企业注册状态分组、原创性审查，公示期异议与递补机制）",
      "official_wording": "第十二届大赛报名条件：\"年龄在40周岁（含）以下（1985年1月1日（含）以后出生）的中国公民\"（长江大学转载通知，2025-08）；专项赛官网评审机制：结果公示\"接受社会质疑\"，\"涉嫌抄袭舞弊者由组委会及评审委员会复查并通报举报人；查实后取消资格，高校选手通报其院校\"，空缺奖项\"由排名后一位的作品递补\"。",
      "scoring_points": [
        "参赛者年龄不超40周岁、为中国公民（海内外华侨青年可参赛）",
        "按初创组/成长组等组别如实报名（企业注册时间与规模符合组别定义）",
        "材料真实、项目原创无抄袭",
        "按节点在官网完成报名与材料提交"
      ],
      "common_deductions": [
        "超龄或资格造假",
        "企业注册时间与所报组别不符",
        "抄袭舞弊查实取消资格并通报院校",
        "公示期被异议查实后失去奖项"
      ]
    }
  ],
