  "process_stages": [
    {
      "stage": "报名与校级初赛（电子档评审）",
      "format": "以学校为单位组织报名，初赛以电子档设计方案和作品图片形式报送评审",
      "notes": "面向省内高校在校生（第七届另设'长江学子创意奖'面向外省和海外高校在校生作品）；历届报名约10-12月"
    },
    {
      "stage": "复赛（实物评审）",
      "format": "传统文化类、创意产品设计类须提交作品实物、样品或模型进行评审",
      "notes": "按类别分组评审，选拔进入决赛"
    },
    {
      "stage": "决赛与颁奖",
      "format": "按类别评出各单项金奖及等级奖；组委会从各单项金奖中择优评选'最具市场潜力奖''最佳创意设计奖'",
      "notes": "第七届决赛获奖名单于2021年12月底公布（长江云）；大赛由省文旅厅、省发改委、省教育厅、省人社厅、省科技厅、团省委、省妇联七部门联合主办"
    }
  ],
  "review_format": "初赛电子档网评+复赛实物评审+决赛分类别终评，按参赛类别分组、专家评委评审，组委会再从单项金奖中择优特评",
  "judge_preferences": [
    "荆楚文化辨识度：从馆藏文物、非遗中提炼元素且有当代转译",
