{
  "competition_id": 4,
  "competition_name": "ACM-ICPC",
  "judging_dimensions": [
    {
      "dimension": "解题数（通过题数）",
      "weight": "客观题：排名首要依据，按通过题数降序排名",
      "official_wording": "ICPC官方区域赛规则（icpc.global/regionals/rules）：'A team's score is determined by problems solved'——队伍成绩首先由解题数决定。",
      "scoring_points": [
        "现场5小时内通过更多题目",
        "每题仅在首次通过（AC）后计分，未通过题目不计入",
        "同一队同一题重复通过以首次为准"
      ],
      "common_deductions": [
        "算法复杂度不达标导致TLE（超时）不算通过",
        "内存超限MLE、答案错误WA均不计分",
        "罚时策略失当导致同分排序落后"
      ]
    },
    {
      "dimension": "总用时（含罚时）",
      "weight": "客观题：解题数相同则按总用时升序排名；每题用时=开赛至首次AC的经过时间+每次被拒提交罚20分钟（编译错误不计罚时）",
      "official_wording": "ICPC官方区域赛规则：'The time consumed for a solved problem is the time elapsed from the beginning of the contest to the submission of the first accepted run plus 20 penalty minutes for every rejected run for that problem'（每题首次通过用时+每次被拒提交20分钟罚时）；2024-2025赛季规则（ICPC/UCup）：编译错误不加罚时，总罚时为各已通过题罚时之和。",
      "scoring_points": [
        "一次性AC可零罚时通过，控制错误提交次数",
        "罚时只对最终通过的题目累计",
        "同分情况下总用时少者排名靠前"
      ],
      "common_deductions": [
        "频繁暴力提交试错，单题累积大量20分钟罚时",
        "编译错误虽不罚时但浪费时间成本"
      ]
    },
    {
      "dimension": "并列裁定",
      "weight": "客观题：解题数与总用时均相同时，以最后一次通过提交的时间更早者列前",
      "official_wording": "ICPC通行排名规则（各区域赛规则一致采用）：以过题数、总罚时之后，比较最后通过题目的最早提交时间【推断：为ICPC各区域通行细则，未逐字核对全部站点原文】。",
      "scoring_points": [
        "奖牌线与晋级线上的同分队伍按此裁定",
        "队长需掌握实时榜单进行终盘决策"
      ],
      "common_deductions": [
        "终盘盲目开难题不交，丢掉并列裁定优势"
      ]
    },
    {
      "dimension": "奖牌线（金银铜）",
      "weight": "通过制：区域赛金/银/铜奖大致按参赛队数的约10%/20%/30%比例授予（亚洲区域赛通行做法；EC-Final 2024金28/银56/铜84，恰为10%/20%/30%），其余为优胜奖（Honorable Mention）",
      "official_wording": "亚洲区域赛与EC-Final通行奖牌比例约10%/20%/30%（知乎参赛者统计与赛事新闻交叉验证）；具体各站奖牌数以当站竞赛手册为准【推断：官方未在公开页固定死比例，个别站点微调】。",
      "scoring_points": [
        "达到金线（如名次进入前约10%）即区域赛金奖",
        "中国区站点竞争激烈，金线过题数逐年水涨船高（如部分站点金线8-10题）"
      ],
      "common_deductions": [
        "同校多队受名额限制（可行性裁定）影响奖牌归属"
      ]
    },
    {
      "dimension": "晋级通道",
      "weight": "通过制：区域赛前列队伍晋级洲际决赛（亚洲为EC-Final），EC-Final优胜队伍晋级World Finals（2024年中国区每站点约38个EC-Final晋级名额；WF获奖校晋级名额上限5、其他学校3）",
      "official_wording": "知乎对2024 ICPC EC-Final的名额统计：'每个赛站38个名额，WF学校晋级名额上限为5，其他为3，不含贡献名额和邀请赛名额'【推断：为社区统计的当年执行口径，非官方章程原文】。",
      "scoring_points": [
        "区域赛奖牌/名次决定EC-Final资格",
        "EC-Final名次决定World Finals出线权"
      ],
      "common_deductions": [
        "校际名额限制：同校多队强队可能因名额分配无法全部晋级"
      ]
    }
  ],
