{
  "competition_id": 35,
  "competition_name": "RAICOM睿抗",
  "judging_dimensions": [
    {
      "dimension": "赛项任务完成与竞技结果",
      "weight": "竞技类赛项按结果评分法计分数，结果分占总成绩100%（赛项规则内再分任务项）",
      "official_wording": "睿抗组委会赛项规则（官方OSS文件）：\"赛项评分采用结果评分方法，结果评分是依据赛项评分标准，对参赛选手提交的比赛结果进行评分\"；具身智能光学动捕挑战赛规则：\"每个参赛队均有两次全流程比赛机会，两次成绩取最高分为最终结果\"",
      "scoring_points": [
        "按赛项评分标准逐任务给分（如识别目标数、完成任务数、用时排名）",
        "两次比赛机会取最高分（以各赛项规则为准）",
        "完成全部规定动作且无犯规",
        "任务精度与稳定性（次数、成功率）"
      ],
      "common_deductions": [
        "犯规动作、出界、碰倒障碍按规则扣分",
        "超时或未完成任务不得该项分数",
        "调试期间违规接触设备被记违规"
      ]
    },
    {
      "dimension": "设计说明与方案文档",
      "weight": "创新设计类赛项设计说明占40%（40分）",
      "official_wording": "《2024睿抗机器人开发者大赛创新设计赛项评分表》（组委会官方文件）：\"设计说明得分情况（40%，40分）\"，按评分项和分数占比逐项打分",
      "scoring_points": [
        "设计方案对需求与场景的阐述完整性",
        "系统结构、机械/电控/算法方案的合理性",
        "图纸、三维模型等技术文档规范性",
        "创新点提炼清晰"
      ],
      "common_deductions": [
        "文档缺失或与作品实际不符",
        "方案描述空泛无技术细节",
        "图纸不规范、无创新点说明"
      ]
    },
    {
      "dimension": "作品完成度与演示答辩",
      "weight": "约60%（创新/设计类赛项设计说明40%以外的部分，按各赛项评审办法）【推断】",
      "official_wording": "CAIM机器人创新应用仿真设计赛项考核内容为\"场景搭建、机器人编程、PLC控制与系统联调、功能演示与答辩路演\"（承办校赛事报道与赛项介绍综合）；省赛规则：\"决赛作品进行评审，并对一等奖作品进行现场答辩、展示\"（渤海大学辽宁省赛通知）。权重为依据上述内容的推断",
      "scoring_points": [
        "作品/仿真场景搭建完整、系统联调可运行",
        "现场功能演示流畅、达到赛项任务书要求",
        "答辩表述清晰、回答准确",
        "编程与调试过程体现工程能力"
      ],
      "common_deductions": [
        "演示时功能无法复现",
        "答辩与作品内容脱节、非本人完成痕迹明显",
        "超时未完成联调"
      ]
    },
    {
      "dimension": "违规与安全扣分",
      "weight": "按赛项规则从总分中扣除相应分数，不单独设权重",
      "official_wording": "组委会省赛规程：\"0分和弃赛者不计入总数\"\"国赛根据评审得分从高到低排名，0分不得获奖\"（奖项条款隐含违规即0分的执行口径）",
      "scoring_points": [
        "遵守比赛流程与检录纪律",
        "设备操作安全规范（无人机、机械臂类尤其）",
        "未使用违规器材或代操作"
      ],
      "common_deductions": [
        "迟到弃赛按0分处理",
        "违反安全操作被中止比赛",
        "冒名顶替或器材违规取消成绩"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "赛项比赛任务成果（竞技类）",
      "format": "现场实机/仿真任务完成结果，由裁判按赛项评分标准记录",
      "page_limit": "未明确",
      "deadline_note": "省赛（预选赛，约5-7月）与国赛（约8月起分阶段）赛程当日"
    },
    {
      "item": "设计说明文档（创新设计类赛项）",
      "format": "赛项规定模板的申报书/设计说明（含图纸、三维模型、创新点说明）",
      "page_limit": "未明确",
      "deadline_note": "按赛项通知规定的提交截止时间（多为赛前线上提交）"
    },
    {
      "item": "线上测试赛作品（部分赛项）",
      "format": "按赛项要求通过指定链接（如金数据表单）提交程序/作品包，比赛环境自行配置",
      "page_limit": "未明确",
      "deadline_note": "预选赛规定截止时间（如智能侦察等线上测试赛）"
    }
  ],
  "process_stages": [
    {
      "stage": "校赛/报名（约3-5月）",
      "format": "校级组织报名与选拔，部分高校举办校赛",
      "notes": "经高校教务/双创学院统一组织报名，赛道四选一：CAIR工程竞技、CAIM工程创客、CAIA数字文化创意、CAIP信息技术创新"
    },
    {
      "stage": "省赛/预选赛（约5-7月）",
      "format": "现场竞技或线上测试赛（视赛项而定），按赛项评分标准评判",
      "notes": "省赛一、二、三等奖比例不超过15%、25%、40%（0分与弃赛不计入）；一、二等奖队伍获国赛资格"
    },
    {
      "stage": "全国总决赛（约8月起分阶段举办）",
      "format": "按评审得分从高到低排名；设计类赛项对作品评审并对一等奖作品现场答辩展示",
      "notes": "国赛一、二、三等奖比例约10%、15%、20%；往届国赛一等奖作品不得再报同赛道"
    }
  ],
  "review_format": "按赛道/赛项分规则评审：竞技类赛项采用结果评分法按任务得分排名，创新设计类赛项按设计说明（40%）+作品演示与答辩评审，省赛一二等奖晋级国赛。",
  "judge_preferences": [
    "竞技类赛项一切以任务结果说话，稳定性和成功率重于花哨方案",
    "设计类赛项看重设计说明的完整规范与创新点提炼",
    "现场演示必须真实可复现，答辩须由队员本人完成",
    "严格遵守赛项器材、环境与流程规定"
  ],
