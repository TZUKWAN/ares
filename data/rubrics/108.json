{
  "competition_id": 108,
  "competition_name": "焊接创新大赛",
  "judging_dimensions": [
    {
      "dimension": "方案设计创新",
      "weight": "国赛评价标准六维度之一（定性打分，权重未公开）；校赛引用国赛标准时列为首位评分项【推断：与结构承载能力、完成度、正确性、实用价值、答辩协作等并列计分】",
      "official_wording": "西南交通大学材料学院校级选拔赛新闻（明确采用国赛评价标准）原文：评委团'采用国赛评价标准，对……6支决赛队伍在\"方案设计创新\"、\"结构件的承载能力及承载力质量比\"、\"完成的完整程度\"、\"结果正确与否\"、\"工程实用价值\"、\"答辩表现和团队协作\"等方面进行提问和评分'。首届大赛章程性表述（360百科词条）：作品内容以焊接相关领域创新性研究及想法为主，'重点考察作品创新思想和学生实际动手能力'。",
      "scoring_points": [
        "焊接结构/工艺方案的新颖性：新方法、新工艺、新材料、新工装或新测试方法（首届章程界定的创新范围）",
        "方案的理论依据与文献支撑（校赛答辩中'阅读大量文献资料和前沿技术，参考国内外先进焊接技术'为佳）",
        "设计建模与计算（结构形式、焊缝布置、材料选型）科学合理",
        "自主探索与原创呈现（'方案设计和实施中的自主探索呈现及创新能力'）"
      ],
      "common_deductions": [
        "方案照搬成熟结构、无自主设计成分",
        "理论依据错误或计算与实际脱节",
        "选题超出组委会公布的固定命题/自选类项目范围"
      ]
    },
    {
      "dimension": "作品实现：结构件承载能力及承载力质量比、完成度与结果正确性",
      "weight": "国赛评价标准六维度之一（定性打分+实测硬指标计入总分，权重未公开）；承载力质量比为区分度主项【推断：按固定命题要求制作焊接结构件并进行承载测试，成绩由实测数据决定】",
      "official_wording": "西南交通大学（采用国赛评价标准）原文评分维度：'结构件的承载能力及承载力质量比'、'完成的完整程度'、'结果正确与否'。河北工程大学校赛通知原文：竞赛含'固定命题创新作品'与'自选题目创新作品'2个类别，'参赛学生从赛事组委会公布的题目中选题，按要求提交作品'。",
      "scoring_points": [
        "结构件极限承载能力（实测载荷值）",
        "承载力质量比（轻量化设计水平，同等承载下质量越轻越优）",
        "作品完成完整程度：按命题要求全部功能/工序完成",
        "结果正确与否：实测表现与设计预期的吻合度",
        "焊接质量：焊缝成形、变形与缺陷控制"
      ],
      "common_deductions": [
        "加载测试中结构件早期失效（焊缝开裂、变形失稳）",
        "超重/超尺寸违反命题约束",
        "未完成全部制作工序或提交半成品",
        "实测结果与设计方案严重偏离且无法解释"
      ]
    },
    {
      "dimension": "工程实用价值",
      "weight": "国赛评价标准六维度之一（定性打分，权重未公开）【推断：与其他维度并列计分】",
      "official_wording": "西南交通大学（采用国赛评价标准）原文评分维度：'工程实用价值'；湖北汽车工业学院新闻表述大赛宗旨为'培养学生的创新意识和理念，提高学生的创新能力，强化学生的团队精神'（河北工程大学通知同款表述）。",
      "scoring_points": [
        "作品面向焊接工程实际需求（结构连接、产线工艺、装备改进等）",
        "成本、工艺可行性与可推广性",
        "对焊接生产效率、质量或安全的改进效果",
        "与行业前沿需求（轻量化、智能制造、绿色焊接）结合度"
      ],
      "common_deductions": [
        "作品仅为实验室演示、无工程应用场景",
        "成本或工艺可行性论证缺失",
        "实用价值夸大、无数据支撑"
      ]
    },
    {
      "dimension": "答辩表现和团队协作",
      "weight": "国赛评价标准六维度之一（定性打分，权重未公开）；校赛至国赛均设现场答辩环节【推断：答辩为展示与问询定分环节】",
      "official_wording": "西南交通大学（采用国赛评价标准）原文评分维度：'答辩表现和团队协作'；湖北汽车工业学院校赛新闻原文：'答辩会上，参赛团队通过PPT的形式展示自己的设计方案……学生和老师们就作品设计和专业知识进行了交流与探讨'。",
      "scoring_points": [
        "PPT展示逻辑：设计方案、制作过程、实测结果的完整呈现",
        "回答评委专业问题准确（焊接冶金、工艺参数、结构力学）",
        "团队分工均衡、协作顺畅（每队不超过4名学生，鼓励跨专业、跨年级组队）",
        "时间控制与展示效果"
      ],
      "common_deductions": [
        "答辩与提交材料矛盾、关键问题无人能答",
        "展示超时或重点不清",
        "团队分工失衡、单人包办"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "固定命题创新作品",
      "format": "从赛事组委会公布的固定命题中选题，按要求制作焊接结构件/作品并提交（承载测试类命题含实测环节）",
      "page_limit": "未明确",
      "deadline_note": "按当届通知：河北工程大学校赛报名截止2023-04-25、竞赛4月26-30日；全国赛时间以当届比赛通知为准（历届多在年中）"
    },
    {
      "item": "自选题目创新作品",
      "format": "从组委会公布的自选类项目中选题，提交创新作品（新方法、新工艺、新材料、焊接应力变形控制、测试分析、新型焊接电源及辅机、工装夹具等方向）",
      "page_limit": "未明确",
      "deadline_note": "与固定命题同期提交；国赛阶段通常需现场答辩（PPT展示）"
    },
    {
      "item": "报名表",
      "format": "以队为单位报名，每队不超过4名学生（鼓励跨专业、跨年级组队），每名学生限参加1支参赛队",
      "page_limit": "未明确",
      "deadline_note": "校级选拔赛先行，获奖团队择优推荐参加全国大赛"
    }
  ],
  "process_stages": [
    {
      "stage": "校内选拔赛",
      "format": "各高校自行组织（答辩会形式，PPT展示设计方案），择优推荐参加全国大赛",
      "notes": "西南交大校级决赛采用国赛评价标准评分；河北工程大学规定无特殊情况拒不参加全国大赛的团队取消校赛资格及奖励荣誉"
    },
    {
      "stage": "全国大赛（作品评审与答辩）",
      "format": "分固定命题创新作品与自选题目创新作品两类；评委按国赛评价标准对方案设计创新、承载能力及承载力质量比、完成度、结果正确性、工程实用价值、答辩表现和团队协作进行提问和评分",
      "notes": "大赛由中国机械工业教育协会焊接学科教学委员会、中国机械工程学会焊接分会（学会）与哈尔滨工业大学先进焊接与连接国家重点实验室共同发起和主办，面向焊接技术与工程、材料成型及控制工程及相关专业"
    },
    {
      "stage": "评奖与教学研讨",
      "format": "评全国一、二、三等奖；同期常伴随焊接技术与工程专业教学研讨会（第八届）",
      "notes": "首届2010年11月在南昌航空大学举行（17所高校48位选手）；历届获奖如湖北汽车工业学院第三届获2项全国一等奖、1项二等奖、1项三等奖"
    }
  ],
  "review_format": "作品提交+现场答辩制：评委团按国赛评价标准对方案创新、结构件承载实测（承载力质量比）、完成度与结果正确性、工程实用价值、答辩表现与团队协作六方面提问评分，总分排序评奖。",
  "judge_preferences": [
    "创新思想与实际动手能力并重（首届章程即明确'重点考察作品创新思想和学生实际动手能力'）",
    "承载力质量比等硬指标实测说话，轻量化设计水平是固定命题的区分度所在",
    "重视工程实用价值与行业前沿结合（轻量化、先进焊接技术自主可控）",
    "答辩中体现扎实的焊接冶金与工艺专业知识",
    "团队协作与跨专业组队受鼓励"
  ],
