{
  "competition_id": 119,
  "competition_name": "CAR-ASHRAE学生设计竞赛",
  "judging_dimensions": [
    {
      "dimension": "负荷计算的合理性（设计说明书部分）",
      "weight": "说明书内20分，折合总分12%（作品最终成绩=设计说明书×60%+图纸×40%）",
      "official_wording": "官方《初审说明》（2026年通知附件3竞赛制度文件4.1）：\"对'项目说明'部分的主要考察点如下：合计100分 1.负荷计算的合理性 20分 其中：冷、热负荷计算过程准确无误 15分 用手算法计算负荷 5分\"。",
      "scoring_points": [
        "冷、热负荷计算过程准确无误（15分）",
        "用手算法（手工计算）完成负荷计算（5分）",
        "计算参数与依据符合现行标准规范，输入参数设定交代清楚",
        "给出代表性房间冬夏季负荷计算过程及结果分析，其余房间以表格给出",
        "采用负荷软件时给出全年逐时负荷分析"
      ],
      "common_deductions": [
        "参数取值引用教科书或手册而非现行标准规范",
        "计算过程跳步、结果与输入参数对不上",
        "缺少手算内容或计算书附件缺失"
      ]
    },
    {
      "dimension": "空调方案与设备选型、系统设计的合理性",
      "weight": "说明书内40分（空调方案20分＋设备选型与系统设计20分），折合总分24%",
      "official_wording": "官方《初审说明》：\"2.空调方案的合理性 20分 3.设备选型和系统设计的合理性 20分 其中：设备选型合理经济 10分 系统设计合理 10分\"。",
      "scoring_points": [
        "空调系统分区合理，风量计算完整（新风/送风/回风/排风）",
        "冬夏季空气处理方案的热湿处理计算正确",
        "冷热源形式比较与选型经济合理（含冷却水设计）",
        "水系统设计与水泵选型合理（建议画水压图，给全系统原理图）",
        "末端装置形式与气流组织形式选择得当"
      ],
      "common_deductions": [
        "方案与目标建筑特点脱节（通用化套图）",
        "机房/管井未尽量采用给定位置且未说明调整理由",
        "设备选型过大或过小、缺经济性比较"
      ]
    },
    {
      "dimension": "自动控制系统及全年运行方案的合理性",
      "weight": "说明书内10分，折合总分6%",
      "official_wording": "官方《初审说明》：\"4.自动控制系统及全年运行方案的合理性 10分\"；设计说明：\"自控系统：包括控制系统的设计原理及运行策略……应该提供有效的全年运行策略说明\"。",
      "scoring_points": [
        "给出主要传感器和执行器的原理位置",
        "给出全年负荷变化时的控制逻辑",
        "制冷、采暖和通风作为整体设计，提供有效的全年运行策略",
        "室外气象与室内负荷变化时冷热源和主要设备的调节策略"
      ],
      "common_deductions": [
        "只画控制原理图、无全年运行策略说明",
        "自控内容与系统方案不一致"
      ]
    },
    {
      "dimension": "节能技术应用的合理性与报告总体质量",
      "weight": "说明书内20分（节能技术要素10分＋报告总体质量10分），折合总分12%",
      "official_wording": "官方《初审说明》：\"5.节能技术应用的合理性 20分 其中：突出节能技术要素 10分 报告总体质量 10分\"；设计说明：\"在满足建筑功能要求的条件下，提倡节能、节资、节地、节材，体现设计的合理性、适用性、经济性和创造性\"。",
      "scoring_points": [
        "节能技术选用的针对性与合理性（结合气候区与建筑功能）",
        "可再生能源的就地利用（题目允许范围内的唯一额外能源）",
        "对节能减排的综合考虑",
        "说明书结构完整、图表清晰、数据准确、结论合理",
        "按要求附\"设计要点汇总表\"且与正文一致"
      ],
      "common_deductions": [
        "节能技术堆砌、与建筑特点无关",
        "缺设计要点汇总表或汇总表与正文数据不一致",
        "报告格式混乱、数据前后矛盾"
      ]
    },
    {
      "dimension": "创新性和特色（含额外加分）",
      "weight": "说明书内10分，折合总分6%；另有1~10分额外加分空间",
      "official_wording": "官方《初审说明》：\"6.创新性和特色10分 7.设计中如有额外内容（如对气流组织进行软件模拟，以验证设计的合理性），可考虑酌情加分\"；\"加分额度控制在1~10分\"。",
      "scoring_points": [
        "方案在某一方面非常有特色而单项分未能体现",
        "额外内容如气流组织软件模拟验证设计合理性",
        "新技术应用的深度（非罗列）",
        "项目特色及自我评价章节的诚实与深度"
      ],
      "common_deductions": [
        "创新点与主体设计脱节、为创新而创新",
        "仅罗列新技术名词无设计落地"
      ]
    },
    {
      "dimension": "图纸评审（独立100分制）",
      "weight": "折合总分40%（图纸规范表达40分＋设备与系统布置合理40分＋图纸质量20分，图纸内合计100分）",
      "official_wording": "官方《初审说明》：\"对'图纸'部分的主要考察点如下：合计100分 1.图纸设计是否规范，表达是否清楚 40分 2.设备和系统布置是否合理 40分 3.图纸质量 20分 作品最终成绩='项目说明'成绩*60%+'图纸'成绩*40%\"。",
      "scoring_points": [
        "递交能完整表达设计内容的6-8张标准张图纸（A1或A2打印）",
        "含图纸目录/图例/主要设备材料表、典型风系统水系统平面图及剖面图、典型机房平剖面图、水系统原理图、自控控制原理图",
        "典型空间、冷热源、水系统和控制原理的表达深度",
        "图纸与设计说明书内容一致",
        "同类图纸只交代表性1张、严格控制张数"
      ],
      "common_deductions": [
        "图纸数量少于规定要求（适当扣除图纸得分）",
        "同类图纸重复罗列、数量多并不增加得分",
        "图面不规范、信息栏出现身份信息"
      ]
    },
    {
      "dimension": "复审会审（工程设计基本概念）与答辩表现",
      "weight": "定性（复审会在作品整体水平上重点考察工程设计基本概念并选出前7名；答辩为补充环节，最终名次主要基于初审、复审意见参考答辩表现确定）",
      "official_wording": "官方《评审流程》：\"复审采取会审的形式，在审查作品整体设计水平的基础上，重点考察参赛团队是否具有基本的工程设计概念\"；\"答辩环节是对'初审'和'复审'环节的补充。前7名团队的最终名次，主要在'初审'及'复审'意见的基础上，参考答辩环节的相关表现来确定\"。",
      "scoring_points": [
        "是否建立工程设计的基本概念、作品是否符合工程设计基本要求",
        "PPT宣讲（20分钟，中文）准确反映设计工作量、内容、特色、创新性、团队合作、对标准规范的理解",
        "问答环节回答准确、清晰、简洁，熟悉团队全部主要工作",
        "答辩代表必须为进行竞赛设计时的本科生"
      ],
      "common_deductions": [
        "以\"不是自己承担的工作\"为由答不上团队其他成员的工作",
        "答问离题或偷换概念",
        "宣讲超时（第18分钟提醒）"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "设计说明书（含计算书作附件）",
      "format": "按本校毕业设计格式，A4双面打印装订成册，最前附\"设计要点汇总表\"；纸质版2份＋电子版PDF（内容与纸质一致）",
      "page_limit": "未明确页数上限（内容须涵盖建筑概况、负荷计算、系统分区与风量、冬夏处理方案、冷热源与水系统、特殊区域供暖通风、自控与全年运行调节、项目特色与自评）",
      "deadline_note": "按当年竞赛通知规定截止时间前寄出（快递邮寄至中国制冷学会）"
    },
    {
      "item": "图纸",
      "format": "6-8张标准张，A1或A2打印；纸质版1份＋电子版PDF和CAD各一份；图纸目录/图例/设备材料表1张（≤2张）、典型风/水系统平面图及剖面图2张、机房平剖面2张、水系统原理图1张、自控原理图1张等",
      "page_limit": "6-8张标准张",
      "deadline_note": "同说明书，随作品包一并寄出"
    },
    {
      "item": "计算书",
      "format": "电子版PDF（不提交纸质版），含计算方法、理论公式/软件、输入参数与详细结果",
      "page_limit": "未明确（要求尽可能详细）",
      "deadline_note": "随电子版作品（光碟，根目录文件夹以学校名命名）一并提交"
    },
    {
      "item": "调研报告（如当年题目要求）",
      "format": "A4双面打印独立装订成册，纸质版2份＋电子版PDF",
      "page_limit": "未明确",
      "deadline_note": "随作品包一并提交"
    }
  ],
  "process_stages": [
    {
      "stage": "命题与发布",
      "format": "组委会命题、分区轮流推荐",
      "notes": "官方《命题说明》：每年9月30日前完成下一年度命题、10月31日前完成审题、11月中旬公布题目；2026年竞赛通知于2025-10-13在中国制冷学会官网发布并附题目；赛题为公共建筑（面积约2万m²、1.5-2.5万m²），所在地区须同时有供冷供热需求，如2025年赛题为\"上海市某美术馆建筑暖通空调工程设计\""
    },
    {
      "stage": "报名组队",
      "format": "网上报名（竞赛官网），以学校为单位推荐",
      "notes": "团队≤4人，最多1名全日制在读硕/博研究生（须无相关执业经历）；团队负责人、主要工作完成人、答辩代表、领奖代表必须为全日制在读本科生；参赛者不超过28岁；资格由推荐学校核定"
    },
    {
      "stage": "设计制作与提交",
      "format": "按题目完成暖通空调系统设计，截止前快递寄出纸质版并提交电子版光碟",
      "notes": "往届报名截止约5月31日（2021年通知）；设计限定：建筑地点和功能不能改变，除就地可再生能源外不得采用题目未提供的能源；须符合现行标准规范"
    },
    {
      "stage": "初审",
      "format": "高校相关专业教师按官方评分表背对背打分",
      "notes": "按\"项目说明100分＋图纸100分\"评分（最终成绩=说明×60%+图纸×40%），选出若干份优秀作品入围复审并撰写主要优缺点评述；有大的原则性错误的作品排名不宜在前三分之一"
    },
    {
      "stage": "复审",
      "format": "9-12名高校及设计院专家会审",
      "notes": "在审查作品整体设计水平基础上重点考察工程设计基本概念；评出前7名进入答辩，其余入围作品获三等奖；复审结果与专家名单同时公布"
    },
    {
      "stage": "决赛答辩",
      "format": "现场公开答辩（前7名团队各派1名本科生代表）",
      "notes": "PPT宣讲20分钟＋问答不超过20分钟；评委由高校专家1人＋设计院专家4人组成；2025年决赛答辩于12月4日在无锡举行并全程公开直播"
    },
    {
      "stage": "授奖",
      "format": "设特等奖/一等奖/二等奖/三等奖（按最终名次）",
      "notes": "特等奖为全国第一名；特等奖团队赴美国参加ASHRAE冬季年会领奖（2025届于2026年1月31日-2月4日赴拉斯维加斯）；各等次具体名额官方未公开【推断：7支答辩队伍角逐特等/一等/二等奖，复审未进前7的入围作品为三等奖】"
    }
  ],
  "review_format": "三级评审：初审（高校教师按官方评分表打分，作品最终成绩=设计说明书×60%＋图纸×40%）→复审（专家会审选出前7名，其余为三等奖）→现场公开答辩（补充环节，确定前7名最终名次）；作品全程匿名评审",
  "judge_preferences": [
    "重点考察\"工程设计的基本概念\"：方案针对目标建筑特点、参数严格依据现行标准规范而非教科书手册",
    "制冷、采暖、通风整体设计并给出有效全年运行策略，自控逻辑与负荷变化对应",
    "图纸宁精勿多：符合类型要求、有代表性，数量多不加分、少于要求扣分，图纸与报告须一致",
    "创新性为加分项而非主体（额外加分1~10分），基础扎实、计算准确优先",
    "存在大的原则性错误（方案性错误）的作品名次难以进入前列"
  ],
  "past_winning_patterns": [
    "特等奖作品在负荷计算（含手算校核）、系统方案、自控与全年运行策略等各单项均衡无明显短板，并有气流组织模拟等加分性额外内容（据官方评审机制与历届答辩表现推断）",
    "获奖团队答辩代表对团队全部工作（含他人承担部分）熟悉，能针对提问准确简洁作答（官方答辩说明导向）"
  ],
  "forbidden_or_risky": [
    "纸质版与电子版材料中（封面除外）任何地方出现学校名称、学院、指导教师或学生姓名等身份信息，包括照片中出现人员、图纸信息栏、调研报告中出现真实校名——取消竞赛成绩",
    "改变建筑地点和功能，或采用建筑介绍中未提供的能源与资源（就地可再生能源除外）",
    "未在截止时间前寄出、未使用快递邮寄，或电子版未按规定目录结构刻录",
    "学籍身份造假：参赛者超28岁、负责人/答辩代表非在读本科生、研究生超1名或有执业经历等，取消团队资格或收回奖励；学校提供不实证明则该校禁赛三年",
    "作品设计违反现行标准规范、或抄袭他人作品"
  ],
