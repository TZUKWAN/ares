{
  "competition_id": 45,
  "competition_name": "中国机器人及人工智能大赛",
  "judging_dimensions": [
    {
      "dimension": "技术先进性（创新赛类作品评审）",
      "weight": "40%（参照第二十八届承办校校赛通知所列“各类比赛评审标准：技术先进性40%”，国赛细则按各赛项规则另发）【推断】",
      "official_wording": "组委会通知：“比赛规则另行通知”；开封文化艺术职业学院第二十八届大赛通知：“各类比赛评审标准：技术先进性（40%）、创新性（30%）、实用性（20%）、答辩表现（10%）”。该百分制为承办校执行标准，组委会未公开发布统一国赛评分表，权重按此参照推断",
      "scoring_points": [
        "机器人本体/算法的技术难度与先进性（视觉感知、运动控制、规划决策等）",
        "系统集成度与运行稳定性",
        "关键指标性能（定位精度、识别率、任务速度等）实测数据",
        "ROS/仿真/实车等平台技术实现的规范性"
      ],
      "common_deductions": [
        "核心模块依赖采购套件且无二次开发",
        "演示与申报技术指标不符",
        "关键技术路线讲不清、答辩露怯"
      ]
    },
    {
      "dimension": "创新性与实用性（创新赛类作品评审）",
      "weight": "创新性30%＋实用性20%（同上承办校执行标准）【推断】",
      "official_wording": "组委会通知设置“创新赛（机器人创新赛、人工智能创新赛、智能文化创意创新赛、智能制造数字孪生创新赛、智能家电创新赛等）”，大赛宗旨为“引导和激励广大青年学生弘扬创新精神……推动‘人工智能+’‘机器人+’新经济产业体系建设”",
      "scoring_points": [
        "选题新颖性、方案独创性（相对已有产品/文献）",
        "应用场景真实需求与推广价值",
        "功能完整性与实用效果",
        "智能文化创意/数字孪生类：文化创意内涵与数字化表达质量"
      ],
      "common_deductions": [
        "选题陈旧、与市面产品雷同",
        "场景空想、无实际应用价值",
        "文化类赛项文化内涵牵强"
      ]
    },
    {
      "dimension": "答辩表现（创新赛类）",
      "weight": "10%（同上承办校执行标准）【推断】",
      "official_wording": "开封文化艺术职业学院第二十八届通知：“答辩表现（10%）”；全国赛采用现场演示与答辩评审（总决赛通知按赛项组织）",
      "scoring_points": [
        "陈述逻辑、PPT/视频质量与时间控制",
        "回答评委质询的准确性与深度",
        "团队分工表述与协作风貌"
      ],
      "common_deductions": [
        "超时、念稿",
        "对评委指出的缺陷无法回应",
        "答辩内容与提交材料矛盾"
      ]
    },
    {
      "dimension": "任务完成成绩（应用赛/竞技赛/挑战赛类客观评分）",
      "weight": "客观成绩排名制：按赛项规则规定的任务得分、用时、对抗胜负等折算分数（现场比赛成绩排名）",
      "official_wording": "组委会通知比赛项目：应用赛含Apollo自动驾驶仿真/实车、城市道路识别、智慧巡检、智能驾驶、授粉、智能家居服务、智慧零售等；竞技赛含Simuro足球、格斗、仿人短跑/障碍跑/点球等；挑战赛含人形机器人创新挑战赛、无人机空地协同、四足仿生、智慧药房等；“比赛规则另行通知”。安徽工程大学教务处转发竞赛规则：“决赛总成绩相同的参赛队按现场决赛成绩排名，仍相同则抽签决定”",
      "scoring_points": [
        "任务完成度（得分点逐项计分）",
        "完成用时/竞速名次",
        "对抗类：小组循环赛、淘汰赛胜负与进球/得分",
        "自主运行程度（减少人工干预加分，违规干预扣分）",
        "多轮一致性（不同轮次成绩累计）"
      ],
      "common_deductions": [
        "任务失败、超时未完成",
        "人工遥控/违规干预被扣分或判负",
        "场地适应差、设备故障退赛"
      ]
    },
    {
      "dimension": "规则合规与赛场纪律",
      "weight": "否决性条件，不计分数（违规取消成绩/资格）",
      "official_wording": "组委会通知：“同一赛项，参赛学校（不含分校）进入国赛队伍不能超过3支（含3支），创新类赛项除外”；“报名系统关闭后，将不再接受信息更改”",
      "scoring_points": [
        "机器人尺寸、重量、电源、传感器符合赛项规则",
        "报名信息真实、不超限项",
        "服从裁判、遵守现场安全规定"
      ],
      "common_deductions": [
        "超限项（同校同赛项进国赛超3支，创新类除外）",
        "机器人规格检查不合格",
        "干扰他队、不服判罚"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "报名信息",
      "format": "官网 www.caairobot.com 报名系统在线提交；每队1-3人、指导教师1-2名",
      "page_limit": "未明确",
      "deadline_note": "2025届报名系统3月6日开放，截止按各省赛区通知；系统关闭后不再接受信息更改"
    },
    {
      "item": "创新赛类作品材料（作品报告/设计文档、演示视频）",
      "format": "按各赛项规则（第二轮通知/赛项细则发布），一般含作品报告与演示视频，现场演示+答辩",
      "page_limit": "未明确",
      "deadline_note": "省级选拔赛2025年6月30日前完成；全国赛2025年8月31日前完成"
    },
    {
      "item": "竞技/挑战类参赛机器人与现场赛",
      "format": "实物机器人到场参加现场任务/对抗赛，规则按各赛项细则",
      "page_limit": "未明确",
      "deadline_note": "全国总决赛每年8月举行（合肥/哈尔滨/线上等分会场及人形机器人专项赛）"
    }
  ],
  "process_stages": [
    {
      "stage": "校级选拔赛",
      "format": "各院校自行组织评审/比赛",
      "notes": "组委会通知：原则上须进行校赛，排名前50%进入省级选拔赛"
    },
    {
      "stage": "省级选拔赛（省级层次选拔赛）",
      "format": "各省赛组委会组织比赛或评审",
      "notes": "一、二等奖推荐参加国赛，推荐比例不超过对应赛项参赛队伍的50%；不能成赛或未设省赛组委会的地区参加全国组委会组织的省级层次选拔赛（获奖为省级证书）"
    },
    {
      "stage": "全国赛（总决赛）",
      "format": "现场比赛/评审答辩，按赛项分会场（2026年第二十八届设合肥、哈尔滨、线上及人形机器人专项赛全国决赛）",
      "notes": "设一等奖、二等奖、三等奖；获全国一等奖的指导教师可申请优秀指导教师奖；设优秀组织奖"
    }
  ],
  "review_format": "创新赛类为材料评审＋现场演示答辩按技术先进性/创新性/实用性/答辩综合评分；应用赛、竞技赛、挑战赛为现场任务与对抗的客观成绩排名制",
