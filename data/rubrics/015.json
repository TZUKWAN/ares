{
  "competition_id": 15,
  "competition_name": "全国大学生物流设计大赛",
  "judging_dimensions": [
    {
      "dimension": "设计内容：针对性（问题把握准确、重点突出）",
      "weight": "网评20%、答辩10%（赛区规程评分表分值）",
      "official_wording": "网络评审评分细则——设计内容针对性：问题把握准确，针对性强，重点突出（20分）；答辩评审评分细则——设计内容（30分）中针对性10分（2024年全国大学生物流设计大赛安徽赛区竞赛暨安徽省大学生物流设计大赛赛项规程，经省大学生创新创业教育办公室审定）",
      "scoring_points": [
        "对案例企业真实问题的识别与聚焦",
        "方案目标与案例企业需求的对齐程度",
        "重点突出，不平均用力",
        "契合当届案例主题（如第八届汽车物流、第九届'新青年吴兴杯'）"
      ],
      "common_deductions": [
        "方案泛化、与所选案例企业问题脱节",
        "堆砌通用物流知识、缺乏针对性"
      ]
    },
    {
      "dimension": "设计内容：正确性与整体性",
      "weight": "网评各20%、答辩各10%（正确性20%+整体性20%；答辩中各10%）",
      "official_wording": "正确性：内容正确，方案合理，能够解决实际问题（20分）；整体性：内容具体、完整，逻辑性和系统性强（20分）（安徽赛区赛项规程网络评审评分细则）",
      "scoring_points": [
        "方案技术内容正确、能真正解决案例企业的实际问题",
        "内容具体完整，逻辑链条与系统性",
        "文字材料、数学模型、算法设计与工程图纸相互支撑",
        "网络评审为5-9名专家匿名评审，取专家平均分"
      ],
      "common_deductions": [
        "方案存在明显技术错误",
        "模块拼凑、逻辑断裂",
        "内容残缺、关键章节缺失"
      ]
    },
    {
      "dimension": "设计方法科学合理性",
      "weight": "网评20%、答辩10%（评分表分值）",
      "official_wording": "设计方法科学合理性：忠于案例物流企业提供的事实和数据；假设条件合理，符合实际；有明确、适用的设计方法；设计方法运用科学严谨（20分）（安徽赛区赛项规程网络评审评分细则）",
      "scoring_points": [
        "忠于案例企业事实与数据，不虚构前提",
        "假设条件合理、边界清晰",
        "选用明确适用的设计方法（设施规划、库存模型、路径优化、仿真等）",
        "方法运用严谨、模型与数据可复算"
      ],
      "common_deductions": [
        "数据与案例企业事实不符、凭空假设",
        "模型选择不当或计算错误",
        "只有方法名词没有实际建模过程"
      ]
    },
    {
      "dimension": "创新与应用价值",
      "weight": "网评10%、答辩10%（评分表分值）",
      "official_wording": "创新和应用价值：有符合案例物流企业实际情况的合理创新；方案实施后预期可以获得较好的运作效果，对物流企业有一定的应用价值或对解决问题有一定的指导意义（10分）（安徽赛区赛项规程网络评审评分细则）",
      "scoring_points": [
        "创新点贴合企业实际而非炫技",
        "方案实施后的预期运作效果可估",
        "对企业降本增效的实际价值",
        "对同类问题的推广指导意义"
      ],
      "common_deductions": [
        "创新脱离企业实际、落地性差",
        "无效果预估或效果测算无依据"
      ]
    },
    {
      "dimension": "文本表现规范性",
      "weight": "网评10%、答辩10%（评分表分值）",
      "official_wording": "文本表现规范性：合理、规范应用文字和非文字要素（如图表、软件、数学模型等），提交评审材料齐全、规范、美观，表现力强（10分）（安徽赛区赛项规程网络评审评分细则）",
      "scoring_points": [
        "图表、模型、软件截图等非文字要素的规范运用",
        "材料齐全、格式规范、版面美观",
        "设计方案可为文字材料、数学模型、算法设计及工程设计图等（第八届大赛要求）"
      ],
      "common_deductions": [
        "材料不齐全、格式混乱",
        "图表粗糙、模型呈现不清晰"
      ]
    },
    {
      "dimension": "现场表现（答辩环节：表述、答辩与总体印象）",
      "weight": "答辩占40%（表述15%+答辩15%+总体印象10%，答辩满分100分）",
      "official_wording": "现场表现（40分）：表述——PPT制作精美，表现形式丰富多样；表述清晰、准确、流畅；时间控制精准，无拖延（15分）；答辩——准确理解评委的提问，反应机敏，回答准确（15分）；总体印象——仪表端庄，精神饱满，配合默契，协作高效（10分）（安徽赛区赛项规程答辩评审评分细则）",
      "scoring_points": [
        "PPT质量与表达流畅度、精准控时",
        "准确理解评委提问并机敏作答",
        "团队仪表、精神面貌与协作默契",
        "评委就方案设计、现场陈述和临时应答的表现作出评分（校赛通知对大赛评分方式的表述）"
      ],
      "common_deductions": [
        "陈述超时、拖延",
        "答非所问、临场慌乱",
        "团队配合失调、由个别队员包办"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "完整设计方案（案例设计）",
      "format": "文字材料、数学模型、算法设计及工程设计图等（可以是但不限于）；从大赛案例中自主选择不超过5个案例进行设计（第八届）",
      "page_limit": "未明确",
      "deadline_note": "大赛案例于官网www.clpp.org.cn公布（第八届2023-11-24公布），方案按赛程节点提交电子版"
    },
    {
      "item": "专业水平测试",
      "format": "物流管理与工程类专业（物流管理、物流工程、采购管理、供应链管理）笔试/机试/网试",
      "page_limit": "未明确",
      "deadline_note": "决赛前一天举行，测试合格方能代表团队参加次日现场答辩"
    },
    {
      "item": "答辩PPT与现场汇报",
      "format": "PPT演示+现场陈述与回答",
      "page_limit": "未明确",
      "deadline_note": "全国总决赛及省决赛现场答辩环节使用"
    }
  ],
  "process_stages": [
    {
      "stage": "校园赛",
      "format": "专业水平测试（笔试/机试/网试，组委会命题）+方案设计赛初选，由各校组织",
      "notes": "大赛由中国物流与采购联合会、教育部高等学校物流类专业教学指导委员会主办，报名与作品提交平台wlsjds.clpp.org.cn"
    },
    {
      "stage": "省级初赛（赛区网评）",
      "format": "5-9名专家对电子版方案进行匿名网络评审，按评分表取专家平均分排序，25%-65%的团队进入赛区决赛；每校最多2支团队",
      "notes": "按《全国大学生物流设计大赛网络评审评分表》评分（安徽赛区规程）"
    },
    {
      "stage": "赛区决赛/全国总决赛",
      "format": "第一天专业水平测试+第二天设计方案现场答辩；按决赛答辩成绩设一、二、三等奖（比例10%/20%/30%），一等奖指导教师获优秀指导教师，20%参赛单位获优秀组织奖",
      "notes": "第九届（2025，'新青年吴兴杯'）吸引全国30个省份300多所院校4万余人参与；研究生组选2-3个工程技术篇案例设计"
    }
  ],
  "review_format": "案例赛制下的'网评+答辩'双百分制评审：省级初赛为专家匿名网络评审（设计内容60%+设计方法20%+创新应用10%+文本规范10%），决赛为专业测试合格后现场答辩（设计内容30%+设计方法10%+创新应用10%+文本表现10%+现场表现40%）。",
  "judge_preferences": [
    "忠于案例企业真实事实与数据，假设合理（这是评分表的明文首条）",
    "设计方法明确、适用、严谨，模型可复算",
    "方案对企业有真实应用价值与可估效果",
    "文本与图表规范美观，材料齐全",
    "答辩控时精准、临场应答机敏、团队协作高效"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "方案必须基于大赛公布的案例企业数据设计，脱离案例或虚构企业事实直接影响针对性、科学合理性两大得分项",
    "参赛队需在案例中自主选择不超过5个案例设计，超量或跨案例拼贴不符合要求",
