{
  "competition_id": 17,
  "competition_name": "华灿奖",
  "judging_dimensions": [
    {
      "dimension": "创新性（创意原创性与培养潜力）",
      "weight": "约40%（官方仅公布定性原则，权重为同类设计赛事惯例推断）",
      "official_wording": "组委会通知明确华灿奖\"以创新、时尚、实用为评审原则，选拔最具创新意识和培养潜力的青年设计人才\"；各定向主题征集要求作品\"兼具功能特性与美学价值，具备良好的市场潜力\"。百分比权重官方未公布，【推断】。",
      "scoring_points": [
        "概念原创，非对既有作品的模仿或改编",
        "对定向主题（如第十届\"华灿运河\"AI赋能大运河文化）的创造性回应",
        "选题切入角度新颖，体现青年设计师的问题意识",
        "在技法、材料、媒介或交互方式上有探索性"
      ],
      "common_deductions": [
        "作品与往届获奖作品或网络现成方案高度雷同",
        "直接使用AI生成图未做二次创作且未按要求说明",
        "套用模板化版面、创意点单薄"
      ]
    },
    {
      "dimension": "表现力与审美（时尚性、视觉完成度）",
      "weight": "约25%（推断）",
      "official_wording": "评审原则中的\"时尚\"对应审美前瞻性与表现完成度；作品格式要求平面类A3、JPG/PNG、不低于300dpi（澳门城市大学发布的台港澳实施方案）。权重【推断】。",
      "scoring_points": [
        "版面构成、色彩与字体系统完整、专业",
        "效果图/样品照片质感高，细节经得起放大审视（长边或宽边不低于2480px）",
        "视觉风格与目标人群、使用场景匹配，有当代感",
        "系列作品呈系统性而非单张拼凑"
      ],
      "common_deductions": [
        "分辨率不足、压缩失真、出血与尺寸不合规",
        "版面信息杂乱，主视觉不突出",
        "效果图与设计说明相互矛盾"
      ]
    },
    {
      "dimension": "实用性与市场性（可转化、落地潜力）",
      "weight": "约25%（推断）",
      "official_wording": "评审原则中的\"实用\"及征集要求\"具备良好的市场潜力\"为依据；终评设路演环节（第九届起设路演奖8项），考察作品的市场转化表达。权重【推断】。",
      "scoring_points": [
        "功能合理，能解决真实使用痛点",
        "成本、工艺、量产可行性有基本考量",
        "文创/品牌类作品有清晰的目标市场与商业模式设想",
        "路演中能讲清应用场景与推广路径"
      ],
      "common_deductions": [
        "纯概念炒作，无使用场景",
        "结构与工艺明显不可实现",
        "市场分析空泛、与作品脱节"
      ]
    },
    {
      "dimension": "文化内涵与两岸交流价值",
      "weight": "约10%（推断）",
      "official_wording": "大赛由中华中山文化交流协会参与主办，定位\"推动两岸设计文化交流\"；第十届定向主题要求围绕大运河文化遗产\"创造性转化与创新性发展\"、孙中山纪念地文创等。权重【推断】。",
      "scoring_points": [
        "对中华文化元素的当代转译自然不生硬",
        "体现两岸青年对话、文化认同的主题立意",
        "社会价值导向积极健康"
      ],
      "common_deductions": [
        "文化符号堆砌、误用或冒犯性表达",
        "内容导向不当"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "平面类作品",
      "format": "A3尺寸，JPG/PNG格式，分辨率不低于300dpi",
      "page_limit": "未明确（按类别征集公告）",
      "deadline_note": "报名一般为每年7月至次年2月，官网 www.huacanjiang.com 在线提交"
    },
    {
      "item": "产品/空间类作品",
      "format": "3D效果图，A3版面规格，共5张，图片长边或宽边不低于2480px、不低于300dpi；另附演示动画MP4（1—3分钟，部分赛区要求）",
      "page_limit": "A3版面5张",
      "deadline_note": "同上，随作品一并上传"
    },
    {
      "item": "视频/数字媒体类作品",
      "format": "MP4视频",
      "page_limit": "未明确（演示动画1—3分钟）",
      "deadline_note": "同上"
    },
    {
      "item": "在线报名信息与原创承诺",
      "format": "官网报名系统填写",
      "page_limit": "未明确",
      "deadline_note": "获奖后信息不可修改，数据不完整者取消参赛资格"
    }
  ],
  "process_stages": [
    {
      "stage": "校赛（大陆高校）",
      "format": "各高校自行组织初评推荐",
      "notes": "华灿奖采用校赛、赛区赛、总赛三级赛制；校赛由各赛区负责组织"
    },
    {
      "stage": "赛区赛（省赛/区域赛）",
      "format": "大陆各省、自治区、直辖市设省赛；香港、澳门、台湾及海外地区设区域赛",
      "notes": "赛区赛获奖作品晋级总赛；澳门等赛区按实施方案（A3、300dpi等）征集评审"
    },
    {
      "stage": "总赛（终评/全国总赛）",
      "format": "专家评审委员会评选全场大奖、最佳新锐设计师等奖项，第九届起增设路演环节",
      "notes": "第十届共征集作品128,468件；奖项含年度华灿奖全场大奖1名（奖金3万元）、最佳新锐设计师/团队3名（每名奖金1万元）、路演奖等"
    }
  ],
  "review_format": "线上投稿、专家评审委员会分级评审（校赛/赛区赛/总赛），总赛终评辅以现场或线上路演答辩。",
  "judge_preferences": [
    "偏好对定向主题（AI+文化、大运河、孙中山纪念地等）回应精准、立意有时代性的作品",
    "重视完整的设计系统呈现（从概念推导到落地物化），反感单张效果图堆砌",
    "关注作品的转化潜力与市场意识，路演表达清晰者占优",
    "强调两岸文化交流语境下的中华美学当代表达"
  ],
