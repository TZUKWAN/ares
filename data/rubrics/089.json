{
  "competition_id": 89,
  "competition_name": "湖北省物理实验创新设计竞赛",
  "judging_dimensions": [
    {
      "dimension": "创新思维（创新性）",
      "weight": "定性评审（组委会四维综合考评之首）；各维分值未公开，【推断约35%：参考省赛以创新为核心导向及获奖作品共性】",
      "official_wording": "第十二届竞赛（武汉轻工大学承办）官方新闻：'评审分方案初审和现场答辩两个环节……综合考评创新思维、理论深度、技术实现、团队协作四个方面'。省组委会未公布各维具体分值，本权重为按官方维度排序与同类实验创新赛事惯例所作推断。",
      "scoring_points": [
        "选题新颖：对传统大学物理实验装置、方法有实质性改进或全新设计",
        "体现问题意识：针对现有实验教学痛点提出新方案",
        "融合新技术：如AI视觉赋能光栅衍射智能测量等跨学科手段（第十二届获奖案例方向）",
        "命题类作品紧扣组委会公布题目的创新空间；自选类突出原创性"
      ],
      "common_deductions": [
        "仅复现教材现有实验、无实质创新",
        "创新点表述空泛，经不起评委追问设计依据",
        "与往届获奖作品或网络方案雷同"
      ]
    },
    {
      "dimension": "理论深度（科学性）",
      "weight": "定性评审（四维之一）；【推断约20%：与校级对接细则中报告书评审的科学性要求对应】",
      "official_wording": "官方四维综合考评表述之一（'理论深度'，第十二届承办校新闻原文）。湖北大学对接该校赛的评审模型佐证：作品报告书单独占50分，重点考察原理与论证。【推断依据：报告书为理论深度主要载体】",
      "scoring_points": [
        "物理原理正确、建模清晰，实验方案有理论依据",
        "误差分析与不确定度评定严谨",
        "与《大学物理实验》课程教学大纲知识衔接自然",
        "引用文献规范，数据可复现"
      ],
      "common_deductions": [
        "原理性错误或公式推导漏洞",
        "误差分析缺失或数据涂改痕迹",
        "理论与实验装置脱节，讲不通设计逻辑"
      ]
    },
    {
      "dimension": "技术实现（作品完成度）",
      "weight": "定性评审（四维之一）；【推断约25%：实物/系统可实现性为现场展示核心】",
      "official_wording": "官方四维综合考评表述之一（'技术实现'）。第十二届决赛'现场设专属作品展示区，各校项目集中布展、交流分享'，作品实物与运行效果为评审对象。",
      "scoring_points": [
        "装置/系统能现场稳定演示，测量结果可重复",
        "制作工艺、装置安全性与可维护性",
        "成本控制与可推广性（便于转化为实验教学仪器）",
        "软硬件集成度（传感器、数据采集、智能算法落地）"
      ],
      "common_deductions": [
        "现场演示失败或仅有效果图无实物",
        "装置粗糙、安全隐患明显",
        "数据孤证、无法重复测量"
      ]
    },
    {
      "dimension": "团队协作与现场答辩",
      "weight": "定性评审（四维之一）+答辩呈现；【推断约20%：含校级对接细则'现场答辩50分'量化依据】",
      "official_wording": "官方四维综合考评表述之一（'团队协作'）。湖北大学对接赛细则：'决赛：现场答辩+专家评审，总分100分——作品报告书50分、现场答辩50分''每组派一名代表作演讲并接受评委提问'。【推断：省级答辩考察口径相近】",
      "scoring_points": [
        "答辩陈述逻辑清晰，PPT与作品报告相互印证",
        "回答评委提问准确、分工内容真实可追问",
        "成员贡献明确（团队按贡献排序，一名主讲）",
        "展示交流环节能讲清创新点与应用价值"
      ],
      "common_deductions": [
        "答辩背稿、答不上基本原理与分工",
        "明显由教师代做的痕迹",
        "超时陈述或未按要求提交答辩材料"
      ]
    },
    {
      "dimension": "材料规范性（合规扣分项）",
      "weight": "定性扣分项：讲课类视频不满足规程要求酌情扣除5-10分（官方明文，独立于各评审维度权重之外）",
      "official_wording": "第九届湖北省大学生物理实验创新设计竞赛讲课竞赛细则及评审标准（组委会附件原文）：'凡不满足以上相关要求的视频，将酌情扣除5-10分'；含时长16-20分钟、720P、不超200M、不得出现校名教师学生信息、须着正装等条款。",
      "scoring_points": [
        "作品报告按官方模板撰写、要件齐全",
        "讲课类视频16-20分钟、720P、≤200M、画面声音清晰",
        "视频为同步课堂教学实录，不过度后期制作",
        "按规定名额申报（讲课类每校最多2项且题目不同）"
      ],
      "common_deductions": [
        "视频或材料出现校名、教师与学生信息（双盲评审破盲风险）",
        "时长/格式/分辨率不达标扣5-10分",
        "未经学院主管领导审核确认即提交"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "作品报告书",
      "format": "Word/PDF，按组委会下发模板撰写（校级对接赛提供'作品报告书模板.docx'）",
      "page_limit": "未明确（按当届模板）",
      "deadline_note": "方案初审（网评）前提交，通常在暑假决赛前"
    },
    {
      "item": "答辩PPT与现场答辩",
      "format": "PPT；决赛现场演讲+评委提问",
      "page_limit": "未明确",
      "deadline_note": "决赛（惯例8月下旬，为期2-3天）现场使用"
    },
    {
      "item": "讲课类：同步课堂教学实录视频",
      "format": "MP4，720P、≤200M、16-20分钟；内容选自本校《大学物理实验》课程；须出镜学生、不得出现指导教师与校名信息；着正装",
      "page_limit": "16-20分钟",
      "deadline_note": "初赛以报送讲课视频形式网络初评"
    },
    {
      "item": "实物作品/展示材料",
      "format": "实验装置实物+展示区布展",
      "page_limit": "未明确",
      "deadline_note": "决赛现场布展与作品展示交流"
    }
  ],
  "process_stages": [
    {
      "stage": "校级预赛（选拔赛）",
      "format": "各校自行组织（部分含笔试+作品答辩），择优申报省赛",
      "notes": "春季学期进行；参赛对象为全日制在校本(专)科生，作品类每队不超过5人、讲课类团队不超过3人（一名主讲）"
    },
    {
      "stage": "省级方案初审（网评）",
      "format": "双盲评审：专家对作品报告等申报材料匿名网评",
      "notes": "评委来自全省30所理事单位本科院校；按类别分赛道评审"
    },
    {
      "stage": "省级决赛（现场答辩+作品展示）",
      "format": "现场答辩分批次进行，设约10个答辩赛道；同期设作品展示区集中布展",
      "notes": "惯例7-8月举办（第十二届2026年8月24-26日在武汉轻工大学）；综合考评创新思维、理论深度、技术实现、团队协作"
    }
  ],
  "review_format": "双盲评审：方案初审（材料网评）+现场答辩（分赛道、专家提问），并设作品展示交流环节",
  "judge_preferences": [
    "创新性优先：对传统实验的实质改造+新技术融合（AI视觉、智能测量为近期获奖方向）",
    "装置现场可演示、数据可重复，忌纸上谈兵",
    "理论建模与误差分析严谨，体现物理味而非纯工程堆料",
    "答辩真实反映学生工作量，双盲材料零校名痕迹",
    "成果具备转化为实验教学仪器/课程资源的潜力"
  ],
