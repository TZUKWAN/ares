{
  "competition_id": 34,
  "competition_name": "中美青年创客大赛",
  "judging_dimensions": [
    {
      "dimension": "首创精神与创新突破",
      "weight": "40%",
      "official_wording": "厦门分赛区评审规则：\"首创精神与创新突破（40%）：创意独特性——作品是否提供了与现有产品明显不同的新思路或解决方案；问题新颖性——是否发现未被广泛关注的问题；跨界融合度；精简原型化——是否专注核心创新点，而非过度开发商业功能或包装\"",
      "scoring_points": [
        "创意与市场现有产品/往届作品有明显差异化新思路",
        "发现未被广泛关注的问题或为常见问题提供新角度",
        "跨学科、跨文化（中美合作）视角融合",
        "聚焦核心创新点的精简原型，不堆砌商业包装"
      ],
      "common_deductions": [
        "与往届获奖作品或市面产品高度雷同",
        "仅做外观包装、商业计划书式堆砌而无实质创新点",
        "无法说清创意的差异化来源"
      ]
    },
    {
      "dimension": "问题导向与社会价值",
      "weight": "30%",
      "official_wording": "厦门分赛区评审规则：\"问题导向与社会价值（30%）：需求明确性——针对明确具体的现实问题；解决有效性；议题相关性——是否针对可持续发展等中美共同关注的社会议题；受益范围性\"",
      "scoring_points": [
        "痛点真实、具体、需求清晰可验证",
        "方案能直接解决所述问题且效果可测量",
        "契合气候变化、韧性社区、低碳环保、食物系统、危机应对等可持续发展议题",
        "受益人群规模与改善程度明确"
      ],
      "common_deductions": [
        "选题空泛、痛点为伪需求",
        "方案与问题脱节、效果无法度量",
        "与社会公共议题无关联且无受益面论证"
      ]
    },
    {
      "dimension": "技术实现与产品完整",
      "weight": "20%",
      "official_wording": "厦门分赛区评审规则：\"技术实现与产品完整（20%）：功能可用性——原型是否具备关键功能、能否实际演示并完成核心任务；技术适当性；体验友好性；完善可能性\"",
      "scoring_points": [
        "现场可演示、核心功能真实跑通",
        "技术路径与问题难度匹配、不过度也不单薄",
        "交互与界面直观友好",
        "有明确迭代与扩展计划"
      ],
      "common_deductions": [
        "原型仅停留在视频或图纸、现场无法演示",
        "技术栈选择与问题不匹配（杀鸡用牛刀或技术不可行）",
        "演示过程死机/失败且无预案"
      ]
    },
    {
      "dimension": "团队协作与开源共享",
      "weight": "10%",
      "official_wording": "厦门分赛区评审规则：\"团队协作与开源共享（10%）：合作实效性——分工明确；过程透明度——详细记录创作过程；资源开放度——技术文档、代码、设计文件以开源方式提供；社区互动度\"",
      "scoring_points": [
        "成员分工与专业背景互补且在答辩中体现",
        "创作过程文档/日志完整、挑战与解决过程可追溯",
        "代码、设计文件开源且组织良好",
        "积极吸收社区/用户反馈迭代"
      ],
      "common_deductions": [
        "答辩中分工不清、一人包办痕迹明显",
        "无过程记录，文档缺失",
        "代码与设计文件闭源或混乱不可复现"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "产品原型",
      "format": "基于开源软件或开源硬件平台制作的可演示实物/系统原型",
      "page_limit": "未明确",
      "deadline_note": "分赛区选拔赛阶段现场（约48小时创客马拉松）完成设计制作"
    },
    {
      "item": "参赛者声明与报名材料",
      "format": "大赛组委会统一表格+《中美青年创客大赛参赛者声明》签署",
      "page_limit": "未明确",
      "deadline_note": "报名截止（通常5-6月，以当年通知为准）"
    },
    {
      "item": "作品介绍/展示材料",
      "format": "项目展示PPT、演示视频、过程文档及开源代码/设计文件",
      "page_limit": "未明确",
      "deadline_note": "分赛区评审前提交，晋级总决赛后按决赛要求更新"
    }
  ],
  "process_stages": [
    {
      "stage": "校内/分赛区报名与选拔",
      "format": "部分高校先组织校级选拔；分赛区受理报名并审核资格（18-40岁，中美公民或永久居留权）",
      "notes": "各分赛区（北京、上海、厦门、深圳、天津等）独立组织，职业院校分赛道单独评审"
    },
    {
      "stage": "分赛区选拔赛（6-7月）",
      "format": "创客马拉松（Make-a-thon）：约48小时现场制作+路演答辩，评审团按百分制打分",
      "notes": "按作品分数排名，分赛区前五名晋级总决赛（向工作组报前七名备选）"
    },
    {
      "stage": "总决赛（8月）",
      "format": "主赛道、职业院校分赛道分别评审，另设中美青年合作奖",
      "notes": "总决赛另有决赛评分标准，同分时创新创意部分得分高者优先"
    }
  ],
  "review_format": "创客马拉松现场制作后由专家评审团路演答辩按百分制维度打分，分赛区按分数排名晋级总决赛。",
  "judge_preferences": [
    "极度看重首创性与问题新颖性（权重40%），拒绝老点子换皮",
    "偏好聚焦核心创新点的精简原型，反感功能堆砌与商业包装",
    "关注可持续发展等中美共同关注的社会议题",
    "要求现场真机演示，开源共享与过程记录是加分项"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "作品须为团队自主研发、拥有完全知识产权，不得依托高校/单位已有技术成果，涉及专利须为第一作者",
    "严禁抄袭往届作品或市场现有成果；未公开发表、未商业化、未在其他竞赛获奖",
    "原型必须基于开源软硬件平台完成，纯闭源商业方案不符合赛制",
    "年龄须在18-40岁且为中美公民/永久合法居留者，须签署参赛者声明",
    "分赛区须现场制作，携带预制半成品冒充现场创作属违规"
  ],
