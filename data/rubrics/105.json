{
  "competition_id": 105,
  "competition_name": "“光威杯”高性能复合材料科技创新竞赛",
  "judging_dimensions": [
    {
      "dimension": "基础内容（作品的研究基础与内容质量）",
      "weight": "约20%【推断：全国半决赛依据评分标准在'基础内容、创新性、先进性、可行性和发展潜力'五个方面打分，学会未公开各维度分值，按五维近似等权推断】",
      "official_wording": "烟台大学学科竞赛网转发第七届竞赛规则原文：'全国半决赛采用专家线上盲评的形式进行，依据半决赛评分标准在基础内容、创新性、先进性、可行性和发展潜力五个方面对作品进行打分评价'。各维度具体分值未公开。",
      "scoring_points": [
        "选题属于复合材料前沿科技领域（制造工艺及装备、结构设计及应用、性能及理论、模拟仿真、检测评价、回收修复六大命题方向之内）",
        "研究内容完整：背景、方案、实验/仿真数据、结论链条清晰",
        "作品申报书（PDF）撰写规范，数据真实可查",
        "技术路线与所用表征/分析方法表述专业"
      ],
      "common_deductions": [
        "选题超出命题范围或内容单薄、拼凑",
        "数据造假、方法描述与结果矛盾",
        "申报书格式不合格、材料缺失（形式审查直接淘汰）"
      ]
    },
    {
      "dimension": "创新性与先进性",
      "weight": "约40%【推断：五维盲评中创新性、先进性两项合计，按等权近似各20%；学会未公开分值】",
      "official_wording": "半决赛五维评分标准原文含'创新性''先进性'两项（烟台大学转发的竞赛规则）；竞赛主题为'新材料 新创意 新世界'（中国复合材料学会第五届通知原文）。",
      "scoring_points": [
        "研究思路、材料体系或结构设计有原创性突破",
        "相对现有工艺/产品有明显性能提升或成本/工艺优势",
        "体现行业前沿（如碳纤维复合材料回收再利用、新能源领域应用等企业命题方向）",
        "创新点凝练准确、能在演示中直观呈现"
      ],
      "common_deductions": [
        "与往届获奖作品雷同（不予受理/取消资格）",
        "创新点仅为常规参数调整、无实质性先进性",
        "引用他人作品、代码、模型未注明"
      ]
    },
    {
      "dimension": "可行性与发展潜力",
      "weight": "约40%【推断：五维盲评中可行性、发展潜力两项合计，按等权近似各20%；学会未公开分值】",
      "official_wording": "半决赛五维评分标准原文含'可行性''发展潜力'两项（烟台大学转发的竞赛规则）；企业命题方向'新能源领域中废旧碳纤维复合材料制品的再利用方向（例如：风电叶片碳梁、储氢气瓶及其他碳纤维制品）'体现产业化导向（烟台大学转发规则原文）。",
      "scoring_points": [
        "技术方案可实现：工艺路线、设备条件与经费/周期匹配",
        "实验或仿真结果支撑预期功能与性能目标",
        "成果具备工程化、产业化转化前景",
        "团队跨学科配置合理，具备持续研究基础"
      ],
      "common_deductions": [
        "方案明显超出本科/硕士生可实现条件、关键环节无法落地",
        "结果不足以支撑结论",
        "已经转化或获得扶持的项目报名（禁止参赛）"
      ]
    },
    {
      "dimension": "全国总决赛现场答辩（成果水平、完成质量与答辩综合评议）",
      "weight": "决赛综合评议定名次环节：以定性评议综合评定（权重未公开，推断约占决赛评分30%）【推断：学会通知原文'决赛评审专家组根据参赛作品的成果水平、完成质量和答辩情况进行综合评议，评定获奖名次'；进决赛作品最低三等奖】",
      "official_wording": "中国复合材料学会第五届通知原文：'全国总决赛采用现场答辩的形式进行，各参赛队（每队限1名指导老师，2名参赛选手）经检录加密后，按抽签顺序依次演讲参赛作品，并进行作品设计演示（PPT、视频等简要介绍作品构思、主要创新点、模型展示等)，时间不超过10分钟；决赛评审专家组进行现场评审和问询，参赛队伍答辩，时间不超过5分钟；最终，决赛评审专家组根据参赛作品的成果水平、完成质量和答辩情况进行综合评议，评定获奖名次，进入决赛的作品最低为三等奖'。",
      "scoring_points": [
        "演讲与演示（PPT/视频/模型展示）在10分钟内讲清构思与主要创新点",
        "5分钟问询答辩准确、坦诚，能回应专家质疑",
        "作品完成质量：实物/样件/仿真成果的成熟度",
        "检录加密、抽签顺序等程序合规"
      ],
      "common_deductions": [
        "超时（演讲超10分钟或答辩超5分钟）",
        "演示与申报材料不符",
        "答辩明显由指导教师主导或回答不上核心问题",
        "未按规定时间到达指定地点视为自动弃赛"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "报名信息表与作品申报书",
      "format": "电子版作品申报书（PDF，学会模板）；报名经大赛官网（jsw.csfcm.org.cn），初版仅需作品封面图与项目摘要；材料命名'赛区-学校-指导教师-作品名称-队名'",
      "page_limit": "按学会模板（未公开页数上限）",
      "deadline_note": "第七届（2023）：报名3月9日-4月19日，作品申报及上传4月20日-5月11日；第五届（2020）：报名截止6月25日、申报书截止6月30日"
    },
    {
      "item": "半决赛盲评版作品材料",
      "format": "无个人信息版参赛作品一份（电子版），材料命名'学校-指导教师-作品名称'",
      "page_limit": "未明确",
      "deadline_note": "全国半决赛阶段规定时间内提交（第五届为2020年8月3-14日期间）"
    },
    {
      "item": "决赛演示材料",
      "format": "PPT、视频、模型展示等；每队限1名指导老师+2名参赛选手到场",
      "page_limit": "演讲不超过10分钟，答辩不超过5分钟",
      "deadline_note": "全国总决赛及颁奖典礼（第五届2020年11月东莞；第八届2025年1月哈尔滨落幕）；总决赛免注册费，组委会承担食宿与高铁二等座交通费"
    }
  ],
  "process_stages": [
    {
      "stage": "报名与作品申报",
      "format": "以院校为单位组队（≤6人含指导老师1名，选手为在读本科生或硕士研究生且本科生数不少于研究生数），官网报名+提交申报书，秘书处形式审查",
      "notes": "跨学科、跨专业、跨年级组队允许；格式不符或内容缺失不合格直接淘汰"
    },
    {
      "stage": "网络投票推介",
      "format": "官网开通投票渠道，高校师生、从业人士投票",
      "notes": "第五届规则：得票全国前3名的作品经评审专家认可后可直接晋级半决赛；网络投票排名不影响后续比赛成绩（第八届表述为'网络投票推介'环节）"
    },
    {
      "stage": "分赛区初赛",
      "format": "按区域分赛区（如华东、华中、东北、华北、烟台等赛区），由赛区高校专家组成评审组，函审或网络答辩评审",
      "notes": "主评委为分赛区材料行业突出高校教师，组织4-5名老师形成评审组；第五届评出120支队伍晋级半决赛"
    },
    {
      "stage": "全国半决赛（线上盲评）",
      "format": "专家盲评无个人信息版作品，按基础内容、创新性、先进性、可行性和发展潜力五个方面打分",
      "notes": "第五届前31名晋级全国总决赛；第八届共47支（本科组27、研究生组20）晋级总决赛"
    },
    {
      "stage": "全国总决赛（现场答辩）与颁奖",
      "format": "现场演讲+演示+专家问询答辩，专家组综合评议评定名次",
      "notes": "分本科组、研究生组评奖（第八届：本科组一等奖2项、二等奖6项、三等奖12项、优胜奖7项；研究生组一等奖2项、二等奖6项、三等奖6项、优胜奖6项）；进决赛作品最低三等奖"
    }
  ],
  "review_format": "分赛区初赛（函审/网络答辩）+全国半决赛专家线上盲评（五维打分）+全国总决赛现场答辩综合评议，逐级淘汰制评审。",
  "judge_preferences": [
    "创新性与先进性是核心区分度：重视碳纤维复合材料等前沿方向的原创突破",
    "重视产业转化潜力与工程可行性（承办方为光威复材，产业链导向明显）",
    "作品完成质量与演示效果并重，鼓励实物/样件展示",
    "盲评阶段严格匿名，材料规范性与真实性是门槛",
    "答辩表述专业、能准确回答复材专业问题"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "抄袭、作假、舞弊一经发现取消参赛资格，已获奖的追回奖项、奖金和扶持政策（官方明文）",
    "作品不得违背法律法规、不得侵犯第三方知识产权、不得涉密",
    "不得与往届获奖作品雷同；往届获奖作品不予受理",
    "已经转化或获得扶持的项目禁止报名",
    "同一作品重复提交、逾期未交材料或未到场比赛视为弃赛"
  ],
