{
  "competition_id": 44,
  "competition_name": "智能机器人创意大赛",
  "judging_dimensions": [
    {
      "dimension": "创意性与主题契合度（创意设计类核心）",
      "weight": "创意类首要维度，约30%【推断】",
      "official_wording": "第八届大赛1号通知（组委会原文）：“所有参加决赛的作品必须与本届大赛的主题和内容相符，与主题及限定范围不符的作品不予评奖”；主题一为“家用智能机器人——让生活更美好”。大赛以“更好、更快、更强”为主题。官方未公布百分制细则，权重为按同类创意赛事惯例推断",
      "scoring_points": [
        "作品创意新颖性、原创性（相对现有产品与往届作品）",
        "紧扣当届主题与限定应用场景（如家用环境）",
        "需求洞察与问题提出的价值（大赛强调“培养学生提出问题能力为起点”）",
        "人机交互/使用体验设计合理性"
      ],
      "common_deductions": [
        "与主题及限定范围不符的作品不予评奖（直接出局）",
        "创意雷同、涉嫌抄袭",
        "往届获奖作品或已公开作品重复参赛且未注明"
      ]
    },
    {
      "dimension": "技术方案与实现难度",
      "weight": "约25%【推断】",
      "official_wording": "通知要求提交“设计创意的PDF文档（文字、设计图、效果图或动画）”，主题二要求“作品设计技术文档PDF，包括文字、设计图、效果，篇幅限A4纸30页”；专项赛强调“融合机器视觉和人工智能算法”“在ROS框架下运行”等技术要求",
      "scoring_points": [
        "机械/电控/算法方案完整性与先进性",
        "关键技术难点与解决思路",
        "方案可行性、成本与工程化考虑",
        "AIGC组：AI仅辅助（生成思路、语言表达、查资料），保留自主创作过程材料"
      ],
      "common_deductions": [
        "AIGC组将AI生成内容直接用于设计创作或代替自主思考",
        "技术文档堆砌、关键方案缺失",
        "实物与文档方案明显不符"
      ]
    },
    {
      "dimension": "作品演示与完成度",
      "weight": "创意类约25%；竞技/对抗类以比赛成绩（竞速计时、对抗胜负）为主要依据",
      "official_wording": "通知规定提交“原理样机视频（mp4格式，限60秒以内，不超过50M）”；主题二、专项赛二/三提交“实物模型一次完整动作过程的视频（不超过90M，魔方机器人≤90S，足式/VEX U≤120S）”；主题三“通过策略的制定及程序的设计……采取小组循环赛、淘汰赛相结合的赛制”",
      "scoring_points": [
        "视频完整展示核心功能，演示效果稳定可复现",
        "实物样机做工、结构完成度",
        "竞技类：魔方复原速度、对抗赛小组循环+淘汰赛成绩排名",
        "尺寸重量等规则符合性（魔方机器人≤480mm³、≤20kg，双手臂）"
      ],
      "common_deductions": [
        "视频超时长/超大小限制、剪辑痕迹明显或非一次完整动作",
        "演示功能与申报内容不符",
        "违反机器人结构、尺寸、重量限制"
      ]
    },
    {
      "dimension": "现场展示与答辩",
      "weight": "全国赛评定环节，约20%【推断】",
      "official_wording": "第八届通知：“全国赛：获得全国赛资格的参赛队采用现场展示、答辩等方式，由专家委员会评选出各奖项”",
      "scoring_points": [
        "现场陈述逻辑与表达",
        "回答评委质询的技术深度",
        "实物现场运行稳定性",
        "团队分工与协作展示"
      ],
      "common_deductions": [
        "现场设备故障无预案、演示失败",
        "答辩答非所问、核心工作说不清",
        "超时、违反现场纪律"
      ]
    },
    {
      "dimension": "原创性与知识产权规范",
      "weight": "否决性条件，不计分数权重（不合规取消评奖资格）",
      "official_wording": "第八届通知：“参赛作品必须为原创，且不侵犯他人知识产权，已经公开或申请专利的，请注明”",
      "scoring_points": [
        "原创声明与佐证",
        "引用第三方素材/开源代码合规标注",
        "已专利/公开成果如实注明"
      ],
      "common_deductions": [
        "侵犯知识产权、代工代做",
        "同校魔方机器人结构与技术方案雷同（通知明令禁止）",
        "申报信息造假"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "参赛作品申报表",
      "format": "电子版+签字盖章PDF扫描版，官网 www.robotcontest.cn 提交",
      "page_limit": "未明确",
      "deadline_note": "报名2025年3月18日-6月25日（各赛区有差异）；申报表审核通过后方可传作品材料"
    },
    {
      "item": "主题一设计创意PDF（无实物组）",
      "format": "文字、设计图、效果图或动画PDF",
      "page_limit": "A4纸6页以内（不含封页），≤20M",
      "deadline_note": "未成立区域赛赛区2025年7月1-6日提交"
    },
    {
      "item": "主题一实物组材料",
      "format": "设计创意PDF+原理样机视频（mp4）",
      "page_limit": "PDF同上；视频≤60秒、≤50M",
      "deadline_note": "同上；AIGC组另附提示词、截屏等原始过程材料"
    },
    {
      "item": "主题二/专项赛材料",
      "format": "一次完整动作视频（mp4，≤90M）+设计技术文档PDF",
      "page_limit": "视频：魔方≤90S、足式/VEX U≤120S；技术文档A4纸30页",
      "deadline_note": "同上"
    }
  ],
  "process_stages": [
    {
      "stage": "校赛/报名",
      "format": "校内选拔（非强制），官网报名",
      "notes": "2025年报名3月18日-6月25日；主题一/二每队1-3人，主题三/专项赛1-4人，指导教师1-2人"
    },
    {
      "stage": "区域赛（省赛）",
      "format": "以省为单位组织选拔评审（无实物/实物等分组评审）；未成立区域赛赛区由组委会统一组织全国选拔赛",
      "notes": "按成绩排序评出不高于24%的队伍获全国赛资格；组委会统一评审的区域赛/专项赛按10%/20%/30%评一二三等奖"
    },
    {
      "stage": "全国赛（决赛）",
      "format": "现场展示、答辩，专家委员会评选；主题二/主题三为现场竞速与对抗赛",
      "notes": "2025年全国赛8月20-21日；一等奖20%、二等奖40%、三等奖40%，宁缺毋滥可空缺；魔方机器人每校进决赛≤2项"
    }
  ],
  "review_format": "创意类按无实物组/自制实物模型组/模块化搭建组/AIGC组分组材料评审+全国赛现场展示答辩；竞技对抗类按竞速计时与循环赛、淘汰赛成绩评定",
  "judge_preferences": [
    "创意设计与主题场景高度贴合、问题真实",
    "样机可现场稳定运行，演示有说服力",
    "技术方案有自研深度（视觉算法、运动控制等）",
    "答辩坦诚、讲清原创贡献点"
  ],
