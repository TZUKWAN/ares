      "deadline_note": "省赛决赛期间进行（历届多在暑期前后）"
    },
    {
      "item": "选拔考试（校级）",
      "format": "各校组织选拔考试（笔试为主或笔试+操作），择优组队报名",
      "page_limit": "未明确",
      "deadline_note": "省赛前数月（如武汉纺织大学第十届选拔考试通知）"
    }
