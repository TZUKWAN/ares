  "process_stages": [
    {
      "stage": "校内选拔",
      "format": "各承办学院组织选拔考试，择优组成代表队",
      "notes": "面向化学化工及相关专业本科生；历届多在春季学期组织"
    },
    {
      "stage": "省级决赛（笔试+实验操作）",
      "format": "由省内高校轮值承办，集中进行理论笔试与现场实验操作考试",
      "notes": "实行笔试与实验操作相结合：笔试占30%、操作占70%；按个人/团体成绩评奖（长江大学曾获非专业团体第一名及多个一二等奖）"
    },
    {
      "stage": "评奖与公示",
      "format": "按四大化学综合成绩评出一、二、三等奖及团体奖，赛后公示",
      "notes": "获奖情况纳入各校学科竞赛认定体系"
    }
  ],
  "review_format": "理论笔试（30%）+现场实验操作考试（70%），评委按评分表现场分项计分，综合总分排名评奖",
  "judge_preferences": [
    "基本功扎实：滴定手法、读数视线、仪器洗涤等细节是评委盯防重点",
