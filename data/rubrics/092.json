{
  "competition_id": 92,
  "competition_name": "湖北省化学实验技能大赛",
  "judging_dimensions": [
    {
      "dimension": "实验操作考试（实操）",
      "weight": "占总分70%（第八届官方口径：笔试占总分的30%，实验操作占70%）",
      "official_wording": "湖北省普通高等学校大学生化学实验技能竞赛（第八届）承办校报道原文：'比赛考试内容涵盖无机化学、分析化学、有机化学、物理化学实验中的基本操作及数据处理等内容，实行笔试与实验操作考试相结合，笔试占总分的30％，实验操作（占70%）'。360文库所载2023年省赛复赛A卷评分表显示操作环节按'试验操作/试验成果/试验汇报'分项给分并须评分人签字确认。【操作环节内部分值结构以当届评分细则为准】",
      "scoring_points": [
        "基本操作规范：称量、移液、滴定、加热、蒸馏、重结晶、装置搭建等（覆盖无机、分析、有机、物化四大化学实验）",
        "仪器使用正确：滴定管、移液管、容量瓶、分光光度计等分析仪器规范校准与读数",
        "实验结果准确度：定量实验的精密度与准确度达到评分标准",
        "实验报告与数据处理：有效数字、误差分析、图表规范",
        "限时完成规定实验项目，现场评委按评分表分项签字计分"
      ],
      "common_deductions": [
        "操作违规（如手握活塞姿势错误、废液乱倒、危险操作）按项扣分",
        "原始记录缺项、随意涂改或伪造数据",
        "结果超出误差允许范围、有效数字错误",
        "超时未完成或实验失败"
      ]
    },
    {
      "dimension": "化学实验理论笔试",
      "weight": "占总分30%（第八届官方口径）",
      "official_wording": "同上承办校报道：'实行笔试与实验操作考试相结合，笔试占总分的30％'；笔试内容与操作考试对应，涵盖四大化学实验的基本原理与数据处理。",
      "scoring_points": [
        "四大化学（无机、分析、有机、物化）实验基本原理与知识",
        "实验安全与应急处理知识",
        "实验方案理解与数据处理方法（标准溶液配制、标定、误差计算等）",
        "笔试成绩计入总分，决定综合排名"
      ],
      "common_deductions": [
        "基本概念与实验原理掌握不牢失分",
        "计算题数据处理方法错误",
        "安全知识题失分"
      ]
    },
    {
      "dimension": "参赛合规与实验室安全",
      "weight": "一票否决：严重违反安全规程或作弊取消成绩",
      "official_wording": "实验技能类竞赛通行规程：选手须服从实验室安全管理，规范处置废液与危险品；校内选拔通知（武汉纺织大学）要求通过选拔考试择优派出。【推断：严重违规、代考、舞弊按取消资格处理，细则以当届通知为准】",
      "scoring_points": [
        "通过校内选拔考试获得参赛资格，实名参赛",
        "全程遵守实验室安全规程（护目镜、白大褂、废液分类）",
        "独立完成操作与报告，接受评委现场巡查",
        "服从赛程与试题保密要求"
      ],
      "common_deductions": [
        "危险操作被评委警告或终止考试",
        "代人考试、通讯设备入场",
        "篡改测量数据或抄袭他人报告"
      ]
    }
  ],
