  "process_stages": [
    {
      "stage": "注册与赛前审核",
      "format": "官网注册车队，提交设计报告/成本报告/营销报告等静态材料，接受规则审核",
      "notes": "三项赛事独立报名：FSC（油动，蔚来杯等冠名）、FSEC（电动）、FSAC（无人，蔚来杯）； FSAC赛车须同时符合电动规则与无人规则"
    },
    {
      "stage": "赛站：车检+静态赛",
      "format": "技术检查（机械/三电/无人专项）→ 设计答辩（150）→ 成本答辩（100）→ 营销答辩（75），FSAC另设无人驾驶系统设计答辩（200）",
      "notes": "车检通过方可参加动态项目；静态答辩由评委按评分表打分"
    },
    {
      "stage": "赛站：动态赛与总成绩",
      "format": "直线加速（75/FSAC 100）→8字绕环（50）→高速避障/操控性（150）→耐久（300）+效率（100）；按各项折算总分1000分（FSC/FSEC）排名颁奖",
      "notes": "FSAC动态为直线加速、八字绕环、操控性测试、高速循迹；总成绩三等奖及以上另有专项奖（优秀底盘设计奖等单项奖）；2023赛季FSAC共31支车队完成管理审核，FSEC/FSAC同场合赛（合肥）"
    }
  ],
  "review_format": "静态赛评委按官方评分表打分（设计/成本/营销/无人系统），动态赛按计时客观计分折算，FSC与FSEC总分1000分（静态325+动态675），FSAC另设无人系统200分专项，按总分排名授奖。",
