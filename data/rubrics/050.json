{
  "competition_id": 50,
  "competition_name": "人工智能创意赛",
  "judging_dimensions": [
    {
      "dimension": "创意性",
      "weight": "30%（官方规程原文）",
      "official_wording": "中国高校计算机大赛—人工智能创意赛规程（组委会原文）：“作品评审将考察创意性、PaddlePaddle技术运用，材料规范性、应用前景等方面，具体如下：创意性 30%：（1）选题及定位。（2）新颖性和独创性。（3）创意转化可行性。”",
      "scoring_points": [
        "选题及定位：应用场景明确（工业、农业、医疗、文化、教育、金融、交通、公共安全、日常生活、公益等）、痛点真实",
        "新颖性和独创性：方案区别于已有产品的原创程度",
        "创意转化可行性：创意能在赛期内落地为可视化应用",
        "作品主题在竞赛过程中不得改变（规程要求）"
      ],
      "common_deductions": [
        "选题空泛、场景牵强",
        "与已有产品/往届作品雷同",
        "竞赛中途改变作品主题和主体内容"
      ]
    },
    {
      "dimension": "技术运用（深度学习平台/大模型技术）",
      "weight": "30%（官方规程原文，2018为“PaddlePaddle技术运用”；2025年起要求基于飞桨及文心大模型并在AI Studio星河社区完成全流程）",
      "official_wording": "规程原文：“PaddlePaddle技术运用 30%：（1）对PaddlePaddle的设计理念、数据类型、内存管理、多设备支持、复杂网络设计、并发编程、多语言接口、分布式训练等的熟知度。（2）PaddlePaddle技术的掌握及运用熟练度。（3）数据处理、任务开发流程、训练与应用等综合能力。”官网2025：“参赛作品须基于百度飞桨及文心大模型相关技术，在飞桨AI Studio星河社区完成相关模型开发、模型部署、模型调用和产品托管/上线的全流程”",
      "scoring_points": [
        "对指定平台（飞桨/文心大模型）核心机制的掌握深度",
        "模型开发-部署-调用-托管全流程在AI Studio完成且可复现",
        "数据处理、训练调优与应用集成的工程质量",
        "技术难点解决与自研工作量占比"
      ],
      "common_deductions": [
        "仅调用现成API无实质开发",
        "作品未在星河社区托管或无法复现",
        "技术方案与演示效果不符"
      ]
    },
    {
      "dimension": "材料规范性",
      "weight": "20%（官方规程原文）",
      "official_wording": "规程原文：“材料规范性 20%：（1）模型源代码、注释的规范性及质量优良度。（2）资料齐全性，逻辑清晰性，重点是否突出。”",
      "scoring_points": [
        "模型源代码与注释规范、质量优良",
        "创意书/说明书按官网模板撰写、资料齐全",
        "文档逻辑清晰、重点突出",
        "各阶段按截止时间提交最后有效版本"
      ],
      "common_deductions": [
        "代码无注释、结构混乱",
        "材料缺项、未用官网模板",
        "逾期提交或版本混乱"
      ]
    },
    {
      "dimension": "应用前景",
      "weight": "20%（官方规程原文）",
      "official_wording": "规程原文：“应用前景 20%：（1）行业需求迫切度。（2）用户需求贴合度。（3）市场价值及推广性。”",
      "scoring_points": [
        "行业需求迫切度与真实用户痛点",
        "方案可用性与用户体验设计",
        "市场价值、推广路径与商业化潜力",
        "社会价值与公益属性（加分观感）"
      ],
      "common_deductions": [
        "需求伪命题、无目标用户",
        "前景论述空泛、无竞品对比",
        "演示仅停留在PPT层面"
      ]
    },
    {
      "dimension": "决赛现场路演答辩",
      "weight": "决赛定性评审环节（现场路演汇报全方位呈现作品实现过程及最终作品）",
      "official_wording": "规程原文：“决赛期间，参赛队伍须通过现场路演汇报的形式，全方位呈现作品实现过程及最终作品。”“初赛和复赛均采取线上评审方式，决赛采取现场答辩的评审方式。”",
      "scoring_points": [
        "路演叙事：创意-技术-演示-前景完整闭环",
        "现场原型/系统演示效果",
        "答辩应答与技术追问应对",
        "团队协作与表达"
      ],
      "common_deductions": [
        "演示翻车无备份方案",
        "念稿、超时",
        "答不清实现细节被判定工作量存疑"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "初赛材料",
      "format": "参赛作品简介+参赛作品创意展示（幻灯片：创新点、设计理念、工作原理、软硬件组成、原型系统；形式含效果图、文档、短视频、源代码含注释）",
      "page_limit": "未明确",
      "deadline_note": "2025届报名及初赛材料提交截止7月25日"
    },
    {
      "item": "复赛材料",
      "format": "参赛作品说明书（官网《复赛作品说明书规范》模板）+作品动态展示视频（3分钟以内）+设计文档、模型源代码（含注释）、可视化应用演示",
      "page_limit": "展示视频3分钟以内",
      "deadline_note": "2025届复赛材料提交截止9月10日"
    },
    {
      "item": "决赛材料",
      "format": "现场路演汇报（作品实现过程+最终作品演示），补充作品介绍PPT按官网模板命名压缩上传",
      "page_limit": "未明确",
      "deadline_note": "2025届决赛现场答辩/颁奖典礼10-11月（海南大学）"
    },
    {
      "item": "平台作品托管",
      "format": "在飞桨AI Studio星河社区完成模型开发、部署、调用和产品托管/上线全流程（2025届）",
      "page_limit": "未明确",
      "deadline_note": "贯穿全程"
    }
  ],
  "process_stages": [
    {
      "stage": "报名+初赛（线上评审）",
      "format": "官网报名，提交作品简介与创意展示，按赛区组织评审，根据各赛区报名队伍数量确定晋级比例",
      "notes": "全国分七大赛区（东北/华北/华东/华中/西北/西南/华南）；2025届截止7月25日"
    },
    {
      "stage": "复赛（线上评审）",
      "format": "提交说明书与3分钟动态展示视频，全国范围综合评选",
      "notes": "晋级不超过50支队伍且不超过初赛报名队数的三分之一"
    },
    {
      "stage": "全国总决赛（现场答辩）",
      "format": "现场路演答辩+颁奖典礼",
      "notes": "2025届10-11月在海南大学；设特等奖1名（5万元）、一等奖5名（2万元）、二等奖10名（1万元）、三等奖若干（2千元）及优秀指导教师奖；获奖队伍享百度校招/实习绿色通道，优秀项目可获产业孵化资助"
    }
  ],
  "review_format": "初赛、复赛均为线上材料评审（创意性30%+平台技术运用30%+材料规范性20%+应用前景20%），决赛为现场路演答辩",
  "judge_preferences": [
    "创意与落地并重：既要场景新颖又要能跑起来（可视化应用展示）",
    "平台技术用得深（模型开发训练部署全流程，非简单套壳）",
    "代码与文档工程素养",
    "答辩讲清工作量与创新贡献"
  ],
