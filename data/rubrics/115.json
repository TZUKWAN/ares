{
  "competition_id": 115,
  "competition_name": "油气储运工程设计技能大赛",
  "judging_dimensions": [
    {
      "dimension": "科学性",
      "weight": "约30%（推断：官方评审四指标之首，工程设计类评审通常以技术正确性为主体）",
      "official_wording": "第十一届大赛通知（官网）：'根据作品的科学性、可行性、创新性和经济性等指标，组委会组织专家进行网络评审和现场评审'。官方评审标准明细见决赛通知附件2（表2），未公开量化分值。【推断】科学性权重约30%。",
      "scoring_points": [
        "工艺计算正确：水力/热力计算、输送工艺方案符合规范",
        "设备选型与参数计算有依据、数据自洽",
        "符合国家标准与行业规范（输油管道设计规范等）",
        "方案逻辑严谨、基础数据引用可靠"
      ],
      "common_deductions": [
        "核心计算错误或前后数据矛盾",
        "违背强制性规范条款",
        "方案存在明显技术性硬伤"
      ]
    },
    {
      "dimension": "可行性",
      "weight": "约25%（推断：设计能否落地是工程类评审核心指标之一）",
      "official_wording": "同上官方通知四指标表述。【推断】可行性权重约25%。",
      "scoring_points": [
        "工艺流程与总图布置可实施",
        "施工/运营可行性论证充分",
        "安全环保措施（HSE）与应急预案完备",
        "符合实际生产运行条件与约束"
      ],
      "common_deductions": [
        "方案脱离工程实际、纸上谈兵",
        "安全环保设计缺失",
        "未考虑现场施工与运维约束"
      ]
    },
    {
      "dimension": "创新性",
      "weight": "约20%（推断：大赛宗旨含'培养创新思维'，创新为四指标之一）",
      "official_wording": "第十一届通知大赛宗旨：'检验知识基础，锻炼实践技能，培养创新思维'；评审四指标含创新性。【推断】创新性权重约20%。",
      "scoring_points": [
        "工艺方案有改进或新思路（新能源融合、智能储运等）",
        "对新赛题情境的针对性创新设计",
        "方法/工具应用有新意（仿真软件、优化算法）"
      ],
      "common_deductions": [
        "方案为往届作品或教材案例的简单复刻",
        "创新点与主体设计脱节、为创新而创新",
        "夸大宣称无技术支撑"
      ]
    },
    {
      "dimension": "经济性",
      "weight": "约15%（推断：官方四指标之一，工程设计必算经济账）",
      "official_wording": "同上官方通知四指标表述。【推断】经济性权重约15%。",
      "scoring_points": [
        "投资估算与运行费用测算方法正确",
        "方案比选含技术经济对比",
        "成本优化有量化论证"
      ],
      "common_deductions": [
        "无经济测算或数据无来源",
        "只讲技术不计成本",
        "经济指标计算方法错误"
      ]
    },
    {
      "dimension": "现场答辩与展示",
      "weight": "定性（决赛环节）：PPT讲解不超过15分钟、评委提问不超过10分钟，评委平均分为最终得分",
      "official_wording": "第十一届决赛通知：'每个作品封闭答辩PPT讲解不超过15分钟，评委提问控制在10分钟以内，共计不超过25分钟'；'分数计算方法：所有评委打分取平均值，其中本科生和专科生队伍再乘以系数1.05，为最终的得分'；决赛另设海报展示（宽80cm×高180cm）。",
      "scoring_points": [
        "答辩重点突出、在15分钟内讲清设计方案",
        "回答评委提问准确、专业、不回避缺陷",
        "海报与PPT制作专业、隐去身份信息",
        "团队协作应答、分工合理"
      ],
      "common_deductions": [
        "严重超时或念稿",
        "答辩者不熟悉设计细节（代做嫌疑）",
        "PPT/海报出现学校、姓名等身份信息（违反匿名要求）"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "《方案设计书》",
      "format": "PDF版，按赛题要求完成设计；文件命名'赛题一/赛题二+团队账号+设计书'；不得出现团队成员姓名、学校、学历、专业年级等信息（匿名评审）",
      "page_limit": "以当届《方案设计书》模板为准，未明确",
      "deadline_note": "第十一届要求5月9日12:00前经高校统一打包发送组委会邮箱"
    },
    {
      "item": "《作品申报书》",
      "format": "PDF版，信息填写完整；命名'赛题+团队账号+申报书'",
      "page_limit": "按官方模板",
      "deadline_note": "同上，随设计书一并提交"
    },
    {
      "item": "高校参赛报名表/作品推荐汇总表",
      "format": "官方附件表格电子版，以高校为单位发送",
      "page_limit": "每所高校限推荐8件作品",
      "deadline_note": "3月1日前发送组委会邮箱"
    },
    {
      "item": "决赛答辩PPT+纸质作品书5份+展示海报1张",
      "format": "PPT现场拷贝（隐去学校、作者、指导老师、团队编号）；纸质书正反面打印；海报宽80cm×高180cm（四角留挂扣）",
      "page_limit": "海报1张",
      "deadline_note": "决赛（6月中旬）报到与试讲时提交"
    }
  ],
  "process_stages": [
    {
      "stage": "赛题发布与高校报名",
      "format": "官网发布赛题（1月中下旬），高校报送报名表（3月1日前）",
      "notes": "第十一届2026年1月19日发布两道赛题（赛题一涉及'油库+输油'方向）；各校对本校作品评审排序后择优推荐，每校限8件"
    },
    {
      "stage": "作品申报",
      "format": "提交《方案设计书》+《作品申报书》PDF（匿名）",
      "notes": "逾期作自动放弃处理；作品提交后不再更换指导教师"
    },
    {
      "stage": "网络评审（初评）",
      "format": "组委会组织专家网评",
      "notes": "第十一届5月10日-22日网评；未晋级决赛作品直接授予三等奖（68件）或成功参赛奖（61件）"
    },
    {
      "stage": "专家会评与公示",
      "format": "专家会评确定入围决赛名单，公示3天",
      "notes": "第十一届5月23-24日会评，5月31日公布：75件作品晋级决赛"
    },
    {
      "stage": "决赛（现场评审）",
      "format": "封闭答辩+海报展示（6月中旬）",
      "notes": "按赛题分组（赛题一每组14个作品、赛题二每组11个），线上抽签定组与顺序；每组第一名角逐特等奖；本科/专科队总分乘1.05系数后排序；第十一届决赛6月15-17日在西安石油大学举行"
    }
  ],
  "review_format": "网评（专家匿名函评设计书）+专家会评+决赛现场答辩（评委打分取平均值，本科/专科队乘1.05系数后按分数排序）三级评审。",
  "judge_preferences": [
    "技术方案科学严谨：计算书完整、规范引用准确（评委来自石油高校、科研院所及石油企业）",
    "贴近行业真实场景：赛题为油库、输油管道等实际工程问题，企业背景评委重落地性",
