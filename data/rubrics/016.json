{
  "competition_id": 16,
  "competition_name": "外研社英语系列赛（4项）",
  "judging_dimensions": [
    {
      "dimension": "【演讲赛项】内容与思辨（切题、思想深度、逻辑）",
      "weight": "约15%（四个赛项各占系列赛约1/4；演讲赛项内部内容/表达/思辨约按40/30/30拆分，系评分惯例推断）",
      "official_wording": "官网样题页说明演讲赛项国赛含定题演讲、即兴演讲、回答问题；即兴演讲考查\"应变、思辨、语言表达、知识面与思想深度\"（ucc.fltrp.com官方样题页）。各校赛通知普遍将\"内容（切题、思想深度、逻辑）\"列为评分首要维度。内部权重为【推断】，官方未公开百分制权重。",
      "scoring_points": [
        "定题演讲破题角度新颖、紧扣年度主题（如2023年The Chinese Path to Modernization）",
        "观点有思想深度，论证逻辑严密，能联系当代中国与现实案例",
        "即兴演讲审题准确，短时间内搭建完整论述框架",
        "回答评委提问切中要点，不回避、不跑题"
      ],
      "common_deductions": [
        "背诵痕迹明显、缺乏与听众交流感",
        "内容套话空话多，堆砌名言而无论证",
        "即兴与问答环节明显偏题或冷场"
      ]
    },
    {
      "dimension": "【演讲赛项】语言与表达（语音语调、台风、感染力）",
      "weight": "约10%（赛项内部比例为推断）",
      "official_wording": "各赛区规程要求评分标准\"标准化、公平、公正\"，全国总决赛评分标准可作为各级比赛参考；备赛材料将语言、表达列为评审核心维度。具体权重【推断】。",
      "scoring_points": [
        "语音语调自然地道，重音、节奏处理得当",
        "肢体语言与眼神交流自然，台风稳健",
        "语速适中、时间把控精准（定题演讲约3分钟）",
        "用词准确得体，修辞服务于表达"
      ],
      "common_deductions": [
        "严重超时或时长不足",
        "中式英语、语法错误密集影响理解",
        "机械背诵、无临场互动"
      ]
    },
    {
      "dimension": "【辩论赛项】论证质量与策略（BP议会制内容分）",
      "weight": "约15%（辩论采用排序判决制，无官方百分制权重，此处为系列赛内占比推断）",
      "official_wording": "大赛采用英国议会制（BP）辩论，每场4支队伍8名辩手（heep.fltrp.com第27届地区复赛通知及百度百科）；百度百科词条列评分要素为\"逻辑论证、语言表达、临场反应及团队协作\"。BP评分细则（speaker分与队伍排序）以评委培训材料为准【推断】。",
      "scoring_points": [
        "clash（争议焦点）把控明确，论证链条完整",
        "证据、例证与推理支撑充分",
        "反方有效反驳（rebuttal），上/下议院职责分工清晰",
        "即兴辩题15分钟准备期内完成立论分工"
      ],
      "common_deductions": [
        "新论点出现在总结发言环节（invalid extension）",
        "仅重复己方论点而无交锋",
        "发言严重不足或超时被扣分"
      ]
    },
    {
      "dimension": "【辩论赛项】语言表达与临场反应",
      "weight": "约10%（赛项内部比例为推断）",
      "official_wording": "百度百科词条及BP评委培训材料（知乎整理版）均将语言表达、临场反应列为判决要素。具体权重【推断】。",
      "scoring_points": [
        "英语表达流利，学术词汇与辩体语言得体",
        "POI（质询）提出与应对得当",
        "面对质询反应迅速、不失风度"
      ],
      "common_deductions": [
        "照稿宣读、缺乏即兴交锋",
        "攻击性言辞或人身攻击",
        "频繁卡顿导致论证中断"
      ]
    },
    {
      "dimension": "【写作赛项】100分制机评+人评（议论文+说明/记叙文）",
      "weight": "约25%（写作赛项占系列赛约1/4；卷面满分100分，初赛120分钟）",
      "official_wording": "官方样题页（ucc.fltrp.com）：全国线上初赛为议论文1篇（300—400词）+说明文1篇（300—400词）；省赛议论文400—600词+说明文300—500词；国赛为基于特定情境的议论文1篇（700—900词）、记叙文1篇（700—900词）；\"议论文侧重考查选手对现象、观点、言行等的分析、评价、论述\"。iWrite 2.0为官方唯一指定评阅系统。",
      "scoring_points": [
        "议论文：审题准确，分析、评价、论述能力突出",
        "说明文：图表信息解读与阐释清晰",
        "记叙文：描写叙述生动，形象思维与创意性强",
        "语言准确性与词汇语法多样性",
        "篇章结构完整、衔接自然，词数符合区间要求"
      ],
      "common_deductions": [
        "词数低于或超出规定区间",
        "套用模板痕迹明显、内容空泛",
        "严重语法错误与拼写错误",
        "离题或部分偏题"
      ]
    },
    {
      "dimension": "【阅读赛项】客观题为主机读评分+Read and Create主观题",
      "weight": "约25%（阅读赛项占系列赛约1/4；初赛为客观题机读评分）",
      "official_wording": "官网章程（uchallenge.unipus.cn）：阅读大赛比赛内容包含四个模块——Part I Read and Know（读以明己）、Part II Read and Reason（读以察世）、Part III Read and Question（读以启思），省赛与国赛另设Read and Create（读以言志，主观题，话题出自官方指定书目）。前三个模块为客观题，iTEST为官方唯一指定赛事平台。",
      "scoring_points": [
        "重要论述、中华思想文化术语、名言等积累题的正确率",
        "中短篇文本信息获取、判断与逻辑推理",
        "同主题多文本对比分析与整合能力",
        "Read and Create：理解、总结、评价与创新表达"
      ],
      "common_deductions": [
        "答题卡/系统提交失误、漏答",
        "阅读速度分配不当导致大面积空题",
        "主观题偏离指定书目话题"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "演讲赛项网络赛场/初赛参赛视频",
      "format": "MP4视频（定题演讲约3分钟，题目由官网提前公布）",
      "page_limit": "未明确（以当年通知为准）",
      "deadline_note": "按官网与校赛通知节点提交，校赛/省赛题目由各院校和省组委会自定"
    },
    {
      "item": "写作赛项线上作答",
      "format": "iWrite 2.0平台在线写作提交",
      "page_limit": "初赛议论文+说明文各300—400词；国赛各700—900词",
      "deadline_note": "全国统一线上初赛在规定时段内120分钟完成，满分100分"
    },
    {
      "item": "阅读赛项线上作答",
      "format": "iTEST平台在线答题（客观题为主，省赛/国赛含主观题Read and Create）",
      "page_limit": "未明确",
      "deadline_note": "各阶段组委会统一安排"
    },
    {
      "item": "辩论赛队报名材料",
      "format": "外研社Heep平台线上报名（2人一队）",
      "page_limit": "未明确",
      "deadline_note": "地区复赛报名一般3月中下旬截止（如第27届华东报名截止3月20日）"
    }
  ],
  "process_stages": [
    {
      "stage": "校赛/初赛（演讲、写作、阅读）",
      "format": "院校自命题选拔，或参加全国统一线上初赛（写作/阅读在指定平台进行）",
      "notes": "校赛、省赛题目由各院校和省组委会自行决定；表现优异者晋级省赛"
    },
    {
      "stage": "省赛/复赛（演讲、写作、阅读）",
      "format": "各省（赛区）组委会组织，写作省赛为议论文400—600词+说明文300—500词",
      "notes": "阅读省赛增加Read and Create主观题模块；省赛优胜者晋级国赛"
    },
    {
      "stage": "国赛/全国总决赛（演讲、写作、阅读）",
      "format": "演讲：定题演讲+即兴演讲+回答问题；写作：议论文+记叙文各700—900词；阅读：四模块",
      "notes": "赛题围绕\"理解中国，沟通世界\"主题；获得往届国赛冠、亚、季军的选手不得继续参加该语种该赛项比赛"
    },
    {
      "stage": "辩论赛：校园选拔赛→地区复赛→全国决赛",
      "format": "BP英国议会制辩论，每场4队8名辩手，即兴辩题、15分钟准备",
      "notes": "第27届覆盖全国近500所高校超一万支队伍；地区复赛分华北、华东、华南、华西四赛区，各赛区优胜队晋级全国决赛"
    }
  ],
  "review_format": "演讲/辩论为评委现场（或看视频）即时打分排序；写作采用iWrite系统机评+专家人评百分制；阅读以iTEST平台机读客观题为主、辅以主观题人评。",
  "judge_preferences": [
    "演讲与写作均强调\"理解中国、沟通世界\"主题下的思想深度与思辨能力，反对空洞套话",
    "语言准确性与得体性是底线，思想内容权重在决赛阶段显著上升",
    "即兴环节（即兴演讲、回答问题、BP交锋）最能拉开分差，评委看重真实语言能力而非背诵",
    "阅读赛项重视中华文化术语与多文本整合，考查知识面与阅读效率"
  ],
