{
  "competition_id": 1,
  "competition_name": "中国国际大学生创新大赛",
  "judging_dimensions": [
    {
      "dimension": "创新维度（创新性）",
      "weight": "创意组30%（第六届官方评审规则）；初创组/成长组20%；2023年更名后各届微调，2025版推断：创意组约30%-40%",
      "official_wording": "第六届官方评审规则：'原始创新或技术突破并取得专利、奖励等行业认可成果；在商业模式、产品服务、管理运营、市场营销、工艺流程、应用场景等方面有突破'。CSDN备赛指南佐证：创意组创新性通常占30%-40%。",
      "scoring_points": [
        "核心技术/模式的原创性与技术壁垒（专利、软著、论文等成果）",
        "解决真问题的程度：痛点是否真实、与现有方案对比优势",
        "技术指标有第三方检测/查新报告支撑",
        "创新点与学生所学专业的结合（学科交叉加分）"
      ],
      "common_deductions": [
        "创新点停留在概念、无专利或查新佐证",
        "与市面上已有产品同质化",
        "技术表述夸大、经不起评委追问技术细节"
      ]
    },
    {
      "dimension": "团队维度（团队情况）",
      "weight": "创意组/初创组/成长组均为25%（第六届官方评审规则）",
      "official_wording": "第六届官方评审规则：'考察成员教育、实践、工作背景、创新能力、分工协作与互补；组织构架、股权结构、人员配置及激励制度合理性；外部资源使用情况'；初创/成长组重点考察成员投入程度。",
      "scoring_points": [
        "团队构成与项目需求匹配（技术+市场+设计互补）",
        "分工明确、指导教师作用合理（不越位代做）",
        "股权结构与组织架构合理，团队稳定性",
        "成员真实投入度与成长故事"
      ],
      "common_deductions": [
        "成员全部同专业、结构单一",
        "明显挂名、评委提问时成员答不上分工内容",
        "股权结构畸形或与指导教师权益纠纷痕迹"
      ]
    },
    {
      "dimension": "商业维度（商业性）",
      "weight": "创意组20%；初创组/成长组30%（第六届官方评审规则）",
      "official_wording": "第六届官方评审规则（创意组）：'商业模式设计完整、可行，项目已具备盈利能力或具有较好的盈利潜力；商业机会识别与利用、产品或服务设计、技术基础、竞争与合作、资金及人员计划具有可行性；强调实地调研形成一手材料'。初创/成长组：'重点考察存续时间、营收（合同订单）、利润、市场份额、税收、投入产出比等经营绩效及成长性、现金流与融资合理性'。",
      "scoring_points": [
        "市场容量测算有一手调研数据支撑",
        "盈利模式闭环清晰、已落地案例/合同订单",
        "财务预测与融资规划合理",
        "已注册公司组别：真实营收、税收、市场份额等经营数据"
      ],
      "common_deductions": [
        "市场分析拍脑袋、无一手数据",
        "财务模型漏洞明显、估值无依据",
        "初创/成长组却拿不出真实经营流水"
      ]
    },
    {
      "dimension": "社会价值维度（带动就业/社会贡献）",
      "weight": "创意组/初创组/成长组均为15%（第六届官方评审规则）；2025版评审规则延续社会价值维度（含就业带动）",
      "official_wording": "中国国际大学生创新大赛（2025）评审规则（转载版）：'项目直接提供就业岗位的数量和质量；项目间接带动就业的能力和规模；项目对社会文明、生态文明、民生福祉等方面的贡献'。",
      "scoring_points": [
        "直接/间接带动就业的数量与质量",
        "服务乡村振兴、双碳、民生等国家战略",
        "社会效益有量化数据（受益人数、帮扶规模）"
      ],
      "common_deductions": [
        "社会价值空喊口号、无量化数据",
        "就业带动与项目体量明显不匹配"
      ]
    },
    {
      "dimension": "教育/引领教育维度",
      "weight": "第六届创意组10%；第八届起教育导向持续加强，2023年更名后推断：约15%-30%（以当届评审规则为准）",
      "official_wording": "第六届官方评审规则：'体现专创结合、专业知识转化应用；突出育人本质，锻炼创新精神与创业能力'。官方解读：第八届评审规则'更突出教育导向'，加大教育分值比重，聚焦学生在创新创业实践中的成长与收获。【推断：更名后教育维度权重上调幅度未获官方原文，需查当届评审规则】",
      "scoring_points": [
        "项目源于课程/科研训练、体现专创融合",
        "学生在项目中的真实成长与能力锻炼轨迹",
        "以赛促教、带动学校创新创业教育改革",
        "学科交叉与产教融合叙事"
      ],
      "common_deductions": [
        "项目与成员专业完全脱节",
        "教育叙事模板化、看不出学生真实参与"
      ]
    },
    {
      "dimension": "赛道专项维度（红旅/职教/产业命题差异化）",
      "weight": "定性：红旅公益组按公益性20%+实效性20%+创新性20%+项目团队20%+可持续性10%+引领教育10%（第六届官方）；产业命题赛道按企业命题需求与落地可行性评审",
      "official_wording": "第六届官方评审规则（红旅公益组）：'公益性——项目以社会价值为导向，以解决社会问题为使命，不以营利为目的；实效性——对精准扶贫、乡村振兴和社区治理的贡献；可持续性——模式可复制、可推广、具有示范效应'；参加红旅活动为参赛必要条件。产业命题赛道：企业出题、学生解题，重点评审解决方案与命题需求的契合度和落地可行性。",
      "scoring_points": [
        "红旅项目：报名参加'青年红色筑梦之旅'活动并有实地痕迹",
        "公益组：非营利属性清晰、受益面与实效性数据",
        "产业命题：方案与企业真实需求的匹配度、可落地性",
        "职教赛道：产教融合、校企合作与'大国工匠'导向"
      ],
      "common_deductions": [
        "红旅项目未实际参加红旅活动（一票否决性质）",
        "公益项目实际以营利为目的",
        "产业命题方案答非所问、未针对命题企业场景"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "商业计划书（项目计划书）",
      "format": "Word/PDF，经全国大学生创业服务网（cy.ncss.cn）系统提交",
      "page_limit": "未明确（校赛常见要求35-45页，含财务、市场附录）",
      "deadline_note": "报名及材料提交约每年4-8月；省赛网评前完成定稿"
    },
    {
      "item": "项目展示PPT",
      "format": "PPT；分网评版与现场路演版",
      "page_limit": "未明确（网评版常见30-45页；现场路演版15-20页，对应8-10分钟陈述）",
      "deadline_note": "随网评材料提交；晋级后为总决赛路演材料，赛前需彩排报备"
    },
    {
      "item": "项目介绍视频/VCR",
      "format": "MP4，通常1-3分钟（部分赛道/省赛要求）",
      "page_limit": "未明确",
      "deadline_note": "与网评材料同期提交"
    },
    {
      "item": "佐证材料",
      "format": "专利证书、软著、检测报告、合同订单、财务报表等扫描件",
      "page_limit": "未明确",
      "deadline_note": "随网评材料提交；初创组/成长组须提供公司注册与经营证明"
    }
  ],
  "process_stages": [
    {
      "stage": "校赛（校级初赛）",
      "format": "校内选拔：材料网评+校赛路演，择优推荐省赛",
      "notes": "每年5-6月；支持跨院系、跨校组队，负责人身份决定组别（创意组须未注册公司）"
    },
    {
      "stage": "省赛（复赛）",
      "format": "省级网评+现场决赛，多轮排位",
      "notes": "每年7-8月；省赛名额决定国赛推荐资格"
    },
    {
      "stage": "国赛网评（半决赛/排位赛）",
      "format": "全国评审委员会对入围项目多轮网评打分",
      "notes": "每年9-10月；凭计划书+PPT+佐证材料盲评，评出入围总决赛项目"
    },
    {
      "stage": "总决赛现场赛",
      "format": "现场路演答辩（项目展示约8-10分钟+评委问辩），金奖争夺赛、冠军争夺赛逐级PK",
      "notes": "2024年总决赛在上海交通大学（10月）；2025年在郑州大学；高教主赛道产生冠亚季军与金/银/铜奖"
    }
  ],
  "review_format": "网评（计划书/PPT/佐证材料盲评）+现场路演答辩（约8-10分钟展示+评委问辩），校-省-国三级多轮晋级",
  "judge_preferences": [
    "选题对齐国家战略与产业真需求（乡村振兴、双碳、卡脖子技术、数字经济）",
    "硬科技含量与知识产权布局（发明专利、查新报告、第三方检测）",
    "教育维度真实：学生深度参与、学科交叉、可见的成长轨迹",
    "数据说话：一手调研、合同订单、营收用户数据等落地证据",
    "路演表现力与答辩逻辑：负责人学历层次与专业素养近年明显走高"
  ],
  "past_winning_patterns": [
    "金奖项目硬科技化：AI大模型行业应用、燃料电池膜电极、法律AI、高端装备、生物医药等方向集中（2024-2025）",
    "负责人高层次化：金奖答辩多由博士/博士后领衔，'高层次人才+硬科技+真落地'成为金奖主流画像",
    "奖项扩容：高教主赛道金奖268项、银奖526项（2024）→金奖317项、银奖620项（2025，教育部公告）",
    "呈现形式：8-10分钟路演+数据大屏/VCR+实时经营数据；强调落地案例演示而非概念宣讲",
    "备赛体系化：校赛-省赛-国赛三级、暑期多轮排位赛、行业专家按评审五维度逐轮辅导",
    "教育维度叙事成为加分项：学科交叉、专创融合、以赛促教案例常出现在金奖路演中"
  ],
  "forbidden_or_risky": [
    "官方明令杜绝参赛文本及路演材料（PPT、项目书等）商业外包、过度包装",
    "曾获往届国赛金奖/银奖的项目不得再次报名参赛",
    "知识产权权属不清、项目非学生真实成果、成员挂名",
    "数据造假：虚构营收、订单、用户量，答辩追问易穿帮",
    "组别与身份不符：如已注册公司却报创意组，红旅项目未实际参加红旅活动"
  ],
