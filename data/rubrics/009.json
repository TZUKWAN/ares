{
  "competition_id": 9,
  "competition_name": "全国大学生结构设计竞赛",
  "judging_dimensions": [
    {
      "dimension": "加载表现（模型加载试验）",
      "weight": "总分的80%（第十四届官方：加载表现分值80分/总分100分）",
      "official_wording": "12.1总分构成……d)加载表现评分：满分80分。第一级加载得分系数 k1=min(Mmin/Mi,1)（该级加载成功/失败）；第二级第1、2步及第三级加载得分系数 k=min(1, (Gi−Gmin)/(Gmax−Gmin)×n)，n=2（第十四届全国大学生结构设计竞赛赛题第12条，竞赛委员会文件）",
      "scoring_points": [
        "第一级静载加载得分与模型自重挂钩：模型越轻（Mi越小）得分系数 Mmin/Mi 越高",
        "第二级荷载转移两步骤的加载量在通过队伍中的相对水平（按 (Gi−Gmin)/(Gmax−Gmin)×2 计系数）",
        "第三级移动荷载（铅球滚过桥面）成功登岸，每队2次机会",
        "挠度控制：测试点最大允许挠度±10mm，超限影响判定",
        "整个加载过程须在300秒内完成，每级加载后读秒10秒结构不失效方为成功"
      ],
      "common_deductions": [
        "任一级加载失效则该级及后续级得分系数记0",
        "加载过程超时300秒",
        "加载绳/钢丝绳与模型构件接触等操作违规"
      ]
    },
    {
      "dimension": "模型结构与制作质量",
      "weight": "总分的10%（官方：分值10分，结构体系5分+制作工艺5分）",
      "official_wording": "模型结构与制作质量分Bi由专家根据模型结构体系（结构的合理性、创新性、实用性等）与制作工艺（制作质量、美观性等）进行评分，其中模型结构与制作质量各占5分（第十四届赛题第12.2条）",
      "scoring_points": [
        "结构体系选型的合理性（传力路径清晰、构件布置有效）",
        "结构创新性（新型节点、构造与体系创意）",
        "制作工艺水平：杆件切口平整、节点粘接密实、外观美观",
        "实物模型与设计图纸的一致性"
      ],
      "common_deductions": [
        "实物模型与设计图纸出现明显差异，经评委会认定可取消参赛资格",
        "节点粗糙、杆件弯扭变形影响观感与性能",
        "使用组委会统一发放材料之外的任何材料"
      ]
    },
    {
      "dimension": "理论方案（计算书与设计文件）",
      "weight": "总分的5%（官方：理论方案分值5分）",
      "official_wording": "理论方案分Ai由专家根据计算内容的科学性、完整性、准确性和图文表达的清晰性与规范性等进行评分；理论方案不得出现参赛学校的标识，否则为零分（第十四届赛题第12.2条）",
      "scoring_points": [
        "计算模型描述与主要计算参数的完整性",
        "强度、刚度、稳定三方面计算结果的准确性",
        "备赛过程总结（理论、试验、计算准备）的呈现",
        "A3幅面模型轴测图清晰表达结构体系"
      ],
      "common_deductions": [
        "理论方案出现参赛学校标识直接零分",
        "计算书缺强度/刚度/稳定性任一方面评价",
        "未按规定时间（第一比赛日18:00前）以PDF/Word提交U盘"
      ]
    },
    {
      "dimension": "现场陈述与答辩",
      "weight": "总分的5%（官方：现场陈述与答辩分值5分）",
      "official_wording": "现场陈述与答辩分Ci由专家根据队员现场陈述和回答评委提问的综合表现（内容表述、逻辑思维、创新点和回答等）进行评分，满分5分（第十四届赛题第12.2条）",
      "scoring_points": [
        "陈述的内容组织与逻辑性",
        "对结构体系与设计思路的阐释深度",
        "回答评委提问的准确性与应变"
      ],
      "common_deductions": [
        "陈述超时或照稿宣读",
        "队员对计算依据不清楚、答非所问"
      ]
    },
    {
      "dimension": "违规罚分与资格判定",
      "weight": "通过制扣分项（违规即罚分或取消资格，不占百分制权重）",
      "official_wording": "模型违规标准：出现10种情况之一判定违规，取消比赛资格（第十四届赛题第11.1条）；如发现实物模型与设计图纸出现明显差异，经评委会认定，可取消该队的参赛资格（同文件12.2条）",
      "scoring_points": [
        "模型与支座竹板接触范围、规避区、桥下净空等几何合规性",
        "模型尺寸与安装检查（尼龙绳绑扎区域、检测板圆孔通过性）",
        "材料使用仅限组委会提供的竹材及规定辅料"
      ],
      "common_deductions": [
        "不满足接触范围/规避区/净空等几何要求取消资格",
        "尼龙绳质量未计入自重或挂点超出规定区域",
        "私自携带未许可工具、材料入场"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "理论方案（含现场设计计算）",
      "format": "电子版PDF+Word，模型轴测图以PDF格式提交，介质U盘",
      "page_limit": "含备赛过程总结+现场计算两部分，A3幅面轴测图1张",
      "deadline_note": "第一比赛日18:00前提交"
    },
    {
      "item": "现场制作竹质模型",
      "format": "使用组委会统一发放竹材现场制作（第十四届：竹皮1250mm×430mm×0.20mm等，发放量有上限）",
      "page_limit": "未明确",
      "deadline_note": "按当届赛程现场制作并提交检测"
    },
    {
      "item": "加载方案与固定螺钉数量申报",
      "format": "与理论方案一并提交（含第二级加载的加载方案）",
      "page_limit": "未明确",
      "deadline_note": "第一比赛日18:00前"
    }
  ],
  "process_stages": [
    {
      "stage": "校赛/省赛区预赛",
      "format": "各高校校内选拔，省级竞赛按章程推荐（如省赛一等奖高校获全国赛参赛资格）；分区赛可采用国赛赛题简化版（调整或删减待定参数）",
      "notes": "竞赛为教育部、财政部教高函〔2007〕30号批准的全国性学科竞赛资助项目，设竞赛委员会与专家委员会"
    },
    {
      "stage": "全国总决赛",
      "format": "现场设计（抽签确定待定参数）+限时制作+理论方案提交+模型加载试验+陈述答辩；每届由承办高校命题并经专家委员会审定（第十四届由上海交通大学命题承办）",
      "notes": "官网 www.structurecontest.com；近年赛题含桥梁静载+移动荷载（第十四届）、拟动力/振动台加载（第十六届）等，加载形式随届次变化"
    }
  ],
  "review_format": "现场加载试验为主导（占总分80%）的百分制评分：加载得分按以模型自重和各级荷载通过情况为核心的效率比公式自动计算，理论方案、制作质量、答辩由专家独立评分，违规罚分单列。",
  "judge_preferences": [
    "轻质高强：效率比（荷载/模型自重）是加载得分的核心，减重与承载力同等重要",
    "变形控制意识：挠度限值（第十四届±10mm）内的刚度设计",
    "结构体系合理且有创新，传力路径清晰",
    "制作工艺精细、图实一致",
    "现场答辩能讲清力学依据与设计逻辑"
  ],
