{
  "competition_id": 71,
  "competition_name": "测绘创新创业智能大赛",
  "judging_dimensions": [
    {
      "dimension": "测绘技能类赛项——计算机系统自动评分成绩",
      "weight": "40%（赛项内官方口径为自动评分80%；此为全赛口径下的合成权重推断）",
      "official_wording": "中国测绘学会教育工作委员会2026年大赛通知（csgpc.org）：\"决赛成绩由竞赛计算机评分系统自动评分（80%）和专家评判（20%）相结合方式评定\"；虚拟仿真数字测图、无人机航测虚拟仿真、机载激光雷达虚拟仿真、测绘程序设计等赛项均适用该口径。合成权重【推断】，依据技能类赛项为参赛规模主体。",
      "scoring_points": [
        "成果数据精度与质量（数字测图地物要素完整性、成图规范）",
        "无人机航测仿真：实景三维单体化建模质量、数据处理与算法设计",
        "机载激光雷达点云处理结果的准确性与效率",
        "测绘程序设计：程序运行正确性、算法效率（系统自动测试用例得分）",
        "限时内完成度（系统按用时与正确率综合计分）"
      ],
      "common_deductions": [
        "成果文件格式不符导致系统无法评判",
        "操作超时或漏做任务模块",
        "抄袭他人数据成果，系统查重判负分或取消成绩"
      ]
    },
    {
      "dimension": "测绘技能类赛项——专家评判",
      "weight": "10%（赛项内官方口径为专家评判20%；合成权重推断）",
      "official_wording": "同上2026年大赛通知：决赛\"计算机评分系统自动评分（80%）和专家评判（20%）相结合\"；校赛阶段由竞赛计算机评分系统自动评判。合成权重【推断】。",
      "scoring_points": [
        "技术路线的合理性与创新性",
        "成果表达的专业规范性（图式、符号、注记）",
        "复杂场景处理能力（虚实协同数字测图团队赛中的人机协同水平）",
        "团队配合与分工展示"
      ],
      "common_deductions": [
        "成果明显雷同（组间抄袭）",
        "违反操作规程、伪造外业数据",
        "决赛答辩/质询环节答不上技术细节"
      ]
    },
    {
      "dimension": "开发设计竞赛",
      "weight": "约20%（推断，按三大竞赛类别规模与历届获奖分布估计）",
      "official_wording": "2026年大赛通知设\"测绘技能竞赛、开发设计竞赛和科技论文竞赛\"三大类；开发设计竞赛由专家人工评判（\"其他比赛由人工评判\"）。分值细项官方未公开，权重【推断】。",
      "scoring_points": [
        "选题面向测绘地理信息真实业务痛点，实用价值明确",
        "软硬件/平台系统功能完整、可演示、可复现",
        "技术方案先进性（AI、实景三维、点云、无人化采集等）",
        "文档与演示质量，创新性与产业化前景"
      ],
      "common_deductions": [
        "作品为课程作业简单包装，创新点牵强",
        "演示环节系统崩溃且无备份",
        "关键功能为开源代码拼装未作说明"
      ]
    },
    {
      "dimension": "科技论文竞赛",
      "weight": "约25%（推断）",
      "official_wording": "科技论文竞赛由竞赛组委会组织专家评审（西南交通大学2022年征文通知：论文限5000字左右、须原创且未发表、每校限额报送）；评分细项官方未公开，权重【推断】。",
      "scoring_points": [
        "选题学术价值与工程应用前景",
        "研究方法与数据处理科学严谨",
        "创新性结论与学术贡献",
        "写作规范（约5000字、图表公式规范、参考文献完整）"
      ],
      "common_deductions": [
        "已发表或一稿多投被查实",
        "超出限额报送被取消参评",
        "数据来源不明、试验设计不可复现"
      ]
    },
    {
      "dimension": "规程符合性与竞赛纪律",
      "weight": "约5%（推断；违规一票否决式扣罚）",
      "official_wording": "大赛采用\"选手线上参赛、评委线下评审\"模式（2026年河南理工大学承办届），各赛项规程均要求独立完成、禁止代考代做；具体扣罚条款【推断】自高校竞赛纪律惯例。",
      "scoring_points": [
        "报名信息与实际参赛人员一致",
        "全程开启监控/遵守线上参赛环境要求",
        "按规程限时提交成果"
      ],
      "common_deductions": [
        "替考、代做等作弊行为取消成绩并通报",
        "线上参赛环境违规（离屏、他人协助）",
        "逾期提交成果"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "技能类赛项成果数据包（数字测图成果/航测建模成果/点云成果/程序源代码）",
      "format": "按各赛项规程规定的数据格式在线提交，由计算机评分系统接收评判",
      "page_limit": "未明确",
      "deadline_note": "赛项规定时限内当场提交（2026年全国决赛约7月底举行，线上参赛）"
    },
    {
      "item": "科技论文（测绘科技论文竞赛）",
      "format": "Word/PDF，学术论文格式，原创且未公开发表",
      "page_limit": "约5000字",
      "deadline_note": "按征文通知限时报送，每校限额（如2022年通知每校限8篇）"
    },
    {
      "item": "开发设计竞赛作品（软硬件系统/平台+说明文档）",
      "format": "可运行系统/演示视频+设计说明文档",
      "page_limit": "未明确",
      "deadline_note": "决赛现场演示或按规定节点线上提交"
    }
  ],
  "process_stages": [
    {
      "stage": "校赛（校内选拔）",
      "format": "各校组织选拔，虚拟仿真类赛项由竞赛计算机评分系统自动评判",
      "notes": "按校赛成绩择优组队推荐参加全国赛；官方竞赛平台统一训练与模拟"
    },
    {
      "stage": "全国决赛",
      "format": "选手线上参赛、评委线下评审；技能类与程序设计类为自动评分80%+专家评判20%，其他赛项专家人工评判",
      "notes": "2026年由河南理工大学承办（7月底），400余所高校8600余名学生参赛；分测绘技能竞赛（含数字测图、无人机航测仿真、机载激光雷达仿真、测绘程序设计、虚实协同数字测图团队赛等）、开发设计竞赛、科技论文竞赛三大类，按赛项分别设奖（特等奖/一二三等奖）"
    }
  ],
  "review_format": "技能类赛项以竞赛平台计算机自动评分为主（80%）、专家评判为辅（20%），论文与开发设计类由组委会组织专家人工评审。",
  "judge_preferences": [
    "成果精度与规范：数据、图件严格遵循测绘行业标准与图式",
    "虚实结合与新技术的真实掌握（无人机航测、激光雷达、AI赋能）",
    "程序设计重运行正确性与算法效率，而非纸面算法",
    "论文重原创性与工程应用价值，反对拼凑"
  ],
