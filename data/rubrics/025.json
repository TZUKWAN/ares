{
  "competition_id": 25,
  "competition_name": "地质技能竞赛",
  "judging_dimensions": [
    {
      "dimension": "野外地质技能（实地作业与路线观察）",
      "weight": "野外单元独立评奖；室内准备+野外实地作业连续计分（具体分值未公开，章程仅给出总评原则）",
      "official_wording": "章程评奖标准：'以操作的娴熟度、阐述的准确性、结果的正确性和文字表述的逻辑性为主要标准'；野外单元由室内准备（图件判读、设计观察路线等）与野外实地作业组成（第八届实地作业在广元青川野外场地进行）。",
      "scoring_points": [
        "野外路线观察记录的规范性：格式（日期/天气/地点、路线编号、任务）、信手剖面、素描图与照片标注",
        "地质点位识别与描述准确性：地层、岩性、构造（褶皱/断层/节理）判读及产状测量",
        "野外地质图/填图成果与实际地质情况吻合度",
        "工具使用娴熟度：罗盘、放大镜、稀盐酸、地形图与GPS/平板填图设备",
        "观察路线设计合理性（室内准备阶段成果）"
      ],
      "common_deductions": [
        "记录本涂改、追记补记、格式不合规范",
        "产状测量错误或岩性描述张冠李戴",
        "安全违规（不戴安全帽、脱离队伍单独行动）",
        "路线设计明显绕远或遗漏关键地质点"
      ]
    },
    {
      "dimension": "地质技能综合应用（室内图件与综合分析）",
      "weight": "独立单元评奖，与前三单元累计得分决定地学知识竞赛参赛资格；具体分值未公开",
      "official_wording": "竞赛简介：'竞赛分为地质技能综合应用、野外地质技能、地质标本鉴定、地学知识竞赛4个单元的竞赛环节，历时3天'；第四届通知：'根据前三个项目竞赛综合成绩累计得分，按队按校依次排名选拔出学校参加地学知识竞赛'。",
      "scoring_points": [
        "地质图判读与地层剖面图编制的正确性",
        "地层柱状图/综合柱状图编录规范性（图例、比例尺、岩性描述）",
        "构造解析与地质事件序列分析逻辑",
        "文字报告表述的逻辑性与术语准确性",
        "图面整饰与制图规范（线条、图例、注记）"
      ],
      "common_deductions": [
        "图例与图面内容不符、比例尺错误",
        "剖面图地形线与地质界线矛盾",
        "文字表述与图件结论不一致",
        "超时未完成或漏题"
      ]
    },
    {
      "dimension": "地质标本鉴定（手标本+薄片）",
      "weight": "独立单元评奖；具体分值未公开",
      "official_wording": "章程评奖标准同样适用：'操作的娴熟度、阐述的准确性、结果的正确性和文字表述的逻辑性'；标本鉴定单元考察矿物、岩石（含沉积/岩浆/变质）及古生物标本的系统鉴定。",
      "scoring_points": [
        "矿物/岩石定名正确（大类与具体种属）",
        "鉴定依据阐述完整：颜色、光泽、硬度、解理、结构与构造等证据链",
        "薄片观察（如有）：矿物组成、结构构造判读",
        "鉴定过程操作规范与时间控制",
        "古生物化石属种识别与时代判断"
      ],
      "common_deductions": [
        "定名错误且依据与结论矛盾",
        "只给结论不写鉴定依据或依据笼统",
        "标本编号抄错、答题卡填写不规范"
      ]
    },
    {
      "dimension": "地学知识竞赛与团队综合表现",
      "weight": "资格赛性质：前三个项目综合成绩累计排名决定参赛资格；地学知识竞赛独立计奖",
      "official_wording": "第四届通知：'根据前三个项目竞赛综合成绩累计得分，按队按校依次排名选拔出学校参加地学知识竞赛'；竞赛简介：以团队形式参与，'考察素质教育、实践能力、野外技能为主……考验了团队协作能力'。",
      "scoring_points": [
        "基础地学知识（矿物学、岩石学、构造、古生物、矿床等）答题准确率",
        "答题速度与团队分工协作",
        "全队四单元综合表现决定团体奖项",
        "队员之间配合默契、无违规沟通"
      ],
      "common_deductions": [
        "违规翻阅资料或使用未允许的电子设备",
        "队内分工混乱、答题超时",
        "冒名顶替或队员资格不符（非在读学生）"
      ]
    }
  ],
