      "format": "需求分析、方案设计文档+答辩PPT",
      "page_limit": "未明确",
      "deadline_note": "按赛项规程节点，决赛线下答辩"
    }
  ],
  "process_stages": [
    {
      "stage": "校内赛/选拔",
      "format": "高校按赛项组织校内选拔报名",
      "notes": "大赛采取学校、省（自治区、直辖市）和全国三级赛制组织"
    },
    {
      "stage": "省赛/区域赛（初赛）",
      "format": "线上提交方案/线上任务，专家评审（部分赛项线上仿真考核）",
      "notes": "各赛项独立发布《竞赛细则》与样题（如2026离散行业自动化逻辑算法初赛细则）；按比例与分数线选拔晋级"
    },
    {
      "stage": "全国总决赛",
      "format": "线下现场任务+方案答辩（分赛项、分赛区同期或集中举行）",
      "notes": "奖项按赛项分设；赛项覆盖流程行业自动化、离散行业自动化（逻辑算法/工程实践）、运动控制/运动系统设计开发、工业网络、自由探索等"
    }
  ],
  "review_format": "按赛项执行独立《竞赛细则》：初赛以线上方案/任务专家评审为主，总决赛为现场实操考核（按任务点计分）+方案答辩，功能实现为客观计分、方案与答辩为专家打分。",
  "judge_preferences": [
    "真功能、真指标：闭环能投自动、任务点全部跑通是得分基本盘",
    "工程规范与可维护性（程序结构、注释、HMI、文档）日益受重视",
