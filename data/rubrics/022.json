{
  "competition_id": 22,
  "competition_name": "“西门子杯”智能制造挑战赛",
  "judging_dimensions": [
    {
      "dimension": "【流程行业自动化赛项】工艺方案与控制系统实现",
      "weight": "约20%（官方按赛项独立发布竞赛细则，未公开统一百分制权重；系列赛内占比推断）",
      "official_wording": "大赛赛项体系含\"流程行业自动化\"方向（各校获奖通报及大赛介绍：教育部与西门子战略合作框架下的国家级A类赛事，中国仿真学会等主办）；各赛项均有独立《竞赛细则》与评分标准（2026年各赛项细则陆续发布）。赛项内权重【推断】。",
      "scoring_points": [
        "工艺对象理解与控制方案设计（回路整定、联锁保护）",
        "PCS/PLC组态编程实现，仿真对象闭环运行指标",
        "抗扰动与动态品质（超调、稳态时间）达标度",
        "工程文件规范性与安全功能实现"
      ],
      "common_deductions": [
        "关键回路无法投自动",
        "联锁保护缺失导致考核工况失败",
        "程序无注释、组态混乱"
      ]
    },
    {
      "dimension": "【离散行业自动化赛项（逻辑算法/工程实践）】任务完成与程序质量",
      "weight": "约20%（推断）",
      "official_wording": "2026年CIMC离散行业自动化（逻辑算法）初赛竞赛细则、运动系统设计开发赛项样题等官方文件均含按任务点逐项计分的评分表（样题细则公开流传版本）；赛项分逻辑算法与工程实践方向。",
      "scoring_points": [
        "按任务书逐项完成工艺动作/逻辑功能（计分点制）",
        "程序结构、标准化块编程与HMI画面",
        "节拍/效率指标与异常处理",
        "现场调试策略与故障排查能力"
      ],
      "common_deductions": [
        "任务点未完成按表扣分",
        "碰撬、超程等现场事故性失误",
        "程序无法下载运行或依赖外部拷贝失败"
      ]
    },
    {
      "dimension": "【运动控制/运动系统设计开发赛项】轨迹与同步控制性能",
      "weight": "约15%（推断）",
      "official_wording": "2024年\"西门子杯\"运动系统设计开发赛项决赛样题等官方文件显示该赛项考核轨迹规划、多轴同步、电子凸轮等运动控制任务，按精度与完成度评分；赛项分类见于各校获奖通报（\"离散行业运动控制方向\"等）。",
      "scoring_points": [
        "定位精度、轨迹跟踪误差指标",
        "多轴同步与凸轮/齿轮联动实现",
        "速度/加速度参数优化的合理性",
        "驱动组态与调试文档完整"
      ],
      "common_deductions": [
        "超调/振荡不收敛",
        "同步误差超标",
        "参数硬凑无调优过程记录"
      ]
    },
    {
      "dimension": "【工业网络等数字化赛项】网络架构与数据链路",
      "weight": "约10%（推断）",
      "official_wording": "赛项体系含工业网络等方向（工业网络赛项涉及西门子交换机与无线模块配置等教学内容；各校获奖通报含\"智能制造工程设计与应用类\"多方向奖项）。权重【推断】。",
      "scoring_points": [
        "工业以太网/PROFINET拓扑与设备组态",
        "网络诊断与故障恢复",
        "数据采集上云/边侧集成的完整性"
      ],
      "common_deductions": [
        "IP规划混乱、组态不匹配",
        "关键链路冗余未配置",
        "只完成连通性未达性能要求"
      ]
    },
    {
      "dimension": "【通用维度】方案设计与答辩（需求分析—方案设计—方案答辩）",
      "weight": "约20%（依据官方赛制环节设置；占比推断）",
      "official_wording": "中国地质大学（北京）教务处2026年通知：\"参赛队针对项目任务要求，完成需求分析、方案设计、方案答辩等环节\"；\"省赛：线上提交方案，专家对方案进行评审；总决赛：线下进行\"。",
      "scoring_points": [
        "需求分析准确、边界条件识别完整",
        "方案的技术路线、选型论证与经济性",
        "答辩表达与对评委技术追问的应对",
        "方案与最终实现的一致性"
      ],
      "common_deductions": [
        "方案与现场实现脱节",
        "答辩关键问题回避或答错基础概念",
        "文档模板不符、技术文件缺失"
      ]
    },
    {
      "dimension": "【通用维度】工程规范与职业素养（安全、标准、协作）",
      "weight": "约15%（推断）",
      "official_wording": "大赛定位为工程实践能力竞赛，各赛项细则普遍强调工业安全操作与工程规范（细则文本及赛项规程）；权重【推断】。",
      "scoring_points": [
        "用电/设备操作安全合规",
        "符合IEC 61131等工业编程与文档规范",
        "团队分工协作与时间管理",
        "竞赛纪律与设备爱护"
      ],
      "common_deductions": [
        "违规操作导致设备损坏或安全事故",
        "严重超时",
        "竞赛纪律违规（替考、代调试）"
      ]
    }
  ],
