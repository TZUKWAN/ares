{
  "competition_id": 77,
  "competition_name": "企业竞争模拟大赛",
  "judging_dimensions": [
    {
      "dimension": "期末综合经营成绩（系统自动评分排名）",
      "weight": "客观题类赛事：名次由系统综合分数排序决定，决赛名次即最终成绩（权重内置于模拟规则，不公开细分）",
      "official_wording": "2025年全国企业竞争模拟大赛通知（浙江大学MBA中心官网PDF）：\"企业决策赛道采用iBizSim企业竞争模拟系统进行比赛\"；校内选拔通知（成都锦城学院等）：\"按大赛评分标准（系统自动评分），所有参赛团队按总成绩从高到低排序\"；\"比赛结束后依据最后一期的综合成绩（总成绩分数）从高到低排序，确定最终名次\"。",
      "scoring_points": [
        "最后一期综合分数为排名唯一依据，全程经营结果导向",
        "综合分数由系统按多项经营指标加权自动计算，无人为主观打分",
        "同分时按系统中七项指标依次比较确定排名",
        "决策周期内每期经营成绩累计决定期末权益与指标水平"
      ],
      "common_deductions": [
        "某期决策失误（如盲目扩张致现金流断裂、破产）导致期末排名大幅下滑",
        "未按时提交决策，系统按默认决策处理致分数受损",
        "违规互通信息或代操作被取消成绩"
      ]
    },
    {
      "dimension": "经营指标体系得分（利润、市场、财务等加权）",
      "weight": "客观题/分数制：系统按期自动计算各指标加权分数（各项指标权重在模拟规则中公布）",
      "official_wording": "大赛评分机制说明（高校校内选拔赛通知及iBizSim系统规则）：评价指标\"包括本期利润、市场份额、累计分红、累计缴税、净资产、人均利润率、资本利润率等，每期得分由系统自动计算综合评分\"；同分处理\"依据系统中的七项指标依次比较确定最终排名\"。",
      "scoring_points": [
        "盈利能力：本期利润、累计利润、资本利润率、人均利润率",
        "市场表现：市场份额及产品线结构",
        "财务稳健：净资产、现金流、累计缴税与分红（股东回报）",
        "多目标平衡：短期利润与长期发展的权衡能力"
      ],
      "common_deductions": [
        "单一指标极化（如只顾利润压价丢市场份额、或只扩份额拖垮利润）",
        "现金流断裂、资不抵债",
        "忽视分红缴税等股东与社会责任指标"
      ]
    },
    {
      "dimension": "决策过程合规与赛道规则遵守",
      "weight": "分数制：违规直接扣罚或取消成绩（规程纪律条款，一票否决式）",
      "official_wording": "2025年全国企业竞争模拟大赛通知：每名选手只能选择参加其中一个赛道（企业决策赛道与企业运营赛道同步进行）；每支参赛队由3名选手组成，分别担任总经理等不同管理角色；远程比赛依托互联网进行，须独立决策。",
      "scoring_points": [
        "每期决策按时在系统内完成提交",
        "3人团队按角色分工协作（总经理、财务、生产、营销等）",
        "遵守赛道唯一性（不得同时报企业决策与企业运营赛道）",
        "独立决策，不与外队串谋交换市场信息"
      ],
      "common_deductions": [
        "漏交/迟交某期决策按系统默认方案处理",
        "跨赛道重复参赛被取消资格",
        "串谋、代打、使用外挂脚本等作弊行为取消成绩"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "各期经营决策（线上系统内提交）",
      "format": "iBizSim企业竞争模拟系统在线决策（生产、营销、财务、人力、投融资等决策单），无纸质材料",
      "page_limit": "每期决策按系统界面限定项目填写",
      "deadline_note": "全国复赛约2-4月远程进行（快赛数日连赛或慢赛按日推进），半决赛远程，总决赛现场进行（2026年总决赛5月30-31日，华北理工大学）"
    },
    {
      "item": "总决赛现场对抗（线上系统现场登录）",
      "format": "现场使用iBizSim系统进行若干期集中对抗",
      "page_limit": "未明确",
      "deadline_note": "晋级总决赛后按组委会安排现场参赛"
    }
  ],
  "process_stages": [
    {
      "stage": "校内赛（初赛选拔）",
      "format": "各校自行组织，使用iBizSim系统模拟对抗，按总成绩排序择优推荐",
      "notes": "每校各赛道有推荐名额限制；依托官网训练平台（bisai.ibizsim.cn）练习；报名经赛事管理系统（bm.bizsand.cn）"
    },
    {
      "stage": "全国复赛",
      "format": "远程互联网比赛（快赛或慢赛），企业决策赛道与企业运营赛道同步进行",
      "notes": "约2-4月；复赛表现优异者可获直通半决赛名额；按赛区综合分数排名晋级"
    },
    {
      "stage": "全国半决赛",
      "format": "远程互联网比赛，晋级队伍争夺总决赛资格",
      "notes": "决策赛道竞争激烈，全国约42支队伍晋级总决赛（2026年口径）；研究生组、本科组、高职组分别组织（截至2025年12月分别已办23届、16届等）"
    },
    {
      "stage": "全国总决赛",
      "format": "现场比赛（现场登录系统集中对抗若干期，按末期综合分数定名次）",
      "notes": "2026年总决赛5月30-31日在华北理工大学（唐山）举行；一万多支队伍参赛规模；评出全国一二三等奖"
    }
  ],
  "review_format": "纯系统自动评分：iBizSim平台按期计算各队综合经营分数，决赛按最后一期综合成绩从高到低排名，同分按七项指标依次比较，无人工主观评分。",
  "judge_preferences": [
    "结果导向：不看过程汇报，只看系统综合分数排名",
    "看重多目标平衡的稳健经营策略（利润、份额、净资产、股东回报兼顾）",
    "重视现金流与产能规划的精细测算，避免激进扩张崩溃",
    "团队角色分工清晰、每期决策准时提交是基本素养",
    "复赛/半决赛晋级规则看重成绩稳定性而非单期爆发"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "每名选手只能选择参加一个赛道（企业决策或企业运营），重复参赛取消资格",
    "严禁队间串谋交换经营信息、代打代操作，违者取消成绩",
    "未按期提交决策按系统默认处理，责任自负",
    "每队固定3名选手，报名后人员变更须按规程审批",
    "远程比赛须遵守组委会对网络与设备环境的要求，掉线按规程处理"
  ],
