{
  "competition_id": 81,
  "competition_name": "智能农业装备创新大赛",
  "judging_dimensions": [
    {
      "dimension": "创新性",
      "weight": "约30%-35%（A/C/D类核心维度）【推断】",
      "official_wording": "章程将大赛定位为'智能农业装备发明制作/创新设计'（A类为'自由选题、科技发明制作'，D类要求'具超前性或颠覆性的创意设计'，西安交大城市学院转载章程+东北农业大学第十届通知）；官方《ACD类作品评审规则》分值表未公开，权重为【推断：按章程对'发明制作''超前性'的定位及同类装备创新赛权重模型推定】。",
      "scoring_points": [
        "原理、结构、功能有明确创新点，非市面产品的简单复制",
        "选题契合智能农机装备前沿（导航、变量作业、传感、电驱动等）",
        "D类作品须体现超前性/颠覆性，与A类'有样机'的作品拉开层次",
        "有论文、专利等成果佐证创新水平"
      ],
      "common_deductions": [
        "创新点雷同、与往届或市售产品重复",
        "把本应交样机的A/C类作品包装成D类规避样机要求（通知明确严查）",
        "创新描述与申报书论证脱节"
      ]
    },
    {
      "dimension": "科学性与技术方案可行性",
      "weight": "约25%-30%【推断】",
      "official_wording": "大赛章程规定评审委员会'负责对决赛入围的作品进行现场评审'，ACD类单独发布《ACD类作品评审规则》；科学性维度表述为【推断：依据工科装备类赛事通行评审框架与章程'科技含量高'要求推定】。",
      "scoring_points": [
        "总体方案与技术路线合理、参数设计有依据",
        "关键计算、仿真、试验数据严谨可信",
        "成果（论文/专利）须在通知规定的近两年时间窗口内取得"
      ],
      "common_deductions": [
        "方案有明显工程原理错误",
        "数据造假或引用与作品无关的成果充数",
        "申报书论证空洞、只有效果图无实现路径"
      ]
    },
    {
      "dimension": "实用性与农业应用价值",
      "weight": "约20%-25%【推断】",
      "official_wording": "章程要求作品为'智能农业装备'并按耕作/种植/田间管理/节水灌溉/收获/产地初加工/基础零部件等领域设置A1-A8组别（东北农业大学转述第十届类别设置），指向对农业生产真实场景的服务；量化权重为【推断】。",
      "scoring_points": [
        "解决农业生产真实痛点，契合乡村振兴与农机装备补短板需求",
        "有明确应用场景、成本与推广可行性分析",
        "B/C类作品响应指定赛题或企业命题的技术指标"
      ],
      "common_deductions": [
        "脱离农艺场景、纯展示性机器人",
        "成本与可靠性论证缺失、无法落地",
        "答不上应用对象与作业工况"
      ]
    },
    {
      "dimension": "作品完成度与现场答辩",
      "weight": "约15%-20%（决赛现场评审+3分钟答辩）【推断】",
      "official_wording": "章程原文：评审专家组'负责对决赛入围的作品进行现场评审，给出获奖作品的建议结果'；校赛通知要求AC类'须有样机或实物模型'、D类'须有概念视频或实物模型'，并'按3分钟答辩准备PPT'（东北农业大学第十届通知）。量化占比为【推断】。",
      "scoring_points": [
        "样机/实物模型能现场演示核心功能（AC类硬要求）",
        "3分钟陈述重点突出、演示顺畅",
        "答辩回答准确，团队分工与指导教师支持合理"
      ],
      "common_deductions": [
        "无样机或演示失败（AC类直接失分）",
        "陈述超时、答非所问",
        "答辩口径与申报书矛盾"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "大赛申报书",
      "format": "官方模板，Word/PDF",
      "page_limit": "不超过30页",
      "deadline_note": "校赛约9月报送（第十届2024年9月28日截稿）；国赛按当届通知"
    },
    {
      "item": "样机/实物模型或概念视频",
      "format": "实物（AC类必备）、概念视频或实物模型（D类）、软件、设计图录像等",
      "page_limit": "未明确",
      "deadline_note": "随申报书提交材料包，决赛现场演示"
    },
    {
      "item": "答辩PPT",
      "format": "PPT（按3分钟答辩准备）",
      "page_limit": "未明确",
      "deadline_note": "校赛/决赛答辩当日"
    },
    {
      "item": "作品汇总表",
      "format": "Excel汇总表，以项目名称命名压缩包提交",
      "page_limit": "未明确",
      "deadline_note": "校赛统一报送"
    }
  ],
  "process_stages": [
    {
      "stage": "校内选拔赛",
      "format": "现场答辩+评审（A/C/D类答辩，按类别限额推荐）",
      "notes": "约9月；每校A类≤15件、B类≤8件、C类≤5件、D类≤5件"
    },
    {
      "stage": "复赛（网评）",
      "format": "网络评审，通过作品设5个工作日公示期",
      "notes": "下半年；复赛通过作品入围终审决赛"
    },
    {
      "stage": "终审决赛",
      "format": "现场评审+答辩，B类另按比赛规则竞技评判",
      "notes": "下半年举行；获奖作品设5个工作日实名质疑投诉期"
    }
  ],
  "review_format": "ACD类作品经网络评审（复赛）筛选后进入终审决赛现场评审与答辩，B类机器人按指定赛题现场竞技评判，专家组给出获奖建议名单。",
  "judge_preferences": [
    "重视真机实证：A/C类必须携带样机或实物模型并现场演示",
    "偏好解决真实农业生产痛点的智能装备（导航、变量施药、电驱传动等）",
    "D类严把门槛，拒绝用概念设计规避样机要求",
    "认可近两年内取得的论文、专利等佐证成果",
    "强调原创性与真实性，指导教师须对作品原创负责"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "不得使用已获国家级奖励的成果、导师课题成果或他人知识产权申报",
    "不得与往届（前九届）作品重复",
    "成果取得时间须在通知规定窗口内（第十届为2022年9月-2024年9月）",
    "每人每类别限报1件；每件作品指导教师1-3人且至多指导A/C/D类各2件、B类1件",
    "决赛期间关键信息（成员、作品名、类别）不得变更；获奖名单设实名质疑投诉期"
  ],
