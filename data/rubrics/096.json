{
  "competition_id": 96,
  "competition_name": "湖北高校美术与设计大展",
  "judging_dimensions": [
    {
      "dimension": "主题立意与思想性",
      "weight": "综合评议首要维度（专家评审制定性评议，官方未公布分值权重）",
      "official_wording": "官方征稿通知未公布量化评分表，采用专家组（组委会聘请专家组成美术与设计作品评选委员会）初评、复评综合评议【推断依据：美术与设计类大展通行评审维度为选题立意、艺术表现、创作水平、创新性，历届通知要求作品弘扬时代精神、反映社会生活】",
      "scoring_points": [
        "主题健康向上，契合大展弘扬时代精神、荆楚文化的导向",
        "选题新颖，立意深度与人文关怀",
        "社会价值与文化内涵的表达",
        "学生组作品体现独立创作与真实感悟"
      ],
      "common_deductions": [
        "题材陈旧、内容空洞堆砌",
        "思想导向不良或格调低俗直接取消资格",
        "明显应付、与课程作业雷同度高"
      ]
    },
    {
      "dimension": "艺术表现与专业水准",
      "weight": "综合评议核心维度（专家评审定性打分，官方未公布分值权重）",
      "official_wording": "大展设美术类、设计类、摄影类三条赛道，甲组（教师组）、乙组（学生组）分别评审；获奖名单按美术/设计/摄影分类评出一、二、三等奖、优秀奖与入选【推断依据：第四届、第九届征稿通知及获奖通稿，评审按专业门类比较艺术语言与技法完成度】",
      "scoring_points": [
        "美术类：造型能力、构图、色彩、材料语言运用与画面完成度",
        "设计类：设计逻辑、功能与审美统一、方案完整性（KT板展版呈现质量）",
        "摄影类：瞬间捕捉、光影控制、影像语言与专题性",
        "原作装裱展评状态（美术作品装框/装裱规范、宽度不超过200cm）"
      ],
      "common_deductions": [
        "技法粗糙、完成度低、细节失控",
        "设计类缺乏设计过程呈现（仅有效果图无推演）",
        "终评原作与初评照片不符或装裱不规范"
      ]
    },
    {
      "dimension": "创新性与个性表达",
      "weight": "综合评议重要维度（专家评审定性比较原创性，官方未公布分值权重）",
      "official_wording": "官方通知未列出创新性分值；美术与设计类省级大展评审惯例将原创性、语言创新列为与艺术性并列的核心标准【推断依据：历届征稿通知倡导创新，获奖作品通稿普遍强调创意与原创】",
      "scoring_points": [
        "艺术语言、媒介或表现形式的探索性",
        "设计类概念创新与跨领域融合（文创、服务设计、可持续等）",
        "个人风格辨识度，区别于流行图式与往届获奖套路"
      ],
      "common_deductions": [
        "临摹、抄袭或高度雷同既有作品（一经查实取消获奖资格）",
        "套用模板化AI生成或图库素材无再创作",
        "形式新奇但与主题脱节"
      ]
    },
    {
      "dimension": "规范性与报送要求",
      "weight": "资格审查项：不符合报送要求不进入评审或取消参评资格（一票否决）",
      "official_wording": "第九届征稿通知：初评作品纸质版打印为A4大小，背面粘贴《作品登记表》，另需提交电子版；终评美术作品均需装框或装裱（禁用普通玻璃，可用透明薄膜或有机玻璃覆盖），装框后宽度不超过200cm，设计作品制作成KT板（黄冈师范学院、中南民族大学转载通知原文）",
      "scoring_points": [
        "初评：A4纸质打印+电子版+《作品登记表》齐全",
        "终评：原作装框/装裱、KT板规格符合通知",
        "作者资格符合甲组（教师）/乙组（学生）分组且由学校统一报送"
      ],
      "common_deductions": [
        "未按规格打印/装裱、登记表缺失",
        "逾期报送或未经学校统一报送",
        "一人超量报送超出通知限额"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "初评作品",
      "format": "作品照片/纸质版打印为A4，背面粘贴《作品登记表》，同时提交电子版，经学校统一报送",
      "page_limit": "A4规格",
      "deadline_note": "历届征稿多在6-9月（第九届通知2022年7月发布）"
    },
    {
      "item": "终评原作",
      "format": "美术作品装框或装裱（禁用普通玻璃，可用透明薄膜/有机玻璃覆盖），装框后宽度不超过200cm；设计作品制作成KT板；摄影作品按通知装裱",
      "page_limit": "宽度不超过200cm",
      "deadline_note": "入围后按通知时间送原作现场展评"
    }
  ],
  "process_stages": [
    {
      "stage": "征稿与校级报送",
      "format": "湖北省教育厅、湖北省文化和旅游厅（早期为省文化厅）发文，各高校组织初选后统一报送",
      "notes": "参展对象分甲组（教师组）、乙组（学生组）；高校美术与设计专业师生均可参加；第九届共75所学校参加、报送作品6800余件"
    },
    {
      "stage": "专家初评（作品照片评审）",
      "format": "组委会聘请专家组成美术与设计作品评选委员会，按美术/设计/摄影三类分别评选入围作品",
      "notes": "先报作品照片参加初评，入围后送原作"
    },
    {
      "stage": "复评/终评（原作展评）与公示",
      "format": "原作现场展评，评出一、二、三等奖、优秀奖及入选作品，获奖名单公示",
      "notes": "第九届美术类获奖242件、设计类260件、摄影类143件，另评优秀组织奖10个；获奖名单于次年公布（第九届名单2023年3月1日公布）"
    }
  ],
  "review_format": "省级专家评审制：作品照片初评+原作终评两轮专家评议，按美术/设计/摄影三赛道、教师/学生两组分类评奖，获奖名单公示，无现场答辩。",
  "judge_preferences": [
    "主题性与时代性：反映时代精神、荆楚地域文化的作品受青睐",
    "完成度与展示效果：装裱/展版精良的原作在终评占优",
    "原创性与个人语言，忌模板化、套路化",
    "学生组更看重真实创作能力与成长性而非炫技"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "抄袭、临摹冒充原创，一经查实取消获奖资格并通报",
    "作品曾在他展获奖或公开发表过（往届通知普遍限制一稿多投）",
    "内容违反意识形态与公序良俗要求",
    "报送信息（作者、指导教师）造假"
  ],
