{
  "competition_id": 84,
  "competition_name": "全国大学生英语竞赛",
  "judging_dimensions": [
    {
      "dimension": "听力理解",
      "weight": "30分/150分（20%）",
      "official_wording": "官方样题与高校转述：'初赛试题共分为七部分，时间120分钟，满分150分'，第一部分为听力（含短对话、长对话、新闻、听写/填空）；全卷'选择反应题型占60分，建构反应题型占90分'，听力中两者兼有。分值为官方样题通行结构，各年微调。",
      "scoring_points": [
        "短对话与长对话细节捕捉与推理",
        "新闻听力主旨与细节",
        "听写/填空拼写与语法形态正确"
      ],
      "common_deductions": [
        "听写单词拼写错误不得分",
        "答题卡填涂错位",
        "开考后听力一旦播完不重放，错过后无法补听"
      ]
    },
    {
      "dimension": "词汇语法与完形填空",
      "weight": "30分/150分（20%）",
      "official_wording": "高校通知与备考解析通引官方样题：第二部分'词汇与语法结构'15分（单选）、第三部分'完形填空'15分（选词填空、首字母填空等），合计30分。分值为样题通行结构【各年可能微调，以当届样题为准】。",
      "scoring_points": [
        "重点词汇辨析、短语搭配与核心语法点",
        "完形上下文逻辑与词形变化正确",
        "答题速度：题量大，需控制在预定时间内"
      ],
      "common_deductions": [
        "首字母/选词填空词形不符合语法要求",
        "纠结难题挤占后续大分值题型时间",
        "漏涂答题卡"
      ]
    },
    {
      "dimension": "阅读理解",
      "weight": "35-40分/150分（约23%-27%，全卷最大单块）",
      "official_wording": "高校备考解析通引官方样题：第四部分'阅读理解'35分（有年份40分），'题型多样：判断、匹配、简答、摘要填空等'。具体分值各年微调【以当届样题为准】。",
      "scoring_points": [
        "多种题型切换（判断正误、段落匹配、简答、摘要）应答规范",
        "简答题答案简洁且语法正确",
        "定位与同义改写识别速度"
      ],
      "common_deductions": [
        "简答超词数或答非所问",
        "按四六级做题习惯漏做非标准题型",
        "时间分配失衡导致作文仓促"
      ]
    },
    {
      "dimension": "翻译与智力测试",
      "weight": "20分/150分（约13%）",
      "official_wording": "高校解析通引官方样题：第五部分'翻译'15分（中译英+英译中，多为段落/句子翻译），第六部分'智力测试'5分（IQ题，'量大分少'）。分值为样题通行结构【各年微调】。",
      "scoring_points": [
        "译文的准确、通顺与关键信息点覆盖",
        "英译中理解长难句、中译英表达地道",
        "IQ题快速识别数列/逻辑/图形规律，性价比低时不恋战"
      ],
      "common_deductions": [
        "译文关键信息漏译、硬伤",
        "智力题耗时过多挤占写作",
        "翻译照抄原文句式导致中式英语"
      ]
    },
    {
      "dimension": "写作",
      "weight": "30分/150分（20%）",
      "official_wording": "高校解析通引官方样题：'写作赛题共分为两个部分'（应用文/图表描述小作文+议论文大作文），合计30分、'占竞赛题的比重为20%'。分值为官方样题口径。",
      "scoring_points": [
        "内容切题、要点覆盖完整",
        "结构清晰（引论-论证-结论）、衔接自然",
        "语言准确性与词汇句式多样性",
        "字数符合要求、卷面与格式规范"
      ],
      "common_deductions": [
        "字数不足或严重超篇",
        "模板痕迹重、内容空洞",
        "语法错误密集、跑题偏题"
      ]
    },
    {
      "dimension": "决赛加试（口试，A类等）",
      "weight": "口试50分制（约占决赛总分25%）【推断：150分笔试+50分口试折算】",
      "official_wording": "2026年高校通知：'决赛（笔试）2026年5月10日上午9:00-11:00'、'决赛（口试）2026年5月10日下午13:30-16:30'；研究生（A类）决赛设口试50分为高校通知与备考资料通行转述【部分年份/类别以当届通知为准】。",
      "scoring_points": [
        "口头表达流利度、语音语调",
        "即席回答的逻辑与互动",
        "决赛笔试与口试综合决定特等奖/一等奖排序"
      ],
      "common_deductions": [
        "背诵痕迹明显、答非所问",
        "语速过快或长时间停顿",
        "未按规定时间到场（决赛迟到30分钟禁入考场）"
      ]
    }
  ],
