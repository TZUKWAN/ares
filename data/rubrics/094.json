{
  "competition_id": 94,
  "competition_name": "湖北新闻传播教育创新实践技能竞赛",
  "judging_dimensions": [
    {
      "dimension": "主题价值与舆论导向",
      "weight": "【推断约30%】官方未公布分项权重；主题方向由实施方案明确",
      "official_wording": "校内报名通知（武汉东湖学院、三峡大学科技学院等转述省实施方案）：'青春湖北：鼓励青年大学生参加社会实践，亲身见证荆楚大地上发生的变化''红色湖北：讲述红色故事'。官方宗旨（中南财经政法大学转发2022年通知）：'提升互联网时代新闻传播专业大学生的新闻实践技能，增强大学生的艺术鉴赏力'。权重为按主题导向地位推断【推断】。",
      "scoring_points": [
        "扣题：作品对应当届主题方向（如青春湖北、红色湖北等），立意积极",
        "新闻价值：选题贴近社会实践与时代议题，反映荆楚大地真实变化",
        "导向正确：政治导向、舆论导向、价值观无偏差",
        "红色题材尊重史实，讲述有细节有温度"
      ],
      "common_deductions": [
        "偏离主题方向或导向性瑕疵",
        "红色题材出现史实错误",
        "选题空泛、缺乏新闻由头与现场感"
      ]
    },
    {
      "dimension": "新闻专业能力（采写编评）",
      "weight": "【推断约30%】新闻采编类为基本赛项，专业规范为核心评分面",
      "official_wording": "校内报名通知转述赛项设置：'新闻采编类（分新闻、新闻评论两类；视频、音频、文字作品均可……）'。官方宗旨强调'新闻实践技能'（中南财经政法大学转发2022年通知）。权重为推断【推断】。",
      "scoring_points": [
        "新闻类：真实性、时效性、要素完整，导语与结构规范，采访扎实",
        "新闻评论类：论点明确、论证有据、时效针对性强",
        "音视频作品：叙事节奏、镜头语言/声音质量、剪辑完成度",
        "语言文字规范：无事实性差错、无错别字与语病"
      ],
      "common_deductions": [
        "事实性差错或信源不清",
        "评论观点先行、论据空洞",
        "音视频粗制滥造、声画不同步",
        "文字稿硬伤多（错字、语病、格式不规范）"
      ]
    },
    {
      "dimension": "创新性与融合表达",
      "weight": "【推断约25%】赛事冠名'创新实践'并强调互联网语境与艺术鉴赏力",
      "official_wording": "官方宗旨：'提升互联网时代新闻传播专业大学生的新闻实践技能，增强大学生的艺术鉴赏力'（中南财经政法大学转发2022年通知）；赛事名称即含'创新实践技能'。权重为推断【推断】。",
      "scoring_points": [
        "融媒体表达：视频、音频、文字多形态呈现与融合创意",
        "形态创新：短视频、数据新闻、H5等新形态运用得当",
        "艺术鉴赏力：画面构图、视听语言、版式审美",
        "广告类作品：创意策略与执行力（设广告类赛项，高校获奖通报佐证）"
      ],
      "common_deductions": [
        "形式大于内容、炫技但信息量低",
        "模仿痕迹重、缺乏原创表达",
        "技术运用与叙事脱节"
      ]
    },
    {
      "dimension": "规范性与原创诚信",
      "weight": "【推断约15%】评审委员会评审+拟获奖名单公示制度",
      "official_wording": "武汉大学新闻与传播学院2023年公示：'湖北省高等教育学会新闻与传播教育专业委员会经湖北省教育厅审批后组织评审委员会对各高校作品进行评审'，拟获奖作品名单公示接受异议。校内选拔与作品申报须经学校审核推荐。权重为推断【推断】。",
      "scoring_points": [
        "作品原创、署名规范（作者、指导教师排序真实）",
        "按要求格式与载体提交（文字/音视频规格符合赛项要求）",
        "经校级选拔推荐，材料审核通过",
        "公示期无异议或异议核查通过"
      ],
      "common_deductions": [
        "抄袭、洗稿或盗用他人素材，取消评奖资格",
        "署名不实、指导教师挂名",
        "格式不符、材料缺项被退回",
        "公示期被实名异议查实问题"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "参赛作品（新闻采编类）",
      "format": "新闻作品与新闻评论作品两类；视频、音频、文字作品均可提交（按赛项要求的文件规格）",
      "page_limit": "未明确（按当届实施方案对时长/字数的规定）",
      "deadline_note": "校内选拔约4-6月进行，省级评审随后"
    },
    {
      "item": "广告类等其他赛项作品",
      "format": "按赛项要求提交（广告类含策划与创意作品，高校获奖通报证实该赛项存在）",
      "page_limit": "未明确",
      "deadline_note": "同全省统一报送节奏"
    },
    {
      "item": "报名与推荐材料",
      "format": "以学校为单位组织报名推荐（校内选拔赛通知+作品申报表，含作者与指导教师署名）",
      "page_limit": "未明确",
      "deadline_note": "按当届实施方案截止时间"
    }
  ],
  "process_stages": [
    {
      "stage": "校级选拔赛",
      "format": "各新闻传播院系组织校内选拔（征集作品、院内评审），按名额推荐省赛",
      "notes": "约4-6月进行（武汉纺织大学2025年6月15-26日院内选拔；武汉大学面向本科生征集作品）"
    },
    {
      "stage": "省级评审",
      "format": "湖北省高等教育学会新闻与传播教育专业委员会经省教育厅审批后组织评审委员会，对各高校作品集中评审，产生拟获奖名单并公示",
      "notes": "作品评审制（不以现场竞技为主）；2025年全省47所本专科高校参与"
    },
    {
      "stage": "颁奖（省年会）",
      "format": "竞赛结果在湖北省新闻与传播教育学会年会期间揭晓并颁奖",
      "notes": "2025年颁奖于11月年会举行；该赛被誉为湖北新闻传播学子的'年度大考'，属省教育厅指导管理的省级高水平学科竞赛"
    }
  ],
  "review_format": "作品评审制：专委会组织评审委员会对高校报送作品集中评审（网络/会议评审），拟获奖名单公示后揭晓，年会颁奖",
  "judge_preferences": [
    "主题先行不等于题材先行：扣题且有真实采访与实践痕迹的作品受青睐",
    "融媒体形态与新闻专业性平衡，反对纯炫技",
    "文字功底与事实核查是基本功底线",
    "红色与荆楚本地题材讲出细节与当代价值",
    "作品署名与指导关系真实，公示无异议"
  ],
