{
  "competition_id": 98,
  "competition_name": "全国混凝土设计大赛",
  "judging_dimensions": [
    {
      "dimension": "材料性能实测（抗压强度与体积密度）",
      "weight": "核心客观指标（占总评分数的主体）：以现场测试的混凝土试件抗压强度与表观密度（体积密度）综合评定，历届主题为在规定密度限值下追求更高强度（强度/密度比），如第十届要求抗压强度≥70MPa且体积密度≤1900kg/m³",
      "official_wording": "第九届全国混凝土设计大赛竞赛规则：以『现场测试的混凝土试件抗压强度』、『表观密度和参赛人员现场答辩情况进行综合评定』；第十届竞赛规则补充通知（CCPA官网/公众号附件）：『混凝土抗压强度不小于70MPa，且混凝土体积密度不大于1900kg/m3』，采用100×100×100mm立方体试块，按GB/T 50081标准测定3块试件抗压强度；高校校赛转载通知明确对『抗压强度、试件强度差异及成本分别给出不同的权重系数』加权计算",
      "scoring_points": [
        "实测28d（或规定龄期）立方体抗压强度达标的绝对值与离散性（3块试件强度差异）",
        "体积密度/表观密度控制（在规定限值内越低且强度越高，强度-密度比越优）",
        "配合比设计的科学性：胶凝材料体系、外加剂与纤维掺量优化",
        "试件成型质量：无缺棱掉角、蜂窝麻面等成型缺陷"
      ],
      "common_deductions": [
        "强度未达规定下限（如第十届70MPa、部分校赛35MPa）直接失格或大幅扣分",
        "体积密度超出限值（如第十届1900kg/m³、校赛1500kg/m³）",
        "3块试件强度离散度过大",
        "试件尺寸/养护龄期不符被判成绩无效"
      ]
    },
    {
      "dimension": "理论考试（混凝土材料专业知识笔试）",
      "weight": "决赛成绩构成之一：理论成绩30分（每队三人笔试，满分100分折算），占决赛总成绩30%档",
      "official_wording": "《混凝土设计大赛决赛实际操作竞赛评分细则》（历届文档转载）：决赛评分包括理论成绩（30分）——每队三人参加笔试，满分100分；『苏博特杯』第二届全国大学生混凝土材料设计大赛评分准则暨理论考试大纲：本次大赛由理论考试与实践操作评分构成，附理论考试大纲",
      "scoring_points": [
        "混凝土材料学基础理论（水化机理、外加剂作用机理、配合比设计方法）",
        "全队三人平均笔试成绩计入团队总分",
        "规范标准知识（GB/T 50081、配合比设计规程等）",
        "轻质高强/纤维增韧等当届主题相关理论知识"
      ],
      "common_deductions": [
        "笔试缺考队员按零分/低分计入团队",
        "基础概念错误率高拉低团队平均分",
        "考场作弊取消参赛资格"
      ]
    },
    {
      "dimension": "现场答辩与方案陈述",
      "weight": "综合评定环节：历届规则明确按现场答辩情况综合评定；规范性等子项占总成绩约5%",
      "official_wording": "第九届竞赛规则：以现场测试强度、表观密度『和参赛人员现场答辩情况进行综合评定』；决赛实际操作评分细则载明规范性等项『本项占总成绩5%』【推断依据：历届规则文档摘要，答辩为定性评议环节】",
      "scoring_points": [
        "配合比设计思路与试验数据支撑（试配-调整过程完整）",
        "对评委提问（材料选择依据、异常数据解释）的应答质量",
        "方案的经济性与绿色低碳性论述",
        "陈述条理与团队分工表现"
      ],
      "common_deductions": [
        "答辩与提交方案不符、数据无法自圆其说",
        "对自身配合比关键参数答不上来",
        "文档不规范（无试验记录、配合比表缺失）"
      ]
    },
    {
      "dimension": "实践操作与规范性（现场拌合、成型、创意作品）",
      "weight": "决赛实操环节：按操作规范性计分（规范性子项约占总成绩5%）；部分届次另设水泥基材料创意作品展",
      "official_wording": "决赛实际操作竞赛评分细则：考核表观密度、28d标准养护立方体抗压强度及现场操作；第六届大赛通知附件含『实践操作考核大纲』与『水泥基材料创意作品展通知』（武汉理工大学承办届次）【推断依据：历届附件清单】",
      "scoring_points": [
        "现场计量、搅拌、成型的操作规范性与安全意识",
        "坍落度/工作性达标与调整能力",
        "创意作品（如设作品展）的材料创意与工艺表现",
        "试验记录与原始数据完整可追溯"
      ],
      "common_deductions": [
        "操作违规（不按计量规程、安全违规）扣分",
        "原始记录缺失或事后补造",
        "创意作品（如设作品展）与材料科学关联性弱、仅停留在造型层面"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "配合比设计方案与试验报告",
      "format": "按当届通知要求提交配合比设计书/试验报告（含原材料检测数据、试配调整记录）；第八届要求提前制作2根50×50×1000mm纤维混凝土小梁并邮寄组委会（邮寄时等效龄期28天）",
      "page_limit": "未明确",
      "deadline_note": "第八届（2026年）比赛时间7月17-19日，赛前按通知截止邮寄/提交"
    },
    {
      "item": "试件",
      "format": "历届A类为现场/统一制作立方体试件（第十届100×100×100mm，按GB/T 50081测3块抗压强度）；第八届为纤维混凝土小梁（骨料粒径不宜大于10mm，纤维直径≤2mm、长度≤50mm，不得有直径2mm以上加强筋或连续配筋，否则成绩无效；容重≤2300kg/m³）",
      "page_limit": "不适用",
      "deadline_note": "现场制件或赛前邮寄（第八届小梁等效龄期28天）"
    },
    {
      "item": "报名组队",
      "format": "以学校为单位组队报名，第八届每队4人（1名领队教师+1名队长+2名队员），面向全体在校本科生和研究生；多数届次要求先校内选拔",
      "page_limit": "不适用",
      "deadline_note": "第八届进群/报名截止2026年4月中旬，各校校赛多在10月-次年4月"
    }
  ],
  "process_stages": [
    {
      "stage": "校内选拔赛",
      "format": "各高校自行组织校赛（规则参照国赛：规定强度下限与密度上限内比强度-密度比，如湖南工学院校赛要求抗压强度≥35MPa、体积密度≤1500kg/m³）",
      "notes": "国赛名额由组委会分配，校赛优胜队获推荐资格"
    },
    {
      "stage": "全国决赛—理论考试",
      "format": "每队三人笔试（混凝土材料学+规范标准），满分100分，按30分折入团队总分",
      "notes": "依据历届《评分准则暨理论考试大纲》"
    },
    {
      "stage": "全国决赛—实测与答辩",
      "format": "现场测试试件抗压强度与表观密度（GB/T 50081），结合现场答辩与操作规范性综合评定，评出一、二、三等奖",
      "notes": "第八届2026年7月17-19日在西北民族大学举行，主题『轻质高强高韧性混凝土』（口号：轻韧筑砼 强固致远）；历届主题多为『轻质与高强：基于强度和密度的混凝土配合比设计』"
    }
  ],
  "review_format": "客观实测为主+理论笔试+现场答辩的综合评定：试件强度与密度由现场按国标实测计分（核心权重），理论考试约占30%档（每队三人笔试），答辩与规范性为定性评议环节（规范性子项约5%）。",
  "judge_preferences": [
    "强度-密度比极致优化：低密度下仍高强度、且3块试件稳定不离散",
    "配合比设计有充分试验数据链支撑（试配-调整-验证闭环）",
    "队员理论基础扎实：笔试与答辩能讲清水化机理与设计依据",
    "重视经济性与绿色低碳（掺合料利用、低胶材）的方案",
    "试验记录真实完整、成型工艺规范"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "试件掺入钢纤维以外的加强筋、连续配筋或超规纤维（第八届明确规定成绩无效）",
