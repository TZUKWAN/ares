{
  "competition_id": 114,
  "competition_name": "中国大学生程序设计竞赛（CCPC）",
  "judging_dimensions": [
    {
      "dimension": "解题数量",
      "weight": "客观题：第一排序键——5小时内通过题数多者名次靠前（机器评测，无人工评分）",
      "official_wording": "OI Wiki（ICPC/CCPC赛制）：'排名先按解题数排名；解题数相同时比较总用时'；每题'必须所有数据点全部通过'方计通过。CCPC分站赛赛制沿用ICPC规则：5小时、上机编程、实时评测排名（高校赛事通知表述：'比赛时长5小时''题目10至13题'）。",
      "scoring_points": [
        "通过题目总数（通过全部测试点才计该题通过）",
        "对难题（压轴题）的突破：决定奖牌档位的关键",
        "读题与建模速度：前期快速签到建立优势",
        "对数据结构与算法的综合运用能力"
      ],
      "common_deductions": [
        "部分正确的提交不得分（测试点未全过）",
        "编译错误/超时/超内存反复提交浪费机时",
        "赛末不必要提交触发罚时改变名次"
      ]
    },
    {
      "dimension": "总罚时（用时效率）",
      "weight": "客观题：第二排序键——同解题数下按总用时升序排名；每题用时=比赛开始至通过该题的分钟数+该题错误提交次数×20分钟",
      "official_wording": "OI Wiki/洛谷赛事简介：'错误提交每次罚20分钟''每题用时为从比赛开始到通过该题的分钟数+该题罚时'；'总用时为各题用时之和'。编译错误通常不罚时（高校校赛通知沿用规则）。",
      "scoring_points": [
        "一次通过率：错误提交越少罚时越少",
        "通过时刻早：比赛前期解题效率",
        "时间/空间复杂度优化避免TLE（超时提交计错误罚时）",
        "封榜（结束前1小时）前的名次管理与提交策略"
      ],
      "common_deductions": [
        "同一题反复错误提交累计罚时20分钟/次",
        "卡在题解法上未及时换题导致整场低效",
        "样例未测就提交导致低级错误罚时"
      ]
    },
    {
      "dimension": "算法与工程能力（题目难度构成）",
      "weight": "定性：题目按难度分档（签到题—中档题—压轴题），通过的题目难度组合反映队伍真实算法水平，决定奖牌归属",
      "official_wording": "知乎备赛讨论：'CCPC是团队赛，队友一般擅长不一样的（方向），遇到偏数学的题可以让队内数学好的来'。分站赛题目约10-13道，覆盖数据结构、图论、动态规划、数论、计算几何、字符串等。【推断】难度分档描述依据历年题目的公开题解共识。",
      "scoring_points": [
        "覆盖面：队内成员算法方向互补（数学/数据结构/图论/构造）",
        "压轴题通过数是金奖与奖牌外的分水岭",
        "代码实现精度与调试能力（对拍、边界构造）",
        "模板库与纸质资料准备（允许携带一定量纸质资料）"
      ],
      "common_deductions": [
        "只会签到题，中档题拿不下（奖牌无望）",
        "算法思路对但实现复杂度不达标",
        "纸质模板准备不足导致现场手推常用算法"
      ]
    },
    {
      "dimension": "团队协作与机时管理",
      "weight": "定性：三人共用一台电脑，机时分配与分工直接影响解题数与罚时",
      "official_wording": "OI Wiki：'一般是三个人组成一队使用一台机器'。中南民族大学计算机学院介绍：'CCPC以团队形式参赛，每队成员不超过3人'。【推断】协作维度的具体表述依据赛制约束归纳。",
      "scoring_points": [
        "分工明确：读题手/主码手/辅助手角色清晰",
        "机时调度：避免单人长时间占用电脑",
        "队内沟通：题意理解统一、策略调整果断",
        "抗压能力：封榜后保持节奏"
      ],
      "common_deductions": [
        "单人包揽全部编码、队友边缘化",
        "队内意见僵持浪费时间",
        "紧张失误（删错代码、提交错文件）"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "赛题程序提交",
      "format": "C/C++/Java/Python等（当届允许语言为准），提交至评测系统，实时评测",
      "page_limit": "不限（代码题）",
      "deadline_note": "比赛开始后5小时内"
    },
    {
      "item": "网络预选赛报名",
      "format": "官网报名系统（signup.ccpc.io）教练/学生注册报名",
      "page_limit": "不限",
      "deadline_note": "每年8-9月（网络赛8月底至9月初举行）"
    },
    {
      "item": "纸质资料（允许携带）",
      "format": "一定量的纸质模板/书籍（现场赛）",
      "page_limit": "以当届竞赛细则为准",
      "deadline_note": "分站赛/总决赛入场检查"
    }
  ],
  "process_stages": [
    {
      "stage": "校内选拔/校队组建",
      "format": "各高校校赛或校内训练选拔",
      "notes": "CCPC不接受个人社会报名，需经本校教练（教师）组织报名；队员为在校生且有参赛年限限制（五年赛龄口径，以当届章程为准）"
    },
    {
      "stage": "网络预选赛（CCPC Online）",
      "format": "线上个人/团队赛，5小时（历届口径）",
      "notes": "每年8月底-9月初；成绩决定各高校分站赛名额分配，校内按校排分配出线队伍"
    },
    {
      "stage": "分站赛",
      "format": "现场赛：3人1机、5小时、约10-13题，实时评测、最后1小时封榜",
      "notes": "每年设3-4个分站（9-11月）；按有效参赛队伍10%/20%/30%授予金、银、铜奖；分站赛成绩决定总决赛参赛资格"
    },
    {
      "stage": "全国总决赛（CCPC Final）",
      "format": "现场赛（赛制同分站赛），历届12月中旬前后举行",
      "notes": "由分站赛成绩优秀队伍参加（第十一届总决赛为2026年）；决出总决赛金银铜奖及冠军；优秀选手可衔接国际赛事（ICPC系列）"
    }
  ],
  "review_format": "全客观机器评测：在线评测系统实时判定（通过/错误提交），按解题数、总罚时（含每次错误提交罚20分钟）自动排名，无人工评委打分。",
  "judge_preferences": [
    "结果导向：测试点全过才算通过，任何部分正确不计分",
    "罚时意识：追求一次通过，避免无谓提交",
    "难题突破：压轴题通过数决定奖牌成色",
    "代码效率严格满足时间与内存限制",
    "诚信参赛：现场赛封闭环境、网络赛代码查重"
  ],
