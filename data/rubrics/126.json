{
  "competition_id": 126,
  "competition_name": "采矿工程专业实践作品大赛",
  "judging_dimensions": [
    {
      "dimension": "专业性与工程科学性（采矿学原理运用）",
      "weight": "定性（官方未公布评分细则；本维度为依据作品性质与同类实践竞赛评审模型的推断）【推断】",
      "official_wording": "官方通知仅规定作品类别与主题方向，未公布评分维度。据第十三届全国赛校内选拔通知（山东理工大学创新创业学院官网）：作品包括\"采矿物理模型、采矿数字模型、采矿数学模型、采矿学习模型和学生创新成果等\"，主题为\"提高创新创业思维，增强就业竞争力\"，鼓励在\"'绿色矿山''智慧矿山''矿山安全'等领域中选择和组织参赛作品\"——专业科学性隐含于各类别作品要求之中。",
      "scoring_points": [
        "模型/方案反映正确的采矿学原理（开拓、采准、切割、回采顺序等）",
        "与真实矿山条件（矿体赋存、围岩、 safety因素）匹配",
        "数字/数学模型的参数与算法有依据",
        "符合矿山安全与规程要求"
      ],
      "common_deductions": [
        "开采顺序或结构参数出现专业错误",
        "模型与所标示矿山条件明显不符",
        "参数无出处、凭感觉设定"
      ]
    },
    {
      "dimension": "创新性与实用价值（主题契合）",
      "weight": "定性（通知明确主题为\"提高创新创业思维，增强就业竞争力\"并鼓励绿色矿山/智慧矿山/矿山安全方向；评分权重未公布）",
      "official_wording": "山东理工大学官网全国赛选拔通知：\"本次大赛以'提高创新创业思维，增强就业竞争力'为主题\"，鼓励在\"'绿色矿山''智慧矿山''矿山安全'等领域中选择和组织参赛作品\"；大赛主办方为教育部高等学校矿业类专业教学指导委员会（武汉理工大学资源与环境工程学院、360百科等表述一致）。",
      "scoring_points": [
        "选题契合绿色矿山、智慧矿山、矿山安全等导向",
        "作品有解决实际矿山问题的应用价值",
        "体现创新设计意识与团队协作（大赛宗旨表述）",
        "学习模型类作品具有教学辅助价值与推广性"
      ],
      "common_deductions": [
        "选题陈旧、与行业方向脱节",
        "为做模型而做模型、无问题意识",
        "对矿业转型（智能化、绿色化）无回应"
      ]
    },
    {
      "dimension": "作品完成度与工艺表现",
      "weight": "定性（按作品类别考核：物理模型看制作工艺与表现力，数字/数学模型看功能实现，学习模型看教学适切性；评分权重未公布）【推断】",
      "official_wording": "官方通知列明作品五类（采矿物理模型、采矿数字模型、采矿数学模型、采矿学习模型和学生创新成果）但未公布分类评分细则；历届获奖作品以模型类为主（如第六届一等奖作品《无底柱分段崩落法物理模型》，据优酷作品视频与高校获奖新闻）。",
      "scoring_points": [
        "物理模型：结构、设备、巷道布置再现准确，工艺精细",
        "数字模型：三维/软件实现完整、可交互演示",
        "数学模型：方法正确、求解可信",
        "学习模型：知识表达准确、利于教学使用",
        "作品说明材料齐全、图文一致"
      ],
      "common_deductions": [
        "模型粗糙、关键构造缺失",
        "数字模型无法演示或与说明不符",
        "说明材料拼凑、图文不一致"
      ]
    },
    {
      "dimension": "展示讲解与现场交流",
      "weight": "定性（全国赛与全国高校采矿工程专业学术年会同期举行，作品现场展示交流；评分权重未公布）【推断】",
      "official_wording": "360百科（经360搜索获取）载明该大赛\"每年一届，与全国高校采矿工程专业学术年会一同举办\"；第九届大赛于2019年7月21-24日在沈阳举行（武汉科技大学新闻网）；第十二届于2023年10月中旬在江西理工大学举行（安徽理工大学矿业工程学院新闻）。",
      "scoring_points": [
        "现场讲解清晰、能在年会场合回答专业提问",
        "作品展示的组织与呈现效果",
        "与评委（教指委专家、高校教师）交流的质量"
      ],
      "common_deductions": [
        "讲解由非参赛成员代答、不熟悉作品",
        "展示内容与作品实际不符"
      ]
    },
    {
      "dimension": "原创性与参赛规范",
      "weight": "定性（通知明确原创度要求与组队限制；获奖比例由校赛通知载明：一等奖5%、二等奖10%、三等奖15%）",
      "official_wording": "山东理工大学官网全国赛选拔通知：\"所有作品原创度不得低于50%\"，\"参赛作品必须是2024年6月30日之前完成的成果\"；\"小组分为专业组与非专业组，每小组成员限定校赛为1-5人，国赛为1-3人\"；校赛\"设一等奖、二等奖、三等奖。各奖项的获奖比例为5%、10%、15%\"，\"依照大赛成绩择优选拔\"参加全国赛。",
      "scoring_points": [
        "作品原创度不低于50%",
        "在规定完成时限内完成的成果",
        "国赛每队1-3人、专业组/非专业组归类准确",
        "经校内选拔按成绩择优推荐"
      ],
      "common_deductions": [
        "原创度不足或抄袭往届作品",
        "国赛组队超3人",
        "推荐材料与作品不符、逾期提交"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "实践作品（五类任选）",
      "format": "采矿物理模型（实物）、采矿数字模型（三维/软件）、采矿数学模型、采矿学习模型、学生创新成果",
      "page_limit": "未明确",
      "deadline_note": "须在通知规定时限前完成（2024年选拔赛要求6月30日前完成成果），随校内选拔后推荐"
    },
    {
      "item": "作品说明材料",
      "format": "作品说明/图纸/演示材料（按当届通知）",
      "page_limit": "未明确",
      "deadline_note": "随作品提交，用于校赛评审与全国赛展示"
    },
    {
      "item": "报名信息",
      "format": "以课题小组报名（校赛1-5人、国赛1-3人），部分高校要求在指定平台报名（如'到梦空间'APP）",
      "page_limit": "不适用",
      "deadline_note": "校赛报名通常上半年（2024年例：5月16日-6月1日），全国赛下半年（10月前后）随学术年会举行"
    }
  ],
  "process_stages": [
    {
      "stage": "校内选拔",
      "format": "各高校自办校赛（线上或线下），按成绩择优推荐",
      "notes": "校赛多由创新创业学院与矿业/资环学院联办（如山东理工大学2024年5-6月校赛，奖项比例5%/10%/15%）；作品类别与全国赛对接"
    },
    {
      "stage": "全国赛组织",
      "format": "教育部高等学校矿业类专业教学指导委员会主办，与全国高校采矿工程专业学术年会同期举行",
      "notes": "每年一届；第六届2016年（武汉）、第九届2019年7月21-24日（沈阳）、第十一届2021年（与第五届全国高校采矿工程专业青年教师讲课比赛、第四届矿业工程研究生论坛同期，昆明理工大学发布3号通知）、第十二届2023年10月（江西理工大学承办）、第十三届2024年"
    },
    {
      "stage": "作品评审与展示",
      "format": "教指委组织专家对推荐作品评审（历届与年会现场展示交流结合）",
      "notes": "评审细则由当届组委会另行制定，未公开统一分值表；获奖报道显示作品以模型类为主"
    },
    {
      "stage": "授奖",
      "format": "设全国一等奖、二等奖、三等奖",
      "notes": "某届获奖规模为一等奖10项、二等奖28项、三等奖54项（六盘水师范学院2022年10月新闻，届次表述待核）；获奖名单由评奖部门（教指委）发布，多所高校将获奖计入学科竞赛档案（该赛列入中国矿业大学（北京）2024年本科生学科竞赛名录）"
    }
  ],
  "review_format": "教育部高等学校矿业类专业教学指导委员会主办的年度实践作品竞赛：各高校校内选拔择优推荐，教指委组织专家评审（与全国高校采矿工程专业学术年会同期、现场展示交流），按作品评选全国一、二、三等奖",
  "judge_preferences": [
    "作品须扎根真实矿山场景：模型能正确再现开采方案与生产系统是基本盘",
    "主题导向鲜明：绿色矿山、智慧矿山、矿山安全方向的作品更契合大赛宗旨",
    "动手实践与创新能力并重：物理模型重工艺、数字/数学模型重实现，学习模型重教学价值",
    "参赛团队应具备协作与表达素质（大赛宗旨明确\"培养创新设计意识、团队协作精神和工程实践能力\"）",
    "原创性底线：原创度不足50%的作品不符合参赛要求"
  ],
  "past_winning_patterns": [
    "一等奖作品多为采矿物理模型（如第六届一等奖《无底柱分段崩落法物理模型》），以工艺精细与方案准确取胜（据历届获奖作品视频与高校获奖新闻）",
    "获奖集中于矿业传统强校（中国矿业大学、中南大学、山东科技大学、武汉科技大学、西安科技大学等），校内训练体系与教师指导投入是共性（据多校获奖新闻推断）"
  ],
  "forbidden_or_risky": [
    "作品原创度低于50%或抄袭往届获奖作品",
    "国赛组队超过3人、跨校拼队或非在校生参赛",
    "作品非规定时限内完成、材料造假",
    "逾期提交或未通过校内选拔自行报名全国赛",
    "展示讲解与作品实际不符"
  ],
