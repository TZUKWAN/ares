{
  "competition_id": 19,
  "competition_name": "全国大学生化工设计竞赛",
  "judging_dimensions": [
    {
      "dimension": "现代设计方法应用（Aspen Plus/HYSYS等流程模拟与能量集成）",
      "weight": "约35%（折算自2026年四川省赛细则\"专项成绩占80%，答辩占20%；专项中现代设计方法占比35%\"，全国细则以当年评审文档为准【推断】）",
      "official_wording": "总决赛评审分为专项评审与现场答辩两大阶段，专项评审围绕\"现代设计方法运用、工程图纸绘制质量、设计文档质量\"进行（承办校新闻及竞赛委员会评审文档发布通知，iche.zju.edu.cn）；省赛细则载明专项80%+答辩20%、现代设计方法35%。",
      "scoring_points": [
        "全流程稳态模拟收敛且物性方法选择有据（Aspen Plus/HYSYS等）",
        "能量集成（换热网络优化、热泵/精馏节能）与动态模拟等进阶应用",
        "设备设计与选型经模拟校核，自控方案与流程联动",
        "经济分析与安全环保（HAZOP、Dow火灾爆炸指数等）基于模拟数据"
      ],
      "common_deductions": [
        "模拟文件残缺、无法复现流程结果",
        "模拟结果与设计说明书数据不一致",
        "仅截屏软件界面而无深度应用（能量集成/调优缺失）"
      ]
    },
    {
      "dimension": "设计文档质量（可行性研究报告、初步设计说明书等）",
      "weight": "约25%（推断，同上折算依据）",
      "official_wording": "官方设计任务书\"参赛作品应提交的材料\"：项目可行性研究报告（篇幅60页以内、4万字以内）、初步设计说明书等必须提交（第十三届任务书，iche.zju.edu.cn；第十九届文件同）。文档质量为专项评审环节之一。",
      "scoring_points": [
        "厂址选择、工艺路线论证充分，数据来源可靠",
        "物料衡算、热量衡算完整自洽",
        "经济分析（投资估算、成本、敏感性分析）规范",
        "安全、环保、职业卫生专篇齐全，符合标准规范引用要求",
        "篇幅与格式符合任务书限制（可研≤60页/4万字）"
      ],
      "common_deductions": [
        "超页数/字数限制或关键章节缺失",
        "衡算数据前后矛盾",
        "标准规范引用过时或错误",
        "文字复制比过高、查重不达标"
      ]
    },
    {
      "dimension": "工程图纸绘制质量",
      "weight": "约20%（推断，同上折算依据）",
      "official_wording": "总决赛评审环节包含\"工程图纸绘制\"专项（承办校总决赛报道汇总；竞赛评审文档含《工程图纸评审细则》，iche.zju.edu.cn第十一届评审文档发布通知）。",
      "scoring_points": [
        "PFD（工艺流程图）信息完整：物流表、操作条件标注",
        "P&ID（管道仪表流程图）符合制图标准，自控联锁合理",
        "车间布置图/设备布置图、总图运输设计规范",
        "图纸深度达到初步设计阶段要求"
      ],
      "common_deductions": [
        "图面不符合国标（比例、图例、线型）",
        "P&ID与PFD物流不对应",
        "图纸与文档中的设备参数不一致"
      ]
    },
    {
      "dimension": "现场答辩（口头报告与问辩）",
      "weight": "约20%（依据省赛细则\"专项成绩80%+答辩成绩20%\"）",
      "official_wording": "全国总决赛要求提交设计作品电子文档并进行口头报告和现场答辩，历届总决赛经专项评审与两轮现场答辩评出金、银、铜奖（承办校报道）；四川省赛通知载明答辩成绩占20%。",
      "scoring_points": [
        "汇报逻辑：从选题背景到方案、模拟、经济与安全环保一脉贯通",
        "PPT与图纸呈现专业，重点突出创新点与亮点",
        "准确回答评委对工艺细节、数据来源、规范依据的追问",
        "团队分工与时间控制得当"
      ],
      "common_deductions": [
        "照稿念PPT、超时严重",
        "答不出本人负责部分的技术细节",
        "答辩内容与提交文档矛盾"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "项目可行性研究报告",
      "format": "电子文档（PDF/Word，按任务书模板）",
      "page_limit": "60页以内，4万字以内",
      "deadline_note": "按当年设计任务书规定节点（省赛评审前提交）"
    },
    {
      "item": "初步设计说明书及主要设备设计说明",
      "format": "电子文档汇编",
      "page_limit": "未明确（按当年任务书）",
      "deadline_note": "省赛/总决赛作品提交截止前"
    },
    {
      "item": "典型设计图纸汇编",
      "format": "CAD图纸（PFD、P&ID、布置图、总平面等）",
      "page_limit": "未明确（按任务书清单）",
      "deadline_note": "同上"
    },
    {
      "item": "现代设计方法应用材料",
      "format": "Aspen Plus/HYSYS等模拟源文件+应用说明",
      "page_limit": "未明确",
      "deadline_note": "随作品电子文档一并提交，总决赛需可现场复现"
    },
    {
      "item": "答辩PPT与口头报告",
      "format": "PPT现场汇报+问辩",
      "page_limit": "未明确",
      "deadline_note": "总决赛现场（历届8月中下旬举行）"
    }
  ],
  "process_stages": [
    {
      "stage": "校赛",
      "format": "高校组织选题组队（5人/队），按当年任务书完成设计",
      "notes": "每年发布全国统一设计任务书（如近年围绕资源循环、双碳背景的化工产品方案）"
    },
    {
      "stage": "省赛/赛区赛",
      "format": "专项评审（文档+图纸+现代设计方法，约80%）+现场答辩（约20%）",
      "notes": "以2026年四川省赛细则为代表：专项成绩占80%、答辩成绩占20%；赛区优胜队晋级全国总决赛"
    },
    {
      "stage": "全国总决赛",
      "format": "专项评审（设计文档质量、工程图纸、现代设计方法）+现场答辩（历届含两轮答辩），评出特等奖及金银铜奖",
      "notes": "第十八届（2024，大连理工）450所学校3685支团队约1.9万人参赛；第十九届（2025，宁夏大学）500余校6000余队；总决赛历届8月举行"
    }
  ],
  "review_format": "作品电子文档专项评审（文档、图纸、现代设计方法分项打分）+现场口头报告与问辩，按当年《评分实施细则》执行（细则逐年修订，官网下载中心发布）。",
  "judge_preferences": [
    "模拟深度优先：能否用Aspen等做能量集成、灵敏度与调优，而非仅跑通流程",
    "前后一致性：文档、衡算表、图纸、模拟结果、答辩口径完全对应",
    "安全环保与经济分析有量化数据支撑（HAZOP、Dow指数、投资回收期等）",
    "规范意识：标准引用、制图国标、文档模板严格执行"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "作品抄袭、查重超标或使用往届获奖作品改造参赛将被取消资格",
    "模拟文件造假或答辩与文档数据不一致，一经发现取消成绩",
    "团队须为同一学校在籍本科生5人，跨校组队、研究生参赛均违规",
    "引用设计规范过时或错误反映专业素养缺陷，影响文档与图纸得分",
    "总决赛现场调试/复现环节弄虚作假按违纪处理"
  ],
