{
  "competition_id": 82,
  "competition_name": "“科云杯”财会职业能力大赛",
  "judging_dimensions": [
    {
      "dimension": "业财税信息处理技能（上半场）",
      "weight": "400分 / 总分800分（50%）",
      "official_wording": "大赛通知（山东财经大学转发第十一届）原文：'总分800分，两个环节各400分'，上半场为'业财税信息处理技能竞赛，180分钟'；西北工业大学通知：'模拟中型制造企业一个月的完整经济业务，设会计主管、出纳、总账会计、成本会计四个岗位'。系统自动评分。",
      "scoring_points": [
        "四岗位（会计主管/出纳/总账会计/成本会计）分岗协作完成约65笔业务",
        "业务协同、会计信息化、网上银行、电子税务局等8大系统模块操作正确",
        "凭证编制、账务处理、报表与涉税业务处理结果与系统标准答案一致",
        "单据流、资金流、账务流、税务流勾稽关系处理正确"
      ],
      "common_deductions": [
        "岗位分工混乱、单据流转顺序错误导致后续业务无法处理",
        "凭证科目/金额错误、申报表数据错报",
        "操作超时未完成，未提交部分不得分"
      ]
    },
    {
      "dimension": "智能化财务应用技能（下半场）",
      "weight": "400分 / 总分800分（50%）",
      "official_wording": "通知原文（西北工业大学/山东财经大学）：下半场'智能化财务应用技能竞赛，120分钟'，考察'财务机器人应用、BI工具应用、Python应用与AI智能体设计'四个项目，'4名队员各自独立完成全部业务'。系统自动评分。",
      "scoring_points": [
        "财务机器人（RPA）流程搭建与执行结果正确",
        "BI工具数据建模与可视化分析符合题目要求",
        "Python数据处理/自动化脚本输出结果正确",
        "AI智能体设计方案可运行、结果符合题意"
      ],
      "common_deductions": [
        "流程/脚本无法运行或输出结果错误",
        "未独立完成（依赖队友代做，环节要求每人独立）",
        "操作步骤跳漏导致下游环节连锁失分"
      ]
    },
    {
      "dimension": "成绩并列判定与团队完成度",
      "weight": "同分定性排序规则：以上半场（业财税，400分/50%）成绩高者列前",
      "official_wording": "通知原文：'若出现成绩相同情况，以业财税信息处理技能竞赛环节成绩高者排名在前'。队伍总成绩为两环节得分之和（系统自动评分，保留两位小数）。",
      "scoring_points": [
        "总分相同时比较业财税环节成绩",
        "按系统给出的最终成绩作为选拔和排名主要标准",
        "全员按时完成并提交，无缺岗"
      ],
      "common_deductions": [
        "缺员或中途弃赛影响团队成绩",
        "提交中断、网络/设备准备不足造成成绩无效",
        "违反考场纪律成绩作废"
      ]
    }
  ],
