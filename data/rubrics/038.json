{
  "competition_id": 38,
  "competition_name": "嵌入式芯片与系统设计竞赛",
  "judging_dimensions": [
    {
      "dimension": "作品完成度与系统功能指标",
      "weight": "约30%【推断】",
      "official_wording": "哈工大（深圳）转发的竞赛通知：分赛区初赛\"先做合格性初筛，再评完成度与技术要求\"；复赛\"综合完成度、创新性、难度、系统功能与指标及答辩情况评奖\"（完成度为官方评审要素首位；具体分值未公开）",
      "scoring_points": [
        "系统功能完整、按赛题任务书实现全部要求",
        "性能指标达到或超过赛题规定（功耗、速度、精度等）",
        "软硬件联调稳定，长时间运行无故障",
        "扩展电路设计合理、构成完整应用系统"
      ],
      "common_deductions": [
        "核心功能缺失或演示时无法复现",
        "性能指标未达赛题要求",
        "系统演示死机/复位且无恢复手段"
      ]
    },
    {
      "dimension": "创新性与应用价值",
      "weight": "约25%【推断】",
      "official_wording": "复赛官方评审要素含\"创新性\"；乐鑫赛题官方指引（厂商命题统一遵循竞赛评审标准）：\"作品需具备明确的创新点和应用价值\"",
      "scoring_points": [
        "选题新颖、解决真实场景痛点",
        "算法/架构/交互有差异化创新点",
        "应用前景与产业结合度",
        "AI能力融入（本届设AI应用说明）"
      ],
      "common_deductions": [
        "仅沿用厂商官方Demo无二次创新",
        "创新点与功能脱节、为创新而创新",
        "无应用场景论证"
      ]
    },
    {
      "dimension": "技术难度与指定平台运用",
      "weight": "约25%【推断】",
      "official_wording": "竞赛通知：\"参赛队采用赛题指定的开发平台为核心，根据选题指南自由选择赛题，开放式自主设计并完成参赛作品\"，在发挥核心平台功能性能基础上\"允许自行设计扩展电路构成完整的应用系统\"；复赛评审要素含\"难度\"；乐鑫赛题要求\"主控芯片必须使用ESP32-P4或ESP32-S3\"",
      "scoring_points": [
        "深度发挥指定芯片平台功能性能（外设、加速器、AI能力）",
        "技术实现难度与复杂度（多传感器融合、实时系统、AI部署）",
        "硬件扩展电路自主设计水平",
        "嵌入式软件工程规范（驱动、RTOS、代码质量）"
      ],
      "common_deductions": [
        "未使用指定平台或主控不符合赛题强制要求",
        "仅调用现成模块库、无底层开发",
        "平台能力浅层使用、难度系数过低"
      ]
    },
    {
      "dimension": "现场演示与答辩（含能力测评）",
      "weight": "约20%【推断】",
      "official_wording": "竞赛通知：全国总决赛为现场评审，含\"作品介绍及演示、质询与答辩等环节\"，\"总决赛期间另有能力测评\"",
      "scoring_points": [
        "作品介绍重点突出、演示流畅真实",
        "质询回答准确、技术细节掌握扎实",
        "全员参与且分工清晰",
        "能力测评（对参赛者知识的独立考核）成绩"
      ],
      "common_deductions": [
        "演示用预录视频替代实机操作",
        "队员答不上自己作品的技术问题（疑似代做）",
        "能力测评成绩与作品水平明显不符"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "参赛作品（实物系统）",
      "format": "以赛题指定开发平台为核心的完整应用系统，允许自行设计扩展电路",
      "page_limit": "未明确",
      "deadline_note": "作品提交截止（第八届为2025年7月10日18:00；第九届作品上传要求于6月初发布）"
    },
    {
      "item": "作品设计报告与上传材料",
      "format": "按官网《作品上传要求》提交设计文档、演示视频等材料",
      "page_limit": "未明确",
      "deadline_note": "与作品提交同期（6-7月）"
    },
    {
      "item": "决赛展示与答辩材料",
      "format": "现场作品介绍PPT+实机演示，接受质询答辩",
      "page_limit": "未明确",
      "deadline_note": "全国总决赛（8月中旬）"
    }
  ],
  "process_stages": [
    {
      "stage": "报名与选题（2-4月）",
      "format": "官网 www.socchina.net 注册报名，从厂商选题指南中选择赛题（海思、瑞芯微、瑞萨、ST、恩智浦、乐鑫、沁恒、龙芯、地瓜机器人、广和通、移远、进迭时空、英飞凌、睿赛德、软通等十余家命题）",
      "notes": "第八届报名截止2025年4月25日；不收报名费和评审费；每队1-3名学生须同校，指导教师不超过2名；按学籍分研究生组/本科组/高职高专组"
    },
    {
      "stage": "作品研制与提交（4-7月）",
      "format": "开放式自主设计，围绕指定平台完成系统开发",
      "notes": "作品提交截止7月上旬（第八届7月10日18点）"
    },
    {
      "stage": "分赛区初赛（7月中旬）",
      "format": "线上评审：合格性初筛后评完成度与技术要求",
      "notes": "入围复赛名单公示不少于3天"
    },
    {
      "stage": "分赛区复赛（7月下旬）",
      "format": "原则上线下评审，综合完成度、创新性、难度、系统功能与指标及答辩情况评奖",
      "notes": "设东部、南部、中部、北部、西北、西南六大赛区"
    },
    {
      "stage": "全国总决赛（8月中旬）",
      "format": "现场评审：作品介绍及演示、质询与答辩，另有能力测评",
      "notes": "第八届总决赛2025年8月10-13日在南京举行（东南大学、南京江北新区承办）；第九届总决赛成绩8月公示"
    }
  ],
  "review_format": "三级评审：初赛线上资格与完成度评审，复赛线下综合评审，总决赛现场演示答辩加能力测评，按组别评奖。",
  "judge_preferences": [
    "重完成度：能跑、能测、指标可验证的作品优先",
    "重指定平台深度开发，反感只套厂商Demo",
    "重现场真机演示与答辩一致性，能力测评用于核验真实水平",
    "鼓励自主设计扩展电路、体现硬件功底",
    "AI应用融入是近年导向（官方发布AI应用说明）"
  ],
