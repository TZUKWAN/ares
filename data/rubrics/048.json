{
  "competition_id": 48,
  "competition_name": "三维数字化创新设计大赛",
  "judging_dimensions": [
    {
      "dimension": "答辩评审（路演+专家评审）",
      "weight": "占组别总成绩：研究生/本科生组60%、青少年组60%、高职高专组40%（组委会官方评审标准表）",
      "official_wording": "第十九届数字化设计与制造大赛通知评审标准表：“1 答辩评审 高职高专组权重40%，研究生/本科生组权重60%，青少年组权重60%，详见《竞赛手册》，文创实物答辩评审”；评审办法：“评审采用综合评分办法，详细要求见《竞赛手册》”",
      "scoring_points": [
        "设计创意与创新点说明（围绕当届主题，体现数字化设计价值）",
        "技术方案完整：设计原理、功能实现方式、结构分析、材料与工艺策略",
        "实物作品现场路演效果与演示质量",
        "回答专家质询的准确性与团队分工表达"
      ],
      "common_deductions": [
        "团队名称或材料中出现院校名称/成员信息（评审公平性要求，违规处理）",
        "实物与申报材料不符、路演超时",
        "创新点讲不清、关键工艺参数缺失"
      ]
    },
    {
      "dimension": "现场实操（现场设计/制造/检测）",
      "weight": "占组别总成绩：高职高专组60%、研究生/本科生组40%、青少年组40%（组委会官方评审标准表）",
      "official_wording": "第十九届通知评审标准表：“2 现场实操 高职高专组权重60%，研究生/本科生组权重40%，青少年组权重40%，详见《竞赛手册》，现场创新设计/3D检测/增材制造”；国赛实操环节示例：“现场利用数字化设计、3D检测技术、连续纤维打印技术，做出轻量化、高强度的赵州桥拱形结构件；在同等形状尺寸大小的情况下，进行3D检测（生成检测报告）、称重及压力测试（重量轻+承重大）”",
      "scoring_points": [
        "现场命题的数字化设计完成度与结构合理性",
        "增材制造工艺质量（打印成功率、结构与表面质量）",
        "量化指标成绩：更轻（称重）+承重大（压力测试）、3D检测报告精度",
        "限时完成与现场应变"
      ],
      "common_deductions": [
        "打印失败、结构件压溃、超重",
        "未生成3D检测报告或数据造假",
        "超时未完成实操任务"
      ]
    },
    {
      "dimension": "三维数字化模型与作品表达质量",
      "weight": "归入答辩评审分数内：官方未单独公布分值，随材料评审与路演综合计分【推断】",
      "official_wording": "第十九届通知作品提交要求：“设计图、装配图、结构图，3D模型须按要求在作品3Dshow介绍中体现”；开放创新设计作品包含“技术方案介绍，设计原理、功能实现方式、创新点说明、结构兼容性分析、3D打印材料与工艺策略说明等，设计制作有关的视频介绍等”",
      "scoring_points": [
        "3D模型建模质量（结构完整性、装配关系、可制造性）",
        "设计图/装配图/结构图规范",
        "作品展示视频与3DShow专辑页面呈现效果",
        "仿真/检测数据对设计结论的支撑"
      ],
      "common_deductions": [
        "模型缺件、文件无法打开或格式不符",
        "图纸不规范、缺装配关系",
        "视频不能真实反映功能、过度剪辑"
      ]
    },
    {
      "dimension": "原创性与合规",
      "weight": "否决性条件，不计分数（抄袭取消参赛资格）",
      "official_wording": "第十九届通知相关条款：作品必须为未公开发表过的原创，不得侵犯第三方的任何著作权、商标权或其他权利，“凡涉及抄袭、剽窃等作品，组委会有权取消其参赛资格”；作品不得包含违反中华人民共和国法律法规的内容",
      "scoring_points": [
        "原创承诺与素材来源可溯",
        "不侵犯第三方知识产权",
        "内容合法合规"
      ],
      "common_deductions": [
        "抄袭、剽窃、套用往届作品",
        "使用侵权模型/贴图/字体素材",
        "报名信息造假"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "3DShow专辑官网作品",
      "format": "在 3dshow.3ddl.net 专项页面提交：技术方案、设计原理、创新点、结构分析、材料与工艺策略、视频、设计图/装配图/结构图及3D模型",
      "page_limit": "未明确（详见各赛项《竞赛手册》）",
      "deadline_note": "报名/作品提交2026年6月5日-8月31日；截止后不得更换、增减成员"
    },
    {
      "item": "实物作品",
      "format": "答辩评审与国赛须携实物到场（文创产品实物、打印结构件等）",
      "page_limit": "未明确",
      "deadline_note": "省/区域赛9-10月；国赛总决赛11月"
    },
    {
      "item": "报名信息",
      "format": "官网注册组队：每队2-3名在校学生+1-2名指导教师；设高职高专组、研究生/本科生组、青少年组；团队名称不得含院校及成员信息",
      "page_limit": "未明确",
      "deadline_note": "每位学生只能加入1支参赛队"
    }
  ],
  "process_stages": [
    {
      "stage": "初赛/校赛（6-8月）",
      "format": "校内选拔或网络海选",
      "notes": "校赛申请条件：以校为单位不少于20支团队、以学院为单位不少于10支团队且均须官网报名提交作品；按院校团队总数30%比例晋级区域赛（同一院校晋级不超过20支）；未组织校赛参加网络海选，按30%晋级"
    },
    {
      "stage": "复赛/省（区域）赛（9-10月）",
      "format": "全国7大赛区组织线上答辩评审+线下现场实操",
      "notes": "本科生/青少年组线上答辩前40%、高职组前60%进入线下实操；评选特等奖（晋级国赛）、一、二、三等奖"
    },
    {
      "stage": "全国总决赛（11月）",
      "format": "区域赛特等奖团队入围；答辩评审+现场实操",
      "notes": "国赛评一、二、三等奖及优秀指导教师奖、优秀组织奖；据渤海大学转发评审方式：专家评委现场评分，去最高分最低分后取平均"
    }
  ],
  "review_format": "线上/现场路演答辩评审与现场实操竞技加权综合评分（专家评分制，综合评分办法见各赛项《竞赛手册》；国赛现场分去最高最低取平均）",
  "judge_preferences": [
    "设计创意与主题契合、创新点真实可验证",
    "从设计到打印实物、到检测报告的完整闭环",
    "量化指标过硬（更轻、更强、更精）",
    "路演表达清晰、实物演示稳定"
  ],
