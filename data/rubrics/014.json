{
  "competition_id": 14,
  "competition_name": "工程实践与创新能力大赛",
  "judging_dimensions": [
    {
      "dimension": "现场竞技任务完成（现场初赛/现场决赛）",
      "weight": "初赛占70%、决赛占70%（2025年智能+赛道：现场初赛70分，决赛现场决赛70分）",
      "official_wording": "赛程安排：第一环节初赛任务命题文档20分、作品创意设计10分、现场初赛70分；决赛：创新实践环节30分、现场决赛70分（2025年中国大学生工程实践与创新能力大赛智能+赛道竞赛过程解析，安徽工程大学发布）",
      "scoring_points": [
        "智能物流搬运：读码领任务、行走避障、物料识别抓取、路径规划与精准摆放（按二维码读取正确性、抓取正确性、放置准确程度计算成绩）",
        "生活垃圾智能分类：分类正确性、显示正确性、满载检测（垃圾存放超箱容75%）与宣传片播放环节",
        "智能救援/智能分拣等赛项的现场任务指标",
        "每队两轮运行取最好成绩（垃圾分类赛项）",
        "决赛现场抽签产生任务，现场完成零部件设计制造与机器人调试"
      ],
      "common_deductions": [
        "任务失败（未读对码、抓取失误、放置超差）按规则扣分",
        "机器人越界或碰撞场地设施",
        "两轮均失败该环节记最低分"
      ]
    },
    {
      "dimension": "任务命题文档（决赛场景策划与工程图）",
      "weight": "占初赛成绩的20%（20分）",
      "official_wording": "任务命题文档A（20分）：参赛队按照决赛的任务命题文档模版提交决赛任务命题方案，根据命题规则给出所策划场景、场地各区域形式位置及物料、物料形状尺寸及零件图（工程图）、对竞赛过程的设想，该项得分计入其初赛成绩；成绩包括内容符合命题规则的程度，也包括文档的排版规范，采用扣分制（2025年智能+赛道竞赛过程解析）",
      "scoring_points": [
        "场景与场地策划符合命题规则",
        "物料形状、尺寸及零件图（工程图）的规范性",
        "竞赛过程设想的完整性",
        "文档排版规范（扣分制评分）"
      ],
      "common_deductions": [
        "文档要素缺项逐条扣分（扣分制）",
        "工程图不符合制图规范",
        "超期提交"
      ]
    },
    {
      "dimension": "作品创意设计",
      "weight": "占初赛成绩的10%（10分）",
      "official_wording": "作品创意设计B（10分）：依据创新性、美观性和合理性等对作品设计进行评价，为所有专家分数的平均值；同校作品雷同得0分（2025年智能+赛道竞赛过程解析）",
      "scoring_points": [
        "创新性：符合主题要求，外形结构与内部结构有新意",
        "美观性：整体美观、实用",
        "合理性：结构方案与功能匹配",
        "多名专家独立打分取平均"
      ],
      "common_deductions": [
        "同校作品雷同得0分",
        "创意与任务功能脱节"
      ]
    },
    {
      "dimension": "决赛创新实践环节（现场设计制造与调试）",
      "weight": "占决赛成绩的30%（30分）",
      "official_wording": "现场实践与考评：现场抽签产生现场决赛任务，根据决赛题目要求，参赛队在现场实践场地完成规定零部件的设计及制造及机器人的调试，现场将提供相关的加工设备（2025年智能+赛道竞赛过程解析）",
      "scoring_points": [
        "规定零部件现场设计（工程图）与制造质量",
        "现场加工设备操作的规范性与安全性",
        "制造完成后机器人重新调试的任务达成度",
        "限时完成能力"
      ],
      "common_deductions": [
        "零件加工超差或无法装配",
        "违规操作机床/设备",
        "限时内未完成调试"
      ]
    },
    {
      "dimension": "工程素养与工程文化（贯穿各赛道）",
      "weight": "定性考察（历届主题强调工程伦理、劳动精神与综合工程素养）",
      "official_wording": "大赛主题'守德崇劳，工程创新求卓越；服务社会，智造强国勇担当'；考察工程思维、工程创新、工程伦理与团队合作等综合素质（大赛章程/主题表述及高校组织通知）",
      "scoring_points": [
        "工程问题求解的完整流程（分析-设计-制造-调试-迭代）",
        "绿色低碳与可持续发展意识的体现（如企业运营仿真以绿色生产决策为特色）",
        "团队协作与职业规范",
        "虚拟仿真赛道：飞行器设计仿真、智能网联汽车设计、工程场景数字化、企业运营仿真的仿真结果与决策质量"
      ],
      "common_deductions": [
        "违反工程伦理或安全操作规程",
        "作品含学校标识信息（前身为工训赛时即明令禁止）",
        "团队分工失衡、单人操盘"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "竞赛机器人/装置作品",
      "format": "自主设计并制造机械部分，除标准件外非标零件须自主设计和制造，不允许使用购买的成品套件拼装；金属与非金属材质须安全（禁用锋利结构）",
      "page_limit": "未明确",
      "deadline_note": "按省赛/国赛赛程现场携带并检录"
    },
    {
      "item": "任务命题文档（智能+赛道决赛环节）",
      "format": "按决赛任务命题文档模版撰写（含场地策划、物料零件图、过程设想）",
      "page_limit": "按模板",
      "deadline_note": "初赛阶段提交，计入初赛成绩20分"
    },
    {
      "item": "虚拟仿真赛道成果",
      "format": "飞行器设计仿真、智能网联汽车设计、工程场景数字化、企业运营仿真等赛项的仿真模型与结果报告",
      "page_limit": "未明确",
      "deadline_note": "按赛项规程线上提交/平台竞赛（企业运营仿真平台qyyyfz.com，模拟两年八个季度经营）"
    }
  ],
  "process_stages": [
    {
      "stage": "校级初赛",
      "format": "高校组织校内选拔（每队3-4名学生+1-2名指导教师，每人限报一个赛项）",
      "notes": "赛制为校级初赛-省级复赛-全国总决赛三级；大赛由教育部高等教育司主办，每两年举办一届"
    },
    {
      "stage": "省级复赛（选拔赛）",
      "format": "各省组织赛区赛（如北京赛区29所高校参赛），按国赛命题和评分执行或参照执行",
      "notes": "赛道设置：工程实践赛道（太阳能电动车、生物质能电动车等）、智能+工程创新赛道（智能物流搬运、生活垃圾智能分类、智能救援、智能分拣等）、虚拟仿真赛道（飞行器设计仿真、智能网联汽车设计、工程场景数字化、企业运营仿真）"
    },
    {
      "stage": "全国总决赛",
      "format": "现场竞技+现场设计制造考评（智能+赛道：创新实践环节30分+现场决赛70分）；分区/分组举行",
      "notes": "2025年预通知于2024-06-25发布；各赛项命题与评分规则文件由各省级赛区/承办校公布（如华南理工、上海理工、西安交大城市学院等发布的赛项评分标准）"
    }
  ],
  "review_format": "客观任务计分为主：智能+赛道初赛总成绩P=任务命题文档A(20分)+作品创意设计B(10分)+现场初赛C(70分)，决赛=创新实践环节30分+现场决赛70分；创意设计由专家平均分评定，命题文档采用扣分制，其余按任务完成度机器判定。",
  "judge_preferences": [
    "真刀真枪的工程实现：非标零件自主设计制造比例越高越受认可",
    "现场任务完成的精度与稳定性优于花哨功能",
    "重安全与规范：用电、机床操作、机器人防护符合工程规范",
    "创意设计求真求新，同校雷同零容忍",
    "虚拟仿真赛道重数据驱动决策（尤其企业运营仿真的绿色低碳决策）"
  ],
