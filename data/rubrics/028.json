{
  "competition_id": 28,
  "competition_name": "金相技能大赛",
  "judging_dimensions": [
    {
      "dimension": "金相图像质量——组织正确与组织清晰度",
      "weight": "40分（图像质量80分中的主项，占总分40%）",
      "official_wording": "全国大学生金相技能大赛评分标准（海南大学选拔赛通知附评分表）：'几乎看不清组织'0～4分；'可以辨别部分组织、很不清晰'5～12分；'组织可勉强辨别、不够清晰'13～20分；'组织正确、组织比较清晰'21～32分；'组织正确、组织很清晰'33～40分。",
      "scoring_points": [
        "显微组织判定正确（不得混入假组织/错判材料状态）",
        "高倍下组织清晰可辨、衬度合适、视场明亮均匀",
        "腐蚀程度恰当：不过蚀（发黑/蚀坑）也不欠蚀（组织未显示）",
        "视场选择具有代表性，能反映材料真实组织"
      ],
      "common_deductions": [
        "组织错误（如把网状渗碳体判为铁素体等相组成误判）直接落入低分档",
        "腐蚀不足或过腐蚀导致组织模糊、难以辨别",
        "视场落在缺陷区而非代表性区域"
      ]
    },
    {
      "dimension": "金相图像质量——划痕与假象",
      "weight": "划痕20分+假象20分（合计占总分40%）",
      "official_wording": "同上评分表：划痕——'低倍粗大划痕3条以上且交叉'0～5分；'无低倍粗大划痕，高倍细划痕数量很少或没有'18～20分。假象——'假象较多'0～8分；'基本没有假象'15～20分（该项满分20分）。",
      "scoring_points": [
        "无低倍粗大划痕、高倍细划痕尽量少（磨制各道砂纸间转动90°、磨透换道）",
        "无变形层/扰乱层等抛光假象",
        "无水迹、污渍、腐蚀花斑等假象",
        "抛光织物与磨料选择得当，避免麻点与拖尾"
      ],
      "common_deductions": [
        "粗大划痕交叉、划痕方向单一未换向",
        "抛光时间不足残留磨制变形层",
        "清洗不净残留抛光膏/腐蚀剂花斑形成假象"
      ]
    },
    {
      "dimension": "样品表面质量（宏观检查）",
      "weight": "10分：宏观划痕及清洁程度5分+观察面平整度4分+倒角1分",
      "official_wording": "同上评分表：'污迹、坑点、宏观划痕多'0～1分、'污迹、坑点、宏观划痕少或没有'4～5分；平整度——'有明显坡面'0～2分、'很平整'4分；倒角——'标准倒角为（0.5～1）mm×45°'0～1分（目测）。",
      "scoring_points": [
        "观察面无宏观划痕、坑点，表面洁净无污迹",
        "磨面平整无坡面（斜面会导致高倍聚焦困难）",
        "倒角规范：0.5～1mm×45°，边缘无圆角化",
        "样品编号端面完好可识别"
      ],
      "common_deductions": [
        "磨面呈明显斜坡/双面磨",
        "倒角过大或缺失导致观察面边缘崩边",
        "表面留有腐蚀指印、水渍"
      ]
    },
    {
      "dimension": "操作规范（现场操作分）",
      "weight": "10分：磨制操作0～3分+抛光及腐蚀操作0～4分+显微镜操作0～3分（占总分10%）",
      "official_wording": "同上评分表：操作规范旨在'引导学生良好实验习惯'，按磨制操作（0～3分）、抛光及腐蚀操作（0～4分）、显微镜操作（0～3分）现场扣分。安徽赛区规程细则含'手拿试样未倾斜导致腐蚀剂流失'等操作扣分项。",
      "scoring_points": [
        "磨制：砂纸选用顺序合理、试样受压均匀、逐道换向磨透",
        "抛光：抛光织物/磨料使用规范、适时转动试样、控制抛光时间",
        "腐蚀：浸蚀/擦拭操作规范（试样倾斜、腐蚀剂均匀作用、及时清洗吹干）",
        "显微镜操作：规范调焦、物镜/目镜选用合理、观察后复位"
      ],
      "common_deductions": [
        "操作粗暴、安全防护缺失（腐蚀剂溅洒）",
        "跳过砂纸道次或未磨净前道划痕即抛光",
        "显微镜违规操作（直接升降载物台压碎试样、乱调光路）",
        "结束后台面不整理、废液未按规定处理"
      ]
    },
    {
      "dimension": "时间管理与现场纪律（记零分/扣分条款）",
      "weight": "否决性条款：违规直接记零分或扣总分3分/次",
      "official_wording": "决赛竞赛规则（苏州城市学院发布第十四届规则）：'选手在刻有编号的端面上进行磨制导致样品编号无法识别的，成绩记为零分'；'在工作人员宣布比赛结束一分钟后仍未上交样品的'，样品不再送评、成绩记零分；'比赛过程中样品丢失申领新样品，每一次总分扣除3分'。",
      "scoring_points": [
        "每位选手每个指定样品30分钟内独立完成磨制、抛光、腐蚀、显微观察全过程",
        "按时上交样品（宣布结束1分钟为硬性时限）",
        "保护样品编号端面",
        "妥善保管样品避免丢失（补领扣3分/次）"
      ],
      "common_deductions": [
        "超时未上交→成绩记零分",
        "编号端面被磨→成绩记零分",
        "样品丢失补领→每次扣总分3分"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "制备完成的金相试样",
      "format": "从指定样品（如20钢等）中经车削加工的未经倒角试样，现场完成倒角-粗磨-细磨-抛光-腐蚀全流程",
      "page_limit": "未明确",
      "deadline_note": "每个样品限时30分钟，宣布比赛结束1分钟内必须上交，否则记零分"
    },
    {
      "item": "显微观察图像（现场采图）",
      "format": "由现场统一配置金相显微镜观察，评委按图像质量档位打分",
      "page_limit": "未明确",
      "deadline_note": "与30分钟限时同步完成"
    },
    {
      "item": "报名与选拔材料",
      "format": "以学校为单位组织校级初赛/复赛选拔，按名额报全国复赛、决赛",
      "page_limit": "未明确",
      "deadline_note": "预赛-复赛-决赛三级递进；第十四届总决赛2025年7月25-30日在四川宜宾举行"
    }
  ],
  "process_stages": [
    {
      "stage": "校级初赛（校园选拔赛）",
      "format": "参照全国大赛评分标准现场制样评比，选拔晋级选手",
      "notes": "各高校材料学院组织（如海南大学、厦门工学院等均按全国评分表执行校级赛）"
