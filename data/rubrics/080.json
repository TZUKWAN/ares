{
  "competition_id": 80,
  "competition_name": "全球校园AI算法精英大赛",
  "judging_dimensions": [
    {
      "dimension": "算法效果（自动化评测指标）",
      "weight": "选拔赛/复赛主体（排行榜自动评分决定入围，答辩环节前约占60%-70%）【推断】",
      "official_wording": "主办学会（江苏省人工智能学会）第四届通知原文：'选手可以通过排行榜实时查看排名'；'大赛评审团根据排行榜上自动化评分结果及专家审核结果评选出三大赛题入围精英赛的21支队伍'。量化占比官方未公布，为【推断：由'自动化评分结果'在评审措辞中居首推定】。",
      "scoring_points": [
        "按赛题评测指标（如精度、召回、CTR指标、对话质量等）在排行榜得分",
        "提交算法模型/代码结果，线上提交按系统自动评分实时排名",
        "复赛成绩等同省级赛事成绩，按成绩晋级总决赛"
      ],
      "common_deductions": [
        "提交格式不符或代码无法运行导致评测失败",
        "刷榜作弊、人工标注泄露、使用测试集调参被专家审核剔除",
        "评测成绩相同按提交时间先后判定落后"
      ]
    },
    {
      "dimension": "结果可复现性与工程规范性",
      "weight": "专家审核必审项（一票否决性质）",
      "official_wording": "官方通知原文：'均需提供Docker文件供赛事组委会审核，确保可以复现选拔赛结果'。属资格审查型维度，不设百分比。",
      "scoring_points": [
        "提供Docker文件，选拔赛结果可一键复现",
        "代码结构清晰、依赖说明完整",
        "训练与推理流程可追溯、无数据泄漏"
      ],
      "common_deductions": [
        "Docker文件缺失或复现失败",
        "复现结果与排行榜成绩严重不符",
        "代码含硬编码路径/密钥、无法在官方环境运行"
      ]
    },
    {
      "dimension": "方案创新性与技术难度",
      "weight": "总决赛约30%-40%【推断】",
      "official_wording": "第八届通知转述：赛道'全方位考查青年学子的算法创新能力、工程实践能力、创新思维'；'根据赛题要求设计算法模型、编写代码、提交赛题结果或给出完整解决方案'。量化占比为【推断：参照同类算法竞赛（创新赛维度+答辩权重）模型推定】。",
      "scoring_points": [
        "算法模型/工程方案相对基线的改进点明确",
        "选题契合赛道方向（挑战/创新/应用/主题/产业命题/专项）",
        "产业命题赛需回应企业真实需求，方案具备落地价值"
      ],
      "common_deductions": [
        "直接套用开源基线无改进",
        "创新点与评测指标脱节、包装大于实质",
        "技术报告与演示内容不一致"
      ]
    },
    {
      "dimension": "成果演示与答辩",
      "weight": "总决赛约20%-30%（PPT汇报+成果演示+答辩）【推断】",
      "official_wording": "赛氪第五届总决赛规程转述：'进入总决赛的队伍在进行展示和答辩时可在省赛项目核心内容不变的情况下进行必要的补充和拓展。参赛者须通过作品汇报PPT、成果演示、答辩等形式，全方位（展示）'；第四届官方通知：'所有入围队伍需进行线上竞赛，并完成线下答辩，确定最终排名'。",
      "scoring_points": [
        "PPT汇报逻辑清晰、突出方法与结果",
        "成果演示真实可运行",
        "答辩答问准确、核心内容与省赛一致"
      ],
      "common_deductions": [
        "演示失败或用录屏替代被质疑",
        "答辩暴露团队成员对方案理解不足",
        "擅自变更省赛核心内容"
      ]
    }
  ],
