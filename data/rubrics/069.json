{
  "competition_id": 69,
  "competition_name": "物联网设计竞赛",
  "judging_dimensions": [
    {
      "dimension": "创新性与选题价值",
      "weight": "25%【推断：官方评分细则全文未公开，按物联网/嵌入式类赛事通行维度权重推断】",
      "official_wording": "评审一般考察创新性与选题意义（赛事通知与院校转述归纳；官网评分细则未公开检索到）【推断】",
      "scoring_points": [
        "选题瞄准物联网真实场景痛点（智慧农业、工业监测、智慧家居、健康监护等）",
        "应用模式或系统方案有新意，非简单拼装开发板demo",
        "社会价值与商业潜力论证",
        "鼓励使用华为云IoT/HarmonyOS/北向API等平台能力的创新集成"
      ],
      "common_deductions": [
        "选题烂大街（又一朵智慧花盆/烟雾报警），无场景差异化",
        "伪物联网：只是手机App+蓝牙无联网架构",
        "创新点仅为现成模块堆叠"
      ]
    },
    {
      "dimension": "系统方案设计与技术难度",
      "weight": "25%【推断】",
      "official_wording": "系统方案设计与技术难度为通行评审维度（院校通知归纳）【推断】",
      "scoring_points": [
        "感知层-网络层-平台层-应用层架构完整合理",
        "技术深度：通信协议选型（NB-IoT/LoRa/MQTT）、边缘计算、数据处理与安全设计",
        "关键技术问题解决能力（低功耗、弱网、并发接入等）",
        "设计报告的技术论证质量（架构图、数据流、接口设计）"
      ],
      "common_deductions": [
        "架构描述空泛，报告与实现脱节",
        "技术含量低：全部使用现成云模板未做二次开发",
        "系统无安全与隐私设计"
      ]
    },
    {
      "dimension": "作品完成度与功能实现",
      "weight": "30%【推断：实物原型可演示为硬要求，通常为最大分项】",
      "official_wording": "分赛区选拔赛阶段需完成作品设计，制作可演示的产品原型，确保核心工作量（兰州交通大学选拔赛通知）；须对作品实物模型或实物样机进行视频展示（院校赛事总结）",
      "scoring_points": [
        "实物样机/产品原型真实可用，核心功能全部跑通",
        "端到端演示：感知采集→传输→云平台→应用反馈闭环",
        "演示视频3分钟以内直观展示实物功能",
        "稳定性：现场演示不宕机、断联可恢复"
      ],
      "common_deductions": [
        "只有仿真或PPT无实物（完制度分重扣）",
        "演示翻车：现场网络问题无预案",
        "核心功能缺失，只演示边缘功能"
      ]
    },
    {
      "dimension": "现场演示与答辩表现",
      "weight": "20%【推断：现场演示与答辩为决赛规定环节】",
      "official_wording": "分赛区决赛和全国总决赛阶段，需进行现场的作品演示和答辩（2026年全国大学生物联网设计竞赛Nordic赛道合作公告，电子工程专辑）",
      "scoring_points": [
        "现场介绍与演示（约5分钟）逻辑清晰、重点突出",
        "答辩质疑（约3分钟）应答准确，队内分工明确",
        "演示与陈述节奏控制，突出技术亮点",
        "对评委关于架构、成本、可靠性的追问应对"
      ],
      "common_deductions": [
        "超时或演示依赖特定私有网络环境",
        "答辩只有一人能答、队员不了解系统",
        "回避评委问题、过度营销话术"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "作品设计报告",
      "format": "PDF/Word 按当届模板（系统架构、功能说明、创新点）",
      "page_limit": "未明确",
      "deadline_note": "分赛区网评阶段提交（春季学期，约4-6月）"
    },
    {
      "item": "作品演示视频",
      "format": "视频展示实物模型/样机功能，时长3分钟以内",
      "page_limit": "未明确",
      "deadline_note": "随设计报告同批提交"
    },
    {
      "item": "实物原型",
      "format": "可演示的产品原型（硬件样机+云平台/应用），分赛区决赛与总决赛须带到现场",
      "page_limit": "未明确",
      "deadline_note": "分赛区决赛与全国总决赛（约7-8月）现场演示"
    },
    {
      "item": "报名（以学校为单位组队）",
      "format": "在校本科生组队参赛，设指导教师；通过官网/华为云平台报名，企业赛道（HarmonyOS、Nordic等）按赛道要求",
      "page_limit": "未明确",
      "deadline_note": "每年上半年报名（华为云竞赛页/官网通知）"
    }
  ],
  "process_stages": [
    {
      "stage": "校级选拔",
      "format": "校内答辩评审（答辩安排表形式组织）",
      "notes": "选拔队伍按学校限额报名分赛区"
    },
    {
      "stage": "分赛区网评/预赛",
      "format": "评委对设计报告、演示视频、系统方案封闭式网评打分",
      "notes": "按评分细则筛选晋级分赛区决赛的队伍"
    },
    {
      "stage": "分赛区决赛",
      "format": "现场作品演示+答辩",
      "notes": "分赛区设一、二、三等奖，优胜队伍晋级全国总决赛"
    },
    {
      "stage": "全国总决赛",
      "format": "现场作品演示+答辩，全国设一、二、三等奖",
      "notes": "近年与华为等企业深度合作（华为杯），设企业专项赛道（HarmonyOS、Nordic、火山引擎等）"
    }
  ],
  "review_format": "网评（设计报告+演示视频）与现场评审（实物演示+答辩）结合：分赛区与全国总决赛均须现场演示和答辩",
  "judge_preferences": [
    "端到端闭环能现场跑通是第一印象分——实物演示优先于PPT",
    "偏好真实场景数据接入与云端联动，反感纯本地demo",
    "使用华为云IoT/HarmonyOS等平台能力的作品在专项赛道有加分空间",
    "看重低功耗、弱网、安全等物联网特有技术问题的处理",
    "答辩关注成本与可落地性，警惕'科研包装+两个传感器'式作品"
  ],
