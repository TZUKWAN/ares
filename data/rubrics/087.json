{
  "competition_id": 87,
  "competition_name": "RAICOM个人赛",
  "judging_dimensions": [
    {
      "dimension": "程序正确性（测试点得分）",
      "weight": "计分权重100%（客观题：每题按通过测试点比例给分，选手总得分为各题得分之和）",
      "official_wording": "睿抗官网2025年CAIP信息技术创新编程技能赛国赛规则PDF：'分高职组、本科组，题目不同，同一时间按统一评分规则比赛''决赛按选手总得分排名'。CSDN转载官方介绍：编程题按测试用例通过比例计分（OJ黑盒评测，通过多少测试点得多少分）。【计分细则原文以官网当年规则PDF附件为准】",
      "scoring_points": [
        "每道编程题按测试点通过比例给分，全部通过得该题满分",
        "总得分为所有题目得分之和，按总得分排名",
        "题型为算法与程序设计题（PAT/CCF CSP风格，常考图论、动态规划、模拟、数据结构）",
        "支持C/C++/Java/Python等语言在指定OJ环境提交",
        "实时评测反馈，可多次提交（以规则允许的计分方式为准）"
      ],
      "common_deductions": [
        "编译错误/超时/内存超限导致测试点不得分",
        "输出格式不严格符合题面要求被判错",
        "使用规则禁止的本地读写或头文件被判无效"
      ]
    },
    {
      "dimension": "解题用时（同分排序）",
      "weight": "不计入分值（0%），作为总得分相同情况下的排名依据（同类OJ赛事通行做法）",
      "official_wording": "官网规则PDF明确'决赛按选手总得分排名'，对同分细则未在检索所得摘要中呈现。【推断：按程序设计竞赛通行做法，同分先比较总用时或最后通过题时间，具体以当年规则PDF为准】",
      "scoring_points": [
        "总得分相同时比较用时/罚时（按通行OJ规则）",
        "尽早完成高分值题目有助于同分占优",
        "错误提交可能计罚时（以当年规则为准）"
      ],
      "common_deductions": [
        "同分情况下因罚时劣势排名靠后",
        "临近截止集中提交导致无时间调试"
      ]
    },
    {
      "dimension": "参赛合规与独立完成",
      "weight": "一票否决：违反考场纪律或代写作弊取消成绩与获奖资格",
      "official_wording": "成都信息工程大学校赛通知：选手须携带有效证件（身份证或学生证）入场机考；官网规则要求赛前完成本地竞赛环境测试。线上赛反作弊为同类赛事通行要求。【推断：代写、多人协同、网络查询等按违规处理，细则以当年规则PDF为准】",
      "scoring_points": [
        "实名参赛，机考现场核验身份证/学生证",
        "赛前按官方要求完成竞赛环境测试",
        "独立完成代码，不借助违规网络资源",
        "以学生1人+指导老师1人的个人赛名义报名"
      ],
      "common_deductions": [
        "找人代写或使用AI代答被代码查重/行为监测认定作弊",
        "考场携带违规资料或通信设备",
        "报名信息与证件不符导致成绩无效"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "赛题程序源代码",
