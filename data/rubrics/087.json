      "item": "本地竞赛环境测试",
      "format": "按官方规则PDF完成编译环境与浏览器测试",
      "page_limit": "未明确",
      "deadline_note": "赛前按官网通知完成"
    }
  ],
  "process_stages": [
    {
      "stage": "校赛（部分高校组织校内选拔）",
      "format": "校内机房机考，PTA系统2小时，择优推荐省赛",
      "notes": "2025年例：5月11日13:00-15:00；一等奖≤10%、二等奖≤15%、三等奖≤20%（0分及弃赛者不计入基数）"
    },
    {
      "stage": "省赛/分站赛",
      "format": "各省统一线上/线下机考，个人赛（学生1人+指导老师1人）",
      "notes": "省赛一、二、三等奖总体比例不超过报名人数的40%，其中各占比不超过15%、25%、40%（甘肃省赛通知）；省赛获奖选手择优晋级国赛"
    },
    {
      "stage": "全国总决赛",
      "format": "统一时间线上/线下机考，分本科组、高职组，题目不同、统一评分规则",
      "notes": "2025年国赛8月15日举行；按选手总得分排名决出一、二、三等奖（第三方整理：约20%/40%/40%，以当年总决赛通知为准）"
    }
  ],
  "review_format": "OJ系统机器自动评测（黑盒测试点计分）+总得分排名，全程客观题无人工评审",
