{
  "competition_id": 27,
  "competition_name": "集成电路创新创业大赛",
  "judging_dimensions": [
    {
      "dimension": "作品技术深度与完成度（技术文档+技术数据）",
      "weight": "技术文档为评审打分重要依据（官方定性，各杯赛评分细则自定，未公开统一百分制）",
      "official_wording": "第十届全国总决赛比赛要求及说明（官网）：'技术文档将作为评审打分重要依据。作为作品技术方案、实现逻辑、研发过程的完整支撑材料，需详实、严谨、可追溯，全面呈现作品研发细节'；'若评委对作品存疑时将以此（技术数据）为准复核查验。若未按要求提交导致复核失败将做出扣分、取消成绩和奖项等处罚'。",
      "scoring_points": [
        "设计链路完整：规格定义→RTL/电路设计→仿真验证（前仿真/后仿真）→版图/上板实现",
        "技术数据完整可复现：代码、工程文件、仿真库、测试结果（如复旦微命题要求'技术数据完整全面，确保可复现'）",
        "验证充分性：跑分结果、验证截图等佐证（如七星微命题要求附实际跑分结果与运行视频）",
        "技术文档结构：附'作品核心内容快速预览'与目录索引，逻辑可追溯"
      ],
      "common_deductions": [
        "技术数据缺项、评委复核时无法复现（扣分直至取消成绩）",
        "只有结论无可追溯的研发过程记录",
        "后仿真/版图方案缺失（如芯海命题明确要求前仿真、版图与后仿真方案在技术文档中明确呈现）",
        "企业评阅环节代码未按要求部署（如中科芯命题：代码须提前放服务器，企业评阅参与打分，未提交直接影响成绩）"
      ]
    },
    {
      "dimension": "创新性与原创性",
      "weight": "定性评审；成果类命题明确将原创性、创新点纳入评审（各杯赛细则自定）",
      "official_wording": "第十届总决赛'七星微'命题：'技术文档中需针对作品的原创性、可行性、创新点做出明确说明并附佐证材料'；成果类命题（芯片应用/设计/产业链创新成果命题）：'本赛题将综合考量项目的整体成熟度与参赛团队成员的实质性贡献……未明确界定或无实质贡献的成果将不予计分'。",
      "scoring_points": [
        "架构/算法/电路层面的原创点及与现有方案对比优势",
        "创新点有实测数据支撑而非概念描述",
        "成员实质性贡献界定清晰（每位成员的角色、核心工作、量化贡献）",
        "产业课题池项目须明确说明来源与团队增量创新部分"
      ],
      "common_deductions": [
        "创新点为开源项目/他人成果的简单拼装且未注明",
        "无实质贡献的成员挂名成果不予计分",
        "宣称的创新指标无佐证数据"
      ]
    },
    {
      "dimension": "应用价值与系统落地（芯片应用/芯创成果方向）",
      "weight": "定性评审：应用类赛题看重在指定平台上的功能实现与演示效果",
      "official_wording": "第十届总决赛'飞腾'命题：'答辩须重点说明在飞腾平台上实现的功能'，高阶功能须说明'风险管控和安全可靠性设计'；多数应用类命题要求'仅允许现场使用实物进行演示'（紫光同创、复旦微、中科芯等）。",
      "scoring_points": [
        "在指定国产平台（飞腾/龙芯/紫光同创FPGA/算能等）上实现功能的深度与复杂度",
        "现场实物演示稳定性与完成度",
        "系统方案的工程可行性、成本与可靠性考量",
        "面向真实产业场景的应用叙事（产业课题池项目）"
      ],
      "common_deductions": [
        "演示与答辩宣称功能不符（奥施特命题明确：答辩表现和题目完成结果明显不符将扣分）",
        "无法现场演示又不提供视频佐证",
        "平台功能实现浅、仅跑通demo"
      ]
    },
    {
      "dimension": "实操/考试能力（实操类赛题）",
      "weight": "实操类赛题以上机实操/现场实测结果计分（部分命题无需提交技术文档与PPT）",
      "official_wording": "第十届总决赛'紫光教育'命题：比赛形式为实操，共90分钟，'现场发放比赛纸质版赛题'；'胜达克'命题：2小时30分钟完成'测试电路搭建，并完成所有测试程序的编写，调试工作'；'龙芯中科'命题：实操3小时全部队伍统一进行。",
      "scoring_points": [
        "限时内完成的正确率与功能覆盖（考试/实操客观计分）",
        "调试与排障能力（部分命题要求提交调试记录文档：问题现象→分析验证→定位→解决方案）",
        "测试原理与代码逻辑掌握（信诺达命题：5分钟答辩直接就被测器件测试原理、方法、代码逻辑提问）",
        "现场遵守考试纪律"
      ],
      "common_deductions": [
        "实操超时或功能未跑通",
        "考试违规（联网、携带纸质材料、使用规定外设备）由组委会及现场评审处理，包括扣分、取消成绩",
        "答辩对实操结果原理性提问答不上"
      ]
    },
    {
      "dimension": "答辩表现与团队素养",
      "weight": "现场答辩独立计时：多为PPT讲解10分钟+专家提问5分钟（实操类另计）",
      "official_wording": "第十届总决赛要求：'计时自打开PPT后开始，原则上答辩、演示、提问互动等环节独立计时……超时将会被终止答辩'；PPT要求：'结构清晰……重点突出：提炼核心成果与关键技术指标，拒绝大段文字堆砌'、'评委的关注点将完全集中在作品的技术深度、实现逻辑、创新性与应用价值上'。",
      "scoring_points": [
        "核心亮点、创新点、应用价值、关键成果的提炼表达",
        "回答评委技术追问的准确性与团队分工覆盖",
        "PPT以内容为王：避免动画特效堆砌（官方明示非核心环节）",
        "演示与讲解协同（队友同步搭建演示环境）"
      ],
      "common_deductions": [
        "超时被终止答辩",
        "答辩讲述与提交材料不一致",
        "PPT文件现场无法播放（官方要求必须上传纯图片版或PDF版）"
      ]
    }
  ],
