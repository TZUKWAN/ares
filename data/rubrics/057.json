{
  "competition_id": 57,
  "competition_name": "“21世纪杯”英语演讲",
  "judging_dimensions": [
    {
      "dimension": "已备演讲（Prepared Speech）",
      "weight": "30%（全国半决赛/总决赛三部分权重之一，官方章程原文；每部分内部按内容45%+语言表达35%+综合印象20%评分）",
      "official_wording": "章程（2021年，21英语网发布）原文：'赛事分为三部分：已备演讲、即席演讲和现场问答。评判标准如下：已备演讲占30%，即席演讲占40%，现场问答占30%。其中各部分评分中，内容占45％……语言表达占35％……综合印象占20％……地区不同略有差别。'",
      "scoring_points": [
        "内容（部分内占45%）：紧扣主题（如'The revival of traditional culture'）、结构清晰、论证合理、逻辑严谨、内容生动且具有创意",
        "语言表达（部分内占35%）：用词恰当、发音准确、语调标准、吐字清晰、停顿得当、表达流畅、富有感染力",
        "综合印象（部分内占20%）：仪态大方、举止得体、表现力强，善用眼神、表情及肢体语言与评委观众交流",
        "自拟题目、讲好中国故事的国际传播视角"
      ],
      "common_deductions": [
        "跑题、大段抄袭、稿件雷同（作弊直接淘汰）",
        "演讲稿与录像作者不一致、稿件与音视频内容不一",
        "透露本人姓名、学校等影响评判的个人信息"
      ]
    },
    {
      "dimension": "即席演讲（Impromptu Speech）",
      "weight": "40%（全国阶段三部分中权重最高，官方章程原文）",
      "official_wording": "章程原文：'即席演讲占40%'。即席演讲考察选手临场审题、快速组织观点与语言输出的综合能力（依据赛制三部分设置推断其重点为临场思维与语言组织）。【推断：子项考查重点依据演讲赛事通行评判实践】",
      "scoring_points": [
        "快速审题与观点建构：短时间内形成有逻辑的论述框架",
        "内容的创意与深度：举例贴切、见解独到",
        "语言组织的流畅度与准确度：无明显长时间停顿或语塞",
        "临场心理素质与台风稳定性"
      ],
      "common_deductions": [
        "背稿痕迹明显、与抽到题目脱节",
        "逻辑断裂、观点空洞",
        "临场紧张导致大面积语言错误"
      ]
    },
    {
      "dimension": "现场问答（Q&A）",
      "weight": "30%（全国阶段三部分权重之一，官方章程原文）",
      "official_wording": "章程原文：'现场问答占30%'。综合印象子项官方要求：'能灵活有效地利用眼神，表情及肢体语言与评委和观众交流'（章程'综合印象'表述同样适用于问答环节的临场交流能力考查）。",
      "scoring_points": [
        "听懂评委问题并正面回应（理解准确性）",
        "应答内容的逻辑性与信息量",
        "语言组织敏捷、表达自然流畅",
        "与评委的眼神/表情/肢体交流与临场风度"
      ],
      "common_deductions": [
        "答非所问、回避问题",
        "依赖背诵模板句、缺乏真实交流感",
        "用中文作答或长时间沉默"
      ]
    },
    {
      "dimension": "作品合规审核（资格性门槛）",
      "weight": "通过制（校园选拔赛视频作品审核标准：内容占40%、语言表达占40%、综合印象占20%，同时为晋级资格审核；官方章程原文）",
      "official_wording": "校园选拔赛章程（河南财经政法大学转发官方章程）原文：'2）审核标准：1）内容占40％，要求紧扣主题、结构清晰、论证合理、逻辑严谨、内容生动且具有创意；2）语言表达占40％……3）综合印象占20％……'；不通过情形：'跑题、大段抄袭、稿件雷同……透露个人信息，如学校或中文姓名'等8类。",
      "scoring_points": [
        "视频MP4、3分钟左右（不超过4分钟）、360P以上、横屏、本人出镜",
        "演讲稿Word版：Times New Roman，标题18号、正文11号、单倍行距",
        "演讲为原创、稿像一致；无字幕、图片、背景音乐",
        "无违反国家政策、触犯法律法规的词汇与表述，意识形态导向正确"
      ],
      "common_deductions": [
        "稿件字数、音视频时长严重不足或过度冗长",
        "环境影响听不清、视频无法播放",
        "加字幕/图片/背景音乐等后期包装（违规）",
        "录制中透露真实姓名、学校（直接审核不通过）"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "已备演讲稿（电子版）",
      "format": "Word文档，自拟题目；全文字体Times New Roman，标题18号字、正文11号字、单倍行距",
      "page_limit": "时长对应约3分钟讲稿（视频不超过4分钟）；字数无明文",
      "deadline_note": "校园选拔赛作品上传截止（2024年章程为4月20日前），截止后视为自动放弃；作品只能确认提交一次"
    },
    {
      "item": "已备演讲视频",
      "format": "MP4，时长3分钟左右（≤4分钟），本人出镜，建议横屏、人物居正前方、清晰度360P以上、无抖动；不得添加字幕、图片、背景音乐",
      "page_limit": "1条视频，提交后不可反复上传",
      "deadline_note": "同演讲稿一并上传；审核周期为上传成功后15日内，不通过者7日内修改重传"
    },
    {
      "item": "全国阶段现场环节",
      "format": "已备演讲+即席演讲+现场问答三部分现场比拼（全国半决赛/总决赛）",
      "page_limit": "组别：国内设青年组、大学组、高中组等；国际赛事不分组（16-22岁）",
      "deadline_note": "以近年节奏：校园选拔赛/地区初赛（12月-3月）→地区复赛（3-4月）→地区半决赛/决赛（4-5月）→全国半决赛/总决赛（7-8月）→国际公众演讲比赛IPSC（次年5月伦敦）"
    }
  ],
  "process_stages": [
    {
      "stage": "报名与作品上传（校园选拔赛/地区初赛）",
      "format": "官网 contest.i21st.cn 或'21世纪杯'微信服务号报名；上传演讲稿+演讲视频",
      "notes": "在校本科生经校园选拔赛专区参赛；研究生走青年组网上报名通道；作品15日内完成审核"
    },
    {
      "stage": "校园选拔赛复赛/地区复赛",
      "format": "落地（现场）比赛，校园初赛1-2名晋级地区复赛，其余获校园一二三等奖",
      "notes": "现场环节开始引入即席演讲与问答（地区不同略有差别）"
    },
    {
      "stage": "地区半决赛/决赛",
      "format": "现场演讲比赛，评出地区奖项并选拔晋级全国选手",
      "notes": "每年4-5月举行"
    },
    {
      "stage": "全国半决赛/总决赛",
      "format": "已备演讲（30%）+即席演讲（40%）+现场问答（30%），评委会现场评分",
      "notes": "每年7-8月；大学组冠军/优胜者代表中国参加国际公众演讲比赛（IPSC）"
    },
    {
      "stage": "国际公众演讲比赛（IPSC）",
      "format": "大赛为IPSC中国区官方唯一选拔赛，优胜者次年5月赴伦敦参赛",
      "notes": "教育部官方认可的全国赛事之一；大赛创办于1996年，中国日报社指导、21世纪报社主办"
    }
  ],
  "review_format": "线上作品审核（视频+稿件合规与内容评分）与线下现场演讲评审（已备演讲+即席演讲+现场问答，评委会打分）相结合的逐级选拔制",
  "judge_preferences": [
    "内容为纲：紧扣年度主题、讲好中国故事、有创意有思想（各部分内容占45%）",
    "语言功底：发音、语调、流畅度与感染力并重（占35%）",
    "看重真实交流感的台风与临场应变，反感背稿痕迹与模板化表达",
    "即席演讲权重最高（40%），偏好思维敏捷、逻辑建构快的选手",
    "国际传播导向：体现跨文化交流能力与青年风貌"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "演讲过程不得透露本人真实姓名、学校等可能影响评判的个人信息（审核不通过）",
    "禁止跑题、大段抄袭、稿件雷同等作弊行为（取消资格）",
    "视频禁止添加字幕、图片、背景音乐或无关素材",
    "不得出现违反国家政策、触犯法律法规的词汇与表述，不得有意识形态导向性问题",
    "作品只能提交一次；对提高获奖等级的复评申诉原则上不予受理（异议须5个工作日内实名书面提出）"
  ],
