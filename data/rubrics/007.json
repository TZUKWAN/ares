{
  "competition_id": 7,
  "competition_name": "中国大学生医学技术技能大赛",
  "judging_dimensions": [
    {
      "dimension": "本专业基本理论、基本知识、基本技能（三基）",
      "weight": "40%【推断权重，官方通知明确考察内容但未公布分值】",
      "official_wording": "大赛重点考察本专业领域的基本理论、基本知识、基本技能（教育部办公厅第十届大赛通知第六条）",
      "scoring_points": [
        "操作站点中规程执行的完整性与规范性（无菌操作、查对制度、爱伤观念）",
        "理论/知识竞答环节答题准确率",
        "临床常用技能操作（心肺复苏、穿刺、缝合、导尿、护理基础操作等）的标准化程度",
        "操作的时效性与熟练度"
      ],
      "common_deductions": [
        "违反无菌原则或操作规程",
        "遗漏关键操作步骤或查对环节",
        "操作粗暴、模拟人/器械使用不当"
      ]
    },
    {
      "dimension": "临床思维与综合分析能力",
      "weight": "20%【推断权重】",
      "official_wording": "强调思维能力、医学人文关怀与团队合作等综合素质（教育部通知第六条）；新标准要注重职业素养、临床思维和技术技能的全面考察（通知第三条）",
      "scoring_points": [
        "病例分析站点中病史采集、诊断思路与鉴别诊断的逻辑性",
        "根据站点情境做出处置决策的准确性",
        "辅助检查结果的解读与运用"
      ],
      "common_deductions": [
        "诊断思路混乱、处置顺序颠倒",
        "忽略危重情境的关键判断",
        "只操作不评估、机械执行不结合病情"
      ]
    },
    {
      "dimension": "医学人文关怀",
      "weight": "15%【推断权重】",
      "official_wording": "强调思维能力、医学人文关怀与团队合作等综合素质，重视健康教育（教育部通知第六条）",
      "scoring_points": [
        "与标准化病人沟通的态度、语言与告知充分性",
        "操作前解释、操作中安抚、操作后观察的人文细节",
        "隐私保护与爱伤观念",
        "健康教育宣教的嵌入"
      ],
      "common_deductions": [
        "全程无语言交流、忽视病人感受",
        "暴露患者隐私、动作粗暴",
        "缺少操作前知情告知"
      ]
    },
    {
      "dimension": "团队合作",
      "weight": "15%【推断权重】",
      "official_wording": "强调思维能力、医学人文关怀与团队合作等综合素质（教育部通知第六条）",
      "scoring_points": [
        "三人正式队员间的分工与角色转换（主操作/助手/巡回）",
        "口头医嘱复述与交接配合",
        "抢救情境下的团队组织与指挥"
      ],
      "common_deductions": [
        "单人包揽、队员闲置",
        "配合失误导致操作中断或重复",
        "沟通喊叫、秩序混乱"
      ]
    },
    {
      "dimension": "职业素养与赛道专项要求",
      "weight": "10%【推断权重】",
      "official_wording": "临床医学专业八年制赛道要加强对国际视野、英文能力、临床科研和新技术应用等综合素质能力的考核（教育部通知第六条）",
      "scoring_points": [
        "八年制赛道的英文问诊/文献能力与科研思维考核",
        "中医学赛道的辨证论治与针灸推拿操作规范",
        "预防医学赛道的现场流行病学处置",
        "护理学赛道的整体护理与个案管理"
      ],
      "common_deductions": [
        "赛道专项操作不规范（如中医辨证与操作脱节）",
        "职业仪态与行为不符合医生角色要求"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "参赛队报名（每校每赛道1支队伍）",
      "format": "大赛官网 medu.bjmu.edu.cn/jnds 线上报名",
      "page_limit": "未明确",
      "deadline_note": "第十届通知规定报名截止2019-12-31（该届因疫情延后至2021年举行）；各届以组委会通知为准"
    },
    {
      "item": "参赛队员",
      "format": "每队3名正式队员+1名候补队员，均为毕业（生产）实习阶段本科生",
      "page_limit": "未明确",
      "deadline_note": "临床八年制赛道限生产实习阶段或完成实习不满半年者"
    },
    {
      "item": "竞赛考核材料（试题、评分标准、录像等）",
      "format": "承办高校按要求向大赛工作委员会报送",
      "page_limit": "未明确",
      "deadline_note": "大赛结束后报送，赛前保密"
    }
  ],
  "process_stages": [
    {
      "stage": "校内选拔",
      "format": "各医学院校组织校级技能竞赛选拔组建参赛队（高校普遍做法）",
      "notes": "覆盖临床、护理、中医、预防等专业【校内选拔为高校通行做法，通知未强制要求】"
    },
    {
      "stage": "分区赛（预选赛）",
      "format": "临床医学五年制赛道与护理学专业赛道设分区赛，由有关高校承办，选拔晋级总决赛的高校",
      "notes": "通知要求2020-04-12前完成（第十届实际延至2021年举行）；八年制与中医学赛道直接报名总决赛"
    },
    {
      "stage": "全国总决赛",
      "format": "多赛道同期进行的多站式操作竞赛；第十届由北京大学、北京中医药大学、首都医科大学联合承办，2021-05-15/16在天津举行；实际设5个赛道（临床五年制、临床八年制、中医学、预防医学、护理学，预防医学赛道为通知4赛道之外增设）",
      "notes": "设金奖、银奖、铜奖和各类单项奖；另设优秀选手、优秀指导教师、优秀组织高校等六类奖项"
    }
  ],
  "review_format": "多站式/赛道式现场操作考核，裁判依据操作评分表对操作规范性、临床思维、人文关怀与团队协作现场打分；各赛道考核范围由相关专业教指委在大赛官网发布。",
  "judge_preferences": [
    "操作标准化与细节完整（无菌观念、查对、爱伤）",
    "人文关怀自然融入操作而非表演化",
    "团队配合默契、抢救组织有序",
    "临床思维清晰，能结合病情做决策",
    "职业仪态稳定，心理素质好"
  ],
  "past_winning_patterns": [],
  "forbidden_or_risky": [
    "参赛选手须为毕业（生产）实习阶段在读本科生，非实习阶段学生或冒名顶替属违规",
    "竞赛试题、评分标准在赛前属保密材料，承办校须赛后报送，泄露试题属严重违规",
    "每所高校每赛道仅1支队伍，重复报名或跨校组队不被允许",
    "操作中致模拟人/器材损坏或危及安全的行为将被扣分或中止考核",
    "大赛厉行勤俭节约，承办与参赛环节不得铺张（通知明示）"
  ],
