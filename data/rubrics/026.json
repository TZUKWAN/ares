{
  "competition_id": 26,
  "competition_name": "光电设计竞赛",
  "judging_dimensions": [
    {
      "dimension": "实物赛道：方案设计与理论分析",
      "weight": "方案设计赛环节独立评分；答辩/演示综合考察科学性、可行性、创新性和经济性（第九届组委会文件，未公开分值表）",
      "official_wording": "第九届全国大学生光电设计竞赛组委会文件：'竞赛答辩：决赛入围一等奖的参赛队还将参加答辩或（和）演示，综合展示作品的科学性、可行性、创新性和经济性'。实物赛道为命题式赛题（如'智能车的激光对抗'），先提交方案设计书、答辩PPT、视频等参加方案设计赛。",
      "scoring_points": [
        "方案设计书的系统完整性：光机电算总体方案、光路/电路/算法设计、指标测算",
        "光学原理运用正确：光源、光束调制与探测、成像与信号处理链条合理",
        "关键指标论证与仿真/计算支撑",
        "答辩PPT与视频质量、陈述逻辑"
      ],
      "common_deductions": [
        "方案与赛题技术要求脱节、指标无法覆盖命题要求",
        "光路设计有明显物理错误",
        "方案书模板化、无定量分析"
      ]
    },
    {
      "dimension": "实物赛道：现场演示/竞技成绩",
      "weight": "现场赛环节独立计分；全国总决赛（现场赛）另发细则（第十三届区赛参考细则、总决赛现场赛细则，分值按赛题设定）",
      "official_wording": "2025年第十三届竞赛设'实物竞赛主赛道'，区赛现场决赛在上海工程技术大学举行（66所高校322支队伍）；官方发布《第十三届全国大学生光电设计竞赛区赛参考细则》与实物赛道全国总决赛（现场赛）细则。",
      "scoring_points": [
        "现场任务完成度：达标动作/命中/竞速等赛题客观指标得分",
        "实物装置的可靠性与稳定性（多次运行一致性）",
        "现场调试应变能力与时间管理",
        "安全规范操作（激光、高压电源防护）"
      ],
      "common_deductions": [
        "现场无法运行或频繁故障",
        "使用与报名不符的器件或代做装置",
        "违反现场安全规程（激光直射人眼等）",
        "超时或占用他人场地"
      ]
    },
    {
      "dimension": "创意赛道：创意与创新水平",
      "weight": "定性评审为主；评审考量创新性、技术水平、可行性与商业价值（第十届创意赛通知，具体分值以当届文件为准）",
      "official_wording": "第十届全国大学生光电设计竞赛（东部区赛）校内选拔赛通知（华东理工教务处）：'本届竞赛为创意赛（开放性的创意创新创业设计类赛题，包含创意类竞赛、初创类竞赛）。参赛项目能够将光电信息技术与移动互联网、云计算、大数据、人工智能……'（原文要求与新技术融合）。",
      "scoring_points": [
        "选题新颖性与光电技术的核心作用（非'贴光电标签'）",
        "与AI、物联网、大数据等热点技术的融合深度",
        "技术方案的科学性与可实现性（原理样机/演示验证加分）",
        "创意类要求报名前尚未完成工商注册、队长为本科生或专科生（每队≤3人且研究生≤1人）"
      ],
      "common_deductions": [
        "创意与光电学科关联弱、跨界拼接生硬",
        "只有概念无任何原型或仿真验证",
        "创意类队伍已完成工商注册（组别不符）"
      ]
    },
    {
      "dimension": "初创类与商业价值展示",
      "weight": "定性评审：以学生为主体的注册公司项目，考察创业可行性与市场前景",
      "official_wording": "第十届创意赛通知（高校转载）：初创类竞赛为'以学生为主体或参与的注册公司'项目，参赛人不多于7人；路演答辩评审综合考察商业可行性。",
      "scoring_points": [
        "商业模式与市场分析合理性",
        "学生团队在公司的真实主体地位与股权结构",
        "产品原型的成熟度与已有订单/用户证据",
        "路演表现力与答辩逻辑"
      ],
      "common_deductions": [
        "公司实际由教师/社会人员控制、学生挂名",
        "商业计划与光电技术脱节",
        "财务与市场预测明显失真"
      ]
    },
    {
      "dimension": "光学设计赛道（如宇瞳杯）",
      "weight": "分赛道独立评审：由当届光学设计赛道分委员会另行制定评分标准",
      "official_wording": "2025年第十三届通知：'本届竞赛包含实物竞赛主赛道和光学设计赛道，将成立第十三届全国大学生光电设计竞赛组织委员会（含光学设计赛道分委员会），确保竞赛的组织实施工作有序开展'；赛题细则由分委员会另行发布。",
      "scoring_points": [
        "光学系统设计指标达成度（焦距、像质、MTF等赛题规定参数）",
        "设计报告的完整性与优化过程记录（ZEMAX/CODE V等文件）",
        "公差分析与加工可行性",
        "答辩对设计取舍的技术阐述"
      ],
      "common_deductions": [
        "设计文件不全、无法复现",
        "指标未达赛题下限",
        "抄袭既有专利设计或代做"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "实物赛道方案设计书",
      "format": "PDF/Word，含总体方案、光机电设计、指标测算；随答辩PPT与演示视频",
      "page_limit": "未明确（以当届赛题细则为准）",
      "deadline_note": "区赛方案设计赛提交截止约5-6月；晋级队伍8月参加全国总决赛现场赛"
    },
    {
      "item": "实物作品（样机）",
      "format": "按赛题要求自制的光电装置，现场携带演示/竞技",
      "page_limit": "未明确",
      "deadline_note": "区赛现场决赛（7月）与全国总决赛（8月）现场检录运行"
    },
    {
      "item": "创意赛道项目计划书与路演PPT",
      "format": "PDF/PPT，路演答辩形式；创意类每队不超3人（研究生不超1人）、初创类不超7人",
      "page_limit": "未明确",
      "deadline_note": "校赛预选3-6月→区赛（6-7月）→国赛（8月）；经区赛按名额推荐国赛"
    },
    {
      "item": "光学设计赛道设计文件",
      "format": "光学设计软件工程文件+设计报告（宇瞳杯等分赛道）",
      "page_limit": "未明确",
      "deadline_note": "按分赛道委员会通知时间提交"
    }
  ],
  "process_stages": [
    {
      "stage": "校赛预选（校级预选赛）",
      "format": "校内组织选拔或直接推荐报名",
      "notes": "每年3-6月；部分高校设预选赛QQ群统一管理（如武汉科技大学第十四届校赛通知）"
    },
    {
      "stage": "区赛（分区赛）",
      "format": "实物赛道：方案设计评审+现场演示/竞技决赛；创意赛道：路演答辩；按赛区规模比例推荐国赛",
      "notes": "分东部/中部/西南/东南/西北/华北等赛区；2025年东部区赛7月11-13日在上海工程技术大学（66校322队）、西南区赛7月28-29日在昆明理工大学；第十二届规则：赛区参赛高校数占比N<50%时按区赛前15%推荐且总数一般不超30支"
    },
    {
      "stage": "全国总决赛（国赛）",
      "format": "实物赛道现场赛细则比拼+一等奖答辩；创意赛道路演答辩评特等奖",
      "notes": "2025年第十三届总决赛8月中下旬在杭州由浙江大学承办；一、二、三等奖约按20%/30%/50%产生，获奖队伍原则上不超过报名队伍数的20%（赛氪转载）"
    }
  ],
  "review_format": "实物赛道'方案设计书评审+现场演示/竞技+一等奖答辩'三级计分；创意赛道计划书网评+路演答辩；光学设计赛道由分赛道委员会专项评审",
  "judge_preferences": [
    "实物赛看重现场硬指标：演示稳定性与任务完成率优先于PPT华丽程度",
    "光学原理与光电技术链条是否真正'以光为核心'，反感贴标签式拼接",
    "创意赛青睐'光电+AI/物联网/大数据'融合且有原型验证的项目",
    "答辩中能讲清关键参数的物理来源与实测数据",
    "装置工艺与安全性（激光防护、结构可靠性）是隐性好感项"
  ],
