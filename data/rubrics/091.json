{
  "competition_id": 91,
  "competition_name": "湖北省生物实验技能竞赛",
  "judging_dimensions": [
    {
      "dimension": "实验操作规范性",
      "weight": "【推断约40%】操作为决赛核心环节；官方未公布分值",
      "official_wording": "武汉华夏理工学院校内选拔赛文件（转发省赛口径）：'操作技能：含各课程基本的实验技能，熟练掌握常用仪器设备的使用方法，能现场使用提供的实验仪器设备获得相关数据'。湖北民族大学2026年赛事报道：'决赛聚焦生物专业核心实验技能，设置常规实验仪器规范操作……'。各环节具体分值未公开，权重为推断【推断】。",
      "scoring_points": [
        "移液器、离心机、显微镜、电泳仪、PCR仪等常规仪器规范熟练使用",
        "无菌操作、试剂取用、安全防护等基本操作规程到位",
        "操作顺序合理、动作规范，无危险动作",
        "能在限定时间内用现场提供的仪器获得有效数据"
      ],
      "common_deductions": [
        "违反无菌/安全操作规程（如枪头回用、器皿混用）",
        "仪器操作错误导致实验失败或数据无效",
        "超时未完成规定操作步骤"
      ]
    },
    {
      "dimension": "实验现象观测与数据整理分析",
      "weight": "【推断约30%】",
      "official_wording": "湖北医药学院赛事报道：决赛设'常规实验仪器规范操作、实验现象观测与数据整理分析、综合型实验方案自主设计'三个环节。武汉华夏理工学院文件：'分析计算能力：对现场实验操作所获得实验数据的分析与计算'。",
      "scoring_points": [
        "规范记录实验现象与原始数据（真实、完整、可追溯）",
        "数据处理与计算正确（标准曲线、浓度换算、统计分析等）",
        "对异常现象能给出合理解释",
        "结果报告条理清晰、结论有据"
      ],
      "common_deductions": [
        "编造、涂改原始数据",
        "计算错误或单位混乱",
        "现象描述与实际观测不符"
      ]
    },
    {
      "dimension": "综合实验方案自主设计",
      "weight": "【推断约20%】",
      "official_wording": "湖北医药学院赛事报道：决赛含'综合型实验方案自主设计'环节。省赛定位（武汉工程大学等转发通知）：'培养大学生生物学实验动手能力和科学思维能力'。",
      "scoring_points": [
        "方案设计科学合理、逻辑完整（目的-原理-步骤-预期结果）",
        "材料方法选择恰当、可操作性强",
        "体现科学思维：设对照、控变量、考虑重复",
        "创新性与综合性：跨知识点整合能力"
      ],
      "common_deductions": [
        "方案原理错误或步骤不可行",
        "无对照设计、变量混乱",
        "照搬讲义实验、无自主设计成分"
      ]
    },
    {
      "dimension": "实验理论知识（初赛笔试）",
      "weight": "省级初赛以理论考核为主，初赛分数为海选/初赛环节计分依据；【推断决赛综合成绩中理论占一定比例】",
      "official_wording": "中南民族大学报道：'本届单项赛涵盖生物学领域分子生物学、生物化学两个学科的理论知识和实验操作。单项赛经过前期的海选、省级初赛'。武汉生物工程学院校内选拔：'初赛（理论测试）+多组实验操作'形式。",
      "scoring_points": [
        "生物化学、分子生物学、细胞生物学与遗传学等科目的实验原理笔试",
        "实验相关理论知识与试剂配方、仪器原理",
        "初赛成绩决定决赛（实验操作）资格"
      ],
      "common_deductions": [
        "理论成绩不达线无法进入操作决赛",
        "基本概念与实验原理掌握不牢影响答辩与设计环节"
      ]
    }
  ],
