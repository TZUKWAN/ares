{
  "competition_id": 132,
  "competition_name": "SAMPE中国复合材料系列竞赛",
  "judging_dimensions": [
    {
      "dimension": "结构性能与轻量化（现场加载测试+称重排名）",
      "weight": "通过制（客观测试：载荷达标为门槛，达标后按试件重量由轻到重排名，不设百分比权重）",
      "official_wording": "官方规则原文（超轻复合材料机翼赛）：“机翼载荷在满足10kN的前提下，按照重量的增加排列名次，即重量越轻的作品获胜”（第八届机翼参赛规则，赛氪转载）；官网称竞赛旨在提升学生“设计、优化、分析、建模和动手制作能力”（SAMPE中国官网）",
      "scoring_points": [
        "试件在规定跨度/支承条件下加载至规定载荷（机翼赛10kN量级）不失效",
        "载荷达标前提下试件重量最轻者名次最高",
        "结构传力路径合理、无提前屈曲/分层/连接失效",
        "按赛项分类测试（机翼预浸料成型、机翼液体成型、碳纤维桥梁、天然纤维桥梁）"
      ],
      "common_deductions": [
        "加载未达规定载荷即破坏，失去排名资格",
        "试件尺寸/重量超限或不符合赛项规定",
        "现场测试与设计报告不一致（结构形式弄虚作假）"
      ]
    },
    {
      "dimension": "工艺制造质量",
      "weight": "定性（专家评审，官方未公布权重）",
      "official_wording": "【推断】官网称竞赛普及“先进复合材料结构设计及制造工艺知识”，赛项按工艺分类（预浸料成型/液体成型），并有波音、赫氏、英斯特朗等材料与工艺企业赞助（SAMPE中国官网及同济大学介绍）。推断依据：工艺分类竞赛中成型质量（孔隙、铺层、固化、表面）必然是专家评审重点",
      "scoring_points": [
        "铺层设计合理，成型工艺与所选赛项匹配",
        "试件无明显缺陷：孔隙、贫富胶、褶皱、分层、翘曲",
        "表面质量与细节（倒角、连接区、加载端处理）",
        "工艺过程记录完整可复现"
      ],
      "common_deductions": [
        "成型缺陷明显影响性能",
        "工艺与赛项类别不符（如液体成型赛用了预浸料工艺）",
        "无法说明制作过程，疑请人代制"
      ]
    },
    {
      "dimension": "设计分析与优化（设计报告）",
      "weight": "定性（专家评审，官方未公布权重）",
      "official_wording": "【推断】官网表述竞赛提升学生“设计、优化、分析、建模”能力（SAMPE中国官网原文），各高校组织通知均要求提交设计与计算材料。推断依据：重量排名赛制下，有限元分析、优化迭代与安全裕度设计是评审区分优劣的重要依据",
      "scoring_points": [
        "设计计算书完整：载荷分析、失效模式评估、安全系数",
        "有限元建模与优化过程规范，与实测结果对照",
        "材料选型与性能数据引用合理",
        "图纸与试件一致"
      ],
      "common_deductions": [
        "无计算依据、纯试错制作",
        "分析结果与实测严重背离且无解释",
        "报告抄袭或数据造假"
      ]
    },
    {
      "dimension": "创新性与工程应用价值（工程结构赛/再生碳纤维等赛项侧重）",
      "weight": "定性（专家评审，官方未公布权重）",
      "official_wording": "官网设“SAMPE国际工程结构纤维复合材料创新应用设计学生竞赛”（第七届，2026年）与“再生碳纤维桥梁竞赛”栏目，名称即以“创新应用设计”定位（SAMPE中国官网学生竞赛栏目）",
      "scoring_points": [
        "复材在工程结构中的应用方案有新意（结构形式、连接、功能一体化）",
        "再生/天然纤维等可持续材料的合理利用",
        "面向真实工程需求的价值论证",
        "成本与可制造性考量"
      ],
      "common_deductions": [
        "方案为已有工程的简单缩比复刻",
        "创新点仅停留在材料替换而无结构层面价值",
        "应用场景空想、无可行性论证"
      ]
    }
  ],
  "deliverable_requirements": [
    {
      "item": "结构试件（机翼/桥梁类赛项）",
      "format": "按当届规则制作的复合材料试件：机翼（预浸料成型/液体成型两个赛项）、桥梁（碳纤维/天然纤维两个赛项），满足规定跨度、几何与重量限制",
      "page_limit": "不适用（以当届规则规定的尺寸重量为准）",
      "deadline_note": "通知约12月发布（第十七届2024-12-10、第十八届2025-12-19），报名截止约12月31日，次年6月SAMPE中国年会现场测试（第十八届2026年6月9-11日，北京中国国际展览中心）"
    },
    {
      "item": "设计报告/计算材料",
      "format": "结构设计说明书、计算分析与建模优化文档、制作工艺记录",
      "page_limit": "未明确",
      "deadline_note": "随试件现场提交或按当届通知线上提交"
    },
    {
      "item": "工程结构创新应用设计赛方案（该赛项）",
      "format": "创新应用设计方案（图纸+说明）与实物或模型（第七届为2026年6月年会期间评审）",
      "page_limit": "未明确",
      "deadline_note": "SAMPE中国年会期间现场评审"
    },
    {
      "item": "学生论文（国际大学生论文大赛）",
      "format": "中英文研究论文全文，经评审推荐者在大会口头宣读",
      "page_limit": "未明确",
      "deadline_note": "随SAMPE中国年会征文（2026年会征文自2025年12月底进行中）"
    }
  ],
  "process_stages": [
    {
      "stage": "竞赛通知与报名",
      "format": "SAMPE中国大陆总会于每年12月前后发布当届通知（经高校创新创业/学院网站转发），在校学生在校内组织下报名，截止约12月31日",
      "notes": "第十七届通知2024年12月10日发布；第十六届报名2023年12月31日截止；主办为国际先进材料与制造工程学会（SAMPE）中国大陆总会，波音、赫氏、英斯特朗、华昌聚合物、中国飞机强度研究所等企业赞助"
    },
    {
      "stage": "设计与制作",
      "format": "团队开展结构设计、有限元分析与优化、工艺成型制作试件，历时数月",
      "notes": "官网称竞赛旨在普及先进复合材料结构设计及制造工艺知识，提升设计、优化、分析、建模与动手制作能力"
    },
    {
      "stage": "年会现场测试与评审",
      "format": "6月SAMPE中国年会期间（北京中国国际展览中心）现场称重、加载测试与专家评审；机翼/桥梁赛分预浸料机翼、液体成型机翼、碳纤维桥梁、天然纤维桥梁四类；同期还有工程结构创新应用设计赛、学生论文大赛、增材制造学生竞赛等",
      "notes": "第十八届2026年6月9-11日举行；第十七届共147支队伍、近千名师生参赛；年会集展览（7馆30000+平米）、学术会议、创新墙报、学生竞赛六位于一体"
    },
    {
      "stage": "颁奖与后续",
      "format": "各赛项评出一、二、三等奖等奖项并颁奖；国内获奖队伍曾获优先推荐赴美参加SAMPE国际学生赛事",
      "notes": "竞赛结果经SAMPE中国官网（sampechina.org/Result）及高校媒体公布"
    }
  ],
  "review_format": "客观性能测试与专家评审结合：机翼/桥梁类赛项以现场加载（达标门槛）后称重排名为主要依据，叠加专家对工艺质量、设计分析报告与创新性的定性评审；工程结构赛、论文赛由专家委员会按方案创新性与学术质量评审。",
  "judge_preferences": [
    "轻量化极致且一次加载成功的试件最受认可——性能测试是硬指标",
    "设计与实测闭环：计算书、有限元优化过程与实际破坏模式能对应者获好评",
    "成型工艺规范、缺陷少的试件体现训练素养，工艺与赛项匹配",
    "可持续材料（天然纤维、再生碳纤维）与工程创新应用是系列新赛项的导向",
    "团队动手真实性与过程记录完整，抵制代工制作"
  ],
