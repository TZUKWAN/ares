{
  "name": "ares",
  "version": "2.3.0",
  "private": true,
  "description": "ARES竞赛作品工坊：真实流程、实时作品预览、DSH原生助手、版本验收与金山共编",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./client": "./client/client.js",
    "./runtime": "./host/runtime.js",
    "./editor-runtime": "./host/editor-runtime.js",
    "./runtime-directory": "./host/runtime-directory.js"
  },
  "engines": {
    "dsh": ">=0.2",
    "node": ">=20"
  },
  "license": "SEE LICENSE IN THIRD_PARTY_NOTICES.md",
  "author": "TZUKWAN",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "index.js",
    "host/",
    "client/",
    "skills/",
    "data/",
    "scripts/",
    "platforms/",
    "docs/",
    "cordis.patch.yml",
    "locale/",
    "assets/",
    "commands/",
    "agents/",
    "hooks/",
    "plugin.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build:forge": "node scripts/build_forge.mjs",
    "test": "node --test tests/core.test.mjs tests/api.test.mjs",
    "test:all": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:browser:install": "playwright install chromium",
    "test:quality": "python -m unittest discover -s tests -p test_*.py",
    "test:editor": "node --test tests/editor.test.mjs tests/editor-client.test.mjs",
    "test:tools:native": "node --test tests/dsh-native-tools.integration.mjs",
    "test:workbench": "node --test tests/project-workbench.test.mjs tests/project-extensions.test.mjs tests/recovery.test.mjs",
    "test:client": "node --test tests/client-workbench.test.mjs",
    "test:workshop": "node --test tests/artifact-viewer.test.mjs tests/native-session.test.mjs tests/project-session.test.mjs tests/cloud-working-draft.test.mjs tests/workshop-client.test.mjs"
  },
  "devDependencies": {
    "playwright": "1.65.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
