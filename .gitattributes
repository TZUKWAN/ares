* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.json text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf

# Preserve upstream license copies and their recorded hashes on every platform.
# Upstream trailing spaces are retained; whitespace checks still apply to code.
assets/forge-fonts/*-LICENSE.txt -text -whitespace
assets/neural-reference/LICENSE -text -whitespace
assets/neural-reference/NOTICE.md -text -whitespace
assets/neural-reference/licenses/* -text -whitespace
platforms/shared/vendor/licenses/* -text -whitespace
platforms/shared/vendor/*.LEGAL.txt -text -whitespace
platforms/ui/licenses/* -text -whitespace
